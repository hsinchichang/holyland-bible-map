[{"pk": 584423, "verse": 1, "text": "\u8036 \u7a4c \u904e \u53bb \u7684 \u6642 \u5019 \uff0c \u770b \u898b \u4e00 \u500b \u4eba \u751f \u4f86 \u662f \u778e \u773c \u7684 \u3002"}, {"pk": 584424, "verse": 2, "text": "\u9580 \u5f92 \u554f \u8036 \u7a4c \u8aaa \uff1a \u62c9 \u6bd4 \uff0c \u9019 \u4eba \u751f \u4f86 \u662f \u778e \u773c \u7684 \uff0c \u662f \u8ab0 \u72af \u4e86 \u7f6a \uff1f \u662f \u9019 \u4eba \u5462 \uff1f \u662f \u4ed6 \u7236 \u6bcd \u5462 \uff1f"}, {"pk": 584425, "verse": 3, "text": "\u8036 \u7a4c \u56de \u7b54 \u8aaa \uff1a \u4e5f \u4e0d \u662f \u9019 \u4eba \u72af \u4e86 \u7f6a \uff0c \u4e5f \u4e0d \u662f \u4ed6 \u7236 \u6bcd \u72af \u4e86 \u7f6a \uff0c \u662f \u8981 \u5728 \u4ed6 \u8eab \u4e0a \u986f \u51fa \u795e \u7684 \u4f5c \u70ba \u4f86 \u3002"}, {"pk": 584426, "verse": 4, "text": "\u8d81 \u8457 \u767d \u65e5 \uff0c \u6211 \u5011 \u5fc5 \u9808 \u505a \u90a3 \u5dee \u6211 \u4f86 \u8005 \u7684 \u5de5 \uff1b \u9ed1 \u591c \u5c07 \u5230 \uff0c \u5c31 \u6c92 \u6709 \u4eba \u80fd \u505a \u5de5 \u4e86 \u3002"}, {"pk": 584427, "verse": 5, "text": "\u6211 \u5728 \u4e16 \u4e0a \u7684 \u6642 \u5019 \uff0c \u662f \u4e16 \u4e0a \u7684 \u5149 \u3002"}, {"pk": 584428, "verse": 6, "text": "\u8036 \u7a4c \u8aaa \u4e86 \u9019 \u8a71 \uff0c \u5c31 \u5410 \u553e \u6cab \u5728 \u5730 \u4e0a \uff0c \u7528 \u553e \u6cab \u548c \u6ce5 \u62b9 \u5728 \u778e \u5b50 \u7684 \u773c \u775b \u4e0a \uff0c"}, {"pk": 584429, "verse": 7, "text": "\u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u5f80 \u897f \u7f85 \u4e9e \u6c60 \u5b50 \u88e1 \u53bb \u6d17 \uff08 \u897f \u7f85 \u4e9e \u7e59 \u51fa \u4f86 \u5c31 \u662f \u5949 \u5dee \u9063 \uff09 \u3002 \u4ed6 \u53bb \u4e00 \u6d17 \uff0c \u56de \u982d \u5c31 \u770b \u898b \u4e86 \u3002"}, {"pk": 584430, "verse": 8, "text": "\u4ed6 \u7684 \u9130 \u820d \u548c \u90a3 \u7d20 \u5e38 \u898b \u4ed6 \u662f \u8a0e \u98ef \u7684 \uff0c \u5c31 \u8aaa \uff1a \u9019 \u4e0d \u662f \u90a3 \u5f9e \u524d \u5750 \u8457 \u8a0e \u98ef \u7684 \u4eba \u9ebc \uff1f"}, {"pk": 584431, "verse": 9, "text": "\u6709 \u4eba \u8aaa \uff1a \u662f \u4ed6 \uff1b \u53c8 \u6709 \u4eba \u8aaa \uff1b \u4e0d \u662f \uff0c \u537b \u662f \u50cf \u4ed6 \u3002 \u4ed6 \u81ea \u5df1 \u8aaa \uff1a \u662f \u6211 \u3002"}, {"pk": 584432, "verse": 10, "text": "\u4ed6 \u5011 \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u7684 \u773c \u775b \u662f \u600e \u9ebc \u958b \u7684 \u5462 \uff1f"}, {"pk": 584433, "verse": 11, "text": "\u4ed6 \u56de \u7b54 \u8aaa \uff1a \u6709 \u4e00 \u500b \u4eba \uff0c \u540d \u53eb \u8036 \u7a4c \uff0c \u4ed6 \u548c \u6ce5 \u62b9 \u6211 \u7684 \u773c \u775b \uff0c \u5c0d \u6211 \u8aaa \uff1a \u4f60 \u5f80 \u897f \u7f85 \u4e9e \u6c60 \u5b50 \u53bb \u6d17 \u3002 \u6211 \u53bb \u4e00 \u6d17 \uff0c \u5c31 \u770b \u898b \u4e86 \u3002"}, {"pk": 584434, "verse": 12, "text": "\u4ed6 \u5011 \u8aaa \uff1a \u90a3 \u500b \u4eba \u5728 \u90a3 \u88e1 \uff1f \u4ed6 \u8aaa \uff1a \u6211 \u4e0d \u77e5 \u9053 \u3002"}, {"pk": 584435, "verse": 13, "text": "\u4ed6 \u5011 \u628a \u5f9e \u524d \u778e \u773c \u7684 \u4eba \u5e36 \u5230 \u6cd5 \u5229 \u8cfd \u4eba \u90a3 \u88e1 \u3002"}, {"pk": 584436, "verse": 14, "text": "\u8036 \u7a4c \u548c \u6ce5 \u958b \u4ed6 \u773c \u775b \u7684 \u65e5 \u5b50 \u662f \u5b89 \u606f \u65e5 \u3002"}, {"pk": 584437, "verse": 15, "text": "\u6cd5 \u5229 \u8cfd \u4eba \u4e5f \u554f \u4ed6 \u662f \u600e \u9ebc \u5f97 \u770b \u898b \u7684 \u3002 \u778e \u5b50 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4ed6 \u628a \u6ce5 \u62b9 \u5728 \u6211 \u7684 \u773c \u775b \u4e0a \uff0c \u6211 \u53bb \u4e00 \u6d17 \uff0c \u5c31 \u770b \u898b \u4e86 \u3002"}, {"pk": 584438, "verse": 16, "text": "\u6cd5 \u5229 \u8cfd \u4eba \u4e2d \u6709 \u7684 \u8aaa \uff1a \u9019 \u500b \u4eba \u4e0d \u662f \u5f9e \u795e \u4f86 \u7684 \uff0c \u56e0 \u70ba \u4ed6 \u4e0d \u5b88 \u5b89 \u606f \u65e5 \u3002 \u53c8 \u6709 \u4eba \u8aaa \uff1a \u4e00 \u500b \u7f6a \u4eba \u600e \u80fd \u884c \u9019 \u6a23 \u7684 \u795e \u8e5f \u5462 \uff1f \u4ed6 \u5011 \u5c31 \u8d77 \u4e86 \u5206 \u722d \u3002"}, {"pk": 584439, "verse": 17, "text": "\u4ed6 \u5011 \u53c8 \u5c0d \u778e \u5b50 \u8aaa \uff1a \u4ed6 \u65e2 \u7136 \u958b \u4e86 \u4f60 \u7684 \u773c \u775b \uff0c \u4f60 \u8aaa \u4ed6 \u662f \u600e \u6a23 \u7684 \u4eba \u5462 \uff1f \u4ed6 \u8aaa \uff1a \u662f \u500b \u5148 \u77e5 \u3002"}, {"pk": 584440, "verse": 18, "text": "\u7336 \u592a \u4eba \u4e0d \u4fe1 \u4ed6 \u5f9e \u524d \u662f \u778e \u773c \uff0c \u5f8c \u4f86 \u80fd \u770b \u898b \u7684 \uff0c \u7b49 \u5230 \u53eb \u4e86 \u4ed6 \u7684 \u7236 \u6bcd \u4f86 \uff0c"}, {"pk": 584441, "verse": 19, "text": "\u554f \u4ed6 \u5011 \u8aaa \uff1a \u9019 \u662f \u4f60 \u5011 \u7684 \u5152 \u5b50 \u9ebc \uff1f \u4f60 \u5011 \u8aaa \u4ed6 \u751f \u4f86 \u662f \u778e \u773c \u7684 \uff0c \u5982 \u4eca \u600e \u9ebc \u80fd \u770b \u898b \u4e86 \u5462 \uff1f"}, {"pk": 584442, "verse": 20, "text": "\u4ed6 \u7236 \u6bcd \u56de \u7b54 \u8aaa \uff1a \u4ed6 \u662f \u6211 \u5011 \u7684 \u5152 \u5b50 \uff0c \u751f \u4f86 \u5c31 \u778e \u773c \uff0c \u9019 \u662f \u6211 \u5011 \u77e5 \u9053 \u7684 \u3002"}, {"pk": 584443, "verse": 21, "text": "\u81f3 \u65bc \u4ed6 \u5982 \u4eca \u600e \u9ebc \u80fd \u770b \u898b \uff0c \u6211 \u5011 \u537b \u4e0d \u77e5 \u9053 \uff1b \u662f \u8ab0 \u958b \u4e86 \u4ed6 \u7684 \u773c \u775b \uff0c \u6211 \u5011 \u4e5f \u4e0d \u77e5 \u9053 \u3002 \u4ed6 \u5df2 \u7d93 \u6210 \u4e86 \u4eba \uff0c \u4f60 \u5011 \u554f \u4ed6 \u7f77 \uff0c \u4ed6 \u81ea \u5df1 \u5fc5 \u80fd \u8aaa \u3002"}, {"pk": 584444, "verse": 22, "text": "\u4ed6 \u7236 \u6bcd \u8aaa \u9019 \u8a71 \uff0c \u662f \u6015 \u7336 \u592a \u4eba \uff1b \u56e0 \u70ba \u7336 \u592a \u4eba \u5df2 \u7d93 \u5546 \u8b70 \u5b9a \u4e86 \uff0c \u82e5 \u6709 \u8a8d \u8036 \u7a4c \u662f \u57fa \u7763 \u7684 \uff0c \u8981 \u628a \u4ed6 \u8d95 \u51fa \u6703 \u5802 \u3002"}, {"pk": 584445, "verse": 23, "text": "\u56e0 \u6b64 \u4ed6 \u7236 \u6bcd \u8aaa \uff1a \u4ed6 \u5df2 \u7d93 \u6210 \u4e86 \u4eba \uff0c \u4f60 \u5011 \u554f \u4ed6 \u7f77 \u3002"}, {"pk": 584446, "verse": 24, "text": "\u6240 \u4ee5 \u6cd5 \u5229 \u8cfd \u4eba \u7b2c \u4e8c \u6b21 \u53eb \u4e86 \u90a3 \u5f9e \u524d \u778e \u773c \u7684 \u4eba \u4f86 \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u8a72 \u5c07 \u69ae \u8000 \u6b78 \u7d66 \u795e \uff0c \u6211 \u5011 \u77e5 \u9053 \u9019 \u4eba \u662f \u500b \u7f6a \u4eba \u3002"}, {"pk": 584447, "verse": 25, "text": "\u4ed6 \u8aaa \uff1a \u4ed6 \u662f \u500b \u7f6a \u4eba \u4e0d \u662f \uff0c \u6211 \u4e0d \u77e5 \u9053 \uff1b \u6709 \u4e00 \u4ef6 \u4e8b \u6211 \u77e5 \u9053 \uff0c \u5f9e \u524d \u6211 \u662f \u773c \u778e \u7684 \uff0c \u5982 \u4eca \u80fd \u770b \u898b \u4e86 \u3002"}, {"pk": 584448, "verse": 26, "text": "\u4ed6 \u5011 \u5c31 \u554f \u4ed6 \u8aaa \uff1a \u4ed6 \u5411 \u4f60 \u505a \u751a \u9ebc \uff1f \u662f \u600e \u9ebc \u958b \u4e86 \u4f60 \u7684 \u773c \u775b \u5462 \uff1f"}, {"pk": 584449, "verse": 27, "text": "\u4ed6 \u56de \u7b54 \u8aaa \uff1a \u6211 \u65b9 \u624d \u544a \u8a34 \u4f60 \u5011 \uff0c \u4f60 \u5011 \u4e0d \u807d \uff0c \u70ba \u751a \u9ebc \u53c8 \u8981 \u807d \u5462 \uff1f \u83ab \u975e \u4f60 \u5011 \u4e5f \u8981 \u4f5c \u4ed6 \u7684 \u9580 \u5f92 \u9ebc \uff1f"}, {"pk": 584450, "verse": 28, "text": "\u4ed6 \u5011 \u5c31 \u7f75 \u4ed6 \u8aaa \uff1a \u4f60 \u662f \u4ed6 \u7684 \u9580 \u5f92 \uff1b \u6211 \u5011 \u662f \u6469 \u897f \u7684 \u9580 \u5f92 \u3002"}, {"pk": 584451, "verse": 29, "text": "\u795e \u5c0d \u6469 \u897f \u8aaa \u8a71 \u662f \u6211 \u5011 \u77e5 \u9053 \u7684 \uff1b \u53ea \u662f \u9019 \u500b \u4eba \uff0c \u6211 \u5011 \u4e0d \u77e5 \u9053 \u4ed6 \u5f9e \u90a3 \u88e1 \u4f86 \uff01"}, {"pk": 584452, "verse": 30, "text": "\u90a3 \u4eba \u56de \u7b54 \u8aaa \uff1a \u4ed6 \u958b \u4e86 \u6211 \u7684 \u773c \u775b \uff0c \u4f60 \u5011 \u7adf \u4e0d \u77e5 \u9053 \u4ed6 \u5f9e \u90a3 \u88e1 \u4f86 \uff0c \u9019 \u771f \u662f \u5947 \u602a \uff01"}, {"pk": 584453, "verse": 31, "text": "\u6211 \u5011 \u77e5 \u9053 \u795e \u4e0d \u807d \u7f6a \u4eba \uff0c \u60df \u6709 \u656c \u5949 \u795e \u3001 \u9075 \u884c \u4ed6 \u65e8 \u610f \u7684 \uff0c \u795e \u624d \u807d \u4ed6 \u3002"}, {"pk": 584454, "verse": 32, "text": "\u5f9e \u5275 \u4e16 \u4ee5 \u4f86 \uff0c \u672a \u66fe \u807d \u898b \u6709 \u4eba \u628a \u751f \u4f86 \u662f \u778e \u5b50 \u7684 \u773c \u775b \u958b \u4e86 \u3002"}, {"pk": 584455, "verse": 33, "text": "\u9019 \u4eba \u82e5 \u4e0d \u662f \u5f9e \u795e \u4f86 \u7684 \uff0c \u751a \u9ebc \u4e5f \u4e0d \u80fd \u505a \u3002"}, {"pk": 584456, "verse": 34, "text": "\u4ed6 \u5011 \u56de \u7b54 \u8aaa \uff1a \u4f60 \u5168 \u7136 \u751f \u5728 \u7f6a \u5b7d \u4e2d \uff0c \u9084 \u8981 \u6559 \u8a13 \u6211 \u5011 \u9ebc \uff1f \u65bc \u662f \u628a \u4ed6 \u8d95 \u51fa \u53bb \u4e86 \u3002"}, {"pk": 584457, "verse": 35, "text": "\u8036 \u7a4c \u807d \u8aaa \u4ed6 \u5011 \u628a \u4ed6 \u8d95 \u51fa \u53bb \uff0c \u5f8c \u4f86 \u9047 \u898b \u4ed6 \uff0c \u5c31 \u8aaa \uff1a \u4f60 \u4fe1 \u795e \u7684 \u5152 \u5b50 \u9ebc \uff1f"}, {"pk": 584458, "verse": 36, "text": "\u4ed6 \u56de \u7b54 \u8aaa \uff1a \u4e3b \u963f \uff0c \u8ab0 \u662f \u795e \u7684 \u5152 \u5b50 \uff0c \u53eb \u6211 \u4fe1 \u4ed6 \u5462 \uff1f"}, {"pk": 584459, "verse": 37, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4f60 \u5df2 \u7d93 \u770b \u898b \u4ed6 \uff0c \u73fe \u5728 \u548c \u4f60 \u8aaa \u8a71 \u7684 \u5c31 \u662f \u4ed6 \u3002"}, {"pk": 584460, "verse": 38, "text": "\u4ed6 \u8aaa \uff1a \u4e3b \u963f \uff0c \u6211 \u4fe1 \uff01 \u5c31 \u62dc \u8036 \u7a4c \u3002"}, {"pk": 584461, "verse": 39, "text": "\u8036 \u7a4c \u8aaa \uff1a \u6211 \u70ba \u5be9 \u5224 \u5230 \u9019 \u4e16 \u4e0a \u4f86 \uff0c \u53eb \u4e0d \u80fd \u770b \u898b \u7684 \uff0c \u53ef \u4ee5 \u770b \u898b \uff1b \u80fd \u770b \u898b \u7684 \uff0c \u53cd \u778e \u4e86 \u773c \u3002"}, {"pk": 584462, "verse": 40, "text": "\u540c \u4ed6 \u5728 \u90a3 \u88e1 \u7684 \u6cd5 \u5229 \u8cfd \u4eba \u807d \u898b \u9019 \u8a71 \uff0c \u5c31 \u8aaa \uff1a \u96e3 \u9053 \u6211 \u5011 \u4e5f \u778e \u4e86 \u773c \u9ebc \uff1f"}, {"pk": 584463, "verse": 41, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u82e5 \u778e \u4e86 \u773c \uff0c \u5c31 \u6c92 \u6709 \u7f6a \u4e86 \uff1b \u4f46 \u5982 \u4eca \u4f60 \u5011 \u8aaa \u6211 \u5011 \u80fd \u770b \u898b \uff0c \u6240 \u4ee5 \u4f60 \u5011 \u7684 \u7f6a \u9084 \u5728 \u3002"}]