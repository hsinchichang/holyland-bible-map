[{"pk": 585199, "verse": 1, "text": "\u6383 \u7f85 \u4ecd \u7136 \u5411 \u4e3b \u7684 \u9580 \u5f92 \u53e3 \u5410 \u5a01 \u5687 \u5147 \u6bba \u7684 \u8a71 \uff0c \u53bb \u898b \u5927 \u796d \u53f8 \uff0c"}, {"pk": 585200, "verse": 2, "text": "\u6c42 \u6587 \u66f8 \u7d66 \u5927 \u99ac \u8272 \u7684 \u5404 \u6703 \u5802 \uff0c \u82e5 \u662f \u627e \u8457 \u4fe1 \u5949 \u9019 \u9053 \u7684 \u4eba \uff0c \u7121 \u8ad6 \u7537 \u5973 \uff0c \u90fd \u51c6 \u4ed6 \u6346 \u7d81 \u5e36 \u5230 \u8036 \u8def \u6492 \u51b7 \u3002"}, {"pk": 585201, "verse": 3, "text": "\u6383 \u7f85 \u884c \u8def \uff0c \u5c07 \u5230 \u5927 \u99ac \u8272 \uff0c \u5ffd \u7136 \u5f9e \u5929 \u4e0a \u767c \u5149 \uff0c \u56db \u9762 \u7167 \u8457 \u4ed6 \uff1b"}, {"pk": 585202, "verse": 4, "text": "\u4ed6 \u5c31 \u4ec6 \u5012 \u5728 \u5730 \uff0c \u807d \u898b \u6709 \u8072 \u97f3 \u5c0d \u4ed6 \u8aaa \uff1a \u6383 \u7f85 \uff01 \u6383 \u7f85 \uff01 \u4f60 \u70ba \u751a \u9ebc \u903c \u8feb \u6211 \uff1f"}, {"pk": 585203, "verse": 5, "text": "\u4ed6 \u8aaa \uff1a \u4e3b \u963f \uff01 \u4f60 \u662f \u8ab0 \uff1f \u4e3b \u8aaa \uff1a \u6211 \u5c31 \u662f \u4f60 \u6240 \u903c \u8feb \u7684 \u8036 \u7a4c \u3002"}, {"pk": 585204, "verse": 6, "text": "\u8d77 \u4f86 \uff01 \u9032 \u57ce \u53bb \uff0c \u4f60 \u6240 \u7576 \u505a \u7684 \u4e8b \uff0c \u5fc5 \u6709 \u4eba \u544a \u8a34 \u4f60 \u3002"}, {"pk": 585205, "verse": 7, "text": "\u540c \u884c \u7684 \u4eba \u7ad9 \u5728 \u90a3 \u88e1 \uff0c \u8aaa \u4e0d \u51fa \u8a71 \u4f86 \uff0c \u807d \u898b \u8072 \u97f3 \uff0c \u537b \u770b \u4e0d \u898b \u4eba \u3002"}, {"pk": 585206, "verse": 8, "text": "\u6383 \u7f85 \u5f9e \u5730 \u4e0a \u8d77 \u4f86 \uff0c \u775c \u958b \u773c \u775b \uff0c \u7adf \u4e0d \u80fd \u770b \u898b \u751a \u9ebc \u3002 \u6709 \u4eba \u62c9 \u4ed6 \u7684 \u624b \uff0c \u9818 \u4ed6 \u9032 \u4e86 \u5927 \u99ac \u8272 \uff1b"}, {"pk": 585207, "verse": 9, "text": "\u4e09 \u65e5 \u4e0d \u80fd \u770b \u898b \uff0c \u4e5f \u4e0d \u5403 \u4e5f \u4e0d \u559d \u3002"}, {"pk": 585208, "verse": 10, "text": "\u7576 \u4e0b \uff0c \u5728 \u5927 \u99ac \u8272 \u6709 \u4e00 \u500b \u9580 \u5f92 \uff0c \u540d \u53eb \u4e9e \u62ff \u5c3c \u4e9e \u3002 \u4e3b \u5728 \u7570 \u8c61 \u4e2d \u5c0d \u4ed6 \u8aaa \uff1a \u4e9e \u62ff \u5c3c \u4e9e \u3002 \u4ed6 \u8aaa \uff1a \u4e3b \uff0c \u6211 \u5728 \u9019 \u88e1 \u3002"}, {"pk": 585209, "verse": 11, "text": "\u4e3b \u5c0d \u4ed6 \u8aaa \uff1a \u8d77 \u4f86 \uff01 \u5f80 \u76f4 \u8857 \u53bb \uff0c \u5728 \u7336 \u5927 \u7684 \u5bb6 \u88e1 \uff0c \u8a2a \u554f \u4e00 \u500b \u5927 \u6578 \u4eba \uff0c \u540d \u53eb \u6383 \u7f85 \u3002 \u4ed6 \u6b63 \u79b1 \u544a \uff0c"}, {"pk": 585210, "verse": 12, "text": "\u53c8 \u770b \u898b \u4e86 \u4e00 \u500b \u4eba \uff0c \u540d \u53eb \u4e9e \u62ff \u5c3c \u4e9e \uff0c \u9032 \u4f86 \u6309 \u624b \u5728 \u4ed6 \u8eab \u4e0a \uff0c \u53eb \u4ed6 \u80fd \u770b \u898b \u3002"}, {"pk": 585211, "verse": 13, "text": "\u4e9e \u62ff \u5c3c \u4e9e \u56de \u7b54 \u8aaa \uff1a \u4e3b \u963f \uff0c \u6211 \u807d \u898b \u8a31 \u591a \u4eba \u8aaa \uff1a \u9019 \u4eba \u600e \u6a23 \u5728 \u8036 \u8def \u6492 \u51b7 \u591a \u591a \u82e6 \u5bb3 \u4f60 \u7684 \u8056 \u5f92 \uff0c"}, {"pk": 585212, "verse": 14, "text": "\u4e26 \u4e14 \u4ed6 \u5728 \u9019 \u88e1 \u6709 \u5f9e \u796d \u53f8 \u9577 \u5f97 \u4f86 \u7684 \u6b0a \u67c4 \u6346 \u7d81 \u4e00 \u5207 \u6c42 \u544a \u4f60 \u540d \u7684 \u4eba \u3002"}, {"pk": 585213, "verse": 15, "text": "\u4e3b \u5c0d \u4e9e \u62ff \u5c3c \u4e9e \u8aaa \uff1a \u4f60 \u53ea \u7ba1 \u53bb \uff01 \u4ed6 \u662f \u6211 \u6240 \u63c0 \u9078 \u7684 \u5668 \u76bf \uff0c \u8981 \u5728 \u5916 \u90a6 \u4eba \u548c \u541b \u738b \uff0c \u4e26 \u4ee5 \u8272 \u5217 \u4eba \u9762 \u524d \u5ba3 \u63da \u6211 \u7684 \u540d \u3002"}, {"pk": 585214, "verse": 16, "text": "\u6211 \u4e5f \u8981 \u6307 \u793a \u4ed6 \uff0c \u70ba \u6211 \u7684 \u540d \u5fc5 \u9808 \u53d7 \u8a31 \u591a \u7684 \u82e6 \u96e3 \u3002"}, {"pk": 585215, "verse": 17, "text": "\u4e9e \u62ff \u5c3c \u4e9e \u5c31 \u53bb \u4e86 \uff0c \u9032 \u5165 \u90a3 \u5bb6 \uff0c \u628a \u624b \u6309 \u5728 \u6383 \u7f85 \u8eab \u4e0a \uff0c \u8aaa \uff1a \u5144 \u5f1f \u6383 \u7f85 \uff0c \u5728 \u4f60 \u4f86 \u7684 \u8def \u4e0a \u5411 \u4f60 \u986f \u73fe \u7684 \u4e3b \uff0c \u5c31 \u662f \u8036 \u7a4c \uff0c \u6253 \u767c \u6211 \u4f86 \uff0c \u53eb \u4f60 \u80fd \u770b \u898b \uff0c \u53c8 \u88ab \u8056 \u9748 \u5145 \u6eff \u3002"}, {"pk": 585216, "verse": 18, "text": "\u6383 \u7f85 \u7684 \u773c \u775b \u4e0a \uff0c \u597d \u50cf \u6709 \u9c57 \u7acb \u523b \u6389 \u4e0b \u4f86 \uff0c \u4ed6 \u5c31 \u80fd \u770b \u898b \u3002 \u65bc \u662f \u8d77 \u4f86 \u53d7 \u4e86 \u6d17 \uff1b"}, {"pk": 585217, "verse": 19, "text": "\u5403 \u904e \u98ef \u5c31 \u5065 \u58ef \u4e86 \u3002 \u6383 \u7f85 \u548c \u5927 \u99ac \u8272 \u7684 \u9580 \u5f92 \u540c \u4f4f \u4e86 \u4e9b \u65e5 \u5b50 \uff0c"}, {"pk": 585218, "verse": 20, "text": "\u5c31 \u5728 \u5404 \u6703 \u5802 \u88e1 \u5ba3 \u50b3 \u8036 \u7a4c \uff0c \u8aaa \u4ed6 \u662f \u795e \u7684 \u5152 \u5b50 \u3002"}, {"pk": 585219, "verse": 21, "text": "\u51e1 \u807d \u898b \u7684 \u4eba \u90fd \u9a5a \u5947 \uff0c \u8aaa \uff1a \u5728 \u8036 \u8def \u6492 \u51b7 \u6b98 \u5bb3 \u6c42 \u544a \u9019 \u540d \u7684 \uff0c \u4e0d \u662f \u9019 \u4eba \u9ebc \uff1f \u4e26 \u4e14 \u4ed6 \u5230 \u9019 \u88e1 \u4f86 \uff0c \u7279 \u8981 \u6346 \u7d81 \u4ed6 \u5011 \uff0c \u5e36 \u5230 \u796d \u53f8 \u9577 \u90a3 \u88e1 \u3002"}, {"pk": 585220, "verse": 22, "text": "\u4f46 \u6383 \u7f85 \u8d8a \u767c \u6709 \u80fd \u529b \uff0c \u99c1 \u5012 \u4f4f \u5927 \u99ac \u8272 \u7684 \u7336 \u592a \u4eba \uff0c \u8b49 \u660e \u8036 \u7a4c \u662f \u57fa \u7763 \u3002"}, {"pk": 585221, "verse": 23, "text": "\u904e \u4e86 \u597d \u4e9b \u65e5 \u5b50 \uff0c \u7336 \u592a \u4eba \u5546 \u8b70 \u8981 \u6bba \u6383 \u7f85 \uff0c"}, {"pk": 585222, "verse": 24, "text": "\u4f46 \u4ed6 \u5011 \u7684 \u8a08 \u8b00 \u88ab \u6383 \u7f85 \u77e5 \u9053 \u4e86 \u3002 \u4ed6 \u5011 \u53c8 \u665d \u591c \u5728 \u57ce \u9580 \u5b88 \u5019 \uff0c \u8981 \u6bba \u4ed6 \u3002"}, {"pk": 585223, "verse": 25, "text": "\u4ed6 \u7684 \u9580 \u5f92 \u5c31 \u5728 \u591c \u9593 \u7528 \u7b50 \u5b50 \u628a \u4ed6 \u5f9e \u57ce \u7246 \u4e0a \u7e0b \u4e0b \u53bb \u3002"}, {"pk": 585224, "verse": 26, "text": "\u6383 \u7f85 \u5230 \u4e86 \u8036 \u8def \u6492 \u51b7 \uff0c \u60f3 \u8207 \u9580 \u5f92 \u7d50 \u4ea4 \uff0c \u4ed6 \u5011 \u537b \u90fd \u6015 \u4ed6 \uff0c \u4e0d \u4fe1 \u4ed6 \u662f \u9580 \u5f92 \u3002"}, {"pk": 585225, "verse": 27, "text": "\u60df \u6709 \u5df4 \u62ff \u5df4 \u63a5 \u5f85 \u4ed6 \uff0c \u9818 \u53bb \u898b \u4f7f \u5f92 \uff0c \u628a \u4ed6 \u5728 \u8def \u4e0a \u600e \u9ebc \u770b \u898b \u4e3b \uff0c \u4e3b \u600e \u9ebc \u5411 \u4ed6 \u8aaa \u8a71 \uff0c \u4ed6 \u5728 \u5927 \u99ac \u8272 \u600e \u9ebc \u5949 \u8036 \u7a4c \u7684 \u540d \u653e \u81bd \u50b3 \u9053 \uff0c \u90fd \u8ff0 \u8aaa \u51fa \u4f86 \u3002"}, {"pk": 585226, "verse": 28, "text": "\u65bc \u662f \u6383 \u7f85 \u5728 \u8036 \u8def \u6492 \u51b7 \u548c \u9580 \u5f92 \u51fa \u5165 \u4f86 \u5f80 \uff0c"}, {"pk": 585227, "verse": 29, "text": "\u5949 \u4e3b \u7684 \u540d \u653e \u81bd \u50b3 \u9053 \uff0c \u4e26 \u8207 \u8aaa \u5e0c \u5229 \u5c3c \u8a71 \u7684 \u7336 \u592a \u4eba \u8b1b \u8ad6 \u8faf \u99c1 \uff1b \u4ed6 \u5011 \u537b \u60f3 \u6cd5 \u5b50 \u8981 \u6bba \u4ed6 \u3002"}, {"pk": 585228, "verse": 30, "text": "\u5f1f \u5144 \u5011 \u77e5 \u9053 \u4e86 \u5c31 \u9001 \u4ed6 \u4e0b \u8a72 \u6492 \u5229 \u4e9e \uff0c \u6253 \u767c \u4ed6 \u5f80 \u5927 \u6578 \u53bb \u3002"}, {"pk": 585229, "verse": 31, "text": "\u90a3 \u6642 \uff0c \u7336 \u592a \u52a0 \u5229 \u5229 \u3001 \u6492 \u746a \u5229 \u4e9e \u5404 \u8655 \u7684 \u6559 \u6703 \u90fd \u5f97 \u5e73 \u5b89 \uff0c \u88ab \u5efa \u7acb \uff1b \u51e1 \u4e8b \u656c \u754f \u4e3b \uff0c \u8499 \u8056 \u9748 \u7684 \u5b89 \u6170 \uff0c \u4eba \u6578 \u5c31 \u589e \u591a \u4e86 \u3002"}, {"pk": 585230, "verse": 32, "text": "\u5f7c \u5f97 \u5468 \u6d41 \u56db \u65b9 \u7684 \u6642 \u5019 \uff0c \u4e5f \u5230 \u4e86 \u5c45 \u4f4f \u5442 \u5927 \u7684 \u8056 \u5f92 \u90a3 \u88e1 \uff1b"}, {"pk": 585231, "verse": 33, "text": "\u9047 \u898b \u4e00 \u500b \u4eba \uff0c \u540d \u53eb \u4ee5 \u5c3c \u96c5 \uff0c \u5f97 \u4e86 \u7671 \u7613 \uff0c \u5728 \u8925 \u5b50 \u4e0a \u8eba \u81e5 \u516b \u5e74 \u3002"}, {"pk": 585232, "verse": 34, "text": "\u5f7c \u5f97 \u5c0d \u4ed6 \u8aaa \uff1a \u4ee5 \u5c3c \u96c5 \uff0c \u8036 \u7a4c \u57fa \u7763 \u91ab \u597d \u4f60 \u4e86 \uff1b \u8d77 \u4f86 \uff01 \u6536 \u62fe \u4f60 \u7684 \u8925 \u5b50 \u3002 \u4ed6 \u5c31 \u7acb \u523b \u8d77 \u4f86 \u4e86 \u3002"}, {"pk": 585233, "verse": 35, "text": "\u51e1 \u4f4f \u5442 \u5927 \u548c \u6c99 \u5d19 \u7684 \u4eba \u90fd \u770b \u898b \u4e86 \u4ed6 \uff0c \u5c31 \u6b78 \u670d \u4e3b \u3002"}, {"pk": 585234, "verse": 36, "text": "\u5728 \u7d04 \u5e15 \u6709 \u4e00 \u500b \u5973 \u5f92 \uff0c \u540d \u53eb \u5927 \u6bd4 \u5927 \uff0c \u7e59 \u5e0c \u5229 \u5c3c \u8a71 \u5c31 \u662f \u591a \u52a0 \uff08 \u5c31 \u662f \u7f9a \u7f8a \u7684 \u610f \u601d \uff09 \uff1b \u4ed6 \u5ee3 \u884c \u5584 \u4e8b \uff0c \u591a \u65bd \u8cd9 \u6fdf \u3002"}, {"pk": 585235, "verse": 37, "text": "\u7576 \u6642 \uff0c \u4ed6 \u60a3 \u75c5 \u800c \u6b7b \uff0c \u6709 \u4eba \u628a \u4ed6 \u6d17 \u4e86 \uff0c \u505c \u5728 \u6a13 \u4e0a \u3002"}, {"pk": 585236, "verse": 38, "text": "\u5442 \u5927 \u539f \u8207 \u7d04 \u5e15 \u76f8 \u8fd1 \uff1b \u9580 \u5f92 \u807d \u898b \u5f7c \u5f97 \u5728 \u90a3 \u88e1 \uff0c \u5c31 \u6253 \u767c \u5169 \u500b \u4eba \u53bb \u898b \u4ed6 \uff0c \u592e \u6c42 \u4ed6 \u8aaa \uff1a \u5feb \u5230 \u6211 \u5011 \u90a3 \u88e1 \u53bb \uff0c \u4e0d \u8981 \u803d \u5ef6 \u3002"}, {"pk": 585237, "verse": 39, "text": "\u5f7c \u5f97 \u5c31 \u8d77 \u8eab \u548c \u4ed6 \u5011 \u540c \u53bb \uff1b \u5230 \u4e86 \uff0c \u4fbf \u6709 \u4eba \u9818 \u4ed6 \u4e0a \u6a13 \u3002 \u773e \u5be1 \u5a66 \u90fd \u7ad9 \u5728 \u5f7c \u5f97 \u65c1 \u908a \u54ed \uff0c \u62ff \u591a \u52a0 \u8207 \u4ed6 \u5011 \u540c \u5728 \u6642 \u6240 \u505a \u7684 \u88e1 \u8863 \u5916 \u8863 \u7d66 \u4ed6 \u770b \u3002"}, {"pk": 585238, "verse": 40, "text": "\u5f7c \u5f97 \u53eb \u4ed6 \u5011 \u90fd \u51fa \u53bb \uff0c \u5c31 \u8dea \u4e0b \u79b1 \u544a \uff0c \u8f49 \u8eab \u5c0d \u8457 \u6b7b \u4eba \u8aaa \uff1a \u5927 \u6bd4 \u5927 \uff0c \u8d77 \u4f86 \uff01 \u4ed6 \u5c31 \u775c \u958b \u773c \u775b \uff0c \u898b \u4e86 \u5f7c \u5f97 \uff0c \u4fbf \u5750 \u8d77 \u4f86 \u3002"}, {"pk": 585239, "verse": 41, "text": "\u5f7c \u5f97 \u4f38 \u624b \u6276 \u4ed6 \u8d77 \u4f86 \uff0c \u53eb \u773e \u8056 \u5f92 \u548c \u5be1 \u5a66 \u9032 \u53bb \uff0c \u628a \u591a \u52a0 \u6d3b \u6d3b \u7684 \u4ea4 \u7d66 \u4ed6 \u5011 \u3002"}, {"pk": 585240, "verse": 42, "text": "\u9019 \u4e8b \u50b3 \u904d \u4e86 \u7d04 \u5e15 \uff0c \u5c31 \u6709 \u8a31 \u591a \u4eba \u4fe1 \u4e86 \u4e3b \u3002"}, {"pk": 585241, "verse": 43, "text": "\u6b64 \u5f8c \uff0c \u5f7c \u5f97 \u5728 \u7d04 \u5e15 \u4e00 \u500b \u785d \u76ae \u5320 \u897f \u9580 \u7684 \u5bb6 \u88e1 \u4f4f \u4e86 \u591a \u65e5 \u3002"}]