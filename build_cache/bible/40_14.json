[{"pk": 581581, "verse": 1, "text": "\u90a3 \u6642 \uff0c \u5206 \u5c01 \u7684 \u738b \u5e0c \u5f8b \u807d \u898b \u8036 \u7a4c \u7684 \u540d \u8072 \uff0c"}, {"pk": 581582, "verse": 2, "text": "\u5c31 \u5c0d \u81e3 \u50d5 \u8aaa \uff1a \u9019 \u662f \u65bd \u6d17 \u7684 \u7d04 \u7ff0 \u5f9e \u6b7b \u88e1 \u5fa9 \u6d3b \uff0c \u6240 \u4ee5 \u9019 \u4e9b \u7570 \u80fd \u5f9e \u4ed6 \u88e1 \u9762 \u767c \u51fa \u4f86 \u3002"}, {"pk": 581583, "verse": 3, "text": "\u8d77 \u5148 \uff0c \u5e0c \u5f8b \u70ba \u4ed6 \u5144 \u5f1f \u8153 \u529b \u7684 \u59bb \u5b50 \u5e0c \u7f85 \u5e95 \u7684 \u7de3 \u6545 \uff0c \u628a \u7d04 \u7ff0 \u62ff \u4f4f \uff0c \u9396 \u5728 \u76e3 \u88e1 \u3002"}, {"pk": 581584, "verse": 4, "text": "\u56e0 \u70ba \u7d04 \u7ff0 \u66fe \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u5a36 \u9019 \u5a66 \u4eba \u662f \u4e0d \u5408 \u7406 \u7684 \u3002"}, {"pk": 581585, "verse": 5, "text": "\u5e0c \u5f8b \u5c31 \u60f3 \u8981 \u6bba \u4ed6 \uff0c \u53ea \u662f \u6015 \u767e \u59d3 \uff0c \u56e0 \u70ba \u4ed6 \u5011 \u4ee5 \u7d04 \u7ff0 \u70ba \u5148 \u77e5 \u3002"}, {"pk": 581586, "verse": 6, "text": "\u5230 \u4e86 \u5e0c \u5f8b \u7684 \u751f \u65e5 \uff0c \u5e0c \u7f85 \u5e95 \u7684 \u5973 \u5152 \u5728 \u773e \u4eba \u9762 \u524d \u8df3 \u821e \uff0c \u4f7f \u5e0c \u5f8b \u6b61 \u559c \u3002"}, {"pk": 581587, "verse": 7, "text": "\u5e0c \u5f8b \u5c31 \u8d77 \u8a93 \uff0c \u61c9 \u8a31 \u96a8 \u4ed6 \u6240 \u6c42 \u7684 \u7d66 \u4ed6 \u3002"}, {"pk": 581588, "verse": 8, "text": "\u5973 \u5152 \u88ab \u6bcd \u89aa \u6240 \u4f7f \uff0c \u5c31 \u8aaa \uff1a \u8acb \u628a \u65bd \u6d17 \u7d04 \u7ff0 \u7684 \u982d \u653e \u5728 \u76e4 \u5b50 \u88e1 \uff0c \u62ff \u4f86 \u7d66 \u6211 \u3002"}, {"pk": 581589, "verse": 9, "text": "\u738b \u4fbf } \u6182 \u6101 \uff0c \u4f46 \u56e0 \u4ed6 \u6240 \u8d77 \u7684 \u8a93 \uff0c \u53c8 \u56e0 \u540c \u5e2d \u7684 \u4eba \uff0c \u5c31 \u5429 \u5490 \u7d66 \u4ed6 \uff1b"}, {"pk": 581590, "verse": 10, "text": "\u65bc \u662f \u6253 \u767c \u4eba \u53bb \uff0c \u5728 \u76e3 \u88e1 \u65ac \u4e86 \u7d04 \u7ff0 \uff0c"}, {"pk": 581591, "verse": 11, "text": "\u628a \u982d \u653e \u5728 \u76e4 \u5b50 \u88e1 \uff0c \u62ff \u4f86 \u7d66 \u4e86 \u5973 \u5b50 \uff1b \u5973 \u5b50 \u62ff \u53bb \u7d66 \u4ed6 \u6bcd \u89aa \u3002"}, {"pk": 581592, "verse": 12, "text": "\u7d04 \u7ff0 \u7684 \u9580 \u5f92 \u4f86 \uff0c \u628a \u5c4d \u9996 \u9818 \u53bb \u57cb \u846c \u4e86 \uff0c \u5c31 \u53bb \u544a \u8a34 \u8036 \u7a4c \u3002"}, {"pk": 581593, "verse": 13, "text": "\u8036 \u7a4c \u807d \u898b \u4e86 \uff0c \u5c31 \u4e0a \u8239 \u5f9e \u90a3 \u88e1 \u7368 \u81ea \u9000 \u5230 \u91ce \u5730 \u88e1 \u53bb \u3002 \u773e \u4eba \u807d \u898b \uff0c \u5c31 \u5f9e \u5404 \u57ce \u88e1 \u6b65 \u884c \u8ddf \u96a8 \u4ed6 \u3002"}, {"pk": 581594, "verse": 14, "text": "\u8036 \u7a4c \u51fa \u4f86 \uff0c \u898b \u6709 \u8a31 \u591a \u7684 \u4eba \uff0c \u5c31 \u6190 \u61ab \u4ed6 \u5011 \uff0c \u6cbb \u597d \u4e86 \u4ed6 \u5011 \u7684 \u75c5 \u4eba \u3002"}, {"pk": 581595, "verse": 15, "text": "\u5929 \u5c07 \u665a \u7684 \u6642 \u5019 \uff0c \u9580 \u5f92 \u9032 \u524d \u4f86 \uff0c \u8aaa \uff1a \u9019 \u662f \u91ce \u5730 \uff0c \u6642 \u5019 \u5df2 \u7d93 \u904e \u4e86 \uff0c \u8acb \u53eb \u773e \u4eba \u6563 \u958b \uff0c \u4ed6 \u5011 \u597d \u5f80 \u6751 \u5b50 \u88e1 \u53bb \uff0c \u81ea \u5df1 \u8cb7 \u5403 \u7684 \u3002"}, {"pk": 581596, "verse": 16, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4e0d \u7528 \u4ed6 \u5011 \u53bb \uff0c \u4f60 \u5011 \u7d66 \u4ed6 \u5011 \u5403 \u7f77 \uff01"}, {"pk": 581597, "verse": 17, "text": "\u9580 \u5f92 \u8aaa \uff1a \u6211 \u5011 \u9019 \u88e1 \u53ea \u6709 \u4e94 \u500b \u9905 \uff0c \u5169 \u689d \u9b5a \u3002"}, {"pk": 581598, "verse": 18, "text": "\u8036 \u7a4c \u8aaa \uff1a \u62ff \u904e \u4f86 \u7d66 \u6211 \u3002"}, {"pk": 581599, "verse": 19, "text": "\u65bc \u662f \u5429 \u5490 \u773e \u4eba \u5750 \u5728 \u8349 \u5730 \u4e0a \uff0c \u5c31 \u62ff \u8457 \u9019 \u4e94 \u500b \u9905 \uff0c \u5169 \u689d \u9b5a \uff0c \u671b \u8457 \u5929 \u795d \u798f \uff0c \u64d8 \u958b \u9905 \uff0c \u905e \u7d66 \u9580 \u5f92 \uff0c \u9580 \u5f92 \u53c8 \u905e \u7d66 \u773e \u4eba \u3002"}, {"pk": 581600, "verse": 20, "text": "\u4ed6 \u5011 \u90fd \u5403 \uff0c \u4e26 \u4e14 \u5403 \u98fd \u4e86 \uff1b \u628a \u5269 \u4e0b \u7684 \u96f6 \u788e \u6536 \u62fe \u8d77 \u4f86 \uff0c \u88dd \u6eff \u4e86 \u5341 \u4e8c \u500b \u7c43 \u5b50 \u3002"}, {"pk": 581601, "verse": 21, "text": "\u5403 \u7684 \u4eba \uff0c \u9664 \u4e86 \u5a66 \u5973 \u5b69 \u5b50 \uff0c \u7d04 \u6709 \u4e94 \u5343 \u3002"}, {"pk": 581602, "verse": 22, "text": "\u8036 \u7a4c \u96a8 \u5373 \u50ac \u9580 \u5f92 \u4e0a \u8239 \uff0c \u5148 \u6e21 \u5230 \u90a3 \u908a \u53bb \uff0c \u7b49 \u4ed6 \u53eb \u773e \u4eba \u6563 \u958b \u3002"}, {"pk": 581603, "verse": 23, "text": "\u6563 \u4e86 \u773e \u4eba \u4ee5 \u5f8c \uff0c \u4ed6 \u5c31 \u7368 \u81ea \u4e0a \u5c71 \u53bb \u79b1 \u544a \u3002 \u5230 \u4e86 \u665a \u4e0a \uff0c \u53ea \u6709 \u4ed6 \u4e00 \u4eba \u5728 \u90a3 \u88e1 \u3002"}, {"pk": 581604, "verse": 24, "text": "\u90a3 \u6642 \u8239 \u5728 \u6d77 \u4e2d \uff0c \u56e0 \u98a8 \u4e0d \u9806 \uff0c \u88ab \u6d6a \u6416 \u64bc \u3002"}, {"pk": 581605, "verse": 25, "text": "\u591c \u88e1 \u56db \u66f4 \u5929 \uff0c \u8036 \u7a4c \u5728 \u6d77 \u9762 \u4e0a \u8d70 \uff0c \u5f80 \u9580 \u5f92 \u90a3 \u88e1 \u53bb \u3002"}, {"pk": 581606, "verse": 26, "text": "\u9580 \u5f92 \u770b \u898b \u4ed6 \u5728 \u6d77 \u9762 \u4e0a \u8d70 \uff0c \u5c31 \u9a5a \u614c \u4e86 \uff0c \u8aaa \uff1a \u662f \u500b \u9b3c \u602a \uff01 \u4fbf \u5bb3 \u6015 \uff0c \u558a \u53eb \u8d77 \u4f86 \u3002"}, {"pk": 581607, "verse": 27, "text": "\u8036 \u7a4c \u9023 \u5fd9 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u653e \u5fc3 \uff01 \u662f \u6211 \uff0c \u4e0d \u8981 \u6015 \uff01"}, {"pk": 581608, "verse": 28, "text": "\u5f7c \u5f97 \u8aaa \uff1a \u4e3b \uff0c \u5982 \u679c \u662f \u4f60 \uff0c \u8acb \u53eb \u6211 \u5f9e \u6c34 \u9762 \u4e0a \u8d70 \u5230 \u4f60 \u90a3 \u88e1 \u53bb \u3002"}, {"pk": 581609, "verse": 29, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4f60 \u4f86 \u7f77 \u3002 \u5f7c \u5f97 \u5c31 \u5f9e \u8239 \u4e0a \u4e0b \u53bb \uff0c \u5728 \u6c34 \u9762 \u4e0a \u8d70 \uff0c \u8981 \u5230 \u8036 \u7a4c \u90a3 \u88e1 \u53bb \uff1b"}, {"pk": 581610, "verse": 30, "text": "\u53ea \u56e0 \u898b \u98a8 \u751a \u5927 \uff0c \u5c31 \u5bb3 \u6015 \uff0c \u5c07 \u8981 \u6c89 \u4e0b \u53bb \uff0c \u4fbf \u558a \u8457 \u8aaa \uff1a \u4e3b \u963f \uff0c \u6551 \u6211 \uff01"}, {"pk": 581611, "verse": 31, "text": "\u8036 \u7a4c \u8d95 \u7dca \u4f38 \u624b \u62c9 \u4f4f \u4ed6 \uff0c \u8aaa \uff1a \u4f60 \u9019 \u5c0f \u4fe1 \u7684 \u4eba \u54ea \uff0c \u70ba \u751a \u9ebc \u7591 \u60d1 \u5462 \uff1f"}, {"pk": 581612, "verse": 32, "text": "\u4ed6 \u5011 \u4e0a \u4e86 \u8239 \uff0c \u98a8 \u5c31 \u4f4f \u4e86 \u3002"}, {"pk": 581613, "verse": 33, "text": "\u5728 \u8239 \u4e0a \u7684 \u4eba \u90fd \u62dc \u4ed6 \uff0c \u8aaa \uff1a \u4f60 \u771f \u662f \u795e \u7684 \u5152 \u5b50 \u4e86 \u3002"}, {"pk": 581614, "verse": 34, "text": "\u4ed6 \u5011 \u904e \u4e86 \u6d77 \uff0c \u4f86 \u5230 \u9769 \u5c3c \u6492 \u52d2 \u5730 \u65b9 \u3002"}, {"pk": 581615, "verse": 35, "text": "\u90a3 \u88e1 \u7684 \u4eba \u4e00 \u8a8d \u51fa \u662f \u8036 \u7a4c \uff0c \u5c31 \u6253 \u767c \u4eba \u5230 \u5468 \u570d \u5730 \u65b9 \u53bb \uff0c \u628a \u6240 \u6709 \u7684 \u75c5 \u4eba \u5e36 \u5230 \u4ed6 \u90a3 \u88e1 \uff0c"}, {"pk": 581616, "verse": 36, "text": "\u53ea \u6c42 \u8036 \u7a4c \u51c6 \u4ed6 \u5011 \u6478 \u4ed6 \u7684 \u8863 \u88f3 \u7e78 \u5b50 \uff1b \u6478 \u8457 \u7684 \u4eba \u5c31 \u90fd \u597d \u4e86 \u3002"}]