[{"pk": 582199, "verse": 1, "text": "\u795e \u7684 \u5152 \u5b50 \uff0c \u8036 \u7a4c \u57fa \u7763 \u798f \u97f3 \u7684 \u8d77 \u982d \u3002"}, {"pk": 582200, "verse": 2, "text": "\u6b63 \u5982 \u5148 \u77e5 \u4ee5 \u8cfd \u4e9e \uff08 \u6709 \u53e4 \u5377 \u7121 \u4ee5 \u8cfd \u4e9e \u4e09 \u500b \u5b57 \uff09 \u66f8 \u4e0a \u8a18 \u8457 \u8aaa \uff1a \u770b \u54ea \uff0c \u6211 \u8981 \u5dee \u9063 \u6211 \u7684 \u4f7f \u8005 \u5728 \u4f60 \u524d \u9762 \uff0c \u9810 \u5099 \u9053 \u8def \u3002"}, {"pk": 582201, "verse": 3, "text": "\u5728 \u66e0 \u91ce \u6709 \u4eba \u8072 \u558a \u8457 \u8aaa \uff1a \u9810 \u5099 \u4e3b \u7684 \u9053 \uff0c \u4fee \u76f4 \u4ed6 \u7684 \u8def \u3002"}, {"pk": 582202, "verse": 4, "text": "\u7167 \u9019 \u8a71 \uff0c \u7d04 \u7ff0 \u4f86 \u4e86 \uff0c \u5728 \u66e0 \u91ce \u65bd \u6d17 \uff0c \u50b3 \u6094 \u6539 \u7684 \u6d17 \u79ae \uff0c \u4f7f \u7f6a \u5f97 \u8d66 \u3002"}, {"pk": 582203, "verse": 5, "text": "\u7336 \u592a \u5168 \u5730 \u548c \u8036 \u8def \u6492 \u51b7 \u7684 \u4eba \u90fd \u51fa \u53bb \u5230 \u7d04 \u7ff0 \u90a3 \u88e1 \uff0c \u627f \u8a8d \u4ed6 \u5011 \u7684 \u7f6a \uff0c \u5728 \u7d04 \u4f46 \u6cb3 \u88e1 \u53d7 \u4ed6 \u7684 \u6d17 \u3002"}, {"pk": 582204, "verse": 6, "text": "\u7d04 \u7ff0 \u7a7f \u99f1 \u99dd \u6bdb \u7684 \u8863 \u670d \uff0c \u8170 \u675f \u76ae \u5e36 \uff0c \u5403 \u7684 \u662f \u8757 \u87f2 \u3001 \u91ce \u871c \u3002"}, {"pk": 582205, "verse": 7, "text": "\u4ed6 \u50b3 \u9053 \u8aaa \uff1a \u6709 \u4e00 \u4f4d \u5728 \u6211 \u4ee5 \u5f8c \u4f86 \u7684 \uff0c \u80fd \u529b \u6bd4 \u6211 \u66f4 \u5927 \uff0c \u6211 \u5c31 \u662f \u5f4e \u8170 \u7d66 \u4ed6 \u89e3 \u978b \u5e36 \u4e5f \u662f \u4e0d \u914d \u7684 \u3002"}, {"pk": 582206, "verse": 8, "text": "\u6211 \u662f \u7528 \u6c34 \u7d66 \u4f60 \u5011 \u65bd \u6d17 \uff0c \u4ed6 \u537b \u8981 \u7528 \u8056 \u9748 \u7d66 \u4f60 \u5011 \u65bd \u6d17 \u3002"}, {"pk": 582207, "verse": 9, "text": "\u90a3 \u6642 \uff0c \u8036 \u7a4c \u5f9e \u52a0 \u5229 \u5229 \u7684 \u62ff \u6492 \u52d2 \u4f86 \uff0c \u5728 \u7d04 \u4f46 \u6cb3 \u88e1 \u53d7 \u4e86 \u7d04 \u7ff0 \u7684 \u6d17 \u3002"}, {"pk": 582208, "verse": 10, "text": "\u4ed6 \u5f9e \u6c34 \u88e1 \u4e00 \u4e0a \u4f86 \uff0c \u5c31 \u770b \u898b \u5929 \u88c2 \u958b \u4e86 \uff0c \u8056 \u9748 \u5f77 \u5f7f \u9d3f \u5b50 \uff0c \u964d \u5728 \u4ed6 \u8eab \u4e0a \u3002"}, {"pk": 582209, "verse": 11, "text": "\u53c8 \u6709 \u8072 \u97f3 \u5f9e \u5929 \u4e0a \u4f86 \uff0c \u8aaa \uff1a \u4f60 \u662f \u6211 \u7684 \u611b \u5b50 \uff0c \u6211 \u559c \u6085 \u4f60 \u3002"}, {"pk": 582210, "verse": 12, "text": "\u8056 \u9748 \u5c31 \u628a \u8036 \u7a4c \u50ac \u5230 \u66e0 \u91ce \u88e1 \u53bb \u3002"}, {"pk": 582211, "verse": 13, "text": "\u4ed6 \u5728 \u66e0 \u91ce \u56db \u5341 \u5929 \uff0c \u53d7 \u6492 \u4f46 \u7684 \u8a66 \u63a2 \uff0c \u4e26 \u8207 \u91ce \u7378 \u540c \u5728 \u4e00 \u8655 \uff0c \u4e14 \u6709 \u5929 \u4f7f \u4f86 \u4f3a \u5019 \u4ed6 \u3002"}, {"pk": 582212, "verse": 14, "text": "\u7d04 \u7ff0 \u4e0b \u76e3 \u4ee5 \u5f8c \uff0c \u8036 \u7a4c \u4f86 \u5230 \u52a0 \u5229 \u5229 \uff0c \u5ba3 \u50b3 \u795e \u7684 \u798f \u97f3 \uff0c"}, {"pk": 582213, "verse": 15, "text": "\u8aaa \uff1a \u65e5 \u671f \u6eff \u4e86 \uff0c \u795e \u7684 \u570b \u8fd1 \u4e86 \u3002 \u4f60 \u5011 \u7576 \u6094 \u6539 \uff0c \u4fe1 \u798f \u97f3 \uff01"}, {"pk": 582214, "verse": 16, "text": "\u8036 \u7a4c \u9806 \u8457 \u52a0 \u5229 \u5229 \u7684 \u6d77 \u908a \u8d70 \uff0c \u770b \u898b \u897f \u9580 \u548c \u897f \u9580 \u7684 \u5144 \u5f1f \u5b89 \u5f97 \u70c8 \u5728 \u6d77 \u88e1 \u6492 \u7db2 \uff1b \u4ed6 \u5011 \u672c \u662f \u6253 \u9b5a \u7684 \u3002"}, {"pk": 582215, "verse": 17, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f86 \u8ddf \u5f9e \u6211 \uff0c \u6211 \u8981 \u53eb \u4f60 \u5011 \u5f97 \u4eba \u5982 \u5f97 \u9b5a \u4e00 \u6a23 \u3002"}, {"pk": 582216, "verse": 18, "text": "\u4ed6 \u5011 \u5c31 \u7acb \u523b \u6368 \u4e86 \u7db2 \uff0c \u8ddf \u5f9e \u4e86 \u4ed6 \u3002"}, {"pk": 582217, "verse": 19, "text": "\u8036 \u7a4c \u7a0d \u5f80 \u524d \u8d70 \uff0c \u53c8 \u898b \u897f \u5e87 \u592a \u7684 \u5152 \u5b50 \u96c5 \u5404 \u548c \u96c5 \u5404 \u7684 \u5144 \u5f1f \u7d04 \u7ff0 \u5728 \u8239 \u4e0a \u88dc \u7db2 \u3002"}, {"pk": 582218, "verse": 20, "text": "\u8036 \u7a4c \u96a8 \u5373 \u62db \u547c \u4ed6 \u5011 \uff0c \u4ed6 \u5011 \u5c31 \u628a \u7236 \u89aa \u897f \u5e87 \u592a \u548c \u96c7 \u5de5 \u4eba \u7559 \u5728 \u8239 \u4e0a \uff0c \u8ddf \u5f9e \u8036 \u7a4c \u53bb \u4e86 \u3002"}, {"pk": 582219, "verse": 21, "text": "\u5230 \u4e86 \u8fe6 \u767e \u8fb2 \uff0c \u8036 \u7a4c \u5c31 \u5728 \u5b89 \u606f \u65e5 \u9032 \u4e86 \u6703 \u5802 \u6559 \u8a13 \u4eba \u3002"}, {"pk": 582220, "verse": 22, "text": "\u773e \u4eba \u5f88 \u5e0c \u5947 \u4ed6 \u7684 \u6559 \u8a13 \uff1b \u56e0 \u70ba \u4ed6 \u6559 \u8a13 \u4ed6 \u5011 \uff0c \u6b63 \u50cf \u6709 \u6b0a \u67c4 \u7684 \u4eba \uff0c \u4e0d \u50cf \u6587 \u58eb \u3002"}, {"pk": 582221, "verse": 23, "text": "\u5728 \u6703 \u5802 \u88e1 \uff0c \u6709 \u4e00 \u500b \u4eba \u88ab \u6c61 \u9b3c \u9644 \u8457 \u3002 \u4ed6 \u558a \u53eb \u8aaa \uff1a"}, {"pk": 582222, "verse": 24, "text": "\u62ff \u6492 \u52d2 \u4eba \u8036 \u7a4c \uff0c \u6211 \u5011 \u8207 \u4f60 \u6709 \u751a \u9ebc \u76f8 \u5e72 \uff1f \u4f60 \u4f86 \u6ec5 \u6211 \u5011 \u9ebc \uff1f \u6211 \u77e5 \u9053 \u4f60 \u662f \u8ab0 \uff0c \u4e43 \u662f \u795e \u7684 \u8056 \u8005 \u3002"}, {"pk": 582223, "verse": 25, "text": "\u8036 \u7a4c \u8cac \u5099 \u4ed6 \u8aaa \uff1a \u4e0d \u8981 \u4f5c \u8072 \uff01 \u5f9e \u9019 \u4eba \u8eab \u4e0a \u51fa \u4f86 \u7f77 \u3002"}, {"pk": 582224, "verse": 26, "text": "\u6c61 \u9b3c \u53eb \u90a3 \u4eba \u62bd \u4e86 \u4e00 \u9663 \u760b \uff0c \u5927 \u8072 \u558a \u53eb \uff0c \u5c31 \u51fa \u4f86 \u4e86 \u3002"}, {"pk": 582225, "verse": 27, "text": "\u773e \u4eba \u90fd \u9a5a \u8a1d \uff0c \u4ee5 \u81f4 \u5f7c \u6b64 \u5c0d \u554f \u8aaa \uff1a \u9019 \u662f \u751a \u9ebc \u4e8b \uff1f \u662f \u500b \u65b0 \u9053 \u7406 \u963f \uff01 \u4ed6 \u7528 \u6b0a \u67c4 \u5429 \u5490 \u6c61 \u9b3c \uff0c \u9023 \u6c61 \u9b3c \u4e5f \u807d \u5f9e \u4e86 \u4ed6 \u3002"}, {"pk": 582226, "verse": 28, "text": "\u8036 \u7a4c \u7684 \u540d \u8072 \u5c31 \u50b3 \u904d \u4e86 \u52a0 \u5229 \u5229 \u7684 \u56db \u65b9 \u3002"}, {"pk": 582227, "verse": 29, "text": "\u4ed6 \u5011 \u4e00 \u51fa \u6703 \u5802 \uff0c \u5c31 \u540c \u8457 \u96c5 \u5404 \u3001 \u7d04 \u7ff0 \uff0c \u9032 \u4e86 \u897f \u9580 \u548c \u5b89 \u5f97 \u70c8 \u7684 \u5bb6 \u3002"}, {"pk": 582228, "verse": 30, "text": "\u897f \u9580 \u7684 \u5cb3 \u6bcd \u6b63 \u5bb3 \u71b1 \u75c5 \u8eba \u8457 \uff0c \u5c31 \u6709 \u4eba \u544a \u8a34 \u8036 \u7a4c \u3002"}, {"pk": 582229, "verse": 31, "text": "\u8036 \u7a4c \u9032 \u524d \u62c9 \u8457 \u4ed6 \u7684 \u624b \uff0c \u6276 \u4ed6 \u8d77 \u4f86 \uff0c \u71b1 \u5c31 \u9000 \u4e86 \uff0c \u4ed6 \u5c31 \u670d \u4e8b \u4ed6 \u5011 \u3002"}, {"pk": 582230, "verse": 32, "text": "\u5929 \u665a \u65e5 \u843d \u7684 \u6642 \u5019 \uff0c \u6709 \u4eba \u5e36 \u8457 \u4e00 \u5207 \u5bb3 \u75c5 \u7684 \uff0c \u548c \u88ab \u9b3c \u9644 \u7684 \uff0c \u4f86 \u5230 \u8036 \u7a4c \u8ddf \u524d \u3002"}, {"pk": 582231, "verse": 33, "text": "\u5408 \u57ce \u7684 \u4eba \u90fd \u805a \u96c6 \u5728 \u9580 \u524d \u3002"}, {"pk": 582232, "verse": 34, "text": "\u8036 \u7a4c \u6cbb \u597d \u4e86 \u8a31 \u591a \u5bb3 \u5404 \u6a23 \u75c5 \u7684 \u4eba \uff0c \u53c8 \u8d95 \u51fa \u8a31 \u591a \u9b3c \uff0c \u4e0d \u8a31 \u9b3c \u8aaa \u8a71 \uff0c \u56e0 \u70ba \u9b3c \u8a8d \u8b58 \u4ed6 \u3002"}, {"pk": 582233, "verse": 35, "text": "\u6b21 \u65e5 \u65e9 \u6668 \uff0c \u5929 \u672a \u4eae \u7684 \u6642 \u5019 \uff0c \u8036 \u7a4c \u8d77 \u4f86 \uff0c \u5230 \u66e0 \u91ce \u5730 \u65b9 \u53bb \uff0c \u5728 \u90a3 \u88e1 \u79b1 \u544a \u3002"}, {"pk": 582234, "verse": 36, "text": "\u897f \u9580 \u548c \u540c \u4f34 \u8ffd \u4e86 \u4ed6 \u53bb \uff0c"}, {"pk": 582235, "verse": 37, "text": "\u9047 \u898b \u4e86 \u5c31 \u5c0d \u4ed6 \u8aaa \uff1a \u773e \u4eba \u90fd \u627e \u4f60 \u3002"}, {"pk": 582236, "verse": 38, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u6211 \u5011 \u53ef \u4ee5 \u5f80 \u5225 \u8655 \u53bb \uff0c \u5230 \u9130 \u8fd1 \u7684 \u9109 \u6751 \uff0c \u6211 \u4e5f \u597d \u5728 \u90a3 \u88e1 \u50b3 \u9053 \uff0c \u56e0 \u70ba \u6211 \u662f \u70ba \u9019 \u4e8b \u51fa \u4f86 \u7684 \u3002"}, {"pk": 582237, "verse": 39, "text": "\u65bc \u662f \u5728 \u52a0 \u5229 \u5229 \u5168 \u5730 \uff0c \u9032 \u4e86 \u6703 \u5802 \uff0c \u50b3 \u9053 \uff0c \u8d95 \u9b3c \u3002"}, {"pk": 582238, "verse": 40, "text": "\u6709 \u4e00 \u500b \u9577 \u5927 \u75f2 \u760b \u7684 \u4f86 \u6c42 \u8036 \u7a4c \uff0c \u5411 \u4ed6 \u8dea \u4e0b \uff0c \u8aaa \uff1a \u4f60 \u82e5 \u80af \uff0c \u5fc5 \u80fd \u53eb \u6211 \u6f54 \u6de8 \u4e86 \u3002"}, {"pk": 582239, "verse": 41, "text": "\u8036 \u7a4c \u52d5 \u4e86 \u6148 \u5fc3 \uff0c \u5c31 \u4f38 \u624b \u6478 \u4ed6 \uff0c \u8aaa \uff1a \u6211 \u80af \uff0c \u4f60 \u6f54 \u6de8 \u4e86 \u7f77 \uff01"}, {"pk": 582240, "verse": 42, "text": "\u5927 \u75f2 \u760b \u5373 \u6642 \u96e2 \u958b \u4ed6 \uff0c \u4ed6 \u5c31 \u6f54 \u6de8 \u4e86 \u3002"}, {"pk": 582241, "verse": 43, "text": "\u8036 \u7a4c \u56b4 \u56b4 \u7684 \u56d1 \u5490 \u4ed6 \uff0c \u5c31 \u6253 \u767c \u4ed6 \u8d70 \uff0c"}, {"pk": 582242, "verse": 44, "text": "\u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u8981 \u8b39 \u614e \uff0c \u751a \u9ebc \u8a71 \u90fd \u4e0d \u53ef \u544a \u8a34 \u4eba \uff0c \u53ea \u8981 \u53bb \u628a \u8eab \u9ad4 \u7d66 \u796d \u53f8 \u5bdf \u770b \uff0c \u53c8 \u56e0 \u70ba \u4f60 \u6f54 \u6de8 \u4e86 \uff0c \u737b \u4e0a \u6469 \u897f \u6240 \u5429 \u5490 \u7684 \u79ae \u7269 \uff0c \u5c0d \u773e \u4eba \u4f5c \u8b49 \u64da \u3002"}, {"pk": 582243, "verse": 45, "text": "\u90a3 \u4eba \u51fa \u53bb \uff0c \u5012 \u8aaa \u8a31 \u591a \u7684 \u8a71 \uff0c \u628a \u9019 \u4ef6 \u4e8b \u50b3 \u63da \u958b \u4e86 \uff0c \u53eb \u8036 \u7a4c \u4ee5 \u5f8c \u4e0d \u5f97 \u518d \u660e \u660e \u7684 \u9032 \u57ce \uff0c \u53ea \u597d \u5728 \u5916 \u908a \u66e0 \u91ce \u5730 \u65b9 \u3002 \u4eba \u5f9e \u5404 \u8655 \u90fd \u5c31 \u4e86 \u4ed6 \u4f86 \u3002"}]