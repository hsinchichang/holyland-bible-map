[{"pk": 562988, "verse": 1, "text": "\u4ee5 \u8272 \u5217 \u4eba \u54ea \uff0c \u73fe \u5728 \u6211 \u6240 \u6559 \u8a13 \u4f60 \u5011 \u7684 \u5f8b \u4f8b \u5178 \u7ae0 \uff0c \u4f60 \u5011 \u8981 \u807d \u5f9e \u9075 \u884c \uff0c \u597d \u53eb \u4f60 \u5011 \u5b58 \u6d3b \uff0c \u5f97 \u4ee5 \u9032 \u5165 \u8036 \u548c \u83ef \u2500 \u4f60 \u5011 \u5217 \u7956 \u4e4b \u3000 \u795e \u6240 \u8cdc \u7d66 \u4f60 \u5011 \u7684 \u5730 \uff0c \u627f \u53d7 \u70ba \u696d \u3002"}, {"pk": 562989, "verse": 2, "text": "\u6240 \u5429 \u5490 \u4f60 \u5011 \u7684 \u8a71 \uff0c \u4f60 \u5011 \u4e0d \u53ef \u52a0 \u6dfb \uff0c \u4e5f \u4e0d \u53ef \u522a \u6e1b \uff0c \u597d \u53eb \u4f60 \u5011 \u9075 \u5b88 \u6211 \u6240 \u5429 \u5490 \u7684 \uff0c \u5c31 \u662f \u8036 \u548c \u83ef \u2500 \u4f60 \u5011 \u3000 \u795e \u7684 \u547d \u4ee4 \u3002"}, {"pk": 562990, "verse": 3, "text": "\u8036 \u548c \u83ef \u56e0 \u5df4 \u529b \u6bd8 \u73e5 \u7684 \u4e8b \u6240 \u884c \u7684 \uff0c \u4f60 \u5011 \u89aa \u773c \u770b \u898b \u4e86 \u3002 \u51e1 \u96a8 \u5f9e \u5df4 \u529b \u6bd8 \u73e5 \u7684 \u4eba \uff0c \u8036 \u548c \u83ef \u2500 \u4f60 \u5011 \u7684 \u3000 \u795e \u90fd \u5f9e \u4f60 \u5011 \u4e2d \u9593 \u9664 \u6ec5 \u4e86 \u3002"}, {"pk": 562991, "verse": 4, "text": "\u60df \u6709 \u4f60 \u5011 \u5c08 \u9760 \u8036 \u548c \u83ef \u2500 \u4f60 \u5011 \u3000 \u795e \u7684 \u4eba \uff0c \u4eca \u65e5 \u5168 \u90fd \u5b58 \u6d3b \u3002"}, {"pk": 562992, "verse": 5, "text": "\u6211 \u7167 \u8457 \u8036 \u548c \u83ef \u2500 \u6211 \u3000 \u795e \u6240 \u5429 \u5490 \u7684 \u5c07 \u5f8b \u4f8b \u5178 \u7ae0 \u6559 \u8a13 \u4f60 \u5011 \uff0c \u4f7f \u4f60 \u5011 \u5728 \u6240 \u8981 \u9032 \u53bb \u5f97 \u70ba \u696d \u7684 \u5730 \u4e0a \u9075 \u884c \u3002"}, {"pk": 562993, "verse": 6, "text": "\u6240 \u4ee5 \u4f60 \u5011 \u8981 \u8b39 \u5b88 \u9075 \u884c \uff1b \u9019 \u5c31 \u662f \u4f60 \u5011 \u5728 \u842c \u6c11 \u773c \u524d \u7684 \u667a \u6167 \u3001 \u8070 \u660e \u3002 \u4ed6 \u5011 \u807d \u898b \u9019 \u4e00 \u5207 \u5f8b \u4f8b \uff0c \u5fc5 \u8aaa \uff1a \u9019 \u5927 \u570b \u7684 \u4eba \u771f \u662f \u6709 \u667a \u6167 \uff0c \u6709 \u8070 \u660e \uff01"}, {"pk": 562994, "verse": 7, "text": "\u90a3 \u4e00 \u5927 \u570b \u7684 \u4eba \u6709 \u3000 \u795e \u8207 \u4ed6 \u5011 \u76f8 \u8fd1 \uff0c \u50cf \u8036 \u548c \u83ef \u2500 \u6211 \u5011 \u7684 \u3000 \u795e \u3001 \u5728 \u6211 \u5011 \u6c42 \u544a \u4ed6 \u7684 \u6642 \u5019 \u8207 \u6211 \u5011 \u76f8 \u8fd1 \u5462 \uff1f"}, {"pk": 562995, "verse": 8, "text": "\u53c8 \u90a3 \u4e00 \u5927 \u570b \u6709 \u9019 \u6a23 \u516c \u7fa9 \u7684 \u5f8b \u4f8b \u5178 \u7ae0 \u3001 \u50cf \u6211 \u4eca \u65e5 \u5728 \u4f60 \u5011 \u9762 \u524d \u6240 \u9673 \u660e \u7684 \u9019 \u4e00 \u5207 \u5f8b \u6cd5 \u5462 \uff1f"}, {"pk": 562996, "verse": 9, "text": "\u4f60 \u53ea \u8981 \u8b39 \u614e \uff0c \u6bb7 \u52e4 \u4fdd \u5b88 \u4f60 \u7684 \u5fc3 \u9748 \uff0c \u514d \u5f97 \u5fd8 \u8a18 \u4f60 \u89aa \u773c \u6240 \u770b \u898b \u7684 \u4e8b \uff0c \u53c8 \u514d \u5f97 \u4f60 \u4e00 \u751f \u9019 \u4e8b \u96e2 \u958b \u4f60 \u7684 \u5fc3 \uff1b \u7e3d \u8981 \u50b3 \u7d66 \u4f60 \u7684 \u5b50 \u5b50 \u5b6b \u5b6b \u3002"}, {"pk": 562997, "verse": 10, "text": "\u4f60 \u5728 \u4f55 \u70c8 \u5c71 \u7ad9 \u5728 \u8036 \u548c \u83ef \u2500 \u4f60 \u3000 \u795e \u9762 \u524d \u7684 \u90a3 \u65e5 \uff0c \u8036 \u548c \u83ef \u5c0d \u6211 \u8aaa \uff1a \u4f60 \u70ba \u6211 \u62db \u805a \u767e \u59d3 \uff0c \u6211 \u8981 \u53eb \u4ed6 \u5011 \u807d \u898b \u6211 \u7684 \u8a71 \uff0c \u4f7f \u4ed6 \u5011 \u5b58 \u6d3b \u5728 \u4e16 \u7684 \u65e5 \u5b50 \uff0c \u53ef \u4ee5 \u5b78 \u7fd2 \u656c \u754f \u6211 \uff0c \u53c8 \u53ef \u4ee5 \u6559 \u8a13 \u5152 \u5973 \u9019 \u6a23 \u884c \u3002"}, {"pk": 562998, "verse": 11, "text": "\u90a3 \u6642 \u4f60 \u5011 \u8fd1 \u524d \u4f86 \uff0c \u7ad9 \u5728 \u5c71 \u4e0b \uff1b \u5c71 \u4e0a \u6709 \u706b \u7130 \u6c96 \u5929 \uff0c \u4e26 \u6709 \u660f \u9ed1 \u3001 \u5bc6 \u96f2 \u3001 \u5e7d \u6697 \u3002"}, {"pk": 562999, "verse": 12, "text": "\u8036 \u548c \u83ef \u5f9e \u706b \u7130 \u4e2d \u5c0d \u4f60 \u5011 \u8aaa \u8a71 \uff0c \u4f60 \u5011 \u53ea \u807d \u898b \u8072 \u97f3 \uff0c \u537b \u6c92 \u6709 \u770b \u898b \u5f62 \u50cf \u3002"}, {"pk": 563000, "verse": 13, "text": "\u4ed6 \u5c07 \u6240 \u5429 \u5490 \u4f60 \u5011 \u7576 \u5b88 \u7684 \u7d04 \u6307 \u793a \u4f60 \u5011 \uff0c \u5c31 \u662f \u5341 \u689d \u8aa1 \uff0c \u4e26 \u5c07 \u9019 \u8aa1 \u5beb \u5728 \u5169 \u584a \u77f3 \u7248 \u4e0a \u3002"}, {"pk": 563001, "verse": 14, "text": "\u90a3 \u6642 \u8036 \u548c \u83ef \u53c8 \u5429 \u5490 \u6211 \u5c07 \u5f8b \u4f8b \u5178 \u7ae0 \u6559 \u8a13 \u4f60 \u5011 \uff0c \u4f7f \u4f60 \u5011 \u5728 \u6240 \u8981 \u904e \u53bb \u5f97 \u70ba \u696d \u7684 \u5730 \u4e0a \u9075 \u884c \u3002"}, {"pk": 563002, "verse": 15, "text": "\u6240 \u4ee5 \uff0c \u4f60 \u5011 \u8981 \u5206 \u5916 \u8b39 \u614e \uff1b \u56e0 \u70ba \u8036 \u548c \u83ef \u5728 \u4f55 \u70c8 \u5c71 \u3001 \u5f9e \u706b \u4e2d \u5c0d \u4f60 \u5011 \u8aaa \u8a71 \u7684 \u90a3 \u65e5 \uff0c \u4f60 \u5011 \u6c92 \u6709 \u770b \u898b \u751a \u9ebc \u5f62 \u50cf \u3002"}, {"pk": 563003, "verse": 16, "text": "\u60df \u6050 \u4f60 \u5011 \u6557 \u58de \u81ea \u5df1 \uff0c \u96d5 \u523b \u5076 \u50cf \uff0c \u5f77 \u5f7f \u751a \u9ebc \u7537 \u50cf \u5973 \u50cf \uff0c"}, {"pk": 563004, "verse": 17, "text": "\u6216 \u5730 \u4e0a \u8d70 \u7378 \u7684 \u50cf \uff0c \u6216 \u7a7a \u4e2d \u98db \u9ce5 \u7684 \u50cf \uff0c"}, {"pk": 563005, "verse": 18, "text": "\u6216 \u5730 \u4e0a \u722c \u7269 \u7684 \u50cf \uff0c \u6216 \u5730 \u5e95 \u4e0b \u6c34 \u4e2d \u9b5a \u7684 \u50cf \u3002"}, {"pk": 563006, "verse": 19, "text": "\u53c8 \u6050 \u6015 \u4f60 \u5411 \u5929 \u8209 \u76ee \u89c0 \u770b \uff0c \u898b \u8036 \u548c \u83ef \u2500 \u4f60 \u7684 \u3000 \u795e \u70ba \u5929 \u4e0b \u842c \u6c11 \u6240 \u64fa \u5217 \u7684 \u65e5 \u6708 \u661f \uff0c \u5c31 \u662f \u5929 \u4e0a \u7684 \u842c \u8c61 \uff0c \u81ea \u5df1 \u4fbf \u88ab \u52fe \u5f15 \u656c \u62dc \u4e8b \u5949 \u4ed6 \u3002"}, {"pk": 563007, "verse": 20, "text": "\u8036 \u548c \u83ef \u5c07 \u4f60 \u5011 \u5f9e \u57c3 \u53ca \u9818 \u51fa \u4f86 \uff0c \u812b \u96e2 \u9435 \u7210 \uff0c \u8981 \u7279 \u4f5c \u81ea \u5df1 \u7522 \u696d \u7684 \u5b50 \u6c11 \uff0c \u50cf \u4eca \u65e5 \u4e00 \u6a23 \u3002"}, {"pk": 563008, "verse": 21, "text": "\u8036 \u548c \u83ef \u53c8 \u56e0 \u4f60 \u5011 \u7684 \u7de3 \u6545 \u5411 \u6211 \u767c \u6012 \uff0c \u8d77 \u8a93 \u5fc5 \u4e0d \u5bb9 \u6211 \u904e \u7d04 \u4f46 \u6cb3 \uff0c \u4e5f \u4e0d \u5bb9 \u6211 \u9032 \u5165 \u8036 \u548c \u83ef \u2500 \u4f60 \u3000 \u795e \u6240 \u8cdc \u4f60 \u70ba \u696d \u7684 \u90a3 \u7f8e \u5730 \u3002"}, {"pk": 563009, "verse": 22, "text": "\u6211 \u53ea \u5f97 \u6b7b \u5728 \u9019 \u5730 \uff0c \u4e0d \u80fd \u904e \u7d04 \u4f46 \u6cb3 \uff1b \u4f46 \u4f60 \u5011 \u5fc5 \u904e \u53bb \u5f97 \u90a3 \u7f8e \u5730 \u3002"}, {"pk": 563010, "verse": 23, "text": "\u4f60 \u5011 \u8981 \u8b39 \u614e \uff0c \u514d \u5f97 \u5fd8 \u8a18 \u8036 \u548c \u83ef \u2500 \u4f60 \u5011 \u3000 \u795e \u8207 \u4f60 \u5011 \u6240 \u7acb \u7684 \u7d04 \uff0c \u70ba \u81ea \u5df1 \u96d5 \u523b \u5076 \u50cf \uff0c \u5c31 \u662f \u8036 \u548c \u83ef \u2500 \u4f60 \u3000 \u795e \u6240 \u7981 \u6b62 \u4f60 \u505a \u7684 \u5076 \u50cf \uff1b"}, {"pk": 563011, "verse": 24, "text": "\u56e0 \u70ba \u8036 \u548c \u83ef \u2500 \u4f60 \u7684 \u3000 \u795e \u4e43 \u662f \u70c8 \u706b \uff0c \u662f \u5fcc \u90aa \u7684 \u3000 \u795e \u3002"}, {"pk": 563012, "verse": 25, "text": "\u4f60 \u5011 \u5728 \u90a3 \u5730 \u4f4f \u4e45 \u4e86 \uff0c \u751f \u5b50 \u751f \u5b6b \uff0c \u5c31 \u96d5 \u523b \u5076 \u50cf \uff0c \u5f77 \u5f7f \u751a \u9ebc \u5f62 \u50cf \uff0c \u6557 \u58de \u81ea \u5df1 \uff0c \u884c \u8036 \u548c \u83ef \u2500 \u4f60 \u3000 \u795e \u773c \u4e2d \u770b \u70ba \u60e1 \u7684 \u4e8b \uff0c \u60f9 \u4ed6 \u767c \u6012 \u3002"}, {"pk": 563013, "verse": 26, "text": "\u6211 \u4eca \u65e5 \u547c \u5929 \u559a \u5730 \u5411 \u4f60 \u5011 \u4f5c \u898b \u8b49 \uff0c \u4f60 \u5011 \u5fc5 \u5728 \u904e \u7d04 \u4f46 \u6cb3 \u5f97 \u70ba \u696d \u7684 \u5730 \u4e0a \u901f \u901f \u6ec5 \u76e1 \uff01 \u4f60 \u5011 \u4e0d \u80fd \u5728 \u90a3 \u5730 \u4e0a \u9577 \u4e45 \uff0c \u5fc5 \u76e1 \u884c \u9664 \u6ec5 \u3002"}, {"pk": 563014, "verse": 27, "text": "\u8036 \u548c \u83ef \u5fc5 \u4f7f \u4f60 \u5011 \u5206 \u6563 \u5728 \u842c \u6c11 \u4e2d \uff1b \u5728 \u4ed6 \u6240 \u9818 \u4f60 \u5011 \u5230 \u7684 \u842c \u570b \u88e1 \uff0c \u4f60 \u5011 \u5269 \u4e0b \u7684 \u4eba \u6578 \u7a00 \u5c11 \u3002"}, {"pk": 563015, "verse": 28, "text": "\u5728 \u90a3 \u88e1 \uff0c \u4f60 \u5011 \u5fc5 \u4e8b \u5949 \u4eba \u624b \u6240 \u9020 \u7684 \u3000 \u795e \uff0c \u5c31 \u662f \u7528 \u6728 \u77f3 \u9020 \u6210 \u3001 \u4e0d \u80fd \u770b \u3001 \u4e0d \u80fd \u807d \u3001 \u4e0d \u80fd \u5403 \u3001 \u4e0d \u80fd \u805e \u7684 \u3000 \u795e \u3002"}, {"pk": 563016, "verse": 29, "text": "\u4f46 \u4f60 \u5011 \u5728 \u90a3 \u88e1 \u5fc5 \u5c0b \u6c42 \u8036 \u548c \u83ef \u2500 \u4f60 \u7684 \u3000 \u795e \u3002 \u4f60 \u76e1 \u5fc3 \u76e1 \u6027 \u5c0b \u6c42 \u4ed6 \u7684 \u6642 \u5019 \uff0c \u5c31 \u5fc5 \u5c0b \u898b \u3002"}, {"pk": 563017, "verse": 30, "text": "\u65e5 \u5f8c \u4f60 \u906d \u9047 \u4e00 \u5207 \u60a3 \u96e3 \u7684 \u6642 \u5019 \uff0c \u4f60 \u5fc5 \u6b78 \u56de \u8036 \u548c \u83ef \u2500 \u4f60 \u7684 \u3000 \u795e \uff0c \u807d \u5f9e \u4ed6 \u7684 \u8a71 \u3002"}, {"pk": 563018, "verse": 31, "text": "\u8036 \u548c \u83ef \u2500 \u4f60 \u3000 \u795e \u539f \u662f \u6709 \u6190 \u61ab \u7684 \u3000 \u795e \uff1b \u4ed6 \u7e3d \u4e0d \u6487 \u4e0b \u4f60 \uff0c \u4e0d \u6ec5 \u7d55 \u4f60 \uff0c \u4e5f \u4e0d \u5fd8 \u8a18 \u4ed6 \u8d77 \u8a93 \u8207 \u4f60 \u5217 \u7956 \u6240 \u7acb \u7684 \u7d04 \u3002"}, {"pk": 563019, "verse": 32, "text": "\u4f60 \u4e14 \u8003 \u5bdf \u5728 \u4f60 \u4ee5 \u524d \u7684 \u4e16 \u4ee3 \uff0c \u81ea \u3000 \u795e \u9020 \u4eba \u5728 \u4e16 \u4ee5 \u4f86 \uff0c \u5f9e \u5929 \u9019 \u908a \u5230 \u5929 \u90a3 \u908a \uff0c \u66fe \u6709 \u4f55 \u6c11 \u807d \u898b \u3000 \u795e \u5728 \u706b \u4e2d \u8aaa \u8a71 \u7684 \u8072 \u97f3 \uff0c \u50cf \u4f60 \u807d \u898b \u9084 \u80fd \u5b58 \u6d3b \u5462 \uff1f"}, {"pk": 563020, "verse": 33, "text": "\u9019 \u6a23 \u7684 \u5927 \u4e8b \u4f55 \u66fe \u6709 \u3001 \u4f55 \u66fe \u807d \u898b \u5462 \uff1f"}, {"pk": 563021, "verse": 34, "text": "\u795e \u4f55 \u66fe \u5f9e \u5225 \u7684 \u570b \u4e2d \u5c07 \u4e00 \u570b \u7684 \u4eba \u6c11 \u9818 \u51fa \u4f86 \uff0c \u7528 \u8a66 \u9a57 \u3001 \u795e \u8e5f \u3001 \u5947 \u4e8b \u3001 \u722d \u6230 \u3001 \u5927 \u80fd \u7684 \u624b \uff0c \u548c \u4f38 \u51fa \u4f86 \u7684 \u8180 \u81c2 \uff0c \u4e26 \u5927 \u53ef \u754f \u7684 \u4e8b \uff0c \u50cf \u8036 \u548c \u83ef \u2500 \u4f60 \u5011 \u7684 \u3000 \u795e \u5728 \u57c3 \u53ca \uff0c \u5728 \u4f60 \u5011 \u773c \u524d \u70ba \u4f60 \u5011 \u6240 \u884c \u7684 \u4e00 \u5207 \u4e8b \u5462 \uff1f"}, {"pk": 563022, "verse": 35, "text": "\u9019 \u662f \u986f \u7d66 \u4f60 \u770b \uff0c \u8981 \u4f7f \u4f60 \u77e5 \u9053 \uff0c \u60df \u6709 \u8036 \u548c \u83ef \u2500 \u4ed6 \u662f \u3000 \u795e \uff0c \u9664 \u4ed6 \u4ee5 \u5916 \uff0c \u518d \u7121 \u5225 \u795e \u3002"}, {"pk": 563023, "verse": 36, "text": "\u4ed6 \u5f9e \u5929 \u4e0a \u4f7f \u4f60 \u807d \u898b \u4ed6 \u7684 \u8072 \u97f3 \uff0c \u70ba \u8981 \u6559 \u8a13 \u4f60 \uff0c \u53c8 \u5728 \u5730 \u4e0a \u4f7f \u4f60 \u770b \u898b \u4ed6 \u7684 \u70c8 \u706b \uff0c \u4e26 \u4e14 \u807d \u898b \u4ed6 \u5f9e \u706b \u4e2d \u6240 \u8aaa \u7684 \u8a71 \u3002"}, {"pk": 563024, "verse": 37, "text": "\u56e0 \u4ed6 \u611b \u4f60 \u7684 \u5217 \u7956 \uff0c \u6240 \u4ee5 \u63c0 \u9078 \u4ed6 \u5011 \u7684 \u5f8c \u88d4 \uff0c \u7528 \u5927 \u80fd \u89aa \u81ea \u9818 \u4f60 \u51fa \u4e86 \u57c3 \u53ca \uff0c"}, {"pk": 563025, "verse": 38, "text": "\u8981 \u5c07 \u6bd4 \u4f60 \u5f37 \u5927 \u7684 \u570b \u6c11 \u5f9e \u4f60 \u9762 \u524d \u8d95 \u51fa \uff0c \u9818 \u4f60 \u9032 \u53bb \uff0c \u5c07 \u4ed6 \u5011 \u7684 \u5730 \u8cdc \u4f60 \u70ba \u696d \uff0c \u50cf \u4eca \u65e5 \u4e00 \u6a23 \u3002"}, {"pk": 563026, "verse": 39, "text": "\u6240 \u4ee5 \uff0c \u4eca \u65e5 \u4f60 \u8981 \u77e5 \u9053 \uff0c \u4e5f \u8981 \u8a18 \u5728 \u5fc3 \u4e0a \uff0c \u5929 \u4e0a \u5730 \u4e0b \u60df \u6709 \u8036 \u548c \u83ef \u4ed6 \u662f \u3000 \u795e \uff0c \u9664 \u4ed6 \u4ee5 \u5916 \uff0c \u518d \u7121 \u5225 \u795e \u3002"}, {"pk": 563027, "verse": 40, "text": "\u6211 \u4eca \u65e5 \u5c07 \u4ed6 \u7684 \u5f8b \u4f8b \u8aa1 \u547d \u66c9 \u8aed \u4f60 \uff0c \u4f60 \u8981 \u9075 \u5b88 \uff0c \u4f7f \u4f60 \u548c \u4f60 \u7684 \u5b50 \u5b6b \u53ef \u4ee5 \u5f97 \u798f \uff0c \u4e26 \u4f7f \u4f60 \u7684 \u65e5 \u5b50 \u5728 \u8036 \u548c \u83ef \u2500 \u4f60 \u3000 \u795e \u6240 \u8cdc \u7684 \u5730 \u4e0a \u5f97 \u4ee5 \u9577 \u4e45 \u3002"}, {"pk": 563028, "verse": 41, "text": "\u90a3 \u6642 \uff0c \u6469 \u897f \u5728 \u7d04 \u4f46 \u6cb3 \u6771 \uff0c \u5411 \u65e5 \u51fa \u4e4b \u5730 \uff0c \u5206 \u5b9a \u4e09 \u5ea7 \u57ce \uff0c"}, {"pk": 563029, "verse": 42, "text": "\u4f7f \u90a3 \u7d20 \u7121 \u4ec7 \u6068 \u3001 \u7121 \u5fc3 \u6bba \u4e86 \u4eba \u7684 \uff0c \u53ef \u4ee5 \u9003 \u5230 \u9019 \u4e09 \u57ce \u4e4b \u4e2d \u7684 \u4e00 \u5ea7 \u57ce \uff0c \u5c31 \u5f97 \u5b58 \u6d3b \uff1a"}, {"pk": 563030, "verse": 43, "text": "\u70ba \u6d41 \u4fbf \u4eba \u5206 \u5b9a \u66e0 \u91ce \u5e73 \u539f \u7684 \u6bd4 \u6089 \uff1b \u70ba \u8fe6 \u5f97 \u4eba \u5206 \u5b9a \u57fa \u5217 \u7684 \u62c9 \u672b \uff1b \u70ba \u746a \u62ff \u897f \u4eba \u5206 \u5b9a \u5df4 \u73ca \u7684 \u54e5 \u862d \u3002"}, {"pk": 563031, "verse": 44, "text": "\u6469 \u897f \u5728 \u4ee5 \u8272 \u5217 \u4eba \u9762 \u524d \u6240 \u9673 \u660e \u7684 \u5f8b \u6cd5 \u2500"}, {"pk": 563032, "verse": 45, "text": "\u5c31 \u662f \u6469 \u897f \u5728 \u4ee5 \u8272 \u5217 \u4eba \u51fa \u57c3 \u53ca \u5f8c \u6240 \u50b3 \u7d66 \u4ed6 \u5011 \u7684 \u6cd5 \u5ea6 \u3001 \u5f8b \u4f8b \u3001 \u5178 \u7ae0 \uff1b"}, {"pk": 563033, "verse": 46, "text": "\u5728 \u7d04 \u4f46 \u6cb3 \u6771 \u4f2f \u6bd8 \u73e5 \u5c0d \u9762 \u7684 \u8c37 \u4e2d \uff0c \u5728 \u4f4f \u5e0c \u5be6 \u672c \u3001 \u4e9e \u6469 \u5229 \u738b \u897f \u5b8f \u4e4b \u5730 \uff1b \u9019 \u897f \u5b8f \u662f \u6469 \u897f \u548c \u4ee5 \u8272 \u5217 \u4eba \u51fa \u57c3 \u53ca \u5f8c \u6240 \u64ca \u6bba \u7684 \u3002"}, {"pk": 563034, "verse": 47, "text": "\u4ed6 \u5011 \u5f97 \u4e86 \u4ed6 \u7684 \u5730 \uff0c \u53c8 \u5f97 \u4e86 \u5df4 \u73ca \u738b \u5669 \u7684 \u5730 \uff0c \u5c31 \u662f \u5169 \u500b \u4e9e \u6469 \u5229 \u738b \uff0c \u5728 \u7d04 \u4f46 \u6cb3 \u6771 \u5411 \u65e5 \u51fa \u4e4b \u5730 \u3002"}, {"pk": 563035, "verse": 48, "text": "\u5f9e \u4e9e \u5ae9 \u8c37 \u908a \u7684 \u4e9e \u7f85 \u73e5 \uff0c \u76f4 \u5230 \u897f \u96f2 \u5c71 \uff0c \u5c31 \u662f \u9ed1 \u9580 \u5c71 \u3002"}, {"pk": 563036, "verse": 49, "text": "\u9084 \u6709 \u7d04 \u4f46 \u6cb3 \u6771 \u7684 \u5168 \u4e9e \u62c9 \u5df4 \uff0c \u76f4 \u5230 \u4e9e \u62c9 \u5df4 \u6d77 \uff0c \u9760 \u8fd1 \u6bd8 \u65af \u8fe6 \u5c71 \u6839 \u3002"}]