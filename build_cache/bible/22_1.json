[{"pk": 575521, "verse": 1, "text": "\u6240 \u7f85 \u9580 \u7684 \u6b4c \uff0c \u662f \u6b4c \u4e2d \u7684 \u96c5 \u6b4c \u3002 \uff08 \u65b0 \u5a18 \uff09"}, {"pk": 575522, "verse": 2, "text": "\u9858 \u4ed6 \u7528 \u53e3 \u8207 \u6211 \u89aa \u5634 \uff1b \u56e0 \u4f60 \u7684 \u611b \u60c5 \u6bd4 \u9152 \u66f4 \u7f8e \u3002"}, {"pk": 575523, "verse": 3, "text": "\u4f60 \u7684 \u818f \u6cb9 \u99a8 \u9999 \uff1b \u4f60 \u7684 \u540d \u5982 \u540c \u5012 \u51fa \u4f86 \u7684 \u9999 \u818f \uff0c \u6240 \u4ee5 \u773e \u7ae5 \u5973 \u90fd \u611b \u4f60 \u3002"}, {"pk": 575524, "verse": 4, "text": "\u9858 \u4f60 \u5438 \u5f15 \u6211 \uff0c \u6211 \u5011 \u5c31 \u5feb \u8dd1 \u8ddf \u96a8 \u4f60 \u3002 \u738b \u5e36 \u6211 \u9032 \u4e86 \u5167 \u5ba4 \uff0c \u6211 \u5011 \u5fc5 \u56e0 \u4f60 \u6b61 \u559c \u5feb \u6a02 \u3002 \u6211 \u5011 \u8981 \u7a31 \u8b9a \u4f60 \u7684 \u611b \u60c5 \uff0c \u52dd \u4f3c \u7a31 \u8b9a \u7f8e \u9152 \u3002 \u4ed6 \u5011 \u611b \u4f60 \u662f \u7406 \u6240 \u7576 \u7136 \u7684 \u3002"}, {"pk": 575525, "verse": 5, "text": "\u8036 \u8def \u6492 \u51b7 \u7684 \u773e \u5973 \u5b50 \u554a \uff0c \u6211 \u96d6 \u7136 \u9ed1 \uff0c \u537b \u662f \u79c0 \u7f8e \uff0c \u5982 \u540c \u57fa \u9054 \u7684 \u5e33 \u68da \uff0c \u597d \u50cf \u6240 \u7f85 \u9580 \u7684 \u5e54 \u5b50 \u3002"}, {"pk": 575526, "verse": 6, "text": "\u4e0d \u8981 \u56e0 \u65e5 \u982d \u628a \u6211 \u66ec \u9ed1 \u4e86 \u5c31 \u8f15 \u770b \u6211 \u3002 \u6211 \u540c \u6bcd \u7684 \u5f1f \u5144 \u5411 \u6211 \u767c \u6012 \uff0c \u4ed6 \u5011 \u4f7f \u6211 \u770b \u5b88 \u8461 \u8404 \u5712 \uff1b \u6211 \u81ea \u5df1 \u7684 \u8461 \u8404 \u5712 \u537b \u6c92 \u6709 \u770b \u5b88 \u3002"}, {"pk": 575527, "verse": 7, "text": "\u6211 \u5fc3 \u6240 \u611b \u7684 \u554a \uff0c \u6c42 \u4f60 \u544a \u8a34 \u6211 \uff0c \u4f60 \u5728 \u4f55 \u8655 \u7267 \u7f8a \uff1f \u664c \u5348 \u5728 \u4f55 \u8655 \u4f7f \u7f8a \u6b47 \u81e5 \uff1f \u6211 \u4f55 \u5fc5 \u5728 \u4f60 \u540c \u4f34 \u7684 \u7f8a \u7fa4 \u65c1 \u908a \u597d \u50cf \u8499 \u8457 \u81c9 \u7684 \u4eba \u5462 \uff1f \uff08 \u65b0 \u90ce \uff09"}, {"pk": 575528, "verse": 8, "text": "\u4f60 \u9019 \u5973 \u5b50 \u4e2d \u6975 \u7f8e \u9e97 \u7684 \uff0c \u4f60 \u82e5 \u4e0d \u77e5 \u9053 \uff0c \u53ea \u7ba1 \u8ddf \u96a8 \u7f8a \u7fa4 \u7684 \u8173 \u8e64 \u53bb \uff0c \u628a \u4f60 \u7684 \u5c71 \u7f8a \u7f94 \u7267 \u653e \u5728 \u7267 \u4eba \u5e33 \u68da \u7684 \u65c1 \u908a \u3002"}, {"pk": 575529, "verse": 9, "text": "\u6211 \u7684 \u4f73 \u5076 \uff0c \u6211 \u5c07 \u4f60 \u6bd4 \u6cd5 \u8001 \u8eca \u4e0a \u5957 \u7684 \u99ff \u99ac \u3002"}, {"pk": 575530, "verse": 10, "text": "\u4f60 \u7684 \u5169 \u816e \u56e0 \u9aee \u8fae \u800c \u79c0 \u7f8e \uff1b \u4f60 \u7684 \u9838 \u9805 \u56e0 \u73e0 \u4e32 \u800c \u83ef \u9e97 \u3002"}, {"pk": 575531, "verse": 11, "text": "\u6211 \u5011 \u8981 \u70ba \u4f60 \u7de8 \u4e0a \u91d1 \u8fae \uff0c \u9472 \u4e0a \u9280 \u91d8 \u3002 \uff08 \u65b0 \u5a18 \uff09"}, {"pk": 575532, "verse": 12, "text": "\u738b \u6b63 \u5750 \u5e2d \u7684 \u6642 \u5019 \uff0c \u6211 \u7684 \u54ea \u5660 \u9999 \u818f \u767c \u51fa \u9999 \u5473 \u3002"}, {"pk": 575533, "verse": 13, "text": "\u6211 \u4ee5 \u6211 \u7684 \u826f \u4eba \u70ba \u4e00 \u888b \u6c92 \u85e5 \uff0c \u5e38 \u5728 \u6211 \u61f7 \u4e2d \u3002"}, {"pk": 575534, "verse": 14, "text": "\u6211 \u4ee5 \u6211 \u7684 \u826f \u4eba \u70ba \u4e00 \u68f5 \u9cf3 \u4ed9 \u82b1 \uff0c \u5728 \u96b1 \u57fa \u5e95 \u8461 \u8404 \u5712 \u4e2d \u3002 \uff08 \u65b0 \u90ce \uff09"}, {"pk": 575535, "verse": 15, "text": "\u6211 \u7684 \u4f73 \u5076 \uff0c \u4f60 \u751a \u7f8e \u9e97 \uff01 \u4f60 \u751a \u7f8e \u9e97 \uff01 \u4f60 \u7684 \u773c \u597d \u50cf \u9d3f \u5b50 \u773c \u3002 \uff08 \u65b0 \u5a18 \uff09"}, {"pk": 575536, "verse": 16, "text": "\u6211 \u7684 \u826f \u4eba \u54ea \uff0c \u4f60 \u751a \u7f8e \u9e97 \u53ef \u611b \uff01 \u6211 \u5011 \u4ee5 \u9752 \u8349 \u70ba \u5e8a \u69bb \uff0c"}, {"pk": 575537, "verse": 17, "text": "\u4ee5 \u9999 \u67cf \u6a39 \u70ba \u623f \u5c4b \u7684 \u68df \u6881 \uff0c \u4ee5 \u677e \u6a39 \u70ba \u693d \u5b50 \u3002"}]