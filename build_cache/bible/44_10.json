[{"pk": 585242, "verse": 1, "text": "\u5728 \u8a72 \u6492 \u5229 \u4e9e \u6709 \u4e00 \u500b \u4eba \uff0c \u540d \u53eb \u54e5 \u5c3c \u6d41 \uff0c \u662f \u7fa9 \u5927 \u5229 \u71df \u7684 \u767e \u592b \u9577 \u3002"}, {"pk": 585243, "verse": 2, "text": "\u4ed6 \u662f \u500b \u8654 \u8aa0 \u4eba \uff0c \u4ed6 \u548c \u5168 \u5bb6 \u90fd \u656c \u754f \u795e \uff0c \u591a \u591a \u8cd9 \u6fdf \u767e \u59d3 \uff0c \u5e38 \u5e38 \u79b1 \u544a \u795e \u3002"}, {"pk": 585244, "verse": 3, "text": "\u6709 \u4e00 \u5929 \uff0c \u7d04 \u5728 \u7533 \u521d \uff0c \u4ed6 \u5728 \u7570 \u8c61 \u4e2d \u660e \u660e \u770b \u898b \u795e \u7684 \u4e00 \u500b \u4f7f \u8005 \u9032 \u53bb \uff0c \u5230 \u4ed6 \u90a3 \u88e1 \uff0c \u8aaa \uff1a \u54e5 \u5c3c \u6d41 \u3002"}, {"pk": 585245, "verse": 4, "text": "\u54e5 \u5c3c \u6d41 \u5b9a \u775b \u770b \u4ed6 \uff0c \u9a5a \u6015 \u8aaa \uff1a \u4e3b \u963f \uff0c \u751a \u9ebc \u4e8b \u5462 \uff1f \u5929 \u4f7f \u8aaa \uff1a \u4f60 \u7684 \u79b1 \u544a \u548c \u4f60 \u7684 \u8cd9 \u6fdf \u9054 \u5230 \u795e \u9762 \u524d \uff0c \u5df2 \u8499 \u8a18 \u5ff5 \u4e86 \u3002"}, {"pk": 585246, "verse": 5, "text": "\u73fe \u5728 \u4f60 \u7576 \u6253 \u767c \u4eba \u5f80 \u7d04 \u5e15 \u53bb \uff0c \u8acb \u90a3 \u7a31 \u547c \u5f7c \u5f97 \u7684 \u897f \u9580 \u4f86 \u3002"}, {"pk": 585247, "verse": 6, "text": "\u4ed6 \u4f4f \u5728 \u6d77 \u908a \u4e00 \u500b \u785d \u76ae \u5320 \u897f \u9580 \u7684 \u5bb6 \u88e1 \uff0c \u623f \u5b50 \u5728 \u6d77 \u908a \u4e0a \u3002"}, {"pk": 585248, "verse": 7, "text": "\u5411 \u4ed6 \u8aaa \u8a71 \u7684 \u5929 \u4f7f \u53bb \u5f8c \uff0c \u54e5 \u5c3c \u6d41 \u53eb \u4e86 \u5169 \u500b \u5bb6 \u4eba \u548c \u5e38 \u4f3a \u5019 \u4ed6 \u7684 \u4e00 \u500b \u8654 \u8aa0 \u5175 \u4f86 \uff0c"}, {"pk": 585249, "verse": 8, "text": "\u628a \u9019 \u4e8b \u90fd \u8ff0 \u8aaa \u7d66 \u4ed6 \u5011 \u807d \uff0c \u5c31 \u6253 \u767c \u4ed6 \u5011 \u5f80 \u7d04 \u5e15 \u53bb \u3002"}, {"pk": 585250, "verse": 9, "text": "\u7b2c \u4e8c \u5929 \uff0c \u4ed6 \u5011 \u884c \u8def \u5c07 \u8fd1 \u90a3 \u57ce \u3002 \u5f7c \u5f97 \u7d04 \u5728 \u5348 \u6b63 \uff0c \u4e0a \u623f \u9802 \u53bb \u79b1 \u544a \uff0c"}, {"pk": 585251, "verse": 10, "text": "\u89ba \u5f97 \u9913 \u4e86 \uff0c \u60f3 \u8981 \u5403 \u3002 \u90a3 \u5bb6 \u7684 \u4eba \u6b63 \u9810 \u5099 \u98ef \u7684 \u6642 \u5019 \uff0c \u5f7c \u5f97 \u9b42 \u904a \u8c61 \u5916 \uff0c"}, {"pk": 585252, "verse": 11, "text": "\u770b \u898b \u5929 \u958b \u4e86 \uff0c \u6709 \u4e00 \u7269 \u964d \u4e0b \uff0c \u597d \u50cf \u4e00 \u584a \u5927 \u5e03 \uff0c \u7e6b \u8457 \u56db \u89d2 \uff0c \u7e0b \u5728 \u5730 \u4e0a \uff0c"}, {"pk": 585253, "verse": 12, "text": "\u88e1 \u9762 \u6709 \u5730 \u4e0a \u5404 \u6a23 \u56db \u8db3 \u7684 \u8d70 \u7378 \u548c \u6606 \u87f2 \uff0c \u4e26 \u5929 \u4e0a \u7684 \u98db \u9ce5 \uff1b"}, {"pk": 585254, "verse": 13, "text": "\u53c8 \u6709 \u8072 \u97f3 \u5411 \u4ed6 \u8aaa \uff1a \u5f7c \u5f97 \uff0c \u8d77 \u4f86 \uff0c \u5bb0 \u4e86 \u5403 \uff01"}, {"pk": 585255, "verse": 14, "text": "\u5f7c \u5f97 \u537b \u8aaa \uff1a \u4e3b \u963f \uff0c \u9019 \u662f \u4e0d \u53ef \u7684 \uff01 \u51e1 \u4fd7 \u7269 \u548c \u4e0d \u6f54 \u6de8 \u7684 \u7269 \uff0c \u6211 \u5f9e \u4f86 \u6c92 \u6709 \u5403 \u904e \u3002"}, {"pk": 585256, "verse": 15, "text": "\u7b2c \u4e8c \u6b21 \u6709 \u8072 \u97f3 \u5411 \u4ed6 \u8aaa \uff1a \u795e \u6240 \u6f54 \u6de8 \u7684 \uff0c \u4f60 \u4e0d \u53ef \u7576 \u4f5c \u4fd7 \u7269 \u3002"}, {"pk": 585257, "verse": 16, "text": "\u9019 \u6a23 \u4e00 \u9023 \u4e09 \u6b21 \uff0c \u90a3 \u7269 \u96a8 \u5373 \u6536 \u56de \u5929 \u4e0a \u53bb \u4e86 \u3002"}, {"pk": 585258, "verse": 17, "text": "\u5f7c \u5f97 \u5fc3 \u88e1 \u6b63 \u5728 \u731c \u7591 \u4e4b \u9593 \uff0c \u4e0d \u77e5 \u6240 \u770b \u898b \u7684 \u7570 \u8c61 \u662f \u751a \u9ebc \u610f \u601d \u3002 \u54e5 \u5c3c \u6d41 \u6240 \u5dee \u4f86 \u7684 \u4eba \u5df2 \u7d93 \u8a2a \u554f \u5230 \u897f \u9580 \u7684 \u5bb6 \uff0c \u7ad9 \u5728 \u9580 \u5916 \uff0c"}, {"pk": 585259, "verse": 18, "text": "\u558a \u8457 \u554f \uff1a \u6709 \u7a31 \u547c \u5f7c \u5f97 \u7684 \u897f \u9580 \u4f4f \u5728 \u9019 \u88e1 \u6c92 \u6709 \uff1f"}, {"pk": 585260, "verse": 19, "text": "\u5f7c \u5f97 \u9084 \u601d \u60f3 \u90a3 \u7570 \u8c61 \u7684 \u6642 \u5019 \uff0c \u8056 \u9748 \u5411 \u4ed6 \u8aaa \uff1a \u6709 \u4e09 \u500b \u4eba \u4f86 \u627e \u4f60 \u3002"}, {"pk": 585261, "verse": 20, "text": "\u8d77 \u4f86 \uff0c \u4e0b \u53bb \uff0c \u548c \u4ed6 \u5011 \u540c \u5f80 \uff0c \u4e0d \u8981 \u7591 \u60d1 \uff0c \u56e0 \u70ba \u662f \u6211 \u5dee \u4ed6 \u5011 \u4f86 \u7684 \u3002"}, {"pk": 585262, "verse": 21, "text": "\u65bc \u662f \u5f7c \u5f97 \u4e0b \u53bb \u898b \u90a3 \u4e9b \u4eba \uff0c \u8aaa \uff1a \u6211 \u5c31 \u662f \u4f60 \u5011 \u6240 \u627e \u7684 \u4eba \u3002 \u4f60 \u5011 \u4f86 \u662f \u70ba \u751a \u9ebc \u7de3 \u6545 \uff1f"}, {"pk": 585263, "verse": 22, "text": "\u4ed6 \u5011 \u8aaa \uff1a \u767e \u592b \u9577 \u54e5 \u5c3c \u6d41 \u662f \u500b \u7fa9 \u4eba \uff0c \u656c \u754f \u795e \uff0c \u70ba \u7336 \u592a \u901a \u570b \u6240 \u7a31 \u8b9a \u3002 \u4ed6 \u8499 \u4e00 \u4f4d \u8056 \u5929 \u4f7f \u6307 \u793a \uff0c \u53eb \u4ed6 \u8acb \u4f60 \u5230 \u4ed6 \u5bb6 \u88e1 \u53bb \uff0c \u807d \u4f60 \u7684 \u8a71 \u3002"}, {"pk": 585264, "verse": 23, "text": "\u5f7c \u5f97 \u5c31 \u8acb \u4ed6 \u5011 \u9032 \u53bb \uff0c \u4f4f \u4e86 \u4e00 \u5bbf \u3002 \u6b21 \u65e5 \uff0c \u8d77 \u8eab \u548c \u4ed6 \u5011 \u540c \u53bb \uff0c \u9084 \u6709 \u7d04 \u5e15 \u7684 \u5e7e \u500b \u5f1f \u5144 \u540c \u8457 \u4ed6 \u53bb \uff1b"}, {"pk": 585265, "verse": 24, "text": "\u53c8 \u6b21 \u65e5 \uff0c \u4ed6 \u5011 \u9032 \u5165 \u8a72 \u6492 \u5229 \u4e9e \uff0c \u54e5 \u5c3c \u6d41 \u5df2 \u7d93 \u8acb \u4e86 \u4ed6 \u7684 \u89aa \u5c6c \u5bc6 \u53cb \u7b49 \u5019 \u4ed6 \u5011 \u3002"}, {"pk": 585266, "verse": 25, "text": "\u5f7c \u5f97 \u4e00 \u9032 \u53bb \uff0c \u54e5 \u5c3c \u6d41 \u5c31 \u8fce \u63a5 \u4ed6 \uff0c \u4fef \u4f0f \u5728 \u4ed6 \u8173 \u524d \u62dc \u4ed6 \u3002"}, {"pk": 585267, "verse": 26, "text": "\u5f7c \u5f97 \u62c9 \u4ed6 \uff0c \u8aaa \uff1a \u4f60 \u8d77 \u4f86 \uff0c \u6211 \u4e5f \u662f \u4eba \u3002"}, {"pk": 585268, "verse": 27, "text": "\u5f7c \u5f97 \u548c \u4ed6 \u8aaa \u8457 \u8a71 \u9032 \u53bb \uff0c \u898b \u6709 \u597d \u4e9b \u4eba \u5728 \u90a3 \u88e1 \u805a \u96c6 \uff0c"}, {"pk": 585269, "verse": 28, "text": "\u5c31 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u77e5 \u9053 \uff0c \u7336 \u592a \u4eba \u548c \u5225 \u570b \u7684 \u4eba \u89aa \u8fd1 \u4f86 \u5f80 \u672c \u662f \u4e0d \u5408 \u4f8b \u7684 \uff0c \u4f46 \u795e \u5df2 \u7d93 \u6307 \u793a \u6211 \uff0c \u7121 \u8ad6 \u751a \u9ebc \u4eba \u90fd \u4e0d \u53ef \u770b \u4f5c \u4fd7 \u800c \u4e0d \u6f54 \u6de8 \u7684 \u3002"}, {"pk": 585270, "verse": 29, "text": "\u6240 \u4ee5 \u6211 \u88ab \u8acb \u7684 \u6642 \u5019 \uff0c \u5c31 \u4e0d \u63a8 \u8fad \u800c \u4f86 \u3002 \u73fe \u5728 \u8acb \u554f \uff1a \u4f60 \u5011 \u53eb \u6211 \u4f86 \u6709 \u751a \u9ebc \u610f \u601d \u5462 \uff1f"}, {"pk": 585271, "verse": 30, "text": "\u54e5 \u5c3c \u6d41 \u8aaa \uff1a \u524d \u56db \u5929 \uff0c \u9019 \u500b \u6642 \u5019 \uff0c \u6211 \u5728 \u5bb6 \u4e2d \u5b88 \u8457 \u7533 \u521d \u7684 \u79b1 \u544a \uff0c \u5ffd \u7136 \u6709 \u4e00 \u500b \u4eba \u7a7f \u8457 \u5149 \u660e \u7684 \u8863 \u88f3 \uff0c \u7ad9 \u5728 \u6211 \u9762 \u524d \uff0c"}, {"pk": 585272, "verse": 31, "text": "\u8aaa \uff1a \u54e5 \u5c3c \u6d41 \uff0c \u4f60 \u7684 \u79b1 \u544a \u5df2 \u8499 \u5782 \u807d \uff0c \u4f60 \u7684 \u8cd9 \u6fdf \u9054 \u5230 \u795e \u9762 \u524d \u5df2 \u8499 \u8a18 \u5ff5 \u4e86 \u3002"}, {"pk": 585273, "verse": 32, "text": "\u4f60 \u7576 \u6253 \u767c \u4eba \u5f80 \u7d04 \u5e15 \u53bb \uff0c \u8acb \u90a3 \u7a31 \u547c \u5f7c \u5f97 \u7684 \u897f \u9580 \u4f86 \uff0c \u4ed6 \u4f4f \u5728 \u6d77 \u908a \u4e00 \u500b \u785d \u76ae \u5320 \u897f \u9580 \u7684 \u5bb6 \u88e1 \u3002"}, {"pk": 585274, "verse": 33, "text": "\u6240 \u4ee5 \u6211 \u7acb \u6642 \u6253 \u767c \u4eba \u53bb \u8acb \u4f60 \u3002 \u4f60 \u4f86 \u4e86 \u5f88 \u597d \uff1b \u73fe \u4eca \u6211 \u5011 \u90fd \u5728 \u795e \u9762 \u524d \uff0c \u8981 \u807d \u4e3b \u6240 \u5429 \u5490 \u4f60 \u7684 \u4e00 \u5207 \u8a71 \u3002"}, {"pk": 585275, "verse": 34, "text": "\u5f7c \u5f97 \u5c31 \u958b \u53e3 \u8aaa \uff1a \u6211 \u771f \u770b \u51fa \u795e \u662f \u4e0d \u504f \u5f85 \u4eba \u3002"}, {"pk": 585276, "verse": 35, "text": "\u539f \u4f86 \uff0c \u5404 \u570b \u4e2d \u90a3 \u656c \u754f \u4e3b \u3001 \u884c \u7fa9 \u7684 \u4eba \u90fd \u70ba \u4e3b \u6240 \u6085 \u7d0d \u3002"}, {"pk": 585277, "verse": 36, "text": "\u795e \u85c9 \u8457 \u8036 \u7a4c \u57fa \u7763 \uff08 \u4ed6 \u662f \u842c \u6709 \u7684 \u4e3b \uff09 \u50b3 \u548c \u5e73 \u7684 \u798f \u97f3 \uff0c \u5c07 \u9019 \u9053 \u8cdc \u7d66 \u4ee5 \u8272 \u5217 \u4eba \u3002"}, {"pk": 585278, "verse": 37, "text": "\u9019 \u8a71 \u5728 \u7d04 \u7ff0 \u5ba3 \u50b3 \u6d17 \u79ae \u4ee5 \u5f8c \uff0c \u5f9e \u52a0 \u5229 \u5229 \u8d77 \uff0c \u50b3 \u904d \u4e86 \u7336 \u592a \u3002"}, {"pk": 585279, "verse": 38, "text": "\u795e \u600e \u6a23 \u4ee5 \u8056 \u9748 \u548c \u80fd \u529b \u818f \u62ff \u6492 \u52d2 \u4eba \u8036 \u7a4c \uff0c \u9019 \u90fd \u662f \u4f60 \u5011 \u77e5 \u9053 \u7684 \u3002 \u4ed6 \u5468 \u6d41 \u56db \u65b9 \uff0c \u884c \u5584 \u4e8b \uff0c \u91ab \u597d \u51e1 \u88ab \u9b54 \u9b3c \u58d3 \u5236 \u7684 \u4eba \uff0c \u56e0 \u70ba \u795e \u8207 \u4ed6 \u540c \u5728 \u3002"}, {"pk": 585280, "verse": 39, "text": "\u4ed6 \u5728 \u7336 \u592a \u4eba \u4e4b \u5730 \uff0c \u4e26 \u8036 \u8def \u6492 \u51b7 \u6240 \u884c \u7684 \u4e00 \u5207 \u4e8b \uff0c \u6709 \u6211 \u5011 \u4f5c \u898b \u8b49 \u3002 \u4ed6 \u5011 \u7adf \u628a \u4ed6 \u639b \u5728 \u6728 \u982d \u4e0a \u6bba \u4e86 \u3002"}, {"pk": 585281, "verse": 40, "text": "\u7b2c \u4e09 \u65e5 \uff0c \u795e \u53eb \u4ed6 \u5fa9 \u6d3b \uff0c \u986f \u73fe \u51fa \u4f86 \uff1b"}, {"pk": 585282, "verse": 41, "text": "\u4e0d \u662f \u986f \u73fe \u7d66 \u773e \u4eba \u770b \uff0c \u4e43 \u662f \u986f \u73fe \u7d66 \u795e \u9810 \u5148 \u6240 \u63c0 \u9078 \u70ba \u4ed6 \u4f5c \u898b \u8b49 \u7684 \u4eba \u770b \uff0c \u5c31 \u662f \u6211 \u5011 \u9019 \u4e9b \u5728 \u4ed6 \u5f9e \u6b7b \u88e1 \u5fa9 \u6d3b \u4ee5 \u5f8c \u548c \u4ed6 \u540c \u5403 \u540c \u559d \u7684 \u4eba \u3002"}, {"pk": 585283, "verse": 42, "text": "\u4ed6 \u5429 \u5490 \u6211 \u5011 \u50b3 \u9053 \u7d66 \u773e \u4eba \uff0c \u8b49 \u660e \u4ed6 \u662f \u795e \u6240 \u7acb \u5b9a \u7684 \uff0c \u8981 \u4f5c \u5be9 \u5224 \u6d3b \u4eba \u3001 \u6b7b \u4eba \u7684 \u4e3b \u3002"}, {"pk": 585284, "verse": 43, "text": "\u773e \u5148 \u77e5 \u4e5f \u70ba \u4ed6 \u4f5c \u898b \u8b49 \u8aaa \uff1a \u51e1 \u4fe1 \u4ed6 \u7684 \u4eba \u5fc5 \u56e0 \u4ed6 \u7684 \u540d \u5f97 \u8499 \u8d66 \u7f6a \u3002"}, {"pk": 585285, "verse": 44, "text": "\u5f7c \u5f97 \u9084 \u8aaa \u9019 \u8a71 \u7684 \u6642 \u5019 \uff0c \u8056 \u9748 \u964d \u5728 \u4e00 \u5207 \u807d \u9053 \u7684 \u4eba \u8eab \u4e0a \u3002"}, {"pk": 585286, "verse": 45, "text": "\u90a3 \u4e9b \u5949 \u5272 \u79ae \u3001 \u548c \u5f7c \u5f97 \u540c \u4f86 \u7684 \u4fe1 \u5f92 \uff0c \u898b \u8056 \u9748 \u7684 \u6069 \u8cdc \u4e5f \u6f86 \u5728 \u5916 \u90a6 \u4eba \u8eab \u4e0a \uff0c \u5c31 \u90fd \u5e0c \u5947 \uff1b"}, {"pk": 585287, "verse": 46, "text": "\u56e0 \u807d \u898b \u4ed6 \u5011 \u8aaa \u65b9 \u8a00 \uff0c \u7a31 \u8b9a \u795e \u70ba \u5927 \u3002"}, {"pk": 585288, "verse": 47, "text": "\u65bc \u662f \u5f7c \u5f97 \u8aaa \uff1a \u9019 \u4e9b \u4eba \u65e2 \u53d7 \u4e86 \u8056 \u9748 \uff0c \u8207 \u6211 \u5011 \u4e00 \u6a23 \uff0c \u8ab0 \u80fd \u7981 \u6b62 \u7528 \u6c34 \u7d66 \u4ed6 \u5011 \u65bd \u6d17 \u5462 \uff1f"}, {"pk": 585289, "verse": 48, "text": "\u5c31 \u5429 \u5490 \u5949 \u8036 \u7a4c \u57fa \u7763 \u7684 \u540d \u7d66 \u4ed6 \u5011 \u65bd \u6d17 \u3002 \u4ed6 \u5011 \u53c8 \u8acb \u5f7c \u5f97 \u4f4f \u4e86 \u5e7e \u5929 \u3002"}]