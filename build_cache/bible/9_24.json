[{"pk": 565823, "verse": 1, "text": "\u6383 \u7f85 \u8ffd \u8d95 \u975e \u5229 \u58eb \u4eba \u56de \u4f86 \uff0c \u6709 \u4eba \u544a \u8a34 \u4ed6 \u8aaa \uff1a \u5927 \u885b \u5728 \u96b1 \u57fa \u5e95 \u7684 \u66e0 \u91ce \u3002"}, {"pk": 565824, "verse": 2, "text": "\u6383 \u7f85 \u5c31 \u5f9e \u4ee5 \u8272 \u5217 \u4eba \u4e2d \u6311 \u9078 \u4e09 \u5343 \u7cbe \u5175 \uff0c \u7387 \u9818 \u4ed6 \u5011 \u5f80 \u91ce \u7f8a \u7684 \u78d0 \u77f3 \u53bb \uff0c \u5c0b \u7d22 \u5927 \u885b \u548c \u8ddf \u96a8 \u4ed6 \u7684 \u4eba \u3002"}, {"pk": 565825, "verse": 3, "text": "\u5230 \u4e86 \u8def \u65c1 \u7684 \u7f8a \u5708 \uff0c \u5728 \u90a3 \u88e1 \u6709 \u6d1e \uff0c \u6383 \u7f85 \u9032 \u53bb \u5927 \u89e3 \u3002 \u5927 \u885b \u548c \u8ddf \u96a8 \u4ed6 \u7684 \u4eba \u6b63 \u85cf \u5728 \u6d1e \u88e1 \u7684 \u6df1 \u8655 \u3002"}, {"pk": 565826, "verse": 4, "text": "\u8ddf \u96a8 \u7684 \u4eba \u5c0d \u5927 \u885b \u8aaa \uff1a \u8036 \u548c \u83ef \u66fe \u61c9 \u8a31 \u4f60 \u8aaa \uff1a \u6211 \u8981 \u5c07 \u4f60 \u7684 \u4ec7 \u6575 \u4ea4 \u5728 \u4f60 \u624b \u88e1 \uff0c \u4f60 \u53ef \u4ee5 \u4efb \u610f \u5f85 \u4ed6 \u3002 \u5982 \u4eca \u6642 \u5019 \u5230 \u4e86 \uff01 \u5927 \u885b \u5c31 \u8d77 \u4f86 \uff0c \u6084 \u6084 \u5730 \u5272 \u4e0b \u6383 \u7f85 \u5916 \u888d \u7684 \u8863 \u895f \u3002"}, {"pk": 565827, "verse": 5, "text": "\u96a8 \u5f8c \u5927 \u885b \u5fc3 \u4e2d \u81ea \u8cac \uff0c \u56e0 \u70ba \u5272 \u4e0b \u6383 \u7f85 \u7684 \u8863 \u895f \uff1b"}, {"pk": 565828, "verse": 6, "text": "\u5c0d \u8ddf \u96a8 \u4ed6 \u7684 \u4eba \u8aaa \uff1a \u6211 \u7684 \u4e3b \u4e43 \u662f \u8036 \u548c \u83ef \u7684 \u53d7 \u818f \u8005 \uff0c \u6211 \u5728 \u8036 \u548c \u83ef \u9762 \u524d \u842c \u4e0d \u6562 \u4f38 \u624b \u5bb3 \u4ed6 \uff0c \u56e0 \u4ed6 \u662f \u8036 \u548c \u83ef \u7684 \u53d7 \u818f \u8005 \u3002"}, {"pk": 565829, "verse": 7, "text": "\u5927 \u885b \u7528 \u9019 \u8a71 \u6514 \u4f4f \u8ddf \u96a8 \u4ed6 \u7684 \u4eba \uff0c \u4e0d \u5bb9 \u4ed6 \u5011 \u8d77 \u4f86 \u5bb3 \u6383 \u7f85 \u3002 \u6383 \u7f85 \u8d77 \u4f86 \uff0c \u5f9e \u6d1e \u88e1 \u51fa \u53bb \u884c \u8def \u3002"}, {"pk": 565830, "verse": 8, "text": "\u96a8 \u5f8c \u5927 \u885b \u4e5f \u8d77 \u4f86 \uff0c \u5f9e \u6d1e \u88e1 \u51fa \u53bb \uff0c \u547c \u53eb \u6383 \u7f85 \u8aaa \uff1a \u6211 \u4e3b \uff0c \u6211 \u738b \uff01 \u6383 \u7f85 \u56de \u982d \u89c0 \u770b \uff0c \u5927 \u885b \u5c31 \u5c48 \u8eab \u3001 \u81c9 \u4f0f \u65bc \u5730 \u4e0b \u62dc \u3002"}, {"pk": 565831, "verse": 9, "text": "\u5927 \u885b \u5c0d \u6383 \u7f85 \u8aaa \uff1a \u4f60 \u70ba \u4f55 \u807d \u4fe1 \u4eba \u7684 \u8b92 \u8a00 \uff0c \u8aaa \u5927 \u885b \u60f3 \u8981 \u5bb3 \u4f60 \u5462 \uff1f"}, {"pk": 565832, "verse": 10, "text": "\u4eca \u65e5 \u4f60 \u89aa \u773c \u770b \u898b \u5728 \u6d1e \u4e2d \uff0c \u8036 \u548c \u83ef \u5c07 \u4f60 \u4ea4 \u5728 \u6211 \u624b \u88e1 \uff1b \u6709 \u4eba \u53eb \u6211 \u6bba \u4f60 \uff0c \u6211 \u537b \u611b \u60dc \u4f60 \uff0c \u8aaa \uff1a \u6211 \u4e0d \u6562 \u4f38 \u624b \u5bb3 \u6211 \u7684 \u4e3b \uff0c \u56e0 \u70ba \u4ed6 \u662f \u8036 \u548c \u83ef \u7684 \u53d7 \u818f \u8005 \u3002"}, {"pk": 565833, "verse": 11, "text": "\u6211 \u7236 \u554a \uff0c \u770b \u770b \u4f60 \u5916 \u888d \u7684 \u8863 \u895f \u5728 \u6211 \u624b \u4e2d \u3002 \u6211 \u5272 \u4e0b \u4f60 \u7684 \u8863 \u895f \uff0c \u6c92 \u6709 \u6bba \u4f60 \uff1b \u4f60 \u7531 \u6b64 \u53ef \u4ee5 \u77e5 \u9053 \u6211 \u6c92 \u6709 \u60e1 \u610f \u53db \u9006 \u4f60 \u3002 \u4f60 \u96d6 \u7136 \u7375 \u53d6 \u6211 \u7684 \u547d \uff0c \u6211 \u537b \u6c92 \u6709 \u5f97 \u7f6a \u4f60 \u3002"}, {"pk": 565834, "verse": 12, "text": "\u9858 \u8036 \u548c \u83ef \u5728 \u4f60 \u6211 \u4e2d \u9593 \u5224 \u65b7 \u662f \u975e \uff0c \u5728 \u4f60 \u8eab \u4e0a \u70ba \u6211 \u4f38 \u51a4 \uff0c \u6211 \u537b \u4e0d \u89aa \u624b \u52a0 \u5bb3 \u65bc \u4f60 \u3002"}, {"pk": 565835, "verse": 13, "text": "\u53e4 \u4eba \u6709 \u53e5 \u4fd7 \u8a9e \u8aaa \uff1a \u60e1 \u4e8b \u51fa \u65bc \u60e1 \u4eba \u3002 \u6211 \u537b \u4e0d \u89aa \u624b \u52a0 \u5bb3 \u65bc \u4f60 \u3002"}, {"pk": 565836, "verse": 14, "text": "\u4ee5 \u8272 \u5217 \u738b \u51fa \u4f86 \u8981 \u5c0b \u627e \u8ab0 \u5462 \uff1f \u8ffd \u8d95 \u8ab0 \u5462 \uff1f \u4e0d \u904e \u8ffd \u8d95 \u4e00 \u689d \u6b7b \u72d7 \uff0c \u4e00 \u500b \u867c \u86a4 \u5c31 \u662f \u4e86 \u3002"}, {"pk": 565837, "verse": 15, "text": "\u9858 \u8036 \u548c \u83ef \u5728 \u4f60 \u6211 \u4e2d \u9593 \u65bd \u884c \u5be9 \u5224 \uff0c \u65b7 \u5b9a \u662f \u975e \uff0c \u4e26 \u4e14 \u9452 \u5bdf \uff0c \u70ba \u6211 \u4f38 \u51a4 \uff0c \u6551 \u6211 \u812b \u96e2 \u4f60 \u7684 \u624b \u3002"}, {"pk": 565838, "verse": 16, "text": "\u5927 \u885b \u5411 \u6383 \u7f85 \u8aaa \u5b8c \u9019 \u8a71 \uff0c \u6383 \u7f85 \u8aaa \uff1a \u6211 \u5152 \u5927 \u885b \uff0c \u9019 \u662f \u4f60 \u7684 \u8072 \u97f3 \u9ebc \uff1f \u5c31 \u653e \u8072 \u5927 \u54ed \uff0c"}, {"pk": 565839, "verse": 17, "text": "\u5c0d \u5927 \u885b \u8aaa \uff1a \u4f60 \u6bd4 \u6211 \u516c \u7fa9 \uff1b \u56e0 \u70ba \u4f60 \u4ee5 \u5584 \u5f85 \u6211 \uff0c \u6211 \u537b \u4ee5 \u60e1 \u5f85 \u4f60 \u3002"}, {"pk": 565840, "verse": 18, "text": "\u4f60 \u4eca \u65e5 \u986f \u660e \u662f \u4ee5 \u5584 \u5f85 \u6211 \uff1b \u56e0 \u70ba \u8036 \u548c \u83ef \u5c07 \u6211 \u4ea4 \u5728 \u4f60 \u624b \u88e1 \uff0c \u4f60 \u537b \u6c92 \u6709 \u6bba \u6211 \u3002"}, {"pk": 565841, "verse": 19, "text": "\u4eba \u82e5 \u9047 \u898b \u4ec7 \u6575 \uff0c \u8c48 \u80af \u653e \u4ed6 \u5e73 \u5b89 \u7121 \u4e8b \u5730 \u53bb \u5462 \uff1f \u9858 \u8036 \u548c \u83ef \u56e0 \u4f60 \u4eca \u65e5 \u5411 \u6211 \u6240 \u884c \u7684 \uff0c \u4ee5 \u5584 \u5831 \u4f60 \u3002"}, {"pk": 565842, "verse": 20, "text": "\u6211 \u4e5f \u77e5 \u9053 \u4f60 \u5fc5 \u8981 \u4f5c \u738b \uff0c \u4ee5 \u8272 \u5217 \u7684 \u570b \u5fc5 \u5805 \u7acb \u5728 \u4f60 \u624b \u88e1 \u3002"}, {"pk": 565843, "verse": 21, "text": "\u73fe \u5728 \u4f60 \u8981 \u6307 \u8457 \u8036 \u548c \u83ef \u5411 \u6211 \u8d77 \u8a93 \uff0c \u4e0d \u526a \u9664 \u6211 \u7684 \u5f8c \u88d4 \uff0c \u5728 \u6211 \u7236 \u5bb6 \u4e0d \u6ec5 \u6c92 \u6211 \u7684 \u540d \u3002"}, {"pk": 565844, "verse": 22, "text": "\u65bc \u662f \u5927 \u885b \u5411 \u6383 \u7f85 \u8d77 \u8a93 \uff0c \u6383 \u7f85 \u5c31 \u56de \u5bb6 \u53bb \uff1b \u5927 \u885b \u548c \u8ddf \u96a8 \u4ed6 \u7684 \u4eba \u4e0a \u5c71 \u5be8 \u53bb \u4e86 \u3002"}]