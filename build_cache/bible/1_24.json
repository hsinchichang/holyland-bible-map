[{"pk": 558575, "verse": 1, "text": "\u4e9e \u4f2f \u62c9 \u7f55 \u5e74 \u7d00 \u8001 \u9081 \uff0c \u5411 \u4f86 \u5728 \u4e00 \u5207 \u4e8b \u4e0a \u8036 \u548c \u83ef \u90fd \u8cdc \u798f \u7d66 \u4ed6 \u3002"}, {"pk": 558576, "verse": 2, "text": "\u4e9e \u4f2f \u62c9 \u7f55 \u5c0d \u7ba1 \u7406 \u4ed6 \u5168 \u696d \u6700 \u8001 \u7684 \u50d5 \u4eba \u8aaa \uff1a \u8acb \u4f60 \u628a \u624b \u653e \u5728 \u6211 \u5927 \u817f \u5e95 \u4e0b \u3002"}, {"pk": 558577, "verse": 3, "text": "\u6211 \u8981 \u53eb \u4f60 \u6307 \u8457 \u8036 \u548c \u83ef \u2500 \u5929 \u5730 \u7684 \u4e3b \u8d77 \u8a93 \uff0c \u4e0d \u8981 \u70ba \u6211 \u5152 \u5b50 \u5a36 \u9019 \u8fe6 \u5357 \u5730 \u4e2d \u7684 \u5973 \u5b50 \u70ba \u59bb \u3002"}, {"pk": 558578, "verse": 4, "text": "\u4f60 \u8981 \u5f80 \u6211 \u672c \u5730 \u672c \u65cf \u53bb \uff0c \u70ba \u6211 \u7684 \u5152 \u5b50 \u4ee5 \u6492 \u5a36 \u4e00 \u500b \u59bb \u5b50 \u3002"}, {"pk": 558579, "verse": 5, "text": "\u50d5 \u4eba \u5c0d \u4ed6 \u8aaa \uff1a \u5018 \u82e5 \u5973 \u5b50 \u4e0d \u80af \u8ddf \u6211 \u5230 \u9019 \u5730 \u65b9 \u4f86 \uff0c \u6211 \u5fc5 \u9808 \u5c07 \u4f60 \u7684 \u5152 \u5b50 \u5e36 \u56de \u4f60 \u539f \u51fa \u4e4b \u5730 \u9ebc \uff1f"}, {"pk": 558580, "verse": 6, "text": "\u4e9e \u4f2f \u62c9 \u7f55 \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u8981 \u8b39 \u614e \uff0c \u4e0d \u8981 \u5e36 \u6211 \u7684 \u5152 \u5b50 \u56de \u90a3 \u88e1 \u53bb \u3002"}, {"pk": 558581, "verse": 7, "text": "\u8036 \u548c \u83ef \u2500 \u5929 \u4e0a \u7684 \u4e3b \u66fe \u5e36 \u9818 \u6211 \u96e2 \u958b \u7236 \u5bb6 \u548c \u672c \u65cf \u7684 \u5730 \uff0c \u5c0d \u6211 \u8aaa \u8a71 \uff0c \u5411 \u6211 \u8d77 \u8a93 \u8aaa \uff1a \u6211 \u8981 \u5c07 \u9019 \u5730 \u8cdc \u7d66 \u4f60 \u7684 \u5f8c \u88d4 \u3002 \u4ed6 \u5fc5 \u5dee \u9063 \u4f7f \u8005 \u5728 \u4f60 \u9762 \u524d \uff0c \u4f60 \u5c31 \u53ef \u4ee5 \u5f9e \u90a3 \u88e1 \u70ba \u6211 \u5152 \u5b50 \u5a36 \u4e00 \u500b \u59bb \u5b50 \u3002"}, {"pk": 558582, "verse": 8, "text": "\u5018 \u82e5 \u5973 \u5b50 \u4e0d \u80af \u8ddf \u4f60 \u4f86 \uff0c \u6211 \u4f7f \u4f60 \u8d77 \u7684 \u8a93 \u5c31 \u8207 \u4f60 \u7121 \u5e72 \u4e86 \uff0c \u53ea \u662f \u4e0d \u53ef \u5e36 \u6211 \u7684 \u5152 \u5b50 \u56de \u90a3 \u88e1 \u53bb \u3002"}, {"pk": 558583, "verse": 9, "text": "\u50d5 \u4eba \u5c31 \u628a \u624b \u653e \u5728 \u4ed6 \u4e3b \u4eba \u4e9e \u4f2f \u62c9 \u7f55 \u7684 \u5927 \u817f \u5e95 \u4e0b \uff0c \u70ba \u9019 \u4e8b \u5411 \u4ed6 \u8d77 \u8a93 \u3002"}, {"pk": 558584, "verse": 10, "text": "\u90a3 \u50d5 \u4eba \u5f9e \u4ed6 \u4e3b \u4eba \u7684 \u99f1 \u99dd \u88e1 \u53d6 \u4e86 \u5341 \u5339 \u99f1 \u99dd \uff0c \u4e26 \u5e36 \u4e9b \u4ed6 \u4e3b \u4eba \u5404 \u6a23 \u7684 \u8ca1 \u7269 \uff0c \u8d77 \u8eab \u5f80 \u7c73 \u6240 \u6ce2 \u5927 \u7c73 \u53bb \uff0c \u5230 \u4e86 \u62ff \u9db4 \u7684 \u57ce \u3002"}, {"pk": 558585, "verse": 11, "text": "\u5929 \u5c07 \u665a \uff0c \u773e \u5973 \u5b50 \u51fa \u4f86 \u6253 \u6c34 \u7684 \u6642 \u5019 \uff0c \u4ed6 \u4fbf \u53eb \u99f1 \u99dd \u8dea \u5728 \u57ce \u5916 \u7684 \u6c34 \u4e95 \u90a3 \u88e1 \u3002"}, {"pk": 558586, "verse": 12, "text": "\u4ed6 \u8aaa \uff1a \u8036 \u548c \u83ef \u2500 \u6211 \u4e3b \u4eba \u4e9e \u4f2f \u62c9 \u7f55 \u7684 \u3000 \u795e \u963f \uff0c \u6c42 \u4f60 \u65bd \u6069 \u7d66 \u6211 \u4e3b \u4eba \u4e9e \u4f2f \u62c9 \u7f55 \uff0c \u4f7f \u6211 \u4eca \u65e5 \u9047 \u898b \u597d \u6a5f \u6703 \u3002"}, {"pk": 558587, "verse": 13, "text": "\u6211 \u73fe \u4eca \u7ad9 \u5728 \u4e95 \u65c1 \uff0c \u57ce \u5167 \u5c45 \u6c11 \u7684 \u5973 \u5b50 \u5011 \u6b63 \u51fa \u4f86 \u6253 \u6c34 \u3002"}, {"pk": 558588, "verse": 14, "text": "\u6211 \u5411 \u90a3 \u4e00 \u500b \u5973 \u5b50 \u8aaa \uff1a \u8acb \u4f60 \u62ff \u4e0b \u6c34 \u74f6 \u4f86 \uff0c \u7d66 \u6211 \u6c34 \u559d \uff0c \u4ed6 \u82e5 \u8aaa \uff1a \u8acb \u559d \uff01 \u6211 \u4e5f \u7d66 \u4f60 \u7684 \u99f1 \u99dd \u559d \uff0c \u9858 \u90a3 \u5973 \u5b50 \u5c31 \u4f5c \u4f60 \u6240 \u9810 \u5b9a \u7d66 \u4f60 \u50d5 \u4eba \u4ee5 \u6492 \u7684 \u59bb \u3002 \u9019 \u6a23 \uff0c \u6211 \u4fbf \u77e5 \u9053 \u4f60 \u65bd \u6069 \u7d66 \u6211 \u4e3b \u4eba \u4e86 \u3002"}, {"pk": 558589, "verse": 15, "text": "\u8a71 \u9084 \u6c92 \u6709 \u8aaa \u5b8c \uff0c \u4e0d \u6599 \uff0c \u5229 \u767e \u52a0 \u80a9 \u982d \u4e0a \u625b \u8457 \u6c34 \u74f6 \u51fa \u4f86 \u3002 \u5229 \u767e \u52a0 \u662f \u5f7c \u571f \u5229 \u6240 \u751f \u7684 \uff1b \u5f7c \u571f \u5229 \u662f \u4e9e \u4f2f \u62c9 \u7f55 \u5144 \u5f1f \u62ff \u9db4 \u59bb \u5b50 \u5bc6 \u8fe6 \u7684 \u5152 \u5b50 \u3002"}, {"pk": 558590, "verse": 16, "text": "\u90a3 \u5973 \u5b50 \u5bb9 \u8c8c \u6975 \u5176 \u4fca \u7f8e \uff0c \u9084 \u662f \u8655 \u5973 \uff0c \u4e5f \u672a \u66fe \u6709 \u4eba \u89aa \u8fd1 \u4ed6 \u3002 \u4ed6 \u4e0b \u5230 \u4e95 \u65c1 \uff0c \u6253 \u6eff \u4e86 \u74f6 \uff0c \u53c8 \u4e0a \u4f86 \u3002"}, {"pk": 558591, "verse": 17, "text": "\u50d5 \u4eba \u8dd1 \u4e0a \u524d \u53bb \u8fce \u8457 \u4ed6 \uff0c \u8aaa \uff1a \u6c42 \u4f60 \u5c07 \u74f6 \u88e1 \u7684 \u6c34 \u7d66 \u6211 \u4e00 \u9ede \u559d \u3002"}, {"pk": 558592, "verse": 18, "text": "\u5973 \u5b50 \u8aaa \uff1a \u6211 \u4e3b \u8acb \u559d \uff01 \u5c31 \u6025 \u5fd9 \u62ff \u4e0b \u74f6 \u4f86 \uff0c \u6258 \u5728 \u624b \u4e0a \u7d66 \u4ed6 \u559d \u3002"}, {"pk": 558593, "verse": 19, "text": "\u5973 \u5b50 \u7d66 \u4ed6 \u559d \u4e86 \uff0c \u5c31 \u8aaa \uff1a \u6211 \u518d \u70ba \u4f60 \u7684 \u99f1 \u99dd \u6253 \u6c34 \uff0c \u53eb \u99f1 \u99dd \u4e5f \u559d \u8db3 \u3002"}, {"pk": 558594, "verse": 20, "text": "\u4ed6 \u5c31 \u6025 \u5fd9 \u628a \u74f6 \u88e1 \u7684 \u6c34 \u5012 \u5728 \u69fd \u88e1 \uff0c \u53c8 \u8dd1 \u5230 \u4e95 \u65c1 \u6253 \u6c34 \uff0c \u5c31 \u70ba \u6240 \u6709 \u7684 \u99f1 \u99dd \u6253 \u4e0a \u6c34 \u4f86 \u3002"}, {"pk": 558595, "verse": 21, "text": "\u90a3 \u4eba \u5b9a \u775b \u770b \u4ed6 \uff0c \u4e00 \u53e5 \u8a71 \u4e5f \u4e0d \u8aaa \uff0c \u8981 \u66c9 \u5f97 \u8036 \u548c \u83ef \u8cdc \u4ed6 \u901a \u9054 \u7684 \u9053 \u8def \u6c92 \u6709 \u3002"}, {"pk": 558596, "verse": 22, "text": "\u99f1 \u99dd \u559d \u8db3 \u4e86 \uff0c \u90a3 \u4eba \u5c31 \u62ff \u4e00 \u500b \u91d1 \u74b0 \uff0c \u91cd \u534a \u820d \u5ba2 \u52d2 \uff0c \u5169 \u500b \u91d1 \u9432 \uff0c \u91cd \u5341 \u820d \u5ba2 \u52d2 \uff0c \u7d66 \u4e86 \u90a3 \u5973 \u5b50 \uff0c"}, {"pk": 558597, "verse": 23, "text": "\u8aaa \uff1a \u8acb \u544a \u8a34 \u6211 \uff0c \u4f60 \u662f \u8ab0 \u7684 \u5973 \u5152 \uff1f \u4f60 \u7236 \u89aa \u5bb6 \u88e1 \u6709 \u6211 \u5011 \u4f4f \u5bbf \u7684 \u5730 \u65b9 \u6c92 \u6709 \uff1f"}, {"pk": 558598, "verse": 24, "text": "\u5973 \u5b50 \u8aaa \uff1a \u6211 \u662f \u5bc6 \u8fe6 \u8207 \u62ff \u9db4 \u4e4b \u5b50 \u5f7c \u571f \u5229 \u7684 \u5973 \u5152 \uff1b"}, {"pk": 558599, "verse": 25, "text": "\u53c8 \u8aaa \uff1a \u6211 \u5011 \u5bb6 \u88e1 \u8db3 \u6709 \u7ce7 \u8349 \uff0c \u4e5f \u6709 \u4f4f \u5bbf \u7684 \u5730 \u65b9 \u3002"}, {"pk": 558600, "verse": 26, "text": "\u90a3 \u4eba \u5c31 \u4f4e \u982d \u5411 \u8036 \u548c \u83ef \u4e0b \u62dc \uff0c"}, {"pk": 558601, "verse": 27, "text": "\u8aaa \uff1a \u8036 \u548c \u83ef \u2500 \u6211 \u4e3b \u4eba \u4e9e \u4f2f \u62c9 \u7f55 \u7684 \u3000 \u795e \u662f \u61c9 \u7576 \u7a31 \u980c \u7684 \uff0c \u56e0 \u4ed6 \u4e0d \u65b7 \u5730 \u4ee5 \u6148 \u611b \u8aa0 \u5be6 \u5f85 \u6211 \u4e3b \u4eba \u3002 \u81f3 \u65bc \u6211 \uff0c \u8036 \u548c \u83ef \u5728 \u8def \u4e0a \u5f15 \u9818 \u6211 \uff0c \u76f4 \u8d70 \u5230 \u6211 \u4e3b \u4eba \u7684 \u5144 \u5f1f \u5bb6 \u88e1 \u3002"}, {"pk": 558602, "verse": 28, "text": "\u5973 \u5b50 \u8dd1 \u56de \u53bb \uff0c \u7167 \u8457 \u9019 \u4e9b \u8a71 \u544a \u8a34 \u4ed6 \u6bcd \u89aa \u548c \u4ed6 \u5bb6 \u88e1 \u7684 \u4eba \u3002"}, {"pk": 558603, "verse": 29, "text": "\u5229 \u767e \u52a0 \u6709 \u4e00 \u500b \u54e5 \u54e5 \uff0c \u540d \u53eb \u62c9 \u73ed \uff0c \u770b \u898b \u91d1 \u74b0 \uff0c \u53c8 \u770b \u898b \u91d1 \u9432 \u5728 \u4ed6 \u59b9 \u5b50 \u7684 \u624b \u4e0a \uff0c \u4e26 \u807d \u898b \u4ed6 \u59b9 \u5b50 \u5229 \u767e \u52a0 \u7684 \u8a71 \uff0c \u8aaa \u90a3 \u4eba \u5c0d \u6211 \u5982 \u6b64 \u5982 \u6b64 \u8aaa \u3002 \u62c9 \u73ed \u5c31 \u8dd1 \u51fa \u4f86 \u5f80 \u4e95 \u65c1 \u53bb \uff0c \u5230 \u90a3 \u4eba \u8ddf \u524d \uff0c \u898b \u4ed6 \u4ecd \u7ad9 \u5728 \u99f1 \u99dd \u65c1 \u908a \u7684 \u4e95 \u65c1 \u90a3 \u88e1 \uff0c"}, {"pk": 558604, "verse": 30, "text": "a"}, {"pk": 558605, "verse": 31, "text": "\u4fbf \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u9019 \u8499 \u8036 \u548c \u83ef \u8cdc \u798f \u7684 \uff0c \u8acb \u9032 \u4f86 \uff0c \u70ba \u751a \u9ebc \u7ad9 \u5728 \u5916 \u908a \uff1f \u6211 \u5df2 \u7d93 \u6536 \u62fe \u4e86 \u623f \u5c4b \uff0c \u4e5f \u70ba \u99f1 \u99dd \u9810 \u5099 \u4e86 \u5730 \u65b9 \u3002"}, {"pk": 558606, "verse": 32, "text": "\u90a3 \u4eba \u5c31 \u9032 \u4e86 \u62c9 \u73ed \u7684 \u5bb6 \u3002 \u62c9 \u73ed \u5378 \u4e86 \u99f1 \u99dd \uff0c \u7528 \u8349 \u6599 \u9935 \u4e0a \uff0c \u62ff \u6c34 \u7d66 \u90a3 \u4eba \u548c \u8ddf \u96a8 \u7684 \u4eba \u6d17 \u8173 \uff0c"}, {"pk": 558607, "verse": 33, "text": "\u628a \u98ef \u64fa \u5728 \u4ed6 \u9762 \u524d \uff0c \u53eb \u4ed6 \u5403 \uff0c \u4ed6 \u537b \u8aaa \uff1a \u6211 \u4e0d \u5403 \uff0c \u7b49 \u6211 \u8aaa \u660e \u767d \u6211 \u7684 \u4e8b \u60c5 \u518d \u5403 \u3002 \u62c9 \u73ed \u8aaa \uff1a \u8acb \u8aaa \u3002"}, {"pk": 558608, "verse": 34, "text": "\u4ed6 \u8aaa \uff1a \u6211 \u662f \u4e9e \u4f2f \u62c9 \u7f55 \u7684 \u50d5 \u4eba \u3002"}, {"pk": 558609, "verse": 35, "text": "\u8036 \u548c \u83ef \u5927 \u5927 \u5730 \u8cdc \u798f \u7d66 \u6211 \u4e3b \u4eba \uff0c \u4f7f \u4ed6 \u660c \u5927 \uff0c \u53c8 \u8cdc \u7d66 \u4ed6 \u7f8a \u7fa4 \u3001 \u725b \u7fa4 \u3001 \u91d1 \u9280 \u3001 \u50d5 \u5a62 \u3001 \u99f1 \u99dd \uff0c \u548c \u9a62 \u3002"}, {"pk": 558610, "verse": 36, "text": "\u6211 \u4e3b \u4eba \u7684 \u59bb \u5b50 \u6492 \u62c9 \u5e74 \u8001 \u7684 \u6642 \u5019 \u7d66 \u6211 \u4e3b \u4eba \u751f \u4e86 \u4e00 \u500b \u5152 \u5b50 \uff1b \u6211 \u4e3b \u4eba \u4e5f \u5c07 \u4e00 \u5207 \u6240 \u6709 \u7684 \u90fd \u7d66 \u4e86 \u9019 \u500b \u5152 \u5b50 \u3002"}, {"pk": 558611, "verse": 37, "text": "\u6211 \u4e3b \u4eba \u53eb \u6211 \u8d77 \u8a93 \u8aaa \uff1a \u4f60 \u4e0d \u8981 \u70ba \u6211 \u5152 \u5b50 \u5a36 \u8fe6 \u5357 \u5730 \u7684 \u5973 \u5b50 \u70ba \u59bb \u3002"}, {"pk": 558612, "verse": 38, "text": "\u4f60 \u8981 \u5f80 \u6211 \u7236 \u5bb6 \u3001 \u6211 \u672c \u65cf \u90a3 \u88e1 \u53bb \uff0c \u70ba \u6211 \u7684 \u5152 \u5b50 \u5a36 \u4e00 \u500b \u59bb \u5b50 \u3002"}, {"pk": 558613, "verse": 39, "text": "\u6211 \u5c0d \u6211 \u4e3b \u4eba \u8aaa \uff1a \u6050 \u6015 \u5973 \u5b50 \u4e0d \u80af \u8ddf \u6211 \u4f86 \u3002"}, {"pk": 558614, "verse": 40, "text": "\u4ed6 \u5c31 \u8aaa \uff1a \u6211 \u6240 \u4e8b \u5949 \u7684 \u8036 \u548c \u83ef \u5fc5 \u8981 \u5dee \u9063 \u4ed6 \u7684 \u4f7f \u8005 \u8207 \u4f60 \u540c \u53bb \uff0c \u53eb \u4f60 \u7684 \u9053 \u8def \u901a \u9054 \uff0c \u4f60 \u5c31 \u5f97 \u4ee5 \u5728 \u6211 \u7236 \u5bb6 \u3001 \u6211 \u672c \u65cf \u90a3 \u88e1 \uff0c \u7d66 \u6211 \u7684 \u5152 \u5b50 \u5a36 \u4e00 \u500b \u59bb \u5b50 \u3002"}, {"pk": 558615, "verse": 41, "text": "\u53ea \u8981 \u4f60 \u5230 \u4e86 \u6211 \u672c \u65cf \u90a3 \u88e1 \uff0c \u6211 \u4f7f \u4f60 \u8d77 \u7684 \u8a93 \u5c31 \u8207 \u4f60 \u7121 \u5e72 \u3002 \u4ed6 \u5011 \u82e5 \u4e0d \u628a \u5973 \u5b50 \u4ea4 \u7d66 \u4f60 \uff0c \u6211 \u4f7f \u4f60 \u8d77 \u7684 \u8a93 \u4e5f \u8207 \u4f60 \u7121 \u5e72 \u3002"}, {"pk": 558616, "verse": 42, "text": "\u6211 \u4eca \u65e5 \u5230 \u4e86 \u4e95 \u65c1 \uff0c \u4fbf \u8aaa \uff1a \u8036 \u548c \u83ef \u2500 \u6211 \u4e3b \u4eba \u4e9e \u4f2f \u62c9 \u7f55 \u7684 \u3000 \u795e \u963f \uff0c \u9858 \u4f60 \u53eb \u6211 \u6240 \u884c \u7684 \u9053 \u8def \u901a \u9054 \u3002"}, {"pk": 558617, "verse": 43, "text": "\u6211 \u5982 \u4eca \u7ad9 \u5728 \u4e95 \u65c1 \uff0c \u5c0d \u90a3 \u4e00 \u500b \u51fa \u4f86 \u6253 \u6c34 \u7684 \u5973 \u5b50 \u8aaa \uff1a \u8acb \u4f60 \u628a \u4f60 \u74f6 \u88e1 \u7684 \u6c34 \u7d66 \u6211 \u4e00 \u9ede \u559d \uff1b"}, {"pk": 558618, "verse": 44, "text": "\u4ed6 \u82e5 \u8aaa \uff1a \u4f60 \u53ea \u7ba1 \u559d \uff0c \u6211 \u4e5f \u70ba \u4f60 \u7684 \u99f1 \u99dd \u6253 \u6c34 \uff1b \u9858 \u90a3 \u5973 \u5b50 \u5c31 \u4f5c \u8036 \u548c \u83ef \u7d66 \u6211 \u4e3b \u4eba \u5152 \u5b50 \u6240 \u9810 \u5b9a \u7684 \u59bb \u3002"}, {"pk": 558619, "verse": 45, "text": "\u6211 \u5fc3 \u88e1 \u7684 \u8a71 \u9084 \u6c92 \u6709 \u8aaa \u5b8c \uff0c \u5229 \u767e \u52a0 \u5c31 \u51fa \u4f86 \uff0c \u80a9 \u982d \u4e0a \u625b \u8457 \u6c34 \u74f6 \uff0c \u4e0b \u5230 \u4e95 \u65c1 \u6253 \u6c34 \u3002 \u6211 \u4fbf \u5c0d \u4ed6 \u8aaa \uff1a \u8acb \u4f60 \u7d66 \u6211 \u6c34 \u559d \u3002"}, {"pk": 558620, "verse": 46, "text": "\u4ed6 \u5c31 \u6025 \u5fd9 \u5f9e \u80a9 \u982d \u4e0a \u62ff \u4e0b \u74f6 \u4f86 \uff0c \u8aaa \uff1a \u8acb \u559d \uff01 \u6211 \u4e5f \u7d66 \u4f60 \u7684 \u99f1 \u99dd \u559d \u3002 \u6211 \u4fbf \u559d \u4e86 \uff1b \u4ed6 \u53c8 \u7d66 \u6211 \u7684 \u99f1 \u99dd \u559d \u4e86 \u3002"}, {"pk": 558621, "verse": 47, "text": "\u6211 \u554f \u4ed6 \u8aaa \uff1a \u4f60 \u662f \u8ab0 \u7684 \u5973 \u5152 \uff1f \u4ed6 \u8aaa \uff1a \u6211 \u662f \u5bc6 \u8fe6 \u8207 \u62ff \u9db4 \u4e4b \u5b50 \u5f7c \u571f \u5229 \u7684 \u5973 \u5152 \u3002 \u6211 \u5c31 \u628a \u74b0 \u5b50 \u6234 \u5728 \u4ed6 \u9f3b \u5b50 \u4e0a \uff0c \u628a \u9432 \u5b50 \u6234 \u5728 \u4ed6 \u5169 \u624b \u4e0a \u3002"}, {"pk": 558622, "verse": 48, "text": "\u96a8 \u5f8c \u6211 \u4f4e \u982d \u5411 \u8036 \u548c \u83ef \u4e0b \u62dc \uff0c \u7a31 \u980c \u8036 \u548c \u83ef \u2500 \u6211 \u4e3b \u4eba \u4e9e \u4f2f \u62c9 \u7f55 \u7684 \u3000 \u795e \uff1b \u56e0 \u70ba \u4ed6 \u5f15 \u5c0e \u6211 \u8d70 \u5408 \u5f0f \u7684 \u9053 \u8def \uff0c \u4f7f \u6211 \u5f97 \u8457 \u6211 \u4e3b \u4eba \u5144 \u5f1f \u7684 \u5b6b \u5973 \uff0c \u7d66 \u6211 \u4e3b \u4eba \u7684 \u5152 \u5b50 \u70ba \u59bb \u3002"}, {"pk": 558623, "verse": 49, "text": "\u73fe \u5728 \u4f60 \u5011 \u82e5 \u9858 \u4ee5 \u6148 \u611b \u8aa0 \u5be6 \u5f85 \u6211 \u4e3b \u4eba \uff0c \u5c31 \u544a \u8a34 \u6211 \uff1b \u82e5 \u4e0d \u7136 \uff0c \u4e5f \u544a \u8a34 \u6211 \uff0c \u4f7f \u6211 \u53ef \u4ee5 \u6216 \u5411 \u5de6 \uff0c \u6216 \u5411 \u53f3 \u3002"}, {"pk": 558624, "verse": 50, "text": "\u62c9 \u73ed \u548c \u5f7c \u571f \u5229 \u56de \u7b54 \u8aaa \uff1a \u9019 \u4e8b \u4e43 \u51fa \u65bc \u8036 \u548c \u83ef \uff0c \u6211 \u5011 \u4e0d \u80fd \u5411 \u4f60 \u8aaa \u597d \u8aaa \u6b79 \u3002"}, {"pk": 558625, "verse": 51, "text": "\u770b \u54ea \uff0c \u5229 \u767e \u52a0 \u5728 \u4f60 \u9762 \u524d \uff0c \u53ef \u4ee5 \u5c07 \u4ed6 \u5e36 \u53bb \uff0c \u7167 \u8457 \u8036 \u548c \u83ef \u6240 \u8aaa \u7684 \uff0c \u7d66 \u4f60 \u4e3b \u4eba \u7684 \u5152 \u5b50 \u70ba \u59bb \u3002"}, {"pk": 558626, "verse": 52, "text": "\u4e9e \u4f2f \u62c9 \u7f55 \u7684 \u50d5 \u4eba \u807d \u898b \u4ed6 \u5011 \u9019 \u8a71 \uff0c \u5c31 \u5411 \u8036 \u548c \u83ef \u4fef \u4f0f \u5728 \u5730 \u3002"}, {"pk": 558627, "verse": 53, "text": "\u7576 \u4e0b \u50d5 \u4eba \u62ff \u51fa \u91d1 \u5668 \u3001 \u9280 \u5668 \uff0c \u548c \u8863 \u670d \u9001 \u7d66 \u5229 \u767e \u52a0 \uff0c \u53c8 \u5c07 \u5bf6 \u7269 \u9001 \u7d66 \u4ed6 \u54e5 \u54e5 \u548c \u4ed6 \u6bcd \u89aa \u3002"}, {"pk": 558628, "verse": 54, "text": "\u50d5 \u4eba \u548c \u8ddf \u5f9e \u4ed6 \u7684 \u4eba \u5403 \u4e86 \u559d \u4e86 \uff0c \u4f4f \u4e86 \u4e00 \u591c \u3002 \u65e9 \u6668 \u8d77 \u4f86 \uff0c \u50d5 \u4eba \u5c31 \u8aaa \uff1a \u8acb \u6253 \u767c \u6211 \u56de \u6211 \u4e3b \u4eba \u90a3 \u88e1 \u53bb \u7f77 \u3002"}, {"pk": 558629, "verse": 55, "text": "\u5229 \u767e \u52a0 \u7684 \u54e5 \u54e5 \u548c \u4ed6 \u6bcd \u89aa \u8aaa \uff1a \u8b93 \u5973 \u5b50 \u540c \u6211 \u5011 \u518d \u4f4f \u5e7e \u5929 \uff0c \u81f3 \u5c11 \u5341 \u5929 \uff0c \u7136 \u5f8c \u4ed6 \u53ef \u4ee5 \u53bb \u3002"}, {"pk": 558630, "verse": 56, "text": "\u50d5 \u4eba \u8aaa \uff1a \u8036 \u548c \u83ef \u65e2 \u8cdc \u7d66 \u6211 \u901a \u9054 \u7684 \u9053 \u8def \uff0c \u4f60 \u5011 \u4e0d \u8981 \u803d \u8aa4 \u6211 \uff0c \u8acb \u6253 \u767c \u6211 \u8d70 \uff0c \u56de \u6211 \u4e3b \u4eba \u90a3 \u88e1 \u53bb \u7f77 \u3002"}, {"pk": 558631, "verse": 57, "text": "\u4ed6 \u5011 \u8aaa \uff1a \u6211 \u5011 \u628a \u5973 \u5b50 \u53eb \u4f86 \u554f \u554f \u4ed6 \uff0c"}, {"pk": 558632, "verse": 58, "text": "\u5c31 \u53eb \u4e86 \u5229 \u767e \u52a0 \u4f86 \uff0c \u554f \u4ed6 \u8aaa \uff1a \u4f60 \u548c \u9019 \u4eba \u540c \u53bb \u9ebc \uff1f \u5229 \u767e \u52a0 \u8aaa \uff1a \u6211 \u53bb \u3002"}, {"pk": 558633, "verse": 59, "text": "\u65bc \u662f \u4ed6 \u5011 \u6253 \u767c \u59b9 \u5b50 \u5229 \u767e \u52a0 \u548c \u4ed6 \u7684 \u4e73 \u6bcd \uff0c \u540c \u4e9e \u4f2f \u62c9 \u7f55 \u7684 \u50d5 \u4eba \uff0c \u4e26 \u8ddf \u5f9e \u50d5 \u4eba \u7684 \uff0c \u90fd \u8d70 \u4e86 \u3002"}, {"pk": 558634, "verse": 60, "text": "\u4ed6 \u5011 \u5c31 \u7d66 \u5229 \u767e \u52a0 \u795d \u798f \u8aaa \uff1a \u6211 \u5011 \u7684 \u59b9 \u5b50 \u963f \uff0c \u9858 \u4f60 \u4f5c \u5343 \u842c \u4eba \u7684 \u6bcd \uff01 \u9858 \u4f60 \u7684 \u5f8c \u88d4 \u5f97 \u8457 \u4ec7 \u6575 \u7684 \u57ce \u9580 \uff01"}, {"pk": 558635, "verse": 61, "text": "\u5229 \u767e \u52a0 \u548c \u4ed6 \u7684 \u4f7f \u5973 \u5011 \u8d77 \u4f86 \uff0c \u9a0e \u4e0a \u99f1 \u99dd \uff0c \u8ddf \u8457 \u90a3 \u50d5 \u4eba \uff0c \u50d5 \u4eba \u5c31 \u5e36 \u8457 \u5229 \u767e \u52a0 \u8d70 \u4e86 \u3002"}, {"pk": 558636, "verse": 62, "text": "\u90a3 \u6642 \uff0c \u4ee5 \u6492 \u4f4f \u5728 \u5357 \u5730 \uff0c \u525b \u5f9e \u5e87 \u8033 \u2022 \u62c9 \u6d77 \u2022 \u840a \u56de \u4f86 \u3002"}, {"pk": 558637, "verse": 63, "text": "\u5929 \u5c07 \u665a \uff0c \u4ee5 \u6492 \u51fa \u4f86 \u5728 \u7530 \u9593 \u9ed8 \u60f3 \uff0c \u8209 \u76ee \u4e00 \u770b \uff0c \u898b \u4f86 \u4e86 \u4e9b \u99f1 \u99dd \u3002"}, {"pk": 558638, "verse": 64, "text": "\u5229 \u767e \u52a0 \u8209 \u76ee \u770b \u898b \u4ee5 \u6492 \uff0c \u5c31 \u6025 \u5fd9 \u4e0b \u4e86 \u99f1 \u99dd \uff0c"}, {"pk": 558639, "verse": 65, "text": "\u554f \u90a3 \u50d5 \u4eba \u8aaa \uff1a \u9019 \u7530 \u9593 \u8d70 \u4f86 \u8fce \u63a5 \u6211 \u5011 \u7684 \u662f \u8ab0 \uff1f \u50d5 \u4eba \u8aaa \uff1a \u662f \u6211 \u7684 \u4e3b \u4eba \u3002 \u5229 \u767e \u52a0 \u5c31 \u62ff \u5e15 \u5b50 \u8499 \u4e0a \u81c9 \u3002"}, {"pk": 558640, "verse": 66, "text": "\u50d5 \u4eba \u5c31 \u5c07 \u6240 \u8fa6 \u7684 \u4e00 \u5207 \u4e8b \u90fd \u544a \u8a34 \u4ee5 \u6492 \u3002"}, {"pk": 558641, "verse": 67, "text": "\u4ee5 \u6492 \u4fbf \u9818 \u5229 \u767e \u52a0 \u9032 \u4e86 \u4ed6 \u6bcd \u89aa \u6492 \u62c9 \u7684 \u5e33 \u68da \uff0c \u5a36 \u4e86 \u4ed6 \u70ba \u59bb \uff0c \u4e26 \u4e14 \u611b \u4ed6 \u3002 \u4ee5 \u6492 \u81ea \u5f9e \u4ed6 \u6bcd \u89aa \u4e0d \u5728 \u4e86 \uff0c \u9019 \u624d \u5f97 \u4e86 \u5b89 \u6170 \u3002"}]