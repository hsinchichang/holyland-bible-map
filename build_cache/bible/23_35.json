[{"pk": 576304, "verse": 1, "text": "\u66e0 \u91ce \u548c \u4e7e \u65f1 \u4e4b \u5730 \u5fc5 \u7136 \u6b61 \u559c \uff1b \u6c99 \u6f20 \u4e5f \u5fc5 \u5feb \u6a02 \uff1b \u53c8 \u50cf \u73ab \u7470 \u958b \u82b1 \uff0c"}, {"pk": 576305, "verse": 2, "text": "\u5fc5 \u958b \u82b1 \u7e41 \u76db \uff0c \u6a02 \u4e0a \u52a0 \u6a02 \uff0c \u800c \u4e14 \u6b61 \u547c \u3002 \u5229 \u5df4 \u5ae9 \u7684 \u69ae \u8000 \uff0c \u4e26 \u8fe6 \u5bc6 \u8207 \u6c99 \u5d19 \u7684 \u83ef \u7f8e \uff0c \u5fc5 \u8cdc \u7d66 \u4ed6 \u3002 \u4eba \u5fc5 \u770b \u898b \u8036 \u548c \u83ef \u7684 \u69ae \u8000 \uff0c \u6211 \u5011 \u3000 \u795e \u7684 \u83ef \u7f8e \u3002"}, {"pk": 576306, "verse": 3, "text": "\u4f60 \u5011 \u8981 \u4f7f \u8edf \u5f31 \u7684 \u624b \u5805 \u58ef \uff0c \u7121 \u529b \u7684 \u819d \u7a69 \u56fa \u3002"}, {"pk": 576307, "verse": 4, "text": "\u5c0d \u81bd \u602f \u7684 \u4eba \u8aaa \uff1a \u4f60 \u5011 \u8981 \u525b \u5f37 \uff0c \u4e0d \u8981 \u61fc \u6015 \u3002 \u770b \u54ea \uff0c \u4f60 \u5011 \u7684 \u3000 \u795e \u5fc5 \u4f86 \u5831 \u4ec7 \uff0c \u5fc5 \u4f86 \u65bd \u884c \u6975 \u5927 \u7684 \u5831 \u61c9 \uff1b \u4ed6 \u5fc5 \u4f86 \u62ef \u6551 \u4f60 \u5011 \u3002"}, {"pk": 576308, "verse": 5, "text": "\u90a3 \u6642 \uff0c \u778e \u5b50 \u7684 \u773c \u5fc5 \u775c \u958b \uff1b \u807e \u5b50 \u7684 \u8033 \u5fc5 \u958b \u901a \u3002"}, {"pk": 576309, "verse": 6, "text": "\u90a3 \u6642 \uff0c \u7638 \u5b50 \u5fc5 \u8df3 \u8e8d \u50cf \u9e7f \uff1b \u555e \u5df4 \u7684 \u820c \u982d \u5fc5 \u80fd \u6b4c \u5531 \u3002 \u5728 \u66e0 \u91ce \u5fc5 \u6709 \u6c34 \u767c \u51fa \uff1b \u5728 \u6c99 \u6f20 \u5fc5 \u6709 \u6cb3 \u6e67 \u6d41 \u3002"}, {"pk": 576310, "verse": 7, "text": "\u767c \u5149 \u7684 \u6c99 \uff08 \u6216 \u8b6f \uff1a \u8703 \u6a13 \uff09 \u8981 \u8b8a \u70ba \u6c34 \u6c60 \uff1b \u4e7e \u6e34 \u4e4b \u5730 \u8981 \u8b8a \u70ba \u6cc9 \u6e90 \u3002 \u5728 \u91ce \u72d7 \u8eba \u81e5 \u4e4b \u8655 \uff0c \u5fc5 \u6709 \u9752 \u8349 \u3001 \u8606 \u8466 \uff0c \u548c \u84b2 \u8349 \u3002"}, {"pk": 576311, "verse": 8, "text": "\u5728 \u90a3 \u88e1 \u5fc5 \u6709 \u4e00 \u689d \u5927 \u9053 \uff0c \u7a31 \u70ba \u8056 \u8def \u3002 \u6c61 \u7a62 \u4eba \u4e0d \u5f97 \u7d93 \u904e \uff0c \u5fc5 \u5c08 \u70ba \u8d16 \u6c11 \u884c \u8d70 \uff1b \u884c \u8def \u7684 \u4eba \u96d6 \u611a \u6627 \uff0c \u4e5f \u4e0d \u81f4 \u5931 \u8ff7 \u3002"}, {"pk": 576312, "verse": 9, "text": "\u5728 \u90a3 \u88e1 \u5fc5 \u6c92 \u6709 \u7345 \u5b50 \uff0c \u731b \u7378 \u4e5f \u4e0d \u767b \u9019 \u8def \uff1b \u5728 \u90a3 \u88e1 \u90fd \u9047 \u4e0d \u898b \uff0c \u53ea \u6709 \u8d16 \u6c11 \u5728 \u90a3 \u88e1 \u884c \u8d70 \u3002"}, {"pk": 576313, "verse": 10, "text": "\u4e26 \u4e14 \u8036 \u548c \u83ef \u6551 \u8d16 \u7684 \u6c11 \u5fc5 \u6b78 \u56de \uff0c \u6b4c \u5531 \u4f86 \u5230 \u932b \u5b89 \uff1b \u6c38 \u6a02 \u5fc5 \u6b78 \u5230 \u4ed6 \u5011 \u7684 \u982d \u4e0a \uff1b \u4ed6 \u5011 \u5fc5 \u5f97 \u8457 \u6b61 \u559c \u5feb \u6a02 \uff0c \u6182 \u6101 \u6b4e \u606f \u76e1 \u90fd \u9003 \u907f \u3002"}]