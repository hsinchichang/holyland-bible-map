[{"pk": 583179, "verse": 1, "text": "\u8036 \u7a4c \u5c0d \u767e \u59d3 \u8b1b \u5b8c \u4e86 \u9019 \u4e00 \u5207 \u7684 \u8a71 \uff0c \u5c31 \u9032 \u4e86 \u8fe6 \u767e \u8fb2 \u3002"}, {"pk": 583180, "verse": 2, "text": "\u6709 \u4e00 \u500b \u767e \u592b \u9577 \u6240 \u5bf6 \u8cb4 \u7684 \u50d5 \u4eba \u5bb3 \u75c5 \uff0c \u5feb \u8981 \u6b7b \u4e86 \u3002"}, {"pk": 583181, "verse": 3, "text": "\u767e \u592b \u9577 \u98a8 \u805e \u8036 \u7a4c \u7684 \u4e8b \uff0c \u5c31 \u8a17 \u7336 \u592a \u4eba \u7684 \u5e7e \u500b \u9577 \u8001 \u53bb \u6c42 \u8036 \u7a4c \u4f86 \u6551 \u4ed6 \u7684 \u50d5 \u4eba \u3002"}, {"pk": 583182, "verse": 4, "text": "\u4ed6 \u5011 \u5230 \u4e86 \u8036 \u7a4c \u90a3 \u88e1 \uff0c \u5c31 \u5207 \u5207 \u7684 \u6c42 \u4ed6 \u8aaa \uff1a \u4f60 \u7d66 \u4ed6 \u884c \u9019 \u4e8b \u662f \u4ed6 \u6240 \u914d \u5f97 \u7684 \uff1b"}, {"pk": 583183, "verse": 5, "text": "\u56e0 \u70ba \u4ed6 \u611b \u6211 \u5011 \u7684 \u767e \u59d3 \uff0c \u7d66 \u6211 \u5011 \u5efa \u9020 \u6703 \u5802 \u3002"}, {"pk": 583184, "verse": 6, "text": "\u8036 \u7a4c \u5c31 \u548c \u4ed6 \u5011 \u540c \u53bb \u3002 \u96e2 \u90a3 \u5bb6 \u4e0d \u9060 \uff0c \u767e \u592b \u9577 \u8a17 \u5e7e \u500b \u670b \u53cb \u53bb \u898b \u8036 \u7a4c \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u4e3b \u963f \uff01 \u4e0d \u8981 \u52de \u52d5 \uff1b \u56e0 \u4f60 \u5230 \u6211 \u820d \u4e0b \uff0c \u6211 \u4e0d \u6562 \u7576 \u3002"}, {"pk": 583185, "verse": 7, "text": "\u6211 \u4e5f \u81ea \u4ee5 \u70ba \u4e0d \u914d \u53bb \u898b \u4f60 \uff0c \u53ea \u8981 \u4f60 \u8aaa \u4e00 \u53e5 \u8a71 \uff0c \u6211 \u7684 \u50d5 \u4eba \u5c31 \u5fc5 \u597d \u4e86 \u3002"}, {"pk": 583186, "verse": 8, "text": "\u56e0 \u70ba \u6211 \u5728 \u4eba \u7684 \u6b0a \u4e0b \uff0c \u4e5f \u6709 \u5175 \u5728 \u6211 \u4ee5 \u4e0b \uff0c \u5c0d \u9019 \u500b \u8aaa \uff1a \u53bb \uff01 \u4ed6 \u5c31 \u53bb \uff1b \u5c0d \u90a3 \u500b \u8aaa \uff1a \u4f86 \uff01 \u4ed6 \u5c31 \u4f86 \uff1b \u5c0d \u6211 \u7684 \u50d5 \u4eba \u8aaa \uff1a \u4f60 \u4f5c \u9019 \u4e8b \uff01 \u4ed6 \u5c31 \u53bb \u4f5c \u3002"}, {"pk": 583187, "verse": 9, "text": "\u8036 \u7a4c \u807d \u898b \u9019 \u8a71 \uff0c \u5c31 \u5e0c \u5947 \u4ed6 \uff0c \u8f49 \u8eab \u5c0d \u8ddf \u96a8 \u7684 \u773e \u4eba \u8aaa \uff1a \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u9019 \u9ebc \u5927 \u7684 \u4fe1 \u5fc3 \uff0c \u5c31 \u662f \u5728 \u4ee5 \u8272 \u5217 \u4e2d \uff0c \u6211 \u4e5f \u6c92 \u6709 \u9047 \u898b \u904e \u3002"}, {"pk": 583188, "verse": 10, "text": "\u90a3 \u8a17 \u4f86 \u7684 \u4eba \u56de \u5230 \u767e \u592b \u9577 \u5bb6 \u88e1 \uff0c \u770b \u898b \u50d5 \u4eba \u5df2 \u7d93 \u597d \u4e86 \u3002"}, {"pk": 583189, "verse": 11, "text": "\u904e \u4e86 \u4e0d \u591a \u6642 \uff08 \u6709 \u53e4 \u5377 \uff1a \u6b21 \u65e5 \uff09 \uff0c \u8036 \u7a4c \u5f80 \u4e00 \u5ea7 \u57ce \u53bb \uff0c \u9019 \u57ce \u540d \u53eb \u62ff \u56e0 \uff0c \u4ed6 \u7684 \u9580 \u5f92 \u548c \u6975 \u591a \u7684 \u4eba \u8207 \u4ed6 \u540c \u884c \u3002"}, {"pk": 583190, "verse": 12, "text": "\u5c07 \u8fd1 \u57ce \u9580 \uff0c \u6709 \u4e00 \u500b \u6b7b \u4eba \u88ab \u62ac \u51fa \u4f86 \u3002 \u9019 \u4eba \u662f \u4ed6 \u6bcd \u89aa \u7368 \u751f \u7684 \u5152 \u5b50 \uff1b \u4ed6 \u6bcd \u89aa \u53c8 \u662f \u5be1 \u5a66 \u3002 \u6709 \u57ce \u88e1 \u7684 \u8a31 \u591a \u4eba \u540c \u8457 \u5be1 \u5a66 \u9001 \u6baf \u3002"}, {"pk": 583191, "verse": 13, "text": "\u4e3b \u770b \u898b \u90a3 \u5be1 \u5a66 \uff0c \u5c31 \u6190 \u61ab \u4ed6 \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u4e0d \u8981 \u54ed \uff01"}, {"pk": 583192, "verse": 14, "text": "\u65bc \u662f \u9032 \u524d \u6309 \u8457 \u69d3 \uff0c \u62ac \u7684 \u4eba \u5c31 \u7ad9 \u4f4f \u4e86 \u3002 \u8036 \u7a4c \u8aaa \uff1a \u5c11 \u5e74 \u4eba \uff0c \u6211 \u5429 \u5490 \u4f60 \uff0c \u8d77 \u4f86 \uff01"}, {"pk": 583193, "verse": 15, "text": "\u90a3 \u6b7b \u4eba \u5c31 \u5750 \u8d77 \uff0c \u4e26 \u4e14 \u8aaa \u8a71 \u3002 \u8036 \u7a4c \u4fbf \u628a \u4ed6 \u4ea4 \u7d66 \u4ed6 \u6bcd \u89aa \u3002"}, {"pk": 583194, "verse": 16, "text": "\u773e \u4eba \u90fd \u9a5a \u5947 \uff0c \u6b78 \u69ae \u8000 \u8207 \u795e \uff0c \u8aaa \uff1a \u6709 \u5927 \u5148 \u77e5 \u5728 \u6211 \u5011 \u4e2d \u9593 \u8208 \u8d77 \u4f86 \u4e86 \uff01 \u53c8 \u8aaa \uff1a \u795e \u7737 \u9867 \u4e86 \u4ed6 \u7684 \u767e \u59d3 \uff01"}, {"pk": 583195, "verse": 17, "text": "\u4ed6 \u9019 \u4e8b \u7684 \u98a8 \u8072 \u5c31 \u50b3 \u904d \u4e86 \u7336 \u592a \u548c \u5468 \u570d \u5730 \u65b9 \u3002"}, {"pk": 583196, "verse": 18, "text": "\u7d04 \u7ff0 \u7684 \u9580 \u5f92 \u628a \u9019 \u4e9b \u4e8b \u90fd \u544a \u8a34 \u7d04 \u7ff0 \u3002"}, {"pk": 583197, "verse": 19, "text": "\u4ed6 \u4fbf \u53eb \u4e86 \u5169 \u500b \u9580 \u5f92 \u4f86 \uff0c \u6253 \u767c \u4ed6 \u5011 \u5230 \u4e3b \u90a3 \u88e1 \u53bb \uff0c \u8aaa \uff1a \u90a3 \u5c07 \u8981 \u4f86 \u7684 \u662f \u4f60 \u9ebc \uff1f \u9084 \u662f \u6211 \u5011 \u7b49 \u5019 \u5225 \u4eba \u5462 \uff1f"}, {"pk": 583198, "verse": 20, "text": "\u90a3 \u5169 \u500b \u4eba \u4f86 \u5230 \u8036 \u7a4c \u90a3 \u88e1 \uff0c \u8aaa \uff1a \u65bd \u6d17 \u7684 \u7d04 \u7ff0 \u6253 \u767c \u6211 \u5011 \u4f86 \u554f \u4f60 \uff1a \u90a3 \u5c07 \u8981 \u4f86 \u7684 \u662f \u4f60 \u9ebc \uff1f \u9084 \u662f \u6211 \u5011 \u7b49 \u5019 \u5225 \u4eba \u5462 \uff1f"}, {"pk": 583199, "verse": 21, "text": "\u6b63 \u7576 \u90a3 \u6642 \u5019 \uff0c \u8036 \u7a4c \u6cbb \u597d \u4e86 \u8a31 \u591a \u6709 \u75be \u75c5 \u7684 \uff0c \u53d7 \u707d \u60a3 \u7684 \uff0c \u88ab \u60e1 \u9b3c \u9644 \u8457 \u7684 \uff0c \u53c8 \u958b \u6069 \u53eb \u597d \u4e9b \u778e \u5b50 \u80fd \u770b \u898b \u3002"}, {"pk": 583200, "verse": 22, "text": "\u8036 \u7a4c \u56de \u7b54 \u8aaa \uff1a \u4f60 \u5011 \u53bb \uff0c \u628a \u6240 \u770b \u898b \u6240 \u807d \u898b \u7684 \u4e8b \u544a \u8a34 \u7d04 \u7ff0 \uff0c \u5c31 \u662f \u778e \u5b50 \u770b \u898b \uff0c \u7638 \u5b50 \u884c \u8d70 \uff0c \u9577 \u5927 \u75f2 \u760b \u7684 \u6f54 \u6de8 \uff0c \u807e \u5b50 \u807d \u898b \uff0c \u6b7b \u4eba \u5fa9 \u6d3b \uff0c \u7aae \u4eba \u6709 \u798f \u97f3 \u50b3 \u7d66 \u4ed6 \u5011 \u3002"}, {"pk": 583201, "verse": 23, "text": "\u51e1 \u4e0d \u56e0 \u6211 \u8dcc \u5012 \u7684 \uff0c \u5c31 \u6709 \u798f \u4e86 \uff01"}, {"pk": 583202, "verse": 24, "text": "\u7d04 \u7ff0 \u6240 \u5dee \u4f86 \u7684 \u4eba \u65e2 \u8d70 \u4e86 \uff0c \u8036 \u7a4c \u5c31 \u5c0d \u773e \u4eba \u8b1b \u8ad6 \u7d04 \u7ff0 \u8aaa \uff1a \u4f60 \u5011 \u5f9e \u524d \u51fa \u53bb \u5230 \u66e0 \u91ce \uff0c \u662f \u8981 \u770b \u751a \u9ebc \u5462 \uff1f \u8981 \u770b \u98a8 \u5439 \u52d5 \u7684 \u8606 \u8466 \u9ebc \uff1f"}, {"pk": 583203, "verse": 25, "text": "\u4f60 \u5011 \u51fa \u53bb \uff0c \u5230 \u5e95 \u662f \u8981 \u770b \u751a \u9ebc \uff1f \u8981 \u770b \u7a7f \u7d30 \u8edf \u8863 \u670d \u7684 \u4eba \u9ebc \uff1f \u90a3 \u7a7f \u83ef \u9e97 \u8863 \u670d \u3001 \u5bb4 \u6a02 \u5ea6 \u65e5 \u7684 \u4eba \u662f \u5728 \u738b \u5bae \u88e1 \u3002"}, {"pk": 583204, "verse": 26, "text": "\u4f60 \u5011 \u51fa \u53bb \uff0c \u7a76 \u7adf \u662f \u8981 \u770b \u751a \u9ebc \uff1f \u8981 \u770b \u5148 \u77e5 \u9ebc \uff1f \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u662f \u7684 \uff0c \u4ed6 \u6bd4 \u5148 \u77e5 \u5927 \u591a \u4e86 \u3002"}, {"pk": 583205, "verse": 27, "text": "\u7d93 \u4e0a \u8a18 \u8457 \u8aaa \uff1a \u6211 \u8981 \u5dee \u9063 \u6211 \u7684 \u4f7f \u8005 \u5728 \u4f60 \u524d \u9762 \u9810 \u5099 \u9053 \u8def \uff0c \u6240 \u8aaa \u7684 \u5c31 \u662f \u9019 \u500b \u4eba \u3002"}, {"pk": 583206, "verse": 28, "text": "\u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u51e1 \u5a66 \u4eba \u6240 \u751f \u7684 \uff0c \u6c92 \u6709 \u4e00 \u500b \u5927 \u904e \u7d04 \u7ff0 \u7684 \uff1b \u7136 \u800c \u795e \u570b \u88e1 \u6700 \u5c0f \u7684 \u6bd4 \u4ed6 \u9084 \u5927 \u3002"}, {"pk": 583207, "verse": 29, "text": "\u773e \u767e \u59d3 \u548c \u7a05 \u540f \u65e2 \u53d7 \u904e \u7d04 \u7ff0 \u7684 \u6d17 \uff0c \u807d \u898b \u9019 \u8a71 \uff0c \u5c31 \u4ee5 \u795e \u70ba \u7fa9 \uff1b"}, {"pk": 583208, "verse": 30, "text": "\u4f46 \u6cd5 \u5229 \u8cfd \u4eba \u548c \u5f8b \u6cd5 \u5e2b \u6c92 \u6709 \u53d7 \u904e \u7d04 \u7ff0 \u7684 \u6d17 \uff0c \u7adf \u70ba \u81ea \u5df1 \u5ee2 \u68c4 \u4e86 \u795e \u7684 \u65e8 \u610f \u3002 \uff0829 \uff0c30 \u5169 \u7bc0 \u6216 \u4f5c \uff1a \u773e \u767e \u59d3 \u548c \u7a05 \u540f \u807d \u898b \u4e86 \u7d04 \u7ff0 \u7684 \u8a71 \uff0c \u5c31 \u53d7 \u4e86 \u4ed6 \u7684 \u6d17 \uff0c \u4fbf \u4ee5 \u795e \u70ba \u7fa9 \uff1b \u4f46 \u6cd5 \u5229 \u8cfd \u4eba \u548c \u5f8b \u6cd5 \u5e2b \u4e0d \u53d7 \u7d04 \u7ff0 \u7684 \u6d17 \uff0c \u7adf \u70ba \u81ea \u5df1 \u5ee2 \u68c4 \u4e86 \u795e \u7684 \u65e8 \u610f \u3002 \uff09"}, {"pk": 583209, "verse": 31, "text": "\u4e3b \u53c8 \u8aaa \uff1a \u9019 \u6a23 \uff0c \u6211 \u53ef \u7528 \u751a \u9ebc \u6bd4 \u9019 \u4e16 \u4ee3 \u7684 \u4eba \u5462 \uff1f \u4ed6 \u5011 \u597d \u50cf \u751a \u9ebc \u5462 \uff1f"}, {"pk": 583210, "verse": 32, "text": "\u597d \u50cf \u5b69 \u7ae5 \u5750 \u5728 \u8857 \u5e02 \u4e0a \uff0c \u5f7c \u6b64 \u547c \u53eb \u8aaa \uff1a \u6211 \u5011 \u5411 \u4f60 \u5011 \u5439 \u7b1b \uff0c \u4f60 \u5011 \u4e0d \u8df3 \u821e \uff1b \u6211 \u5011 \u5411 \u4f60 \u5011 \u8209 \u54c0 \uff0c \u4f60 \u5011 \u4e0d \u557c \u54ed \u3002"}, {"pk": 583211, "verse": 33, "text": "\u65bd \u6d17 \u7684 \u7d04 \u7ff0 \u4f86 \uff0c \u4e0d \u5403 \u9905 \uff0c \u4e0d \u559d \u9152 \uff0c \u4f60 \u5011 \u8aaa \u4ed6 \u662f \u88ab \u9b3c \u9644 \u8457 \u7684 \u3002"}, {"pk": 583212, "verse": 34, "text": "\u4eba \u5b50 \u4f86 \uff0c \u4e5f \u5403 \u4e5f \u559d \uff0c \u4f60 \u5011 \u8aaa \u4ed6 \u662f \u8caa \u98df \u597d \u9152 \u7684 \u4eba \uff0c \u662f \u7a05 \u540f \u548c \u7f6a \u4eba \u7684 \u670b \u53cb \u3002"}, {"pk": 583213, "verse": 35, "text": "\u4f46 \u667a \u6167 \u4e4b \u5b50 \u90fd \u4ee5 \u667a \u6167 \u70ba \u662f \u3002"}, {"pk": 583214, "verse": 36, "text": "\u6709 \u4e00 \u500b \u6cd5 \u5229 \u8cfd \u4eba \u8acb \u8036 \u7a4c \u548c \u4ed6 \u5403 \u98ef \uff1b \u8036 \u7a4c \u5c31 \u5230 \u6cd5 \u5229 \u8cfd \u4eba \u5bb6 \u88e1 \u53bb \u5750 \u5e2d \u3002"}, {"pk": 583215, "verse": 37, "text": "\u90a3 \u57ce \u88e1 \u6709 \u4e00 \u500b \u5973 \u4eba \uff0c \u662f \u500b \u7f6a \u4eba \uff0c \u77e5 \u9053 \u8036 \u7a4c \u5728 \u6cd5 \u5229 \u8cfd \u4eba \u5bb6 \u88e1 \u5750 \u5e2d \uff0c \u5c31 \u62ff \u8457 \u76db \u9999 \u818f \u7684 \u7389 \u74f6 \uff0c"}, {"pk": 583216, "verse": 38, "text": "\u7ad9 \u5728 \u8036 \u7a4c \u80cc \u5f8c \uff0c \u6328 \u8457 \u4ed6 \u7684 \u8173 \u54ed \uff0c \u773c \u6dda \u6ebc \u4e86 \u8036 \u7a4c \u7684 \u8173 \uff0c \u5c31 \u7528 \u81ea \u5df1 \u7684 \u982d \u9aee \u64e6 \u4e7e \uff0c \u53c8 \u7528 \u5634 \u9023 \u9023 \u89aa \u4ed6 \u7684 \u8173 \uff0c \u628a \u9999 \u818f \u62b9 \u4e0a \u3002"}, {"pk": 583217, "verse": 39, "text": "\u8acb \u8036 \u7a4c \u7684 \u6cd5 \u5229 \u8cfd \u4eba \u770b \u898b \u9019 \u4e8b \uff0c \u5fc3 \u88e1 \u8aaa \uff1a \u9019 \u4eba \u82e5 \u662f \u5148 \u77e5 \uff0c \u5fc5 \u77e5 \u9053 \u6478 \u4ed6 \u7684 \u662f \u8ab0 \uff0c \u662f \u500b \u600e \u6a23 \u7684 \u5973 \u4eba \uff0c \u4e43 \u662f \u500b \u7f6a \u4eba \u3002"}, {"pk": 583218, "verse": 40, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u897f \u9580 \uff01 \u6211 \u6709 \u53e5 \u8a71 \u8981 \u5c0d \u4f60 \u8aaa \u3002 \u897f \u9580 \u8aaa \uff1a \u592b \u5b50 \uff0c \u8acb \u8aaa \u3002"}, {"pk": 583219, "verse": 41, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4e00 \u500b \u50b5 \u4e3b \u6709 \u5169 \u500b \u4eba \u6b20 \u4ed6 \u7684 \u50b5 \uff1b \u4e00 \u500b \u6b20 \u4e94 \u5341 \u5169 \u9280 \u5b50 \uff0c \u4e00 \u500b \u6b20 \u4e94 \u5169 \u9280 \u5b50 \uff1b"}, {"pk": 583220, "verse": 42, "text": "\u56e0 \u70ba \u4ed6 \u5011 \u7121 \u529b \u511f \u9084 \uff0c \u50b5 \u4e3b \u5c31 \u958b \u6069 \u514d \u4e86 \u4ed6 \u5011 \u5169 \u500b \u4eba \u7684 \u50b5 \u3002 \u9019 \u5169 \u500b \u4eba \u90a3 \u4e00 \u500b \u66f4 \u611b \u4ed6 \u5462 \uff1f"}, {"pk": 583221, "verse": 43, "text": "\u897f \u9580 \u56de \u7b54 \u8aaa \uff1a \u6211 \u60f3 \u662f \u90a3 \u591a \u5f97 \u6069 \u514d \u7684 \u4eba \u3002 \u8036 \u7a4c \u8aaa \uff1a \u4f60 \u65b7 \u7684 \u4e0d \u932f \u3002"}, {"pk": 583222, "verse": 44, "text": "\u65bc \u662f \u8f49 \u904e \u4f86 \u5411 \u8457 \u90a3 \u5973 \u4eba \uff0c \u4fbf \u5c0d \u897f \u9580 \u8aaa \uff1a \u4f60 \u770b \u898b \u9019 \u5973 \u4eba \u9ebc \uff1f \u6211 \u9032 \u4e86 \u4f60 \u7684 \u5bb6 \uff0c \u4f60 \u6c92 \u6709 \u7d66 \u6211 \u6c34 \u6d17 \u8173 \uff1b \u4f46 \u9019 \u5973 \u4eba \u7528 \u773c \u6dda \u6ebc \u4e86 \u6211 \u7684 \u8173 \uff0c \u7528 \u982d \u9aee \u64e6 \u4e7e \u3002"}, {"pk": 583223, "verse": 45, "text": "\u4f60 \u6c92 \u6709 \u8207 \u6211 \u89aa \u5634 \uff1b \u4f46 \u9019 \u5973 \u4eba \u5f9e \u6211 \u9032 \u4f86 \u7684 \u6642 \u5019 \u5c31 \u4e0d \u4f4f \u7684 \u7528 \u5634 \u89aa \u6211 \u7684 \u8173 \u3002"}, {"pk": 583224, "verse": 46, "text": "\u4f60 \u6c92 \u6709 \u7528 \u6cb9 \u62b9 \u6211 \u7684 \u982d \uff1b \u4f46 \u9019 \u5973 \u4eba \u7528 \u9999 \u818f \u62b9 \u6211 \u7684 \u8173 \u3002"}, {"pk": 583225, "verse": 47, "text": "\u6240 \u4ee5 \u6211 \u544a \u8a34 \u4f60 \uff0c \u4ed6 \u8a31 \u591a \u7684 \u7f6a \u90fd \u8d66 \u514d \u4e86 \uff0c \u56e0 \u70ba \u4ed6 \u7684 \u611b \u591a \uff1b \u4f46 \u90a3 \u8d66 \u514d \u5c11 \u7684 \uff0c \u4ed6 \u7684 \u611b \u5c31 \u5c11 \u3002"}, {"pk": 583226, "verse": 48, "text": "\u65bc \u662f \u5c0d \u90a3 \u5973 \u4eba \u8aaa \uff1a \u4f60 \u7684 \u7f6a \u8d66 \u514d \u4e86 \u3002"}, {"pk": 583227, "verse": 49, "text": "\u540c \u5e2d \u7684 \u4eba \u5fc3 \u88e1 \u8aaa \uff1a \u9019 \u662f \u751a \u9ebc \u4eba \uff0c \u7adf \u8d66 \u514d \u4eba \u7684 \u7f6a \u5462 \uff1f"}, {"pk": 583228, "verse": 50, "text": "\u8036 \u7a4c \u5c0d \u90a3 \u5973 \u4eba \u8aaa \uff1a \u4f60 \u7684 \u4fe1 \u6551 \u4e86 \u4f60 \uff1b \u5e73 \u5e73 \u5b89 \u5b89 \u7684 \u56de \u53bb \u7f77 \uff01"}]