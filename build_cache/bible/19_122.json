[{"pk": 574073, "verse": 1, "text": "\uff08 \u5927 \u885b \u4e0a \u884c \u4e4b \u8a69 \u3002 \uff09 \u4eba \u5c0d \u6211 \u8aaa \uff1a \u6211 \u5011 \u5f80 \u8036 \u548c \u83ef \u7684 \u6bbf \u53bb \uff0c \u6211 \u5c31 \u6b61 \u559c \u3002"}, {"pk": 574074, "verse": 2, "text": "\u8036 \u8def \u6492 \u51b7 \u554a \uff0c \u6211 \u5011 \u7684 \u8173 \u7ad9 \u5728 \u4f60 \u7684 \u9580 \u5167 \u3002"}, {"pk": 574075, "verse": 3, "text": "\u8036 \u8def \u6492 \u51b7 \u88ab \u5efa \u9020 \uff0c \u5982 \u540c \u9023 \u7d61 \u6574 \u9f4a \u7684 \u4e00 \u5ea7 \u57ce \u3002"}, {"pk": 574076, "verse": 4, "text": "\u773e \u652f \u6d3e \uff0c \u5c31 \u662f \u8036 \u548c \u83ef \u7684 \u652f \u6d3e \uff0c \u4e0a \u90a3 \u88e1 \u53bb \uff0c \u6309 \u4ee5 \u8272 \u5217 \u7684 \u5e38 \u4f8b \uff08 \u6216 \u8b6f \uff1a \u4f5c \u4ee5 \u8272 \u5217 \u7684 \u8b49 \u64da \uff09 \u7a31 \u8b9a \u8036 \u548c \u83ef \u7684 \u540d \u3002"}, {"pk": 574077, "verse": 5, "text": "\u56e0 \u70ba \u5728 \u90a3 \u88e1 \u8a2d \u7acb \u5be9 \u5224 \u7684 \u5bf6 \u5ea7 \uff0c \u5c31 \u662f \u5927 \u885b \u5bb6 \u7684 \u5bf6 \u5ea7 \u3002"}, {"pk": 574078, "verse": 6, "text": "\u4f60 \u5011 \u8981 \u70ba \u8036 \u8def \u6492 \u51b7 \u6c42 \u5e73 \u5b89 \uff01 \u8036 \u8def \u6492 \u51b7 \u554a \uff0c \u611b \u4f60 \u7684 \u4eba \u5fc5 \u7136 \u8208 \u65fa \uff01"}, {"pk": 574079, "verse": 7, "text": "\u9858 \u4f60 \u57ce \u4e2d \u5e73 \u5b89 \uff01 \u9858 \u4f60 \u5bae \u5167 \u8208 \u65fa \uff01"}, {"pk": 574080, "verse": 8, "text": "\u56e0 \u6211 \u5f1f \u5144 \u548c \u540c \u4f34 \u7684 \u7de3 \u6545 \uff0c \u6211 \u8981 \u8aaa \uff1a \u9858 \u5e73 \u5b89 \u5728 \u4f60 \u4e2d \u9593 \uff01"}, {"pk": 574081, "verse": 9, "text": "\u56e0 \u8036 \u548c \u83ef \u2500 \u6211 \u5011 \u3000 \u795e \u6bbf \u7684 \u7de3 \u6545 \uff0c \u6211 \u8981 \u70ba \u4f60 \u6c42 \u798f \uff01"}]