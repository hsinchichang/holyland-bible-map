[{"pk": 560035, "verse": 1, "text": "\u795e \u5429 \u5490 \u9019 \u4e00 \u5207 \u7684 \u8a71 \u8aaa \uff1a"}, {"pk": 560036, "verse": 2, "text": "\u6211 \u662f \u8036 \u548c \u83ef \u2500 \u4f60 \u7684 \u3000 \u795e \uff0c \u66fe \u5c07 \u4f60 \u5f9e \u57c3 \u53ca \u5730 \u70ba \u5974 \u4e4b \u5bb6 \u9818 \u51fa \u4f86 \u3002"}, {"pk": 560037, "verse": 3, "text": "\u9664 \u4e86 \u6211 \u4ee5 \u5916 \uff0c \u4f60 \u4e0d \u53ef \u6709 \u5225 \u7684 \u795e \u3002"}, {"pk": 560038, "verse": 4, "text": "\u4e0d \u53ef \u70ba \u81ea \u5df1 \u96d5 \u523b \u5076 \u50cf \uff0c \u4e5f \u4e0d \u53ef \u505a \u751a \u9ebc \u5f62 \u50cf \u5f77 \u5f7f \u4e0a \u5929 \u3001 \u4e0b \u5730 \uff0c \u548c \u5730 \u5e95 \u4e0b \u3001 \u6c34 \u4e2d \u7684 \u767e \u7269 \u3002"}, {"pk": 560039, "verse": 5, "text": "\u4e0d \u53ef \u8dea \u62dc \u90a3 \u4e9b \u50cf \uff0c \u4e5f \u4e0d \u53ef \u4e8b \u5949 \u4ed6 \uff0c \u56e0 \u70ba \u6211 \u8036 \u548c \u83ef \u2500 \u4f60 \u7684 \u3000 \u795e \u662f \u5fcc \u90aa \u7684 \u3000 \u795e \u3002 \u6068 \u6211 \u7684 \uff0c \u6211 \u5fc5 \u8ffd \u8a0e \u4ed6 \u7684 \u7f6a \uff0c \u81ea \u7236 \u53ca \u5b50 \uff0c \u76f4 \u5230 \u4e09 \u56db \u4ee3 \uff1b"}, {"pk": 560040, "verse": 6, "text": "\u611b \u6211 \u3001 \u5b88 \u6211 \u8aa1 \u547d \u7684 \uff0c \u6211 \u5fc5 \u5411 \u4ed6 \u5011 \u767c \u6148 \u611b \uff0c \u76f4 \u5230 \u5343 \u4ee3 \u3002"}, {"pk": 560041, "verse": 7, "text": "\u4e0d \u53ef \u5984 \u7a31 \u8036 \u548c \u83ef \u2500 \u4f60 \u795e \u7684 \u540d \uff1b \u56e0 \u70ba \u5984 \u7a31 \u8036 \u548c \u83ef \u540d \u7684 \uff0c \u8036 \u548c \u83ef \u5fc5 \u4e0d \u4ee5 \u4ed6 \u70ba \u7121 \u7f6a \u3002"}, {"pk": 560042, "verse": 8, "text": "\u7576 \u8a18 \u5ff5 \u5b89 \u606f \u65e5 \uff0c \u5b88 \u70ba \u8056 \u65e5 \u3002"}, {"pk": 560043, "verse": 9, "text": "\u516d \u65e5 \u8981 \u52de \u788c \u505a \u4f60 \u4e00 \u5207 \u7684 \u5de5 \uff0c"}, {"pk": 560044, "verse": 10, "text": "\u4f46 \u7b2c \u4e03 \u65e5 \u662f \u5411 \u8036 \u548c \u83ef \u2500 \u4f60 \u3000 \u795e \u7576 \u5b88 \u7684 \u5b89 \u606f \u65e5 \u3002 \u9019 \u4e00 \u65e5 \u4f60 \u548c \u4f60 \u7684 \u5152 \u5973 \u3001 \u50d5 \u5a62 \u3001 \u7272 \u755c \uff0c \u4e26 \u4f60 \u57ce \u88e1 \u5bc4 \u5c45 \u7684 \u5ba2 \u65c5 \uff0c \u7121 \u8ad6 \u4f55 \u5de5 \u90fd \u4e0d \u53ef \u505a \uff1b"}, {"pk": 560045, "verse": 11, "text": "\u56e0 \u70ba \u516d \u65e5 \u4e4b \u5167 \uff0c \u8036 \u548c \u83ef \u9020 \u5929 \u3001 \u5730 \u3001 \u6d77 \uff0c \u548c \u5176 \u4e2d \u7684 \u842c \u7269 \uff0c \u7b2c \u4e03 \u65e5 \u4fbf \u5b89 \u606f \uff0c \u6240 \u4ee5 \u8036 \u548c \u83ef \u8cdc \u798f \u8207 \u5b89 \u606f \u65e5 \uff0c \u5b9a \u70ba \u8056 \u65e5 \u3002"}, {"pk": 560046, "verse": 12, "text": "\u7576 \u5b5d \u656c \u7236 \u6bcd \uff0c \u4f7f \u4f60 \u7684 \u65e5 \u5b50 \u5728 \u8036 \u548c \u83ef \u2500 \u4f60 \u3000 \u795e \u6240 \u8cdc \u4f60 \u7684 \u5730 \u4e0a \u5f97 \u4ee5 \u9577 \u4e45 \u3002"}, {"pk": 560047, "verse": 13, "text": "\u4e0d \u53ef \u6bba \u4eba \u3002"}, {"pk": 560048, "verse": 14, "text": "\u4e0d \u53ef  \u59e6 \u6deb \u3002"}, {"pk": 560049, "verse": 15, "text": "\u4e0d \u53ef \u5077 \u76dc \u3002"}, {"pk": 560050, "verse": 16, "text": "\u4e0d \u53ef \u4f5c \u5047 \u898b \u8b49 \u9677 \u5bb3 \u4eba \u3002"}, {"pk": 560051, "verse": 17, "text": "\u4e0d \u53ef \u8caa \u6200 \u4eba \u7684 \u623f \u5c4b \uff1b \u4e5f \u4e0d \u53ef \u8caa \u6200 \u4eba \u7684 \u59bb \u5b50 \u3001 \u50d5 \u5a62 \u3001 \u725b \u9a62 \uff0c \u4e26 \u4ed6 \u4e00 \u5207 \u6240 \u6709 \u7684 \u3002"}, {"pk": 560052, "verse": 18, "text": "\u773e \u767e \u59d3 \u898b \u96f7 \u8f5f \u3001 \u9583 \u96fb \u3001 \u89d2 \u8072 \u3001 \u5c71 \u4e0a \u5192 \u7159 \uff0c \u5c31 \u90fd \u767c \u986b \uff0c \u9060 \u9060 \u7684 \u7ad9 \u7acb \uff0c"}, {"pk": 560053, "verse": 19, "text": "\u5c0d \u6469 \u897f \u8aaa \uff1a \u6c42 \u4f60 \u548c \u6211 \u5011 \u8aaa \u8a71 \uff0c \u6211 \u5011 \u5fc5 \u807d \uff1b \u4e0d \u8981 \u3000 \u795e \u548c \u6211 \u5011 \u8aaa \u8a71 \uff0c \u6050 \u6015 \u6211 \u5011 \u6b7b \u4ea1 \u3002"}, {"pk": 560054, "verse": 20, "text": "\u6469 \u897f \u5c0d \u767e \u59d3 \u8aaa \uff1a \u4e0d \u8981 \u61fc \u6015 \uff1b \u56e0 \u70ba \u3000 \u795e \u964d \u81e8 \u662f \u8981 \u8a66 \u9a57 \u4f60 \u5011 \uff0c \u53eb \u4f60 \u5011 \u6642 \u5e38 \u656c \u754f \u4ed6 \uff0c \u4e0d \u81f4 \u72af \u7f6a \u3002"}, {"pk": 560055, "verse": 21, "text": "\u65bc \u662f \u767e \u59d3 \u9060 \u9060 \u5730 \u7ad9 \u7acb \uff1b \u6469 \u897f \u5c31 \u6328 \u8fd1 \u3000 \u795e \u6240 \u5728 \u7684 \u5e7d \u6697 \u4e4b \u4e2d \u3002"}, {"pk": 560056, "verse": 22, "text": "\u8036 \u548c \u83ef \u5c0d \u6469 \u897f \u8aaa \uff1a \u4f60 \u8981 \u5411 \u4ee5 \u8272 \u5217 \u4eba \u9019 \u6a23 \u8aaa \uff1a \u4f60 \u5011 \u81ea \u5df1 \u770b \u898b \u6211 \u5f9e \u5929 \u4e0a \u548c \u4f60 \u5011 \u8aaa \u8a71 \u4e86 \u3002"}, {"pk": 560057, "verse": 23, "text": "\u4f60 \u5011 \u4e0d \u53ef \u505a \u751a \u9ebc \u3000 \u795e \u50cf \u8207 \u6211 \u76f8 \u914d \uff0c \u4e0d \u53ef \u70ba \u81ea \u5df1 \u505a \u91d1 \u9280 \u7684 \u3000 \u795e \u50cf \u3002"}, {"pk": 560058, "verse": 24, "text": "\u4f60 \u8981 \u70ba \u6211 \u7bc9 \u571f \u58c7 \uff0c \u5728 \u4e0a \u9762 \u4ee5 \u725b \u7f8a \u737b \u70ba \u71d4 \u796d \u548c \u5e73 \u5b89 \u796d \u3002 \u51e1 \u8a18 \u4e0b \u6211 \u540d \u7684 \u5730 \u65b9 \uff0c \u6211 \u5fc5 \u5230 \u90a3 \u88e1 \u8cdc \u798f \u7d66 \u4f60 \u3002"}, {"pk": 560059, "verse": 25, "text": "\u4f60 \u82e5 \u70ba \u6211 \u7bc9 \u4e00 \u5ea7 \u77f3 \u58c7 \uff0c \u4e0d \u53ef \u7528 \u947f \u6210 \u7684 \u77f3 \u982d \uff0c \u56e0 \u4f60 \u5728 \u4e0a \u982d \u4e00 \u52d5 \u5bb6 \u5177 \uff0c \u5c31 \u628a \u58c7 \u6c61 \u7a62 \u4e86 \u3002"}, {"pk": 560060, "verse": 26, "text": "\u4f60 \u4e0a \u6211 \u7684 \u58c7 \uff0c \u4e0d \u53ef \u7528 \u81fa \u968e \uff0c \u514d \u5f97 \u9732 \u51fa \u4f60 \u7684 \u4e0b \u9ad4 \u4f86 \u3002"}]