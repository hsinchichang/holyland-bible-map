[{"pk": 581153, "verse": 1, "text": "\u7576 \u5e0c \u5f8b \u738b \u7684 \u6642 \u5019 \uff0c \u8036 \u7a4c \u751f \u5728 \u7336 \u592a \u7684 \u4f2f \u5229 \u6046 \u3002 \u6709 \u5e7e \u500b \u535a \u58eb \u5f9e \u6771 \u65b9 \u4f86 \u5230 \u8036 \u8def \u6492 \u51b7 \uff0c \u8aaa \uff1a"}, {"pk": 581154, "verse": 2, "text": "\u90a3 \u751f \u4e0b \u4f86 \u4f5c \u7336 \u592a \u4eba \u4e4b \u738b \u7684 \u5728 \u90a3 \u88e1 \uff1f \u6211 \u5011 \u5728 \u6771 \u65b9 \u770b \u898b \u4ed6 \u7684 \u661f \uff0c \u7279 \u4f86 \u62dc \u4ed6 \u3002"}, {"pk": 581155, "verse": 3, "text": "\u5e0c \u5f8b \u738b \u807d \u898b \u4e86 \uff0c \u5c31 \u5fc3 \u88e1 \u4e0d \u5b89 \uff1b \u8036 \u8def \u6492 \u51b7 \u5408 \u57ce \u7684 \u4eba \u4e5f \u90fd \u4e0d \u5b89 \u3002"}, {"pk": 581156, "verse": 4, "text": "\u4ed6 \u5c31 \u53ec \u9f4a \u4e86 \u796d \u53f8 \u9577 \u548c \u6c11 \u9593 \u7684 \u6587 \u58eb \uff0c \u554f \u4ed6 \u5011 \u8aaa \uff1a \u57fa \u7763 \u7576 \u751f \u5728 \u4f55 \u8655 \uff1f"}, {"pk": 581157, "verse": 5, "text": "\u4ed6 \u5011 \u56de \u7b54 \u8aaa \uff1a \u5728 \u7336 \u592a \u7684 \u4f2f \u5229 \u6046 \u3002 \u56e0 \u70ba \u6709 \u5148 \u77e5 \u8a18 \u8457 \uff0c \u8aaa \uff1a"}, {"pk": 581158, "verse": 6, "text": "\u7336 \u5927 \u5730 \u7684 \u4f2f \u5229 \u6046 \u963f \uff0c \u4f60 \u5728 \u7336 \u5927 \u8af8 \u57ce \u4e2d \u4e26 \u4e0d \u662f \u6700 \u5c0f \u7684 \uff1b \u56e0 \u70ba \u5c07 \u4f86 \u6709 \u4e00 \u4f4d \u541b \u738b \u8981 \u5f9e \u4f60 \u90a3 \u88e1 \u51fa \u4f86 \uff0c \u7267 \u990a \u6211 \u4ee5 \u8272 \u5217 \u6c11 \u3002"}, {"pk": 581159, "verse": 7, "text": "\u7576 \u4e0b \uff0c \u5e0c \u5f8b \u6697 \u6697 \u7684 \u53ec \u4e86 \u535a \u58eb \u4f86 \uff0c \u7d30 \u554f \u90a3 \u661f \u662f \u751a \u9ebc \u6642 \u5019 \u51fa \u73fe \u7684 \uff0c"}, {"pk": 581160, "verse": 8, "text": "\u5c31 \u5dee \u4ed6 \u5011 \u5f80 \u4f2f \u5229 \u6046 \u53bb \uff0c \u8aaa \uff1a \u4f60 \u5011 \u53bb \u4ed4 \u7d30 \u5c0b \u8a2a \u90a3 \u5c0f \u5b69 \u5b50 \uff0c \u5c0b \u5230 \u4e86 \uff0c \u5c31 \u4f86 \u5831 \u4fe1 \uff0c \u6211 \u4e5f \u597d \u53bb \u62dc \u4ed6 \u3002"}, {"pk": 581161, "verse": 9, "text": "\u4ed6 \u5011 \u807d \u898b \u738b \u7684 \u8a71 \u5c31 \u53bb \u4e86 \u3002 \u5728 \u6771 \u65b9 \u6240 \u770b \u898b \u7684 \u90a3 \u661f \u5ffd \u7136 \u5728 \u4ed6 \u5011 \u524d \u982d \u884c \uff0c \u76f4 \u884c \u5230 \u5c0f \u5b69 \u5b50 \u7684 \u5730 \u65b9 \uff0c \u5c31 \u5728 \u4e0a \u982d \u505c \u4f4f \u4e86 \u3002"}, {"pk": 581162, "verse": 10, "text": "\u4ed6 \u5011 \u770b \u898b \u90a3 \u661f \uff0c \u5c31 \u5927 \u5927 \u7684 \u6b61 \u559c \uff1b"}, {"pk": 581163, "verse": 11, "text": "\u9032 \u4e86 \u623f \u5b50 \uff0c \u770b \u898b \u5c0f \u5b69 \u5b50 \u548c \u4ed6 \u6bcd \u89aa \u99ac \u5229 \u4e9e \uff0c \u5c31 \u4fef \u4f0f \u62dc \u90a3 \u5c0f \u5b69 \u5b50 \uff0c \u63ed \u958b \u5bf6 \u76d2 \uff0c \u62ff \u9ec3 \u91d1 \u3001 \u4e73 \u9999 \u3001 \u6c92 \u85e5 \u70ba \u79ae \u7269 \u737b \u7d66 \u4ed6 \u3002"}, {"pk": 581164, "verse": 12, "text": "\u535a \u58eb \u56e0 \u70ba \u5728 \u5922 \u4e2d \u88ab \u4e3b \u6307 \u793a \u4e0d \u8981 \u56de \u53bb \u898b \u5e0c \u5f8b \uff0c \u5c31 \u5f9e \u5225 \u7684 \u8def \u56de \u672c \u5730 \u53bb \u4e86 \u3002"}, {"pk": 581165, "verse": 13, "text": "\u4ed6 \u5011 \u53bb \u5f8c \uff0c \u6709 \u4e3b \u7684 \u4f7f \u8005 \u5411 \u7d04 \u745f \u5922 \u4e2d \u986f \u73fe \uff0c \u8aaa \uff1a \u8d77 \u4f86 \uff01 \u5e36 \u8457 \u5c0f \u5b69 \u5b50 \u540c \u4ed6 \u6bcd \u89aa \u9003 \u5f80 \u57c3 \u53ca \uff0c \u4f4f \u5728 \u90a3 \u88e1 \uff0c \u7b49 \u6211 \u5429 \u5490 \u4f60 \uff1b \u56e0 \u70ba \u5e0c \u5f8b \u5fc5 \u5c0b \u627e \u5c0f \u5b69 \u5b50 \uff0c \u8981 \u9664 \u6ec5 \u4ed6 \u3002"}, {"pk": 581166, "verse": 14, "text": "\u7d04 \u745f \u5c31 \u8d77 \u4f86 \uff0c \u591c \u9593 \u5e36 \u8457 \u5c0f \u5b69 \u5b50 \u548c \u4ed6 \u6bcd \u89aa \u5f80 \u57c3 \u53ca \u53bb \uff0c"}, {"pk": 581167, "verse": 15, "text": "\u4f4f \u5728 \u90a3 \u88e1 \uff0c \u76f4 \u5230 \u5e0c \u5f8b \u6b7b \u4e86 \u3002 \u9019 \u662f \u8981 \u61c9 \u9a57 \u4e3b \u85c9 \u5148 \u77e5 \u6240 \u8aaa \u7684 \u8a71 \uff0c \u8aaa \uff1a \u6211 \u5f9e \u57c3 \u53ca \u53ec \u51fa \u6211 \u7684 \u5152 \u5b50 \u4f86 \u3002"}, {"pk": 581168, "verse": 16, "text": "\u5e0c \u5f8b \u898b \u81ea \u5df1 \u88ab \u535a \u58eb \u611a \u5f04 \uff0c \u5c31 \u5927 \u5927 \u767c \u6012 \uff0c \u5dee \u4eba \u5c07 \u4f2f \u5229 \u6046 \u57ce \u88e1 \u4e26 \u56db \u5883 \u6240 \u6709 \u7684 \u7537 \u5b69 \uff0c \u7167 \u8457 \u4ed6 \u5411 \u535a \u58eb \u4ed4 \u7d30 \u67e5 \u554f \u7684 \u6642 \u5019 \uff0c \u51e1 \u5169 \u6b72 \u4ee5 \u88e1 \u7684 \uff0c \u90fd \u6bba \u76e1 \u4e86 \u3002"}, {"pk": 581169, "verse": 17, "text": "\u9019 \u5c31 \u61c9 \u4e86 \u5148 \u77e5 \u8036 \u5229 \u7c73 \u7684 \u8a71 \uff0c \u8aaa \uff1a"}, {"pk": 581170, "verse": 18, "text": "\u5728 \u62c9 \u746a \u807d \u898b \u865f \u54b7 \u5927 \u54ed \u7684 \u8072 \u97f3 \uff0c \u662f \u62c9 \u7d50 \u54ed \u4ed6 \u5152 \u5973 \uff0c \u4e0d \u80af \u53d7 \u5b89 \u6170 \uff0c \u56e0 \u70ba \u4ed6 \u5011 \u90fd \u4e0d \u5728 \u4e86 \u3002"}, {"pk": 581171, "verse": 19, "text": "\u5e0c \u5f8b \u6b7b \u4e86 \u4ee5 \u5f8c \uff0c \u6709 \u4e3b \u7684 \u4f7f \u8005 \u5728 \u57c3 \u53ca \u5411 \u7d04 \u745f \u5922 \u4e2d \u986f \u73fe \uff0c \u8aaa \uff1a"}, {"pk": 581172, "verse": 20, "text": "\u8d77 \u4f86 \uff01 \u5e36 \u8457 \u5c0f \u5b69 \u5b50 \u548c \u4ed6 \u6bcd \u89aa \u5f80 \u4ee5 \u8272 \u5217 \u5730 \u53bb \uff0c \u56e0 \u70ba \u8981 \u5bb3 \u5c0f \u5b69 \u5b50 \u6027 \u547d \u7684 \u4eba \u5df2 \u7d93 \u6b7b \u4e86 \u3002"}, {"pk": 581173, "verse": 21, "text": "\u7d04 \u745f \u5c31 \u8d77 \u4f86 \uff0c \u628a \u5c0f \u5b69 \u5b50 \u548c \u4ed6 \u6bcd \u89aa \u5e36 \u5230 \u4ee5 \u8272 \u5217 \u5730 \u53bb \uff1b"}, {"pk": 581174, "verse": 22, "text": "\u53ea \u56e0 \u807d \u898b \u4e9e \u57fa \u8001 \u63a5 \u8457 \u4ed6 \u7236 \u89aa \u5e0c \u5f8b \u4f5c \u4e86 \u7336 \u592a \u738b \uff0c \u5c31 \u6015 \u5f80 \u90a3 \u88e1 \u53bb \uff0c \u53c8 \u5728 \u5922 \u4e2d \u88ab \u4e3b \u6307 \u793a \uff0c \u4fbf \u5f80 \u52a0 \u5229 \u5229 \u5883 \u5167 \u53bb \u4e86 \uff0c"}, {"pk": 581175, "verse": 23, "text": "\u5230 \u4e86 \u4e00 \u5ea7 \u57ce \uff0c \u540d \u53eb \u62ff \u6492 \u52d2 \uff0c \u5c31 \u4f4f \u5728 \u90a3 \u88e1 \u3002 \u9019 \u662f \u8981 \u61c9 \u9a57 \u5148 \u77e5 \u6240 \u8aaa \uff0c \u4ed6 \u5c07 \u7a31 \u70ba \u62ff \u6492 \u52d2 \u4eba \u7684 \u8a71 \u4e86 \u3002"}]