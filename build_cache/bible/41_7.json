[{"pk": 582447, "verse": 1, "text": "\u6709 \u6cd5 \u5229 \u8cfd \u4eba \u548c \u5e7e \u500b \u6587 \u58eb \u5f9e \u8036 \u8def \u6492 \u51b7 \u4f86 \uff0c \u5230 \u8036 \u7a4c \u90a3 \u88e1 \u805a \u96c6 \u3002"}, {"pk": 582448, "verse": 2, "text": "\u4ed6 \u5011 \u66fe \u770b \u898b \u4ed6 \u7684 \u9580 \u5f92 \u4e2d \u6709 \u4eba \u7528 \u4fd7 \u624b \uff0c \u5c31 \u662f \u6c92 \u6709 \u6d17 \u7684 \u624b \uff0c \u5403 \u98ef \u3002"}, {"pk": 582449, "verse": 3, "text": "\uff08 \u539f \u4f86 \u6cd5 \u5229 \u8cfd \u4eba \u548c \u7336 \u592a \u4eba \u90fd \u62d8 \u5b88 \u53e4 \u4eba \u7684 \u907a \u50b3 \uff0c \u82e5 \u4e0d \u4ed4 \u7d30 \u6d17 \u624b \u5c31 \u4e0d \u5403 \u98ef \uff1b"}, {"pk": 582450, "verse": 4, "text": "\u5f9e \u5e02 \u4e0a \u4f86 \uff0c \u82e5 \u4e0d \u6d17 \u6d74 \u4e5f \u4e0d \u5403 \u98ef \uff1b \u9084 \u6709 \u597d \u4e9b \u5225 \u7684 \u898f \u77e9 \uff0c \u4ed6 \u5011 \u6b77 \u4ee3 \u62d8 \u5b88 \uff0c \u5c31 \u662f \u6d17 \u676f \u3001 \u7f50 \u3001 \u9285 \u5668 \u7b49 \u7269 \u3002 \uff09"}, {"pk": 582451, "verse": 5, "text": "\u6cd5 \u5229 \u8cfd \u4eba \u548c \u6587 \u58eb \u554f \u4ed6 \u8aaa \uff1a \u4f60 \u7684 \u9580 \u5f92 \u70ba \u751a \u9ebc \u4e0d \u7167 \u53e4 \u4eba \u7684 \u907a \u50b3 \uff0c \u7528 \u4fd7 \u624b \u5403 \u98ef \u5462 \uff1f"}, {"pk": 582452, "verse": 6, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4ee5 \u8cfd \u4e9e \u6307 \u8457 \u4f60 \u5011 \u5047 \u5192 \u70ba \u5584 \u4e4b \u4eba \u6240 \u8aaa \u7684 \u9810 \u8a00 \u662f \u4e0d \u932f \u7684 \u3002 \u5982 \u7d93 \u4e0a \u8aaa \uff1a \u9019 \u767e \u59d3 \u7528 \u5634 \u5507 \u5c0a \u656c \u6211 \uff0c \u5fc3 \u537b \u9060 \u96e2 \u6211 \u3002"}, {"pk": 582453, "verse": 7, "text": "\u4ed6 \u5011 \u5c07 \u4eba \u7684 \u5429 \u5490 \u7576 \u4f5c \u9053 \u7406 \u6559 \u5c0e \u4eba \uff0c \u6240 \u4ee5 \u62dc \u6211 \u4e5f \u662f \u6789 \u7136 \u3002"}, {"pk": 582454, "verse": 8, "text": "\u4f60 \u5011 \u662f \u96e2 \u68c4 \u795e \u7684 \u8aa1 \u547d \uff0c \u62d8 \u5b88 \u4eba \u7684 \u907a \u50b3 \uff1b"}, {"pk": 582455, "verse": 9, "text": "\u53c8 \u8aaa \uff1a \u4f60 \u5011 \u8aa0 \u7136 \u662f \u5ee2 \u68c4 \u795e \u7684 \u8aa1 \u547d \uff0c \u8981 \u5b88 \u81ea \u5df1 \u7684 \u907a \u50b3 \u3002"}, {"pk": 582456, "verse": 10, "text": "\u6469 \u897f \u8aaa \uff1a \u7576 \u5b5d \u656c \u7236 \u6bcd \uff1b \u53c8 \u8aaa \uff1a \u5492 \u7f75 \u7236 \u6bcd \u7684 \uff0c \u5fc5 \u6cbb \u6b7b \u4ed6 \u3002"}, {"pk": 582457, "verse": 11, "text": "\u4f60 \u5011 \u5012 \u8aaa \uff1a \u4eba \u82e5 \u5c0d \u7236 \u6bcd \u8aaa \uff1a \u6211 \u6240 \u7576 \u5949 \u7d66 \u4f60 \u7684 \uff0c \u5df2 \u7d93 \u4f5c \u4e86 \u5404 \u8033 \u677f \uff08 \u5404 \u8033 \u677f \u5c31 \u662f \u4f9b \u737b \u7684 \u610f \u601d \uff09 \uff0c"}, {"pk": 582458, "verse": 12, "text": "\u4ee5 \u5f8c \u4f60 \u5011 \u5c31 \u4e0d \u5bb9 \u4ed6 \u518d \u5949 \u990a \u7236 \u6bcd \u3002"}, {"pk": 582459, "verse": 13, "text": "\u9019 \u5c31 \u662f \u4f60 \u5011 \u627f \u63a5 \u907a \u50b3 \uff0c \u5ee2 \u4e86 \u795e \u7684 \u9053 \u3002 \u4f60 \u5011 \u9084 \u505a \u8a31 \u591a \u9019 \u6a23 \u7684 \u4e8b \u3002"}, {"pk": 582460, "verse": 14, "text": "\u8036 \u7a4c \u53c8 \u53eb \u773e \u4eba \u4f86 \uff0c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u90fd \u8981 \u807d \u6211 \u7684 \u8a71 \uff0c \u4e5f \u8981 \u660e \u767d \u3002"}, {"pk": 582461, "verse": 15, "text": "\u5f9e \u5916 \u9762 \u9032 \u53bb \u7684 \u4e0d \u80fd \u6c61 \u7a62 \u4eba \uff0c \u60df \u6709 \u5f9e \u88e1 \u9762 \u51fa \u4f86 \u7684 \u4e43 \u80fd \u6c61 \u7a62 \u4eba \u3002 \uff08 \u6709 \u53e4 \u5377 \u5728 \u6b64 \u6709 \uff1a"}, {"pk": 582462, "verse": 16, "text": "\u6709 \u8033 \u53ef \u807d \u7684 \uff0c \u5c31 \u61c9 \u7576 \u807d \uff01 \uff09"}, {"pk": 582463, "verse": 17, "text": "\u8036 \u7a4c \u96e2 \u958b \u773e \u4eba \uff0c \u9032 \u4e86 \u5c4b \u5b50 \uff0c \u9580 \u5f92 \u5c31 \u554f \u4ed6 \u9019 \u6bd4 \u55bb \u7684 \u610f \u601d \u3002"}, {"pk": 582464, "verse": 18, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u4e5f \u662f \u9019 \u6a23 \u4e0d \u660e \u767d \u9ebc \uff1f \u8c48 \u4e0d \u66c9 \u5f97 \u51e1 \u5f9e \u5916 \u9762 \u9032 \u5165 \u7684 \uff0c \u4e0d \u80fd \u6c61 \u7a62 \u4eba \uff0c"}, {"pk": 582465, "verse": 19, "text": "\u56e0 \u70ba \u4e0d \u662f \u5165 \u4ed6 \u7684 \u5fc3 \uff0c \u4e43 \u662f \u5165 \u4ed6 \u7684 \u809a \u8179 \uff0c \u53c8 \u843d \u5230 \u8305 \u5ec1 \u88e1 \u3002 \u9019 \u662f \u8aaa \uff0c \u5404 \u6a23 \u7684 \u98df \u7269 \u90fd \u662f \u6f54 \u6de8 \u7684 \uff1b"}, {"pk": 582466, "verse": 20, "text": "\u53c8 \u8aaa \uff1a \u5f9e \u4eba \u88e1 \u9762 \u51fa \u4f86 \u7684 \uff0c \u90a3 \u624d \u80fd \u6c61 \u7a62 \u4eba \uff1b"}, {"pk": 582467, "verse": 21, "text": "\u56e0 \u70ba \u5f9e \u88e1 \u9762 \uff0c \u5c31 \u662f \u5f9e \u4eba \u5fc3 \u88e1 \uff0c \u767c \u51fa \u60e1 \u5ff5 \u3001 \u82df \u5408 \u3001"}, {"pk": 582468, "verse": 22, "text": "\u5077 \u76dc \u3001 \u5147 \u6bba \u3001 \u59e6 \u6deb \u3001 \u8caa \u5a6a \u3001 \u90aa \u60e1 \u3001 \u8a6d \u8a50 \u3001 \u6deb \u8569 \u3001 \u5ac9 \u5992 \u3001 \u8b17 \u8b9f \u3001 \u9a55 \u50b2 \u3001 \u72c2 \u5984 \u3002"}, {"pk": 582469, "verse": 23, "text": "\u9019 \u4e00 \u5207 \u7684 \u60e1 \u90fd \u662f \u5f9e \u88e1 \u9762 \u51fa \u4f86 \uff0c \u4e14 \u80fd \u6c61 \u7a62 \u4eba \u3002"}, {"pk": 582470, "verse": 24, "text": "\u8036 \u7a4c \u5f9e \u90a3 \u88e1 \u8d77 \u8eab \uff0c \u5f80 \u63a8 \u7f85 \u3001 \u897f \u9813 \u7684 \u5883 \u5167 \u53bb \uff0c \u9032 \u4e86 \u4e00 \u5bb6 \uff0c \u4e0d \u9858 \u610f \u4eba \u77e5 \u9053 \uff0c \u537b \u96b1 \u85cf \u4e0d \u4f4f \u3002"}, {"pk": 582471, "verse": 25, "text": "\u7576 \u4e0b \uff0c \u6709 \u4e00 \u500b \u5a66 \u4eba \uff0c \u4ed6 \u7684 \u5c0f \u5973 \u5152 \u88ab \u6c61 \u9b3c \u9644 \u8457 \uff0c \u807d \u898b \u8036 \u7a4c \u7684 \u4e8b \uff0c \u5c31 \u4f86 \u4fef \u4f0f \u5728 \u4ed6 \u8173 \u524d \u3002"}, {"pk": 582472, "verse": 26, "text": "\u9019 \u5a66 \u4eba \u662f \u5e0c \u5229 \u5c3c \u4eba \uff0c \u5c6c \u6558 \u5229 \u8153 \u5c3c \u57fa \u65cf \u3002 \u4ed6 \u6c42 \u8036 \u7a4c \u8d95 \u51fa \u90a3 \u9b3c \u96e2 \u958b \u4ed6 \u7684 \u5973 \u5152 \u3002"}, {"pk": 582473, "verse": 27, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u8b93 \u5152 \u5973 \u5011 \u5148 \u5403 \u98fd \uff0c \u4e0d \u597d \u62ff \u5152 \u5973 \u7684 \u9905 \u4e1f \u7d66 \u72d7 \u5403 \u3002"}, {"pk": 582474, "verse": 28, "text": "\u5a66 \u4eba \u56de \u7b54 \u8aaa \uff1a \u4e3b \u963f \uff0c \u4e0d \u932f \uff1b \u4f46 \u662f \u72d7 \u5728 \u684c \u5b50 \u5e95 \u4e0b \u4e5f \u5403 \u5b69 \u5b50 \u5011 \u7684 \u788e \u6e23 \u5152 \u3002"}, {"pk": 582475, "verse": 29, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u56e0 \u9019 \u53e5 \u8a71 \uff0c \u4f60 \u56de \u53bb \u7f77 \uff1b \u9b3c \u5df2 \u7d93 \u96e2 \u958b \u4f60 \u7684 \u5973 \u5152 \u4e86 \u3002"}, {"pk": 582476, "verse": 30, "text": "\u4ed6 \u5c31 \u56de \u5bb6 \u53bb \uff0c \u898b \u5c0f \u5b69 \u5b50 \u8eba \u5728 \u5e8a \u4e0a \uff0c \u9b3c \u5df2 \u7d93 \u51fa \u53bb \u4e86 \u3002"}, {"pk": 582477, "verse": 31, "text": "\u8036 \u7a4c \u53c8 \u96e2 \u4e86 \u63a8 \u7f85 \u7684 \u5883 \u754c \uff0c \u7d93 \u904e \u897f \u9813 \uff0c \u5c31 \u5f9e \u4f4e \u52a0 \u6ce2 \u5229 \u5883 \u5167 \u4f86 \u5230 \u52a0 \u5229 \u5229 \u6d77 \u3002"}, {"pk": 582478, "verse": 32, "text": "\u6709 \u4eba \u5e36 \u8457 \u4e00 \u500b \u8033 \u807e \u820c \u7d50 \u7684 \u4eba \u4f86 \u898b \u8036 \u7a4c \uff0c \u6c42 \u4ed6 \u6309 \u624b \u5728 \u4ed6 \u8eab \u4e0a \u3002"}, {"pk": 582479, "verse": 33, "text": "\u8036 \u7a4c \u9818 \u4ed6 \u96e2 \u958b \u773e \u4eba \uff0c \u5230 \u4e00 \u908a \u53bb \uff0c \u5c31 \u7528 \u6307 \u982d \u63a2 \u4ed6 \u7684 \u8033 \u6735 \uff0c \u5410 \u553e \u6cab \u62b9 \u4ed6 \u7684 \u820c \u982d \uff0c"}, {"pk": 582480, "verse": 34, "text": "\u671b \u5929 \u6b4e \u606f \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u4ee5 \u6cd5 \u5927 \uff01 \u5c31 \u662f \u8aaa \uff1a \u958b \u4e86 \u7f77 \uff01"}, {"pk": 582481, "verse": 35, "text": "\u4ed6 \u7684 \u8033 \u6735 \u5c31 \u958b \u4e86 \uff0c \u820c \u7d50 \u4e5f \u89e3 \u4e86 \uff0c \u8aaa \u8a71 \u4e5f \u6e05 \u695a \u4e86 \u3002"}, {"pk": 582482, "verse": 36, "text": "\u8036 \u7a4c \u56d1 \u5490 \u4ed6 \u5011 \u4e0d \u8981 \u544a \u8a34 \u4eba \uff1b \u4f46 \u4ed6 \u8d8a \u767c \u56d1 \u5490 \uff0c \u4ed6 \u5011 \u8d8a \u767c \u50b3 \u63da \u958b \u4e86 \u3002"}, {"pk": 582483, "verse": 37, "text": "\u773e \u4eba \u5206 \u5916 \u5e0c \u5947 \uff0c \u8aaa \uff1a \u4ed6 \u6240 \u505a \u7684 \u4e8b \u90fd \u597d \uff0c \u4ed6 \u9023 \u807e \u5b50 \u4e5f \u53eb \u4ed6 \u5011 \u807d \u898b \uff0c \u555e \u5427 \u4e5f \u53eb \u4ed6 \u5011 \u8aaa \u8a71 \u3002"}]