[{"pk": 583848, "verse": 1, "text": "\u9664 \u9175 \u7bc0 \uff0c \u53c8 \u540d \u903e \u8d8a \u7bc0 \uff0c \u8fd1 \u4e86 \u3002"}, {"pk": 583849, "verse": 2, "text": "\u796d \u53f8 \u9577 \u548c \u6587 \u58eb \u60f3 \u6cd5 \u5b50 \u600e \u9ebc \u624d \u80fd \u6bba \u5bb3 \u8036 \u7a4c \uff0c \u662f \u56e0 \u4ed6 \u5011 \u61fc \u6015 \u767e \u59d3 \u3002"}, {"pk": 583850, "verse": 3, "text": "\u9019 \u6642 \uff0c \u6492 \u4f46 \u5165 \u4e86 \u90a3 \u7a31 \u70ba \u52a0 \u7565 \u4eba \u7336 \u5927 \u7684 \u5fc3 \uff1b \u4ed6 \u672c \u662f \u5341 \u4e8c \u9580 \u5f92 \u88e1 \u7684 \u4e00 \u500b \u3002"}, {"pk": 583851, "verse": 4, "text": "\u4ed6 \u53bb \u548c \u796d \u53f8 \u9577 \u4e26 \u5b88 \u6bbf \u5b98 \u5546 \u91cf \uff0c \u600e \u9ebc \u53ef \u4ee5 \u628a \u8036 \u7a4c \u4ea4 \u7d66 \u4ed6 \u5011 \u3002"}, {"pk": 583852, "verse": 5, "text": "\u4ed6 \u5011 \u6b61 \u559c \uff0c \u5c31 \u7d04 \u5b9a \u7d66 \u4ed6 \u9280 \u5b50 \u3002"}, {"pk": 583853, "verse": 6, "text": "\u4ed6 \u61c9 \u5141 \u4e86 \uff0c \u5c31 \u627e \u6a5f \u6703 \uff0c \u8981 \u8d81 \u773e \u4eba \u4e0d \u5728 \u8ddf \u524d \u7684 \u6642 \u5019 \u628a \u8036 \u7a4c \u4ea4 \u7d66 \u4ed6 \u5011 \u3002"}, {"pk": 583854, "verse": 7, "text": "\u9664 \u9175 \u7bc0 \uff0c \u9808 \u5bb0 \u903e \u8d8a \u7f8a \u7f94 \u7684 \u90a3 \u4e00 \u5929 \u5230 \u4e86 \u3002"}, {"pk": 583855, "verse": 8, "text": "\u8036 \u7a4c \u6253 \u767c \u5f7c \u5f97 \u3001 \u7d04 \u7ff0 \uff0c \u8aaa \uff1a \u4f60 \u5011 \u53bb \u70ba \u6211 \u5011 \u9810 \u5099 \u903e \u8d8a \u7bc0 \u7684 \u7b75 \u5e2d \uff0c \u597d \u53eb \u6211 \u5011 \u5403 \u3002"}, {"pk": 583856, "verse": 9, "text": "\u4ed6 \u5011 \u554f \u4ed6 \u8aaa \uff1a \u8981 \u6211 \u5011 \u5728 \u90a3 \u88e1 \u9810 \u5099 \uff1f"}, {"pk": 583857, "verse": 10, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4f60 \u5011 \u9032 \u4e86 \u57ce \uff0c \u5fc5 \u6709 \u4eba \u62ff \u8457 \u4e00 \u74f6 \u6c34 \u8fce \u9762 \u800c \u4f86 \uff0c \u4f60 \u5011 \u5c31 \u8ddf \u8457 \u4ed6 \uff0c \u5230 \u4ed6 \u6240 \u9032 \u7684 \u623f \u5b50 \u88e1 \u53bb \uff0c"}, {"pk": 583858, "verse": 11, "text": "\u5c0d \u90a3 \u5bb6 \u7684 \u4e3b \u4eba \u8aaa \uff1a \u592b \u5b50 \u8aaa \uff1a \u5ba2 \u623f \u5728 \u90a3 \u88e1 \uff1f \u6211 \u8207 \u9580 \u5f92 \u597d \u5728 \u90a3 \u88e1 \u5403 \u903e \u8d8a \u7bc0 \u7684 \u7b75 \u5e2d \u3002"}, {"pk": 583859, "verse": 12, "text": "\u4ed6 \u5fc5 \u6307 \u7d66 \u4f60 \u5011 \u64fa \u8a2d \u6574 \u9f4a \u7684 \u4e00 \u9593 \u5927 \u6a13 \uff0c \u4f60 \u5011 \u5c31 \u5728 \u90a3 \u88e1 \u9810 \u5099 \u3002"}, {"pk": 583860, "verse": 13, "text": "\u4ed6 \u5011 \u53bb \u4e86 \uff0c \u6240 \u9047 \u898b \u7684 \u6b63 \u5982 \u8036 \u7a4c \u6240 \u8aaa \u7684 \uff1b \u4ed6 \u5011 \u5c31 \u9810 \u5099 \u4e86 \u903e \u8d8a \u7bc0 \u7684 \u7b75 \u5e2d \u3002"}, {"pk": 583861, "verse": 14, "text": "\u6642 \u5019 \u5230 \u4e86 \uff0c \u8036 \u7a4c \u5750 \u5e2d \uff0c \u4f7f \u5f92 \u4e5f \u548c \u4ed6 \u540c \u5750 \u3002"}, {"pk": 583862, "verse": 15, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u6211 \u5f88 \u9858 \u610f \u5728 \u53d7 \u5bb3 \u4ee5 \u5148 \u548c \u4f60 \u5011 \u5403 \u9019 \u903e \u8d8a \u7bc0 \u7684 \u7b75 \u5e2d \u3002"}, {"pk": 583863, "verse": 16, "text": "\u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u6211 \u4e0d \u518d \u5403 \u9019 \u7b75 \u5e2d \uff0c \u76f4 \u5230 \u6210 \u5c31 \u5728 \u795e \u7684 \u570b \u88e1 \u3002"}, {"pk": 583864, "verse": 17, "text": "\u8036 \u7a4c \u63a5 \u904e \u676f \u4f86 \uff0c \u795d \u8b1d \u4e86 \uff0c \u8aaa \uff1a \u4f60 \u5011 \u62ff \u9019 \u500b \uff0c \u5927 \u5bb6 \u5206 \u8457 \u559d \u3002"}, {"pk": 583865, "verse": 18, "text": "\u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u5f9e \u4eca \u4ee5 \u5f8c \uff0c \u6211 \u4e0d \u518d \u559d \u9019 \u8461 \u8404 \u6c41 \uff0c \u76f4 \u7b49 \u795e \u7684 \u570b \u4f86 \u5230 \u3002"}, {"pk": 583866, "verse": 19, "text": "\u53c8 \u62ff \u8d77 \u9905 \u4f86 \uff0c \u795d \u8b1d \u4e86 \uff0c \u5c31 \u64d8 \u958b \uff0c \u905e \u7d66 \u4ed6 \u5011 \uff0c \u8aaa \uff1a \u9019 \u662f \u6211 \u7684 \u8eab \u9ad4 \uff0c \u70ba \u4f60 \u5011 \u6368 \u7684 \uff0c \u4f60 \u5011 \u4e5f \u61c9 \u7576 \u5982 \u6b64 \u884c \uff0c \u70ba \u7684 \u662f \u8a18 \u5ff5 \u6211 \u3002"}, {"pk": 583867, "verse": 20, "text": "\u98ef \u5f8c \u4e5f \u7167 \u6a23 \u62ff \u8d77 \u676f \u4f86 \uff0c \u8aaa \uff1a \u9019 \u676f \u662f \u7528 \u6211 \u8840 \u6240 \u7acb \u7684 \u65b0 \u7d04 \uff0c \u662f \u70ba \u4f60 \u5011 \u6d41 \u51fa \u4f86 \u7684 \u3002"}, {"pk": 583868, "verse": 21, "text": "\u770b \u54ea \uff01 \u90a3 \u8ce3 \u6211 \u4e4b \u4eba \u7684 \u624b \u8207 \u6211 \u4e00 \u540c \u5728 \u684c \u5b50 \u4e0a \u3002"}, {"pk": 583869, "verse": 22, "text": "\u4eba \u5b50 \u56fa \u7136 \u8981 \u7167 \u6240 \u9810 \u5b9a \u7684 \u53bb \u4e16 \uff0c \u4f46 \u8ce3 \u4eba \u5b50 \u7684 \u4eba \u6709 \u798d \u4e86 \uff01"}, {"pk": 583870, "verse": 23, "text": "\u4ed6 \u5011 \u5c31 \u5f7c \u6b64 \u5c0d \u554f \uff0c \u662f \u90a3 \u4e00 \u500b \u8981 \u505a \u9019 \u4e8b \u3002"}, {"pk": 583871, "verse": 24, "text": "\u9580 \u5f92 \u8d77 \u4e86 \u722d \u8ad6 \uff0c \u4ed6 \u5011 \u4e2d \u9593 \u90a3 \u4e00 \u500b \u53ef \u7b97 \u70ba \u5927 \u3002"}, {"pk": 583872, "verse": 25, "text": "\u8036 \u7a4c \u8aaa \uff1a \u5916 \u90a6 \u4eba \u6709 \u541b \u738b \u70ba \u4e3b \u6cbb \u7406 \u4ed6 \u5011 \uff0c \u90a3 \u638c \u6b0a \u7ba1 \u4ed6 \u5011 \u7684 \u7a31 \u70ba \u6069 \u4e3b \u3002"}, {"pk": 583873, "verse": 26, "text": "\u4f46 \u4f60 \u5011 \u4e0d \u53ef \u9019 \u6a23 \uff1b \u4f60 \u5011 \u88e1 \u982d \u70ba \u5927 \u7684 \uff0c \u5012 \u8981 \u50cf \u5e74 \u5e7c \u7684 \uff1b \u70ba \u9996 \u9818 \u7684 \uff0c \u5012 \u8981 \u50cf \u670d \u4e8b \u4eba \u7684 \u3002"}, {"pk": 583874, "verse": 27, "text": "\u662f \u8ab0 \u70ba \u5927 \uff1f \u662f \u5750 \u5e2d \u7684 \u5462 \uff1f \u662f \u670d \u4e8b \u4eba \u7684 \u5462 \uff1f \u4e0d \u662f \u5750 \u5e2d \u7684 \u5927 \u9ebc \uff1f \u7136 \u800c \uff0c \u6211 \u5728 \u4f60 \u5011 \u4e2d \u9593 \u5982 \u540c \u670d \u4e8b \u4eba \u7684 \u3002"}, {"pk": 583875, "verse": 28, "text": "\u6211 \u5728 \u78e8 \u7149 \u4e4b \u4e2d \uff0c \u5e38 \u548c \u6211 \u540c \u5728 \u7684 \u5c31 \u662f \u4f60 \u5011 \u3002"}, {"pk": 583876, "verse": 29, "text": "\u6211 \u5c07 \u570b \u8cdc \u7d66 \u4f60 \u5011 \uff0c \u6b63 \u5982 \u6211 \u7236 \u8cdc \u7d66 \u6211 \u4e00 \u6a23 \uff0c"}, {"pk": 583877, "verse": 30, "text": "\u53eb \u4f60 \u5011 \u5728 \u6211 \u570b \u88e1 \uff0c \u5750 \u5728 \u6211 \u7684 \u5e2d \u4e0a \u5403 \u559d \uff0c \u4e26 \u4e14 \u5750 \u5728 \u5bf6 \u5ea7 \u4e0a \uff0c \u5be9 \u5224 \u4ee5 \u8272 \u5217 \u5341 \u4e8c \u500b \u652f \u6d3e \u3002"}, {"pk": 583878, "verse": 31, "text": "\u4e3b \u53c8 \u8aaa \uff1a \u897f \u9580 \uff01 \u897f \u9580 \uff01 \u6492 \u4f46 \u60f3 \u8981 \u5f97 \u8457 \u4f60 \u5011 \uff0c \u597d \u7be9 \u4f60 \u5011 \u50cf \u7be9 \u9ea5 \u5b50 \u4e00 \u6a23 \uff1b"}, {"pk": 583879, "verse": 32, "text": "\u4f46 \u6211 \u5df2 \u7d93 \u70ba \u4f60 \u7948 \u6c42 \uff0c \u53eb \u4f60 \u4e0d \u81f3 \u65bc \u5931 \u4e86 \u4fe1 \u5fc3 \uff0c \u4f60 \u56de \u982d \u4ee5 \u5f8c \uff0c \u8981 \u5805 \u56fa \u4f60 \u7684 \u5f1f \u5144 \u3002"}, {"pk": 583880, "verse": 33, "text": "\u5f7c \u5f97 \u8aaa \uff1a \u4e3b \u963f \uff0c \u6211 \u5c31 \u662f \u540c \u4f60 \u4e0b \u76e3 \uff0c \u540c \u4f60 \u53d7 \u6b7b \uff0c \u4e5f \u662f \u7518 \u5fc3 \uff01"}, {"pk": 583881, "verse": 34, "text": "\u8036 \u7a4c \u8aaa \uff1a \u5f7c \u5f97 \uff0c \u6211 \u544a \u8a34 \u4f60 \uff0c \u4eca \u65e5 \u96de \u9084 \u6c92 \u6709 \u53eb \uff0c \u4f60 \u8981 \u4e09 \u6b21 \u8aaa \u4e0d \u8a8d \u5f97 \u6211 \u3002"}, {"pk": 583882, "verse": 35, "text": "\u8036 \u7a4c \u53c8 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u6211 \u5dee \u4f60 \u5011 \u51fa \u53bb \u7684 \u6642 \u5019 \uff0c \u6c92 \u6709 \u9322 \u56ca \uff0c \u6c92 \u6709 \u53e3 \u888b \uff0c \u6c92 \u6709 \u978b \uff0c \u4f60 \u5011 \u7f3a \u5c11 \u751a \u9ebc \u6c92 \u6709 \uff1f \u4ed6 \u5011 \u8aaa \uff1a \u6c92 \u6709 \u3002"}, {"pk": 583883, "verse": 36, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4f46 \u5982 \u4eca \u6709 \u9322 \u56ca \u7684 \u53ef \u4ee5 \u5e36 \u8457 \uff0c \u6709 \u53e3 \u888b \u7684 \u4e5f \u53ef \u4ee5 \u5e36 \u8457 \uff0c \u6c92 \u6709 \u5200 \u7684 \u8981 \u8ce3 \u8863 \u670d \u8cb7 \u5200 \u3002"}, {"pk": 583884, "verse": 37, "text": "\u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u7d93 \u4e0a \u5beb \u8457 \u8aaa \uff1a \u4ed6 \u88ab \u5217 \u5728 \u7f6a \u72af \u4e4b \u4e2d \u3002 \u9019 \u8a71 \u5fc5 \u61c9 \u9a57 \u5728 \u6211 \u8eab \u4e0a \uff1b \u56e0 \u70ba \u90a3 \u95dc \u4fc2 \u6211 \u7684 \u4e8b \u5fc5 \u7136 \u6210 \u5c31 \u3002"}, {"pk": 583885, "verse": 38, "text": "\u4ed6 \u5011 \u8aaa \uff1a \u4e3b \u963f \uff0c \u8acb \u770b \uff01 \u9019 \u88e1 \u6709 \u5169 \u628a \u5200 \u3002 \u8036 \u7a4c \u8aaa \uff1a \u5920 \u4e86 \u3002"}, {"pk": 583886, "verse": 39, "text": "\u8036 \u7a4c \u51fa \u4f86 \uff0c \u7167 \u5e38 \u5f80 \u6a44 \u6b16 \u5c71 \u53bb \uff0c \u9580 \u5f92 \u4e5f \u8ddf \u96a8 \u4ed6 \u3002"}, {"pk": 583887, "verse": 40, "text": "\u5230 \u4e86 \u90a3 \u5730 \u65b9 \uff0c \u5c31 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u8981 \u79b1 \u544a \uff0c \u514d \u5f97 \u5165 \u4e86 \u8ff7 \u60d1 \u3002"}, {"pk": 583888, "verse": 41, "text": "\u65bc \u662f \u96e2 \u958b \u4ed6 \u5011 \u7d04 \u6709 \u6254 \u4e00 \u584a \u77f3 \u982d \u90a3 \u9ebc \u9060 \uff0c \u8dea \u4e0b \u79b1 \u544a \uff0c"}, {"pk": 583889, "verse": 42, "text": "\u8aaa \uff1a \u7236 \u963f \uff01 \u4f60 \u82e5 \u9858 \u610f \uff0c \u5c31 \u628a \u9019 \u676f \u64a4 \u53bb \uff1b \u7136 \u800c \uff0c \u4e0d \u8981 \u6210 \u5c31 \u6211 \u7684 \u610f \u601d \uff0c \u53ea \u8981 \u6210 \u5c31 \u4f60 \u7684 \u610f \u601d \u3002"}, {"pk": 583890, "verse": 43, "text": "\u6709 \u4e00 \u4f4d \u5929 \u4f7f \u5f9e \u5929 \u4e0a \u986f \u73fe \uff0c \u52a0 \u6dfb \u4ed6 \u7684 \u529b \u91cf \u3002"}, {"pk": 583891, "verse": 44, "text": "\u8036 \u7a4c \u6975 \u5176 \u50b7 \u75db \uff0c \u79b1 \u544a \u66f4 \u52a0 \u61c7 \u5207 \uff0c \u6c57 \u73e0 \u5982 \u5927 \u8840 \u9ede \u6ef4 \u5728 \u5730 \u4e0a \u3002"}, {"pk": 583892, "verse": 45, "text": "\u79b1 \u544a \u5b8c \u4e86 \uff0c \u5c31 \u8d77 \u4f86 \uff0c \u5230 \u9580 \u5f92 \u90a3 \u88e1 \uff0c \u898b \u4ed6 \u5011 \u56e0 \u70ba \u6182 \u6101 \u90fd \u7761 \u8457 \u4e86 \uff0c"}, {"pk": 583893, "verse": 46, "text": "\u5c31 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u70ba \u751a \u9ebc \u7761 \u89ba \u5462 \uff1f \u8d77 \u4f86 \u79b1 \u544a \uff0c \u514d \u5f97 \u5165 \u4e86 \u8ff7 \u60d1 \uff01"}, {"pk": 583894, "verse": 47, "text": "\u8aaa \u8a71 \u4e4b \u9593 \uff0c \u4f86 \u4e86 \u8a31 \u591a \u4eba \u3002 \u90a3 \u5341 \u4e8c \u500b \u9580 \u5f92 \u88e1 \u540d \u53eb \u7336 \u5927 \u7684 \uff0c \u8d70 \u5728 \u524d \u982d \uff0c \u5c31 \u8fd1 \u8036 \u7a4c \uff0c \u8981 \u8207 \u4ed6 \u89aa \u5634 \u3002"}, {"pk": 583895, "verse": 48, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u7336 \u5927 \uff01 \u4f60 \u7528 \u89aa \u5634 \u7684 \u6697 \u865f \u8ce3 \u4eba \u5b50 \u9ebc \uff1f"}, {"pk": 583896, "verse": 49, "text": "\u5de6 \u53f3 \u7684 \u4eba \u898b \u5149 \u666f \u4e0d \u597d \uff0c \u5c31 \u8aaa \uff1a \u4e3b \u963f \ufe57 \u6211 \u5011 \u62ff \u5200 \u780d \u53ef \u4ee5 \u4e0d \u53ef \u4ee5 \uff1f"}, {"pk": 583897, "verse": 50, "text": "\u5167 \u4e2d \u6709 \u4e00 \u500b \u4eba \u628a \u5927 \u796d \u53f8 \u7684 \u50d5 \u4eba \u780d \u4e86 \u4e00 \u5200 \uff0c \u524a \u6389 \u4e86 \u4ed6 \u7684 \u53f3 \u8033 \u3002"}, {"pk": 583898, "verse": 51, "text": "\u8036 \u7a4c \u8aaa \uff1a \u5230 \u4e86 \u9019 \u500b \u5730 \u6b65 \uff0c \u7531 \u4ed6 \u5011 \u7f77 \uff01 \u5c31 \u6478 \u90a3 \u4eba \u7684 \u8033 \u6735 \uff0c \u628a \u4ed6 \u6cbb \u597d \u4e86 \u3002"}, {"pk": 583899, "verse": 52, "text": "\u8036 \u7a4c \u5c0d \u90a3 \u4e9b \u4f86 \u62ff \u4ed6 \u7684 \u796d \u53f8 \u9577 \u548c \u5b88 \u6bbf \u5b98 \u4e26 \u9577 \u8001 \u8aaa \uff1a \u4f60 \u5011 \u5e36 \u8457 \u5200 \u68d2 \u51fa \u4f86 \u62ff \u6211 \uff0c \u5982 \u540c \u62ff \u5f37 \u76dc \u9ebc \uff1f"}, {"pk": 583900, "verse": 53, "text": "\u6211 \u5929 \u5929 \u540c \u4f60 \u5011 \u5728 \u6bbf \u88e1 \uff0c \u4f60 \u5011 \u4e0d \u4e0b \u624b \u62ff \u6211 \u3002 \u73fe \u5728 \u537b \u662f \u4f60 \u5011 \u7684 \u6642 \u5019 \uff0c \u9ed1 \u6697 \u638c \u6b0a \u4e86 \u3002"}, {"pk": 583901, "verse": 54, "text": "\u4ed6 \u5011 \u62ff \u4f4f \u8036 \u7a4c \uff0c \u628a \u4ed6 \u5e36 \u5230 \u5927 \u796d \u53f8 \u7684 \u5b85 \u88e1 \u3002 \u5f7c \u5f97 \u9060 \u9060 \u7684 \u8ddf \u8457 \u3002"}, {"pk": 583902, "verse": 55, "text": "\u4ed6 \u5011 \u5728 \u9662 \u5b50 \u88e1 \u751f \u4e86 \u706b \uff0c \u4e00 \u540c \u5750 \u8457 \uff1b \u5f7c \u5f97 \u4e5f \u5750 \u5728 \u4ed6 \u5011 \u4e2d \u9593 \u3002"}, {"pk": 583903, "verse": 56, "text": "\u6709 \u4e00 \u500b \u4f7f \u5973 \u770b \u898b \u5f7c \u5f97 \u5750 \u5728 \u706b \u5149 \u88e1 \uff0c \u5c31 \u5b9a \u775b \u770b \u4ed6 \uff0c \u8aaa \uff1a \u9019 \u500b \u4eba \u7d20 \u4f86 \u4e5f \u662f \u540c \u90a3 \u4eba \u4e00 \u5925 \u7684 \u3002"}, {"pk": 583904, "verse": 57, "text": "\u5f7c \u5f97 \u537b \u4e0d \u627f \u8a8d \uff0c \u8aaa \uff1a \u5973 \u5b50 \uff0c \u6211 \u4e0d \u8a8d \u5f97 \u4ed6 \u3002"}, {"pk": 583905, "verse": 58, "text": "\u904e \u4e86 \u4e0d \u591a \u7684 \u6642 \u5019 \uff0c \u53c8 \u6709 \u4e00 \u500b \u4eba \u770b \u898b \u4ed6 \uff0c \u8aaa \uff1a \u4f60 \u4e5f \u662f \u4ed6 \u5011 \u4e00 \u9ee8 \u7684 \u3002 \u5f7c \u5f97 \u8aaa \uff1a \u4f60 \u9019 \u500b \u4eba \uff01 \u6211 \u4e0d \u662f \u3002"}, {"pk": 583906, "verse": 59, "text": "\u7d04 \u904e \u4e86 \u4e00 \u5c0f \u6642 \uff0c \u53c8 \u6709 \u4e00 \u500b \u4eba \u6975 \u529b \u7684 \u8aaa \uff1a \u4ed6 \u5be6 \u5728 \u662f \u540c \u90a3 \u4eba \u4e00 \u5925 \u7684 \uff0c \u56e0 \u70ba \u4ed6 \u4e5f \u662f \u52a0 \u5229 \u5229 \u4eba \u3002"}, {"pk": 583907, "verse": 60, "text": "\u5f7c \u5f97 \u8aaa \uff1a \u4f60 \u9019 \u500b \u4eba \uff01 \u6211 \u4e0d \u66c9 \u5f97 \u4f60 \u8aaa \u7684 \u662f \u751a \u9ebc \uff01 \u6b63 \u8aaa \u8a71 \u4e4b \u9593 \uff0c \u96de \u5c31 \u53eb \u4e86 \u3002"}, {"pk": 583908, "verse": 61, "text": "\u4e3b \u8f49 \u904e \u8eab \u4f86 \u770b \u5f7c \u5f97 \u3002 \u5f7c \u5f97 \u4fbf \u60f3 \u8d77 \u4e3b \u5c0d \u4ed6 \u6240 \u8aaa \u7684 \u8a71 \uff1a \u4eca \u65e5 \u96de \u53eb \u4ee5 \u5148 \uff0c \u4f60 \u8981 \u4e09 \u6b21 \u4e0d \u8a8d \u6211 \u3002"}, {"pk": 583909, "verse": 62, "text": "\u4ed6 \u5c31 \u51fa \u53bb \u75db \u54ed \u3002"}, {"pk": 583910, "verse": 63, "text": "\u770b \u5b88 \u8036 \u7a4c \u7684 \u4eba \u6232 \u5f04 \u4ed6 \uff0c \u6253 \u4ed6 \uff0c"}, {"pk": 583911, "verse": 64, "text": "\u53c8 \u8499 \u8457 \u4ed6 \u7684 \u773c \uff0c \u554f \u4ed6 \u8aaa \uff1a \u4f60 \u662f \u5148 \u77e5 \uff0c \u544a \u8a34 \u6211 \u5011 \u6253 \u4f60 \u7684 \u662f \u8ab0 \uff1f"}, {"pk": 583912, "verse": 65, "text": "\u4ed6 \u5011 \u9084 \u7528 \u8a31 \u591a \u5225 \u7684 \u8a71 \u8fb1 \u7f75 \u4ed6 \u3002"}, {"pk": 583913, "verse": 66, "text": "\u5929 \u4e00 \u4eae \uff0c \u6c11 \u9593 \u7684 \u773e \u9577 \u8001 \u9023 \u796d \u53f8 \u9577 \u5e36 \u6587 \u58eb \u90fd \u805a \u6703 \uff0c \u628a \u8036 \u7a4c \u5e36 \u5230 \u4ed6 \u5011 \u7684 \u516c \u6703 \u88e1 \uff0c"}, {"pk": 583914, "verse": 67, "text": "\u8aaa \uff1a \u4f60 \u82e5 \u662f \u57fa \u7763 \uff0c \u5c31 \u544a \u8a34 \u6211 \u5011 \u3002 \u8036 \u7a4c \u8aaa \uff1a \u6211 \u82e5 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4f60 \u5011 \u4e5f \u4e0d \u4fe1 \uff1b"}, {"pk": 583915, "verse": 68, "text": "\u6211 \u82e5 \u554f \u4f60 \u5011 \uff0c \u4f60 \u5011 \u4e5f \u4e0d \u56de \u7b54 \u3002"}, {"pk": 583916, "verse": 69, "text": "\u5f9e \u4eca \u4ee5 \u5f8c \uff0c \u4eba \u5b50 \u8981 \u5750 \u5728 \u795e \u6b0a \u80fd \u7684 \u53f3 \u908a \u3002"}, {"pk": 583917, "verse": 70, "text": "\u4ed6 \u5011 \u90fd \u8aaa \uff1a \u9019 \u6a23 \uff0c \u4f60 \u662f \u795e \u7684 \u5152 \u5b50 \u9ebc \uff1f \u8036 \u7a4c \u8aaa \uff1a \u4f60 \u5011 \u6240 \u8aaa \u7684 \u662f \u3002"}, {"pk": 583918, "verse": 71, "text": "\u4ed6 \u5011 \u8aaa \uff1a \u4f55 \u5fc5 \u518d \u7528 \u898b \u8b49 \u5462 \uff1f \u4ed6 \u89aa \u53e3 \u6240 \u8aaa \u7684 \uff0c \u6211 \u5011 \u90fd \u89aa \u81ea \u807d \u898b \u4e86 \u3002"}]