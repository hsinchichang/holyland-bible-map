[{"pk": 581193, "verse": 1, "text": "\u7576 \u6642 \uff0c \u8036 \u7a4c \u88ab \u8056 \u9748 \u5f15 \u5230 \u66e0 \u91ce \uff0c \u53d7 \u9b54 \u9b3c \u7684 \u8a66 \u63a2 \u3002"}, {"pk": 581194, "verse": 2, "text": "\u4ed6 \u7981 \u98df \u56db \u5341 \u665d \u591c \uff0c \u5f8c \u4f86 \u5c31 \u9913 \u4e86 \u3002"}, {"pk": 581195, "verse": 3, "text": "\u90a3 \u8a66 \u63a2 \u4eba \u7684 \u9032 \u524d \u4f86 \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u82e5 \u662f \u795e \u7684 \u5152 \u5b50 \uff0c \u53ef \u4ee5 \u5429 \u5490 \u9019 \u4e9b \u77f3 \u982d \u8b8a \u6210 \u98df \u7269 \u3002"}, {"pk": 581196, "verse": 4, "text": "\u8036 \u7a4c \u537b \u56de \u7b54 \u8aaa \uff1a \u7d93 \u4e0a \u8a18 \u8457 \u8aaa \uff1a \u4eba \u6d3b \u8457 \uff0c \u4e0d \u662f \u55ae \u9760 \u98df \u7269 \uff0c \u4e43 \u662f \u9760 \u795e \u53e3 \u88e1 \u6240 \u51fa \u7684 \u4e00 \u5207 \u8a71 \u3002"}, {"pk": 581197, "verse": 5, "text": "\u9b54 \u9b3c \u5c31 \u5e36 \u4ed6 \u9032 \u4e86 \u8056 \u57ce \uff0c \u53eb \u4ed6 \u7ad9 \u5728 \u6bbf \u9802 \uff08 \u9802 \uff1a \u539f \u6587 \u662f \u7fc5 \uff09 \u4e0a \uff0c"}, {"pk": 581198, "verse": 6, "text": "\u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u82e5 \u662f \u795e \u7684 \u5152 \u5b50 \uff0c \u53ef \u4ee5 \u8df3 \u4e0b \u53bb \uff0c \u56e0 \u70ba \u7d93 \u4e0a \u8a18 \u8457 \u8aaa \uff1a \u4e3b \u8981 \u70ba \u4f60 \u5429 \u5490 \u4ed6 \u7684 \u4f7f \u8005 \u7528 \u624b \u6258 \u8457 \u4f60 \uff0c \u514d \u5f97 \u4f60 \u7684 \u8173 \u78b0 \u5728 \u77f3 \u982d \u4e0a \u3002"}, {"pk": 581199, "verse": 7, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u7d93 \u4e0a \u53c8 \u8a18 \u8457 \u8aaa \uff1a \u4e0d \u53ef \u8a66 \u63a2 \u4e3b \u2500 \u4f60 \u7684 \u795e \u3002"}, {"pk": 581200, "verse": 8, "text": "\u9b54 \u9b3c \u53c8 \u5e36 \u4ed6 \u4e0a \u4e86 \u4e00 \u5ea7 \u6700 \u9ad8 \u7684 \u5c71 \uff0c \u5c07 \u4e16 \u4e0a \u7684 \u842c \u570b \u8207 \u842c \u570b \u7684 \u69ae \u83ef \u90fd \u6307 \u7d66 \u4ed6 \u770b \uff0c"}, {"pk": 581201, "verse": 9, "text": "\u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u82e5 \u4fef \u4f0f \u62dc \u6211 \uff0c \u6211 \u5c31 \u628a \u9019 \u4e00 \u5207 \u90fd \u8cdc \u7d66 \u4f60 \u3002"}, {"pk": 581202, "verse": 10, "text": "\u8036 \u7a4c \u8aaa \uff1a \u6492 \u4f46 \uff08 \u6492 \u4f46 \u5c31 \u662f \u62b5 \u64cb \u7684 \u610f \u601d \uff0c \u4e43 \u9b54 \u9b3c \u7684 \u5225 \u540d \uff09 \uff0c \u9000 \u53bb \u7f77 \uff01 \u56e0 \u70ba \u7d93 \u4e0a \u8a18 \u8457 \u8aaa \uff1a \u7576 \u62dc \u4e3b \u4f60 \u7684 \u795e \uff0c \u55ae \u8981 \u4e8b \u5949 \u4ed6 \u3002"}, {"pk": 581203, "verse": 11, "text": "\u65bc \u662f \uff0c \u9b54 \u9b3c \u96e2 \u4e86 \u8036 \u7a4c \uff0c \u6709 \u5929 \u4f7f \u4f86 \u4f3a \u5019 \u4ed6 \u3002"}, {"pk": 581204, "verse": 12, "text": "\u8036 \u7a4c \u807d \u898b \u7d04 \u7ff0 \u4e0b \u4e86 \u76e3 \uff0c \u5c31 \u9000 \u5230 \u52a0 \u5229 \u5229 \u53bb \uff1b"}, {"pk": 581205, "verse": 13, "text": "\u5f8c \u53c8 \u96e2 \u958b \u62ff \u6492 \u52d2 \uff0c \u5f80 \u8fe6 \u767e \u8fb2 \u53bb \uff0c \u5c31 \u4f4f \u5728 \u90a3 \u88e1 \u3002 \u90a3 \u5730 \u65b9 \u9760 \u6d77 \uff0c \u5728 \u897f \u5e03 \u502b \u548c \u62ff \u5f17 \u4ed6 \u5229 \u7684 \u908a \u754c \u4e0a \u3002"}, {"pk": 581206, "verse": 14, "text": "\u9019 \u662f \u8981 \u61c9 \u9a57 \u5148 \u77e5 \u4ee5 \u8cfd \u4e9e \u7684 \u8a71 \uff0c"}, {"pk": 581207, "verse": 15, "text": "\u8aaa \uff1a \u897f \u5e03 \u502b \u5730 \uff0c \u62ff \u5f17 \u4ed6 \u5229 \u5730 \uff0c \u5c31 \u662f \u6cbf \u6d77 \u7684 \u8def \uff0c \u7d04 \u4f46 \u6cb3 \u5916 \uff0c \u5916 \u90a6 \u4eba \u7684 \u52a0 \u5229 \u5229 \u5730 \u3002"}, {"pk": 581208, "verse": 16, "text": "\u90a3 \u5750 \u5728 \u9ed1 \u6697 \u88e1 \u7684 \u767e \u59d3 \u770b \u898b \u4e86 \u5927 \u5149 \uff1b \u5750 \u5728 \u6b7b \u852d \u4e4b \u5730 \u7684 \u4eba \u6709 \u5149 \u767c \u73fe \u7167 \u8457 \u4ed6 \u5011 \u3002"}, {"pk": 581209, "verse": 17, "text": "\u5f9e \u90a3 \u6642 \u5019 \uff0c \u8036 \u7a4c \u5c31 \u50b3 \u8d77 \u9053 \u4f86 \uff0c \u8aaa \uff1a \u5929 \u570b \u8fd1 \u4e86 \uff0c \u4f60 \u5011 \u61c9 \u7576 \u6094 \u6539 \uff01"}, {"pk": 581210, "verse": 18, "text": "\u8036 \u7a4c \u5728 \u52a0 \u5229 \u5229 \u6d77 \u908a \u884c \u8d70 \uff0c \u770b \u898b \u5f1f \u5144 \u4e8c \u4eba \uff0c \u5c31 \u662f \u90a3 \u7a31 \u547c \u5f7c \u5f97 \u7684 \u897f \u9580 \u548c \u4ed6 \u5144 \u5f1f \u5b89 \u5f97 \u70c8 \uff0c \u5728 \u6d77 \u88e1 \u6492 \u7db2 \uff1b \u4ed6 \u5011 \u672c \u662f \u6253 \u9b5a \u7684 \u3002"}, {"pk": 581211, "verse": 19, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f86 \u8ddf \u5f9e \u6211 \uff0c \u6211 \u8981 \u53eb \u4f60 \u5011 \u5f97 \u4eba \u5982 \u5f97 \u9b5a \u4e00 \u6a23 \u3002"}, {"pk": 581212, "verse": 20, "text": "\u4ed6 \u5011 \u5c31 \u7acb \u523b \u6368 \u4e86 \u7db2 \uff0c \u8ddf \u5f9e \u4e86 \u4ed6 \u3002"}, {"pk": 581213, "verse": 21, "text": "\u5f9e \u90a3 \u88e1 \u5f80 \u524d \u8d70 \uff0c \u53c8 \u770b \u898b \u5f1f \u5144 \u4e8c \u4eba \uff0c \u5c31 \u662f \u897f \u5e87 \u592a \u7684 \u5152 \u5b50 \u96c5 \u5404 \u548c \u4ed6 \u5144 \u5f1f \u7d04 \u7ff0 \uff0c \u540c \u4ed6 \u5011 \u7684 \u7236 \u89aa \u897f \u5e87 \u592a \u5728 \u8239 \u4e0a \u88dc \u7db2 \uff0c \u8036 \u7a4c \u5c31 \u62db \u547c \u4ed6 \u5011 \uff0c"}, {"pk": 581214, "verse": 22, "text": "\u4ed6 \u5011 \u7acb \u523b \u6368 \u4e86 \u8239 \uff0c \u5225 \u4e86 \u7236 \u89aa \uff0c \u8ddf \u5f9e \u4e86 \u8036 \u7a4c \u3002"}, {"pk": 581215, "verse": 23, "text": "\u8036 \u7a4c \u8d70 \u904d \u52a0 \u5229 \u5229 \uff0c \u5728 \u5404 \u6703 \u5802 \u88e1 \u6559 \u8a13 \u4eba \uff0c \u50b3 \u5929 \u570b \u7684 \u798f \u97f3 \uff0c \u91ab \u6cbb \u767e \u59d3 \u5404 \u6a23 \u7684 \u75c5 \u75c7 \u3002"}, {"pk": 581216, "verse": 24, "text": "\u4ed6 \u7684 \u540d \u8072 \u5c31 \u50b3 \u904d \u4e86 \u6558 \u5229 \u4e9e \u3002 \u90a3 \u88e1 \u7684 \u4eba \u628a \u4e00 \u5207 \u5bb3 \u75c5 \u7684 \uff0c \u5c31 \u662f \u5bb3 \u5404 \u6a23 \u75be \u75c5 \u3001 \u5404 \u6a23 \u75bc \u75db \u7684 \u548c \u88ab \u9b3c \u9644 \u7684 \u3001 \u7672 \u7647 \u7684 \u3001 \u7671 \u7613 \u7684 \uff0c \u90fd \u5e36 \u4e86 \u4f86 \uff0c \u8036 \u7a4c \u5c31 \u6cbb \u597d \u4e86 \u4ed6 \u5011 \u3002"}, {"pk": 581217, "verse": 25, "text": "\u7576 \u4e0b \uff0c \u6709 \u8a31 \u591a \u4eba \u5f9e \u52a0 \u5229 \u5229 \u3001 \u4f4e \u52a0 \u6ce2 \u5229 \u3001 \u8036 \u8def \u6492 \u51b7 \u3001 \u7336 \u592a \u3001 \u7d04 \u4f46 \u6cb3 \u5916 \u4f86 \u8ddf \u8457 \u4ed6 \u3002"}]