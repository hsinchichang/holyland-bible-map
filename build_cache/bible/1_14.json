[{"pk": 558320, "verse": 1, "text": "\u7576 \u6697 \u62c9 \u975e \u4f5c \u793a \u62ff \u738b \uff0c \u4e9e \u7565 \u4f5c \u4ee5 \u62c9 \u6492 \u738b \uff0c \u57fa \u5927 \u8001 \u746a \u4f5c \u4ee5 \u6514 \u738b \uff0c \u63d0 \u9054 \u4f5c \u6208 \u5370 \u738b \u7684 \u6642 \u5019 \uff0c"}, {"pk": 558321, "verse": 2, "text": "\u4ed6 \u5011 \u90fd \u653b \u6253 \u6240 \u591a \u746a \u738b \u6bd4 \u62c9 \u3001 \u86fe \u6469 \u62c9 \u738b \u6bd4 \u6c99 \u3001 \u62bc \u746a \u738b \u793a \u7d0d \u3001 \u6d17 \u6241 \u738b \u5584 \u4ee5 \u5225 \uff0c \u548c \u6bd4 \u62c9 \u738b \uff1b \u6bd4 \u62c9 \u5c31 \u662f \u7463 \u73e5 \u3002"}, {"pk": 558322, "verse": 3, "text": "\u9019 \u4e94 \u738b \u90fd \u5728 \u897f \u8a02 \u8c37 \u6703 \u5408 \uff1b \u897f \u8a02 \u8c37 \u5c31 \u662f \u9e7d \u6d77 \u3002"}, {"pk": 558323, "verse": 4, "text": "\u4ed6 \u5011 \u5df2 \u7d93 \u4e8b \u5949 \u57fa \u5927 \u8001 \u746a \u5341 \u4e8c \u5e74 \uff0c \u5230 \u5341 \u4e09 \u5e74 \u5c31 \u80cc \u53db \u4e86 \u3002"}, {"pk": 558324, "verse": 5, "text": "\u5341 \u56db \u5e74 \uff0c \u57fa \u5927 \u8001 \u746a \u548c \u540c \u76df \u7684 \u738b \u90fd \u4f86 \u5728 \u4e9e \u7279 \u5f8b \u52a0 \u5be7 \uff0c \u6bba \u6557 \u4e86 \u5229 \u4e4f \u97f3 \u4eba \uff0c \u5728 \u54c8 \u9ea5 \u6bba \u6557 \u4e86 \u8607 \u897f \u4eba \uff0c \u5728 \u6c99 \u5fae \u57fa \u5217 \u4ead \u6bba \u6557 \u4e86 \u4ee5 \u7c73 \u4eba \uff0c"}, {"pk": 558325, "verse": 6, "text": "\u5728 \u4f55 \u5229 \u4eba \u7684 \u897f \u73e5 \u5c71 \u6bba \u6557 \u4e86 \u4f55 \u5229 \u4eba \uff0c \u4e00 \u76f4 \u6bba \u5230 \u9760 \u8fd1 \u66e0 \u91ce \u7684 \u4f0a \u52d2 \u5df4 \u862d \u3002"}, {"pk": 558326, "verse": 7, "text": "\u4ed6 \u5011 \u56de \u5230 \u5b89 \u5bc6 \u5df4 \uff0c \u5c31 \u662f \u52a0 \u4f4e \u65af \uff0c \u6bba \u6557 \u4e86 \u4e9e \u746a \u529b \u5168 \u5730 \u7684 \u4eba \uff0c \u4ee5 \u53ca \u4f4f \u5728 \u54c8 \u6d17 \u905c \u4ed6 \u746a \u7684 \u4e9e \u6469 \u5229 \u4eba \u3002"}, {"pk": 558327, "verse": 8, "text": "\u65bc \u662f \u6240 \u591a \u746a \u738b \u3001 \u86fe \u6469 \u62c9 \u738b \u3001 \u62bc \u746a \u738b \u3001 \u6d17 \u6241 \u738b \uff0c \u548c \u6bd4 \u62c9 \u738b \uff08 \u6bd4 \u62c9 \u5c31 \u662f \u7463 \u73e5 \uff09 \u90fd \u51fa \u4f86 \uff0c \u5728 \u897f \u8a02 \u8c37 \u64fa \u9663 \uff0c \u8207 \u4ed6 \u5011 \u4ea4 \u6230 \uff0c"}, {"pk": 558328, "verse": 9, "text": "\u5c31 \u662f \u8207 \u4ee5 \u6514 \u738b \u57fa \u5927 \u8001 \u746a \u3001 \u6208 \u5370 \u738b \u63d0 \u9054 \u3001 \u793a \u62ff \u738b \u6697 \u62c9 \u975e \u3001 \u4ee5 \u62c9 \u6492 \u738b \u4e9e \u7565 \u4ea4 \u6230 \uff1b \u4e43 \u662f \u56db \u738b \u8207 \u4e94 \u738b \u4ea4 \u6230 \u3002"}, {"pk": 558329, "verse": 10, "text": "\u897f \u8a02 \u8c37 \u6709 \u8a31 \u591a \u77f3 \u6f06 \u5751 \u3002 \u6240 \u591a \u746a \u738b \u548c \u86fe \u6469 \u62c9 \u738b \u9003 \u8dd1 \uff0c \u6709 \u6389 \u5728 \u5751 \u88e1 \u7684 \uff0c \u5176 \u9918 \u7684 \u4eba \u90fd \u5f80 \u5c71 \u4e0a \u9003 \u8dd1 \u3002"}, {"pk": 558330, "verse": 11, "text": "\u56db \u738b \u5c31 \u628a \u6240 \u591a \u746a \u548c \u86fe \u6469 \u62c9 \u6240 \u6709 \u7684 \u8ca1 \u7269 \uff0c \u4e26 \u4e00 \u5207 \u7684 \u7ce7 \u98df \u90fd \u64c4 \u63a0 \u53bb \u4e86 \uff1b"}, {"pk": 558331, "verse": 12, "text": "\u53c8 \u628a \u4e9e \u4f2f \u862d \u7684 \u59ea \u5152 \u7f85 \u5f97 \u548c \u7f85 \u5f97 \u7684 \u8ca1 \u7269 \u64c4 \u63a0 \u53bb \u4e86 \u3002 \u7576 \u6642 \u7f85 \u5f97 \u6b63 \u4f4f \u5728 \u6240 \u591a \u746a \u3002"}, {"pk": 558332, "verse": 13, "text": "\u6709 \u4e00 \u500b \u9003 \u51fa \u4f86 \u7684 \u4eba \u544a \u8a34 \u5e0c \u4f2f \u4f86 \u4eba \u4e9e \u4f2f \u862d \uff1b \u4e9e \u4f2f \u862d \u6b63 \u4f4f \u5728 \u4e9e \u6469 \u5229 \u4eba \u5e54 \u5229 \u7684 \u6a61 \u6a39 \u90a3 \u88e1 \u3002 \u5e54 \u5229 \u548c \u4ee5 \u5be6 \u5404 \u4e26 \u4e9e \u4e43 \u90fd \u662f \u5f1f \u5144 \uff0c \u66fe \u8207 \u4e9e \u4f2f \u862d \u806f \u76df \u3002"}, {"pk": 558333, "verse": 14, "text": "\u4e9e \u4f2f \u862d \u807d \u898b \u4ed6 \u59ea \u5152 ( \u539f \u6587 \u4f5c \u5f1f \u5144 ) \u88ab \u64c4 \u53bb \uff0c \u5c31 \u7387 \u9818 \u4ed6 \u5bb6 \u88e1 \u751f \u990a \u7684 \u7cbe \u7df4 \u58ef \u4e01 \u4e09 \u767e \u4e00 \u5341 \u516b \u4eba \uff0c \u76f4 \u8ffd \u5230 \u4f46 \uff0c"}, {"pk": 558334, "verse": 15, "text": "\u4fbf \u5728 \u591c \u9593 \uff0c \u81ea \u5df1 \u540c \u50d5 \u4eba \u5206 \u968a \u6bba \u6557 \u6575 \u4eba \uff0c \u53c8 \u8ffd \u5230 \u5927 \u99ac \u8272 \u5de6 \u908a \u7684 \u4f55 \u628a \uff0c"}, {"pk": 558335, "verse": 16, "text": "\u5c07 \u88ab \u64c4 \u63a0 \u7684 \u4e00 \u5207 \u8ca1 \u7269 \u596a \u56de \u4f86 \uff0c \u9023 \u4ed6 \u59ea \u5152 \u7f85 \u5f97 \u548c \u4ed6 \u7684 \u8ca1 \u7269 \uff0c \u4ee5 \u53ca \u5a66 \u5973 \u3001 \u4eba \u6c11 \u4e5f \u90fd \u596a \u56de \u4f86 \u3002"}, {"pk": 558336, "verse": 17, "text": "\u4e9e \u4f2f \u862d \u6bba \u6557 \u57fa \u5927 \u8001 \u746a \u548c \u8207 \u4ed6 \u540c \u76df \u7684 \u738b \u56de \u4f86 \u7684 \u6642 \u5019 \uff0c \u6240 \u591a \u746a \u738b \u51fa \u4f86 \uff0c \u5728 \u6c99 \u5fae \u8c37 \u8fce \u63a5 \u4ed6 \uff1b \u6c99 \u5fae \u8c37 \u5c31 \u662f \u738b \u8c37 \u3002"}, {"pk": 558337, "verse": 18, "text": "\u53c8 \u6709 \u6492 \u51b7 \u738b \u9ea5 \u57fa \u6d17 \u5fb7 \u5e36 \u8457 \u9905 \u548c \u9152 \u51fa \u4f86 \u8fce \u63a5 \uff1b \u4ed6 \u662f \u81f3 \u9ad8 \u795e \u7684 \u796d \u53f8 \u3002"}, {"pk": 558338, "verse": 19, "text": "\u4ed6 \u70ba \u4e9e \u4f2f \u862d \u795d \u798f \uff0c \u8aaa \uff1a \u9858 \u5929 \u5730 \u7684 \u4e3b \u3001 \u81f3 \u9ad8 \u7684 \u795e \u8cdc \u798f \u8207 \u4e9e \u4f2f \u862d \uff01"}, {"pk": 558339, "verse": 20, "text": "\u81f3 \u9ad8 \u7684 \u795e \u628a \u6575 \u4eba \u4ea4 \u5728 \u4f60 \u624b \u88e1 \uff0c \u662f \u61c9 \u7576 \u7a31 \u980c \u7684 \uff01 \u4e9e \u4f2f \u862d \u5c31 \u628a \u6240 \u5f97 \u7684 \u62ff \u51fa \u5341 \u5206 \u4e4b \u4e00 \u4f86 \uff0c \u7d66 \u9ea5 \u57fa \u6d17 \u5fb7 \u3002"}, {"pk": 558340, "verse": 21, "text": "\u6240 \u591a \u746a \u738b \u5c0d \u4e9e \u4f2f \u862d \u8aaa \uff1a \u4f60 \u628a \u4eba \u53e3 \u7d66 \u6211 \uff0c \u8ca1 \u7269 \u4f60 \u81ea \u5df1 \u62ff \u53bb \u7f77 \uff01"}, {"pk": 558341, "verse": 22, "text": "\u4e9e \u4f2f \u862d \u5c0d \u6240 \u591a \u746a \u738b \u8aaa \uff1a \u6211 \u5df2 \u7d93 \u5411 \u5929 \u5730 \u7684 \u4e3b \u2500 \u81f3 \u9ad8 \u7684 \u795e \u8036 \u548c \u83ef \u8d77 \u8a93 \uff1a"}, {"pk": 558342, "verse": 23, "text": "\u51e1 \u662f \u4f60 \u7684 \u6771 \u897f \uff0c \u5c31 \u662f \u4e00 \u6839 \u7dda \u3001 \u4e00 \u6839 \u978b \u5e36 \uff0c \u6211 \u90fd \u4e0d \u62ff \uff0c \u514d \u5f97 \u4f60 \u8aaa \uff1a \u6211 \u4f7f \u4e9e \u4f2f \u862d \u5bcc \u8db3 \uff01"}, {"pk": 558343, "verse": 24, "text": "\u53ea \u6709 \u50d5 \u4eba \u6240 \u5403 \u7684 \uff0c \u4e26 \u8207 \u6211 \u540c \u884c \u7684 \u4e9e \u4e43 \u3001 \u4ee5 \u5be6 \u5404 \u3001 \u5e54 \u5229 \u6240 \u61c9 \u5f97 \u7684 \u5206 \uff0c \u53ef \u4ee5 \u4efb \u6191 \u4ed6 \u5011 \u62ff \u53bb \u3002"}]