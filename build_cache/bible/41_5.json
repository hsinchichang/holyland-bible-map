[{"pk": 582348, "verse": 1, "text": "\u4ed6 \u5011 \u4f86 \u5230 \u6d77 \u90a3 \u908a \u683c \u62c9 \u68ee \u4eba \u7684 \u5730 \u65b9 \u3002"}, {"pk": 582349, "verse": 2, "text": "\u8036 \u7a4c \u4e00 \u4e0b \u8239 \uff0c \u5c31 \u6709 \u4e00 \u500b \u88ab \u6c61 \u9b3c \u9644 \u8457 \u7684 \u4eba \u5f9e \u58b3 \u584b \u88e1 \u51fa \u4f86 \u8fce \u8457 \u4ed6 \u3002"}, {"pk": 582350, "verse": 3, "text": "\u90a3 \u4eba \u5e38 \u4f4f \u5728 \u58b3 \u584b \u88e1 \uff0c \u6c92 \u6709 \u4eba \u80fd \u6346 \u4f4f \u4ed6 \uff0c \u5c31 \u662f \u7528 \u9435 \u934a \u4e5f \u4e0d \u80fd \uff1b"}, {"pk": 582351, "verse": 4, "text": "\u56e0 \u70ba \u4eba \u5c62 \u6b21 \u7528 \u8173 \u9410 \u548c \u9435 \u934a \u6346 \u9396 \u4ed6 \uff0c \u9435 \u934a \u7adf \u88ab \u4ed6 \u6399 \u65b7 \u4e86 \uff0c \u8173 \u9410 \u4e5f \u88ab \u4ed6 \u5f04 \u788e \u4e86 \uff1b \u7e3d \u6c92 \u6709 \u4eba \u80fd \u5236 \u4f0f \u4ed6 \u3002"}, {"pk": 582352, "verse": 5, "text": "\u4ed6 \u665d \u591c \u5e38 \u5728 \u58b3 \u584b \u88e1 \u548c \u5c71 \u4e2d \u558a \u53eb \uff0c \u53c8 \u7528 \u77f3 \u982d \u780d \u81ea \u5df1 \u3002"}, {"pk": 582353, "verse": 6, "text": "\u4ed6 \u9060 \u9060 \u7684 \u770b \u898b \u8036 \u7a4c \uff0c \u5c31 \u8dd1 \u904e \u53bb \u62dc \u4ed6 \uff0c"}, {"pk": 582354, "verse": 7, "text": "\u5927 \u8072 \u547c \u53eb \u8aaa \uff1a \u81f3 \u9ad8 \u795e \u7684 \u5152 \u5b50 \u8036 \u7a4c \uff0c \u6211 \u8207 \u4f60 \u6709 \u751a \u9ebc \u76f8 \u5e72 \uff1f \u6211 \u6307 \u8457 \u795e \u61c7 \u6c42 \u4f60 \uff0c \u4e0d \u8981 \u53eb \u6211 \u53d7 \u82e6 \uff01"}, {"pk": 582355, "verse": 8, "text": "\u662f \u56e0 \u8036 \u7a4c \u66fe \u5429 \u5490 \u4ed6 \u8aaa \uff1a \u6c61 \u9b3c \u963f \uff0c \u5f9e \u9019 \u4eba \u8eab \u4e0a \u51fa \u4f86 \u7f77 \uff01"}, {"pk": 582356, "verse": 9, "text": "\u8036 \u7a4c \u554f \u4ed6 \u8aaa \uff1a \u4f60 \u540d \u53eb \u751a \u9ebc \uff1f \u56de \u7b54 \u8aaa \uff1a \u6211 \u540d \u53eb \u7fa4 \uff0c \u56e0 \u70ba \u6211 \u5011 \u591a \u7684 \u7de3 \u6545 \uff1b"}, {"pk": 582357, "verse": 10, "text": "\u5c31 \u518d \u4e09 \u7684 \u6c42 \u8036 \u7a4c \uff0c \u4e0d \u8981 \u53eb \u4ed6 \u5011 \u96e2 \u958b \u90a3 \u5730 \u65b9 \u3002"}, {"pk": 582358, "verse": 11, "text": "\u5728 \u90a3 \u88e1 \u5c71 \u5761 \u4e0a \uff0c \u6709 \u4e00 \u5927 \u7fa4 \u8c6c \u5403 \u98df \uff1b"}, {"pk": 582359, "verse": 12, "text": "\u9b3c \u5c31 \u592e \u6c42 \u8036 \u7a4c \u8aaa \uff1a \u6c42 \u4f60 \u6253 \u767c \u6211 \u5011 \u5f80 \u8c6c \u7fa4 \u88e1 \uff0c \u9644 \u8457 \u8c6c \u53bb \u3002"}, {"pk": 582360, "verse": 13, "text": "\u8036 \u7a4c \u51c6 \u4e86 \u4ed6 \u5011 \uff0c \u6c61 \u9b3c \u5c31 \u51fa \u4f86 \uff0c \u9032 \u5165 \u8c6c \u88e1 \u53bb \u3002 \u65bc \u662f \u90a3 \u7fa4 \u8c6c \u95d6 \u4e0b \u5c71 \u5d16 \uff0c \u6295 \u5728 \u6d77 \u88e1 \uff0c \u6df9 \u6b7b \u4e86 \u3002 \u8c6c \u7684 \u6578 \u76ee \u7d04 \u6709 \u4e8c \u5343 \u3002"}, {"pk": 582361, "verse": 14, "text": "\u653e \u8c6c \u7684 \u5c31 \u9003 \u8dd1 \u4e86 \uff0c \u53bb \u544a \u8a34 \u57ce \u88e1 \u548c \u9109 \u4e0b \u7684 \u4eba \u3002 \u773e \u4eba \u5c31 \u4f86 \uff0c \u8981 \u770b \u662f \u751a \u9ebc \u4e8b \u3002"}, {"pk": 582362, "verse": 15, "text": "\u4ed6 \u5011 \u4f86 \u5230 \u8036 \u7a4c \u90a3 \u88e1 \uff0c \u770b \u898b \u90a3 \u88ab \u9b3c \u9644 \u8457 \u7684 \u4eba \uff0c \u5c31 \u662f \u5f9e \u524d \u88ab \u7fa4 \u9b3c \u6240 \u9644 \u7684 \uff0c \u5750 \u8457 \uff0c \u7a7f \u4e0a \u8863 \u670d \uff0c \u5fc3 \u88e1 \u660e \u767d \u904e \u4f86 \uff0c \u4ed6 \u5011 \u5c31 \u5bb3 \u6015 \u3002"}, {"pk": 582363, "verse": 16, "text": "\u770b \u898b \u9019 \u4e8b \u7684 \uff0c \u4fbf \u5c07 \u9b3c \u9644 \u4e4b \u4eba \u6240 \u9047 \u898b \u7684 \u548c \u90a3 \u7fa4 \u8c6c \u7684 \u4e8b \u90fd \u544a \u8a34 \u4e86 \u773e \u4eba \uff1b"}, {"pk": 582364, "verse": 17, "text": "\u773e \u4eba \u5c31 \u592e \u6c42 \u8036 \u7a4c \u96e2 \u958b \u4ed6 \u5011 \u7684 \u5883 \u754c \u3002"}, {"pk": 582365, "verse": 18, "text": "\u8036 \u7a4c \u4e0a \u8239 \u7684 \u6642 \u5019 \uff0c \u90a3 \u5f9e \u524d \u88ab \u9b3c \u9644 \u8457 \u7684 \u4eba \u61c7 \u6c42 \u548c \u8036 \u7a4c \u540c \u5728 \u3002"}, {"pk": 582366, "verse": 19, "text": "\u8036 \u7a4c \u4e0d \u8a31 \uff0c \u537b \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u56de \u5bb6 \u53bb \uff0c \u5230 \u4f60 \u7684 \u89aa \u5c6c \u90a3 \u88e1 \uff0c \u5c07 \u4e3b \u70ba \u4f60 \u6240 \u505a \u7684 \u662f \u4f55 \u7b49 \u5927 \u7684 \u4e8b \uff0c \u662f \u600e \u6a23 \u6190 \u61ab \u4f60 \uff0c \u90fd \u544a \u8a34 \u4ed6 \u5011 \u3002"}, {"pk": 582367, "verse": 20, "text": "\u90a3 \u4eba \u5c31 \u8d70 \u4e86 \uff0c \u5728 \u4f4e \u52a0 \u6ce2 \u5229 \u50b3 \u63da \u8036 \u7a4c \u70ba \u4ed6 \u505a \u4e86 \u4f55 \u7b49 \u5927 \u7684 \u4e8b \uff0c \u773e \u4eba \u5c31 \u90fd \u5e0c \u5947 \u3002"}, {"pk": 582368, "verse": 21, "text": "\u8036 \u7a4c \u5750 \u8239 \u53c8 \u6e21 \u5230 \u90a3 \u908a \u53bb \uff0c \u5c31 \u6709 \u8a31 \u591a \u4eba \u5230 \u4ed6 \u90a3 \u88e1 \u805a \u96c6 \uff1b \u4ed6 \u6b63 \u5728 \u6d77 \u908a \u4e0a \u3002"}, {"pk": 582369, "verse": 22, "text": "\u6709 \u4e00 \u500b \u7ba1 \u6703 \u5802 \u7684 \u4eba \uff0c \u540d \u53eb \u775a \u9b6f \uff0c \u4f86 \u898b \u8036 \u7a4c \uff0c \u5c31 \u4fef \u4f0f \u5728 \u4ed6 \u8173 \u524d \uff0c"}, {"pk": 582370, "verse": 23, "text": "\u518d \u4e09 \u7684 \u6c42 \u4ed6 \uff0c \u8aaa \uff1a \u6211 \u7684 \u5c0f \u5973 \u5152 \u5feb \u8981 \u6b7b \u4e86 \uff0c \u6c42 \u4f60 \u53bb \u6309 \u624b \u5728 \u4ed6 \u8eab \u4e0a \uff0c \u4f7f \u4ed6 \u75ca \u6108 \uff0c \u5f97 \u4ee5 \u6d3b \u4e86 \u3002"}, {"pk": 582371, "verse": 24, "text": "\u8036 \u7a4c \u5c31 \u548c \u4ed6 \u540c \u53bb \u3002 \u6709 \u8a31 \u591a \u4eba \u8ddf \u96a8 \u64c1 \u64e0 \u4ed6 \u3002"}, {"pk": 582372, "verse": 25, "text": "\u6709 \u4e00 \u500b \u5973 \u4eba \uff0c \u60a3 \u4e86 \u5341 \u4e8c \u5e74 \u7684 \u8840 \u6f0f \uff0c"}, {"pk": 582373, "verse": 26, "text": "\u5728 \u597d \u4e9b \u91ab \u751f \u624b \u88e1 \u53d7 \u4e86 \u8a31 \u591a \u7684 \u82e6 \uff0c \u53c8 \u82b1 \u76e1 \u4e86 \u4ed6 \u6240 \u6709 \u7684 \uff0c \u4e00 \u9ede \u4e5f \u4e0d \u898b \u597d \uff0c \u75c5 \u52e2 \u53cd \u5012 \u66f4 \u91cd \u4e86 \u3002"}, {"pk": 582374, "verse": 27, "text": "\u4ed6 \u807d \u898b \u8036 \u7a4c \u7684 \u4e8b \uff0c \u5c31 \u5f9e \u5f8c \u982d \u4f86 \uff0c \u96dc \u5728 \u773e \u4eba \u4e2d \u9593 \uff0c \u6478 \u8036 \u7a4c \u7684 \u8863 \u88f3 \uff0c"}, {"pk": 582375, "verse": 28, "text": "\u610f \u601d \u8aaa \uff1a \u6211 \u53ea \u6478 \u4ed6 \u7684 \u8863 \u88f3 \uff0c \u5c31 \u5fc5 \u75ca \u6108 \u3002"}, {"pk": 582376, "verse": 29, "text": "\u65bc \u662f \u4ed6 \u8840 \u6f0f \u7684 \u6e90 \u982d \u7acb \u523b \u4e7e \u4e86 \uff1b \u4ed6 \u4fbf \u89ba \u5f97 \u8eab \u4e0a \u7684 \u707d \u75c5 \u597d \u4e86 \u3002"}, {"pk": 582377, "verse": 30, "text": "\u8036 \u7a4c \u9813 \u6642 \u5fc3 \u88e1 \u89ba \u5f97 \u6709 \u80fd \u529b \u5f9e \u81ea \u5df1 \u8eab \u4e0a \u51fa \u53bb \uff0c \u5c31 \u5728 \u773e \u4eba \u4e2d \u9593 \u8f49 \u904e \u4f86 \uff0c \u8aaa \uff1a \u8ab0 \u6478 \u6211 \u7684 \u8863 \u88f3 \uff1f"}, {"pk": 582378, "verse": 31, "text": "\u9580 \u5f92 \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u770b \u773e \u4eba \u64c1 \u64e0 \u4f60 \uff0c \u9084 \u8aaa \u8ab0 \u6478 \u6211 \u9ebc \uff1f"}, {"pk": 582379, "verse": 32, "text": "\u8036 \u7a4c \u5468 \u570d \u89c0 \u770b \uff0c \u8981 \u898b \u505a \u9019 \u4e8b \u7684 \u5973 \u4eba \u3002"}, {"pk": 582380, "verse": 33, "text": "\u90a3 \u5973 \u4eba \u77e5 \u9053 \u5728 \u81ea \u5df1 \u8eab \u4e0a \u6240 \u6210 \u7684 \u4e8b \uff0c \u5c31 \u6050 \u61fc \u6230 \u5162 \uff0c \u4f86 \u4fef \u4f0f \u5728 \u8036 \u7a4c \u8ddf \u524d \uff0c \u5c07 \u5be6 \u60c5 \u5168 \u544a \u8a34 \u4ed6 \u3002"}, {"pk": 582381, "verse": 34, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u5973 \u5152 \uff0c \u4f60 \u7684 \u4fe1 \u6551 \u4e86 \u4f60 \uff0c \u5e73 \u5e73 \u5b89 \u5b89 \u7684 \u56de \u53bb \u7f77 \uff01 \u4f60 \u7684 \u707d \u75c5 \u75ca \u6108 \u4e86 \u3002"}, {"pk": 582382, "verse": 35, "text": "\u9084 \u8aaa \u8a71 \u7684 \u6642 \u5019 \uff0c \u6709 \u4eba \u5f9e \u7ba1 \u6703 \u5802 \u7684 \u5bb6 \u88e1 \u4f86 \uff0c \u8aaa \uff1a \u4f60 \u7684 \u5973 \u5152 \u6b7b \u4e86 \uff0c \u4f55 \u5fc5 \u9084 \u52de \u52d5 \u5148 \u751f \u5462 \uff1f"}, {"pk": 582383, "verse": 36, "text": "\u8036 \u7a4c \u807d \u898b \u6240 \u8aaa \u7684 \u8a71 \uff0c \u5c31 \u5c0d \u7ba1 \u6703 \u5802 \u7684 \u8aaa \uff1a \u4e0d \u8981 \u6015 \uff0c \u53ea \u8981 \u4fe1 \uff01"}, {"pk": 582384, "verse": 37, "text": "\u65bc \u662f \u5e36 \u8457 \u5f7c \u5f97 \u3001 \u96c5 \u5404 \u3001 \u548c \u96c5 \u5404 \u7684 \u5144 \u5f1f \u7d04 \u7ff0 \u540c \u53bb \uff0c \u4e0d \u8a31 \u5225 \u4eba \u8ddf \u96a8 \u4ed6 \u3002"}, {"pk": 582385, "verse": 38, "text": "\u4ed6 \u5011 \u4f86 \u5230 \u7ba1 \u6703 \u5802 \u7684 \u5bb6 \u88e1 \uff1b \u8036 \u7a4c \u770b \u898b \u90a3 \u88e1 \u4e82 \u56b7 \uff0c \u4e26 \u6709 \u4eba \u5927 \u5927 \u7684 \u54ed \u6ce3 \u54c0 \u865f \uff0c"}, {"pk": 582386, "verse": 39, "text": "\u9032 \u5230 \u88e1 \u9762 \uff0c \u5c31 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u70ba \u751a \u9ebc \u4e82 \u56b7 \u54ed \u6ce3 \u5462 \uff1f \u5b69 \u5b50 \u4e0d \u662f \u6b7b \u4e86 \uff0c \u662f \u7761 \u8457 \u4e86 \u3002"}, {"pk": 582387, "verse": 40, "text": "\u4ed6 \u5011 \u5c31 \u55e4 \u7b11 \u8036 \u7a4c \u3002 \u8036 \u7a4c \u628a \u4ed6 \u5011 \u90fd \u6506 \u51fa \u53bb \uff0c \u5c31 \u5e36 \u8457 \u5b69 \u5b50 \u7684 \u7236 \u6bcd \uff0c \u548c \u8ddf \u96a8 \u7684 \u4eba \u9032 \u4e86 \u5b69 \u5b50 \u6240 \u5728 \u7684 \u5730 \u65b9 \uff0c"}, {"pk": 582388, "verse": 41, "text": "\u5c31 \u62c9 \u8457 \u5b69 \u5b50 \u7684 \u624b \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u5927 \u5229 \u5927 \uff0c \u53e4 \u7c73 \uff01 \u7e59 \u51fa \u4f86 \u5c31 \u662f \u8aaa \uff1a \u95a8 \u5973 \uff0c \u6211 \u5429 \u5490 \u4f60 \u8d77 \u4f86 \uff01"}, {"pk": 582389, "verse": 42, "text": "\u90a3 \u95a8 \u5973 \u7acb \u6642 \u8d77 \u4f86 \u8d70 \u3002 \u4ed6 \u5011 \u5c31 \u5927 \u5927 \u7684 \u9a5a \u5947 \uff1b \u95a8 \u5973 \u5df2 \u7d93 \u5341 \u4e8c \u6b72 \u4e86 \u3002"}, {"pk": 582390, "verse": 43, "text": "\u8036 \u7a4c \u5207 \u5207 \u7684 \u56d1 \u5490 \u4ed6 \u5011 \uff0c \u4e0d \u8981 \u53eb \u4eba \u77e5 \u9053 \u9019 \u4e8b \uff0c \u53c8 \u5429 \u5490 \u7d66 \u4ed6 \u6771 \u897f \u5403 \u3002"}]