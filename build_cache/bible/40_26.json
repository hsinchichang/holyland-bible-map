[{"pk": 582038, "verse": 1, "text": "\u8036 \u7a4c \u8aaa \u5b8c \u4e86 \u9019 \u4e00 \u5207 \u7684 \u8a71 \uff0c \u5c31 \u5c0d \u9580 \u5f92 \u8aaa \uff1a"}, {"pk": 582039, "verse": 2, "text": "\u4f60 \u5011 \u77e5 \u9053 \uff0c \u904e \u5169 \u5929 \u662f \u903e \u8d8a \u7bc0 \uff0c \u4eba \u5b50 \u5c07 \u8981 \u88ab \u4ea4 \u7d66 \u4eba \uff0c \u91d8 \u5728 \u5341 \u5b57 \u67b6 \u4e0a \u3002"}, {"pk": 582040, "verse": 3, "text": "\u90a3 \u6642 \uff0c \u796d \u53f8 \u9577 \u548c \u6c11 \u9593 \u7684 \u9577 \u8001 \u805a \u96c6 \u5728 \u5927 \u796d \u53f8 \u7a31 \u70ba \u8a72 \u4e9e \u6cd5 \u7684 \u9662 \u88e1 \u3002"}, {"pk": 582041, "verse": 4, "text": "\u5927 \u5bb6 \u5546 \u8b70 \u8981 \u7528 \u8a6d \u8a08 \u62ff \u4f4f \u8036 \u7a4c \uff0c \u6bba \u4ed6 \uff0c"}, {"pk": 582042, "verse": 5, "text": "\u53ea \u662f \u8aaa \uff1a \u7576 \u7bc0 \u7684 \u65e5 \u5b50 \u4e0d \u53ef \uff0c \u6050 \u6015 \u6c11 \u9593 \u751f \u4e82 \u3002"}, {"pk": 582043, "verse": 6, "text": "\u8036 \u7a4c \u5728 \u4f2f \u5927 \u5c3c \u9577 \u5927 \u75f2 \u760b \u7684 \u897f \u9580 \u5bb6 \u88e1 \uff0c"}, {"pk": 582044, "verse": 7, "text": "\u6709 \u4e00 \u500b \u5973 \u4eba \u62ff \u8457 \u4e00 \u7389 \u74f6 \u6975 \u8cb4 \u7684 \u9999 \u818f \u4f86 \uff0c \u8d81 \u8036 \u7a4c \u5750 \u5e2d \u7684 \u6642 \u5019 \uff0c \u6f86 \u5728 \u4ed6 \u7684 \u982d \u4e0a \u3002"}, {"pk": 582045, "verse": 8, "text": "\u9580 \u5f92 \u770b \u898b \u5c31 \u5f88 \u4e0d \u559c \u6085 \uff0c \u8aaa \uff1a \u4f55 \u7528 \u9019 \u6a23 \u7684 \u6789 \u8cbb \u5462 \uff01"}, {"pk": 582046, "verse": 9, "text": "\u9019 \u9999 \u818f \u53ef \u4ee5 \u8ce3 \u8a31 \u591a \u9322 \uff0c \u8cd9 \u6fdf \u7aae \u4eba \u3002"}, {"pk": 582047, "verse": 10, "text": "\u8036 \u7a4c \u770b \u51fa \u4ed6 \u5011 \u7684 \u610f \u601d \uff0c \u5c31 \u8aaa \uff1a \u70ba \u751a \u9ebc \u96e3 \u70ba \u9019 \u5973 \u4eba \u5462 \uff1f \u4ed6 \u5728 \u6211 \u8eab \u4e0a \u505a \u7684 \u662f \u4e00 \u4ef6 \u7f8e \u4e8b \u3002"}, {"pk": 582048, "verse": 11, "text": "\u56e0 \u70ba \u5e38 \u6709 \u7aae \u4eba \u548c \u4f60 \u5011 \u540c \u5728 \uff1b \u53ea \u662f \u4f60 \u5011 \u4e0d \u5e38 \u6709 \u6211 \u3002"}, {"pk": 582049, "verse": 12, "text": "\u4ed6 \u5c07 \u9019 \u9999 \u818f \u6f86 \u5728 \u6211 \u8eab \u4e0a \u662f \u70ba \u6211 \u5b89 \u846c \u505a \u7684 \u3002"}, {"pk": 582050, "verse": 13, "text": "\u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u666e \u5929 \u4e4b \u4e0b \uff0c \u7121 \u8ad6 \u5728 \u751a \u9ebc \u5730 \u65b9 \u50b3 \u9019 \u798f \u97f3 \uff0c \u4e5f \u8981 \u8ff0 \u8aaa \u9019 \u5973 \u4eba \u6240 \u884c \u7684 \uff0c \u4f5c \u500b \u7d00 \u5ff5 \u3002"}, {"pk": 582051, "verse": 14, "text": "\u7576 \u4e0b \uff0c \u5341 \u4e8c \u9580 \u5f92 \u88e1 \u6709 \u4e00 \u500b \u7a31 \u70ba \u52a0 \u7565 \u4eba \u7336 \u5927 \u7684 \uff0c \u53bb \u898b \u796d \u53f8 \u9577 \uff0c"}, {"pk": 582052, "verse": 15, "text": "\u8aaa \uff1a \u6211 \u628a \u4ed6 \u4ea4 \u7d66 \u4f60 \u5011 \uff0c \u4f60 \u5011 \u9858 \u610f \u7d66 \u6211 \u591a \u5c11 \u9322 \uff1f \u4ed6 \u5011 \u5c31 \u7d66 \u4e86 \u4ed6 \u4e09 \u5341 \u584a \u9322 \u3002"}, {"pk": 582053, "verse": 16, "text": "\u5f9e \u90a3 \u6642 \u5019 \uff0c \u4ed6 \u5c31 \u627e \u6a5f \u6703 \u8981 \u628a \u8036 \u7a4c \u4ea4 \u7d66 \u4ed6 \u5011 \u3002"}, {"pk": 582054, "verse": 17, "text": "\u9664 \u9175 \u7bc0 \u7684 \u7b2c \u4e00 \u5929 \uff0c \u9580 \u5f92 \u4f86 \u554f \u8036 \u7a4c \u8aaa \uff1a \u4f60 \u5403 \u903e \u8d8a \u7bc0 \u7684 \u7b75 \u5e2d \uff0c \u8981 \u6211 \u5011 \u5728 \u90a3 \u88e1 \u7d66 \u4f60 \u9810 \u5099 \uff1f"}, {"pk": 582055, "verse": 18, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4f60 \u5011 \u9032 \u57ce \u53bb \uff0c \u5230 \u67d0 \u4eba \u90a3 \u88e1 \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u592b \u5b50 \u8aaa \uff1a \u6211 \u7684 \u6642 \u5019 \u5feb \u5230 \u4e86 \uff0c \u6211 \u8207 \u9580 \u5f92 \u8981 \u5728 \u4f60 \u5bb6 \u88e1 \u5b88 \u903e \u8d8a \u7bc0 \u3002"}, {"pk": 582056, "verse": 19, "text": "\u9580 \u5f92 \u9075 \u8457 \u8036 \u7a4c \u6240 \u5429 \u5490 \u7684 \u5c31 \u53bb \u9810 \u5099 \u4e86 \u903e \u8d8a \u7bc0 \u7684 \u7b75 \u5e2d \u3002"}, {"pk": 582057, "verse": 20, "text": "\u5230 \u4e86 \u665a \u4e0a \uff0c \u8036 \u7a4c \u548c \u5341 \u4e8c \u500b \u9580 \u5f92 \u5750 \u5e2d \u3002"}, {"pk": 582058, "verse": 21, "text": "\u6b63 \u5403 \u7684 \u6642 \u5019 \uff0c \u8036 \u7a4c \u8aaa \uff1a \u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4f60 \u5011 \u4e2d \u9593 \u6709 \u4e00 \u500b \u4eba \u8981 \u8ce3 \u6211 \u4e86 \u3002"}, {"pk": 582059, "verse": 22, "text": "\u4ed6 \u5011 \u5c31 \u751a \u6182 \u6101 \uff0c \u4e00 \u500b \u4e00 \u500b \u7684 \u554f \u4ed6 \u8aaa \uff1a \u4e3b \uff0c \u662f \u6211 \u9ebc \uff1f"}, {"pk": 582060, "verse": 23, "text": "\u8036 \u7a4c \u56de \u7b54 \u8aaa \uff1a \u540c \u6211 \u8638 \u624b \u5728 \u76e4 \u5b50 \u88e1 \u7684 \uff0c \u5c31 \u662f \u4ed6 \u8981 \u8ce3 \u6211 \u3002"}, {"pk": 582061, "verse": 24, "text": "\u4eba \u5b50 \u5fc5 \u8981 \u53bb \u4e16 \uff0c \u6b63 \u5982 \u7d93 \u4e0a \u6307 \u8457 \u4ed6 \u6240 \u5beb \u7684 \uff1b \u4f46 \u8ce3 \u4eba \u5b50 \u7684 \u4eba \u6709 \u798d \u4e86 \uff01 \u90a3 \u4eba \u4e0d \u751f \u5728 \u4e16 \u4e0a \u5012 \u597d \u3002"}, {"pk": 582062, "verse": 25, "text": "\u8ce3 \u8036 \u7a4c \u7684 \u7336 \u5927 \u554f \u4ed6 \u8aaa \uff1a \u62c9 \u6bd4 \uff0c \u662f \u6211 \u9ebc \uff1f \u8036 \u7a4c \u8aaa \uff1a \u4f60 \u8aaa \u7684 \u662f \u3002"}, {"pk": 582063, "verse": 26, "text": "\u4ed6 \u5011 \u5403 \u7684 \u6642 \u5019 \uff0c \u8036 \u7a4c \u62ff \u8d77 \u9905 \u4f86 \uff0c \u795d \u798f \uff0c \u5c31 \u64d8 \u958b \uff0c \u905e \u7d66 \u9580 \u5f92 \uff0c \u8aaa \uff1a \u4f60 \u5011 \u62ff \u8457 \u5403 \uff0c \u9019 \u662f \u6211 \u7684 \u8eab \u9ad4 \uff1b"}, {"pk": 582064, "verse": 27, "text": "\u53c8 \u62ff \u8d77 \u676f \u4f86 \uff0c \u795d \u8b1d \u4e86 \uff0c \u905e \u7d66 \u4ed6 \u5011 \uff0c \u8aaa \uff1a \u4f60 \u5011 \u90fd \u559d \u9019 \u500b \uff1b"}, {"pk": 582065, "verse": 28, "text": "\u56e0 \u70ba \u9019 \u662f \u6211 \u7acb \u7d04 \u7684 \u8840 \uff0c \u70ba \u591a \u4eba \u6d41 \u51fa \u4f86 \uff0c \u4f7f \u7f6a \u5f97 \u8d66 \u3002"}, {"pk": 582066, "verse": 29, "text": "\u4f46 \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u5f9e \u4eca \u4ee5 \u5f8c \uff0c \u6211 \u4e0d \u518d \u559d \u9019 \u8461 \u8404 \u6c41 \uff0c \u76f4 \u5230 \u6211 \u5728 \u6211 \u7236 \u7684 \u570b \u88e1 \u540c \u4f60 \u5011 \u559d \u65b0 \u7684 \u90a3 \u65e5 \u5b50 \u3002"}, {"pk": 582067, "verse": 30, "text": "\u4ed6 \u5011 \u5531 \u4e86 \u8a69 \uff0c \u5c31 \u51fa \u4f86 \u5f80 \u6a44 \u6b16 \u5c71 \u53bb \u3002"}, {"pk": 582068, "verse": 31, "text": "\u90a3 \u6642 \uff0c \u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4eca \u591c \uff0c \u4f60 \u5011 \u70ba \u6211 \u7684 \u7de3 \u6545 \u90fd \u8981 \u8dcc \u5012 \u3002 \u56e0 \u70ba \u7d93 \u4e0a \u8a18 \u8457 \u8aaa \uff1a \u6211 \u8981 \u64ca \u6253 \u7267 \u4eba \uff0c \u7f8a \u5c31 \u5206 \u6563 \u4e86 \u3002"}, {"pk": 582069, "verse": 32, "text": "\u4f46 \u6211 \u5fa9 \u6d3b \u4ee5 \u5f8c \uff0c \u8981 \u5728 \u4f60 \u5011 \u4ee5 \u5148 \u5f80 \u52a0 \u5229 \u5229 \u53bb \u3002"}, {"pk": 582070, "verse": 33, "text": "\u5f7c \u5f97 \u8aaa \uff1a \u773e \u4eba \u96d6 \u7136 \u70ba \u4f60 \u7684 \u7de3 \u6545 \u8dcc \u5012 \uff0c \u6211 \u537b \u6c38 \u4e0d \u8dcc \u5012 \u3002"}, {"pk": 582071, "verse": 34, "text": "\u8036 \u7a4c \u8aaa \uff1a \u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \uff0c \u4eca \u591c \u96de \u53eb \u4ee5 \u5148 \uff0c \u4f60 \u8981 \u4e09 \u6b21 \u4e0d \u8a8d \u6211 \u3002"}, {"pk": 582072, "verse": 35, "text": "\u5f7c \u5f97 \u8aaa \uff1a \u6211 \u5c31 \u662f \u5fc5 \u9808 \u548c \u4f60 \u540c \u6b7b \uff0c \u4e5f \u7e3d \u4e0d \u80fd \u4e0d \u8a8d \u4f60 \u3002 \u773e \u9580 \u5f92 \u90fd \u662f \u9019 \u6a23 \u8aaa \u3002"}, {"pk": 582073, "verse": 36, "text": "\u8036 \u7a4c \u540c \u9580 \u5f92 \u4f86 \u5230 \u4e00 \u500b \u5730 \u65b9 \uff0c \u540d \u53eb \u5ba2 \u897f \u99ac \u5c3c \uff0c \u5c31 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u5750 \u5728 \u9019 \u88e1 \uff0c \u7b49 \u6211 \u5230 \u90a3 \u908a \u53bb \u79b1 \u544a \u3002"}, {"pk": 582074, "verse": 37, "text": "\u65bc \u662f \u5e36 \u8457 \u5f7c \u5f97 \u548c \u897f \u5e87 \u592a \u7684 \u5169 \u500b \u5152 \u5b50 \u540c \u53bb \uff0c \u5c31 \u6182 \u6101 \u8d77 \u4f86 \uff0c \u6975 \u5176 \u96e3 \u904e \uff0c"}, {"pk": 582075, "verse": 38, "text": "\u4fbf \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u6211 \u5fc3 \u88e1 \u751a \u662f \u6182 \u50b7 \uff0c \u5e7e \u4e4e \u8981 \u6b7b \uff1b \u4f60 \u5011 \u5728 \u9019 \u88e1 \u7b49 \u5019 \uff0c \u548c \u6211 \u4e00 \u540c \u5106 \u9192 \u3002"}, {"pk": 582076, "verse": 39, "text": "\u4ed6 \u5c31 \u7a0d \u5f80 \u524d \u8d70 \uff0c \u4fef \u4f0f \u5728 \u5730 \uff0c \u79b1 \u544a \u8aaa \uff1a \u6211 \u7236 \u963f \uff0c \u5018 \u82e5 \u53ef \u884c \uff0c \u6c42 \u4f60 \u53eb \u9019 \u676f \u96e2 \u958b \u6211 \u3002 \u7136 \u800c \uff0c \u4e0d \u8981 \u7167 \u6211 \u7684 \u610f \u601d \uff0c \u53ea \u8981 \u7167 \u4f60 \u7684 \u610f \u601d \u3002"}, {"pk": 582077, "verse": 40, "text": "\u4f86 \u5230 \u9580 \u5f92 \u90a3 \u88e1 \uff0c \u898b \u4ed6 \u5011 \u7761 \u8457 \u4e86 \uff0c \u5c31 \u5c0d \u5f7c \u5f97 \u8aaa \uff1a \u600e \u9ebc \u6a23 \uff1f \u4f60 \u5011 \u4e0d \u80fd \u540c \u6211 \u5106 \u9192 \u7247 \u6642 \u9ebc \uff1f"}, {"pk": 582078, "verse": 41, "text": "\u7e3d \u8981 \u5106 \u9192 \u79b1 \u544a \uff0c \u514d \u5f97 \u5165 \u4e86 \u8ff7 \u60d1 \u3002 \u4f60 \u5011 \u5fc3 \u9748 \u56fa \u7136 \u9858 \u610f \uff0c \u8089 \u9ad4 \u537b \u8edf \u5f31 \u4e86 \u3002"}, {"pk": 582079, "verse": 42, "text": "\u7b2c \u4e8c \u6b21 \u53c8 \u53bb \u79b1 \u544a \u8aaa \uff1a \u6211 \u7236 \u963f \uff0c \u9019 \u676f \u82e5 \u4e0d \u80fd \u96e2 \u958b \u6211 \uff0c \u5fc5 \u8981 \u6211 \u559d \uff0c \u5c31 \u9858 \u4f60 \u7684 \u610f \u65e8 \u6210 \u5168 \u3002"}, {"pk": 582080, "verse": 43, "text": "\u53c8 \u4f86 \uff0c \u898b \u4ed6 \u5011 \u7761 \u8457 \u4e86 \uff0c \u56e0 \u70ba \u4ed6 \u5011 \u7684 \u773c \u775b \u56f0 \u5026 \u3002"}, {"pk": 582081, "verse": 44, "text": "\u8036 \u7a4c \u53c8 \u96e2 \u958b \u4ed6 \u5011 \u53bb \u4e86 \u3002 \u7b2c \u4e09 \u6b21 \u79b1 \u544a \uff0c \u8aaa \u7684 \u8a71 \u9084 \u662f \u8207 \u5148 \u524d \u4e00 \u6a23 \u3002"}, {"pk": 582082, "verse": 45, "text": "\u65bc \u662f \u4f86 \u5230 \u9580 \u5f92 \u90a3 \u88e1 \uff0c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u73fe \u5728 \u4f60 \u5011 \u4ecd \u7136 \u7761 \u89ba \u5b89 \u6b47 \u7f77 \uff08 \u7f77 \uff1a \u6216 \u4f5c \u9ebc \uff1f \uff09 \uff01 \u6642 \u5019 \u5230 \u4e86 \uff0c \u4eba \u5b50 \u88ab \u8ce3 \u5728 \u7f6a \u4eba \u624b \u88e1 \u4e86 \u3002"}, {"pk": 582083, "verse": 46, "text": "\u8d77 \u4f86 \uff01 \u6211 \u5011 \u8d70 \u7f77 \u3002 \u770b \u54ea \uff0c \u8ce3 \u6211 \u7684 \u4eba \u8fd1 \u4e86 \u3002"}, {"pk": 582084, "verse": 47, "text": "\u8aaa \u8a71 \u4e4b \u9593 \uff0c \u90a3 \u5341 \u4e8c \u500b \u9580 \u5f92 \u88e1 \u7684 \u7336 \u5927 \u4f86 \u4e86 \uff0c \u4e26 \u6709 \u8a31 \u591a \u4eba \u5e36 \u8457 \u5200 \u68d2 \uff0c \u5f9e \u796d \u53f8 \u9577 \u548c \u6c11 \u9593 \u7684 \u9577 \u8001 \u90a3 \u88e1 \u8207 \u4ed6 \u540c \u4f86 \u3002"}, {"pk": 582085, "verse": 48, "text": "\u90a3 \u8ce3 \u8036 \u7a4c \u7684 \u7d66 \u4e86 \u4ed6 \u5011 \u4e00 \u500b \u6697 \u865f \uff0c \u8aaa \uff1a \u6211 \u8207 \u8ab0 \u89aa \u5634 \uff0c \u8ab0 \u5c31 \u662f \u4ed6 \u3002 \u4f60 \u5011 \u53ef \u4ee5 \u62ff \u4f4f \u4ed6 \u3002"}, {"pk": 582086, "verse": 49, "text": "\u7336 \u5927 \u96a8 \u5373 \u5230 \u8036 \u7a4c \u8ddf \u524d \uff0c \u8aaa \uff1a \u8acb \u62c9 \u6bd4 \u5b89 \uff0c \u5c31 \u8207 \u4ed6 \u89aa \u5634 \u3002"}, {"pk": 582087, "verse": 50, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u670b \u53cb \uff0c \u4f60 \u4f86 \u8981 \u505a \u7684 \u4e8b \uff0c \u5c31 \u505a \u7f77 \u3002 \u65bc \u662f \u90a3 \u4e9b \u4eba \u4e0a \u524d \uff0c \u4e0b \u624b \u62ff \u4f4f \u8036 \u7a4c \u3002"}, {"pk": 582088, "verse": 51, "text": "\u6709 \u8ddf \u96a8 \u8036 \u7a4c \u7684 \u4e00 \u500b \u4eba \u4f38 \u624b \u62d4 \u51fa \u5200 \u4f86 \uff0c \u5c07 \u5927 \u796d \u53f8 \u7684 \u50d5 \u4eba \u780d \u4e86 \u4e00 \u5200 \uff0c \u524a \u6389 \u4e86 \u4ed6 \u4e00 \u500b \u8033 \u6735 \u3002"}, {"pk": 582089, "verse": 52, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u6536 \u5200 \u5165 \u9798 \u7f77 \uff01 \u51e1 \u52d5 \u5200 \u7684 \uff0c \u5fc5 \u6b7b \u5728 \u5200 \u4e0b \u3002"}, {"pk": 582090, "verse": 53, "text": "\u4f60 \u60f3 \uff0c \u6211 \u4e0d \u80fd \u6c42 \u6211 \u7236 \u73fe \u5728 \u70ba \u6211 \u5dee \u9063 \u5341 \u4e8c \u71df \u591a \u5929 \u4f7f \u4f86 \u9ebc \uff1f"}, {"pk": 582091, "verse": 54, "text": "\u82e5 \u662f \u9019 \u6a23 \uff0c \u7d93 \u4e0a \u6240 \u8aaa \uff0c \u4e8b \u60c5 \u5fc5 \u9808 \u5982 \u6b64 \u7684 \u8a71 \u600e \u9ebc \u61c9 \u9a57 \u5462 \uff1f"}, {"pk": 582092, "verse": 55, "text": "\u7576 \u6642 \uff0c \u8036 \u7a4c \u5c0d \u773e \u4eba \u8aaa \uff1a \u4f60 \u5011 \u5e36 \u8457 \u5200 \u68d2 \u51fa \u4f86 \u62ff \u6211 \uff0c \u5982 \u540c \u62ff \u5f37 \u76dc \u9ebc \uff1f \u6211 \u5929 \u5929 \u5750 \u5728 \u6bbf \u88e1 \u6559 \u8a13 \u4eba \uff0c \u4f60 \u5011 \u4e26 \u6c92 \u6709 \u62ff \u6211 \u3002"}, {"pk": 582093, "verse": 56, "text": "\u4f46 \u9019 \u4e00 \u5207 \u7684 \u4e8b \u6210 \u5c31 \u4e86 \uff0c \u70ba \u8981 \u61c9 \u9a57 \u5148 \u77e5 \u66f8 \u4e0a \u7684 \u8a71 \u3002 \u7576 \u4e0b \uff0c \u9580 \u5f92 \u90fd \u96e2 \u958b \u4ed6 \u9003 \u8d70 \u4e86 \u3002"}, {"pk": 582094, "verse": 57, "text": "\u62ff \u8036 \u7a4c \u7684 \u4eba \u628a \u4ed6 \u5e36 \u5230 \u5927 \u796d \u53f8 \u8a72 \u4e9e \u6cd5 \u90a3 \u88e1 \u53bb \uff1b \u6587 \u58eb \u548c \u9577 \u8001 \u5df2 \u7d93 \u5728 \u90a3 \u88e1 \u805a \u6703 \u3002"}, {"pk": 582095, "verse": 58, "text": "\u5f7c \u5f97 \u9060 \u9060 \u7684 \u8ddf \u8457 \u8036 \u7a4c \uff0c \u76f4 \u5230 \u5927 \u796d \u53f8 \u7684 \u9662 \u5b50 \uff0c \u9032 \u5230 \u88e1 \u9762 \uff0c \u5c31 \u548c \u5dee \u5f79 \u540c \u5750 \uff0c \u8981 \u770b \u9019 \u4e8b \u5230 \u5e95 \u600e \u6a23 \u3002"}, {"pk": 582096, "verse": 59, "text": "\u796d \u53f8 \u9577 \u548c \u5168 \u516c \u6703 \u5c0b \u627e \u5047 \u898b \u8b49 \u63a7 \u544a \u8036 \u7a4c \uff0c \u8981 \u6cbb \u6b7b \u4ed6 \u3002"}, {"pk": 582097, "verse": 60, "text": "\u96d6 \u6709 \u597d \u4e9b \u4eba \u4f86 \u4f5c \u5047 \u898b \u8b49 \uff0c \u7e3d \u5f97 \u4e0d \u8457 \u5be6 \u64da \u3002 \u672b \u5f8c \u6709 \u5169 \u500b \u4eba \u524d \u4f86 \uff0c \u8aaa \uff1a"}, {"pk": 582098, "verse": 61, "text": "\u9019 \u500b \u4eba \u66fe \u8aaa \uff1a \u6211 \u80fd \u62c6 \u6bc0 \u795e \u7684 \u6bbf \uff0c \u4e09 \u65e5 \u5167 \u53c8 \u5efa \u9020 \u8d77 \u4f86 \u3002"}, {"pk": 582099, "verse": 62, "text": "\u5927 \u796d \u53f8 \u5c31 \u7ad9 \u8d77 \u4f86 \uff0c \u5c0d \u8036 \u7a4c \u8aaa \uff1a \u4f60 \u751a \u9ebc \u90fd \u4e0d \u56de \u7b54 \u9ebc \uff1f \u9019 \u4e9b \u4eba \u4f5c \u898b \u8b49 \u544a \u4f60 \u7684 \u662f \u751a \u9ebc \u5462 \uff1f"}, {"pk": 582100, "verse": 63, "text": "\u8036 \u7a4c \u537b \u4e0d \u8a00 \u8a9e \u3002 \u5927 \u796d \u53f8 \u5c0d \u4ed6 \u8aaa \uff1a \u6211 \u6307 \u8457 \u6c38 \u751f \u795e \u53eb \u4f60 \u8d77 \u8a93 \u544a \u8a34 \u6211 \u5011 \uff0c \u4f60 \u662f \u795e \u7684 \u5152 \u5b50 \u57fa \u7763 \u4e0d \u662f \uff1f"}, {"pk": 582101, "verse": 64, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u8aaa \u7684 \u662f \u3002 \u7136 \u800c \uff0c \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u5f8c \u4f86 \u4f60 \u5011 \u8981 \u770b \u898b \u4eba \u5b50 \u5750 \u5728 \u90a3 \u6b0a \u80fd \u8005 \u7684 \u53f3 \u908a \uff0c \u99d5 \u8457 \u5929 \u4e0a \u7684 \u96f2 \u964d \u81e8 \u3002"}, {"pk": 582102, "verse": 65, "text": "\u5927 \u796d \u53f8 \u5c31 \u6495 \u958b \u8863 \u670d \uff0c \u8aaa \uff1a \u4ed6 \u8aaa \u4e86 \u50ed \u5984 \u7684 \u8a71 \uff0c \u6211 \u5011 \u4f55 \u5fc5 \u518d \u7528 \u898b \u8b49 \u4eba \u5462 \uff1f \u9019 \u50ed \u5984 \u7684 \u8a71 \uff0c \u73fe \u5728 \u4f60 \u5011 \u90fd \u807d \u898b \u4e86 \u3002"}, {"pk": 582103, "verse": 66, "text": "\u4f60 \u5011 \u7684 \u610f \u898b \u5982 \u4f55 \uff1f \u4ed6 \u5011 \u56de \u7b54 \u8aaa \uff1a \u4ed6 \u662f \u8a72 \u6b7b \u7684 \u3002"}, {"pk": 582104, "verse": 67, "text": "\u4ed6 \u5011 \u5c31 \u5410 \u553e \u6cab \u5728 \u4ed6 \u81c9 \u4e0a \uff0c \u7528 \u62f3 \u982d \u6253 \u4ed6 \uff1b \u4e5f \u6709 \u7528 \u624b \u638c \u6253 \u4ed6 \u7684 \uff0c \u8aaa \uff1a"}, {"pk": 582105, "verse": 68, "text": "\u57fa \u7763 \u963f \uff01 \u4f60 \u662f \u5148 \u77e5 \uff0c \u544a \u8a34 \u6211 \u5011 \u6253 \u4f60 \u7684 \u662f \u8ab0 \uff1f"}, {"pk": 582106, "verse": 69, "text": "\u5f7c \u5f97 \u5728 \u5916 \u9762 \u9662 \u5b50 \u88e1 \u5750 \u8457 \uff0c \u6709 \u4e00 \u500b \u4f7f \u5973 \u524d \u4f86 \uff0c \u8aaa \uff1a \u4f60 \u7d20 \u4f86 \u4e5f \u662f \u540c \u90a3 \u52a0 \u5229 \u5229 \u4eba \u8036 \u7a4c \u4e00 \u5925 \u7684 \u3002"}, {"pk": 582107, "verse": 70, "text": "\u5f7c \u5f97 \u5728 \u773e \u4eba \u9762 \u524d \u537b \u4e0d \u627f \u8a8d \uff0c \u8aaa \uff1a \u6211 \u4e0d \u77e5 \u9053 \u4f60 \u8aaa \u7684 \u662f \u751a \u9ebc \uff01"}, {"pk": 582108, "verse": 71, "text": "\u65e2 \u51fa \u53bb \uff0c \u5230 \u4e86 \u9580 \u53e3 \uff0c \u53c8 \u6709 \u4e00 \u500b \u4f7f \u5973 \u770b \u898b \u4ed6 \uff0c \u5c31 \u5c0d \u90a3 \u88e1 \u7684 \u4eba \u8aaa \uff1a \u9019 \u500b \u4eba \u4e5f \u662f \u540c \u62ff \u6492 \u52d2 \u4eba \u8036 \u7a4c \u4e00 \u5925 \u7684 \u3002"}, {"pk": 582109, "verse": 72, "text": "\u5f7c \u5f97 \u53c8 \u4e0d \u627f \u8a8d \uff0c \u4e26 \u4e14 \u8d77 \u8a93 \u8aaa \uff1a \u6211 \u4e0d \u8a8d \u5f97 \u90a3 \u500b \u4eba \u3002"}, {"pk": 582110, "verse": 73, "text": "\u904e \u4e86 \u4e0d \u591a \u7684 \u6642 \u5019 \uff0c \u65c1 \u908a \u7ad9 \u8457 \u7684 \u4eba \u524d \u4f86 \uff0c \u5c0d \u5f7c \u5f97 \u8aaa \uff1a \u4f60 \u771f \u662f \u4ed6 \u5011 \u4e00 \u9ee8 \u7684 \uff0c \u4f60 \u7684 \u53e3 \u97f3 \u628a \u4f60 \u9732 \u51fa \u4f86 \u4e86 \u3002"}, {"pk": 582111, "verse": 74, "text": "\u5f7c \u5f97 \u5c31 \u767c \u5492 \u8d77 \u8a93 \u7684 \u8aaa \uff1a \u6211 \u4e0d \u8a8d \u5f97 \u90a3 \u500b \u4eba \u3002 \u7acb \u6642 \uff0c \u96de \u5c31 \u53eb \u4e86 \u3002"}, {"pk": 582112, "verse": 75, "text": "\u5f7c \u5f97 \u60f3 \u8d77 \u8036 \u7a4c \u6240 \u8aaa \u7684 \u8a71 \uff1a \u96de \u53eb \u4ee5 \u5148 \uff0c \u4f60 \u8981 \u4e09 \u6b21 \u4e0d \u8a8d \u6211 \u3002 \u4ed6 \u5c31 \u51fa \u53bb \u75db \u54ed \u3002"}]