[{"pk": 581656, "verse": 1, "text": "\u6cd5 \u5229 \u8cfd \u4eba \u548c \u6492 \u90fd \u8a72 \u4eba \u4f86 \u8a66 \u63a2 \u8036 \u7a4c \uff0c \u8acb \u4ed6 \u5f9e \u5929 \u4e0a \u986f \u500b \u795e \u8e5f \u7d66 \u4ed6 \u5011 \u770b \u3002"}, {"pk": 581657, "verse": 2, "text": "\u8036 \u7a4c \u56de \u7b54 \u8aaa \uff1a \u665a \u4e0a \u5929 \u767c \u7d05 \uff0c \u4f60 \u5011 \u5c31 \u8aaa \uff1a \u5929 \u5fc5 \u8981 \u6674 \u3002"}, {"pk": 581658, "verse": 3, "text": "\u65e9 \u6668 \u5929 \u767c \u7d05 \uff0c \u53c8 \u767c \u9ed1 \uff0c \u4f60 \u5011 \u5c31 \u8aaa \uff1a \u4eca \u65e5 \u5fc5 \u6709 \u98a8 \u96e8 \u3002 \u4f60 \u5011 \u77e5 \u9053 \u5206 \u8fa8 \u5929 \u4e0a \u7684 \u6c23 \u8272 \uff0c \u5012 \u4e0d \u80fd \u5206 \u8fa8 \u9019 \u6642 \u5019 \u7684 \u795e \u8e5f \u3002"}, {"pk": 581659, "verse": 4, "text": "\u4e00 \u500b \u90aa \u60e1 \u6deb \u4e82 \u7684 \u4e16 \u4ee3 \u6c42 \u795e \u8e5f \uff0c \u9664 \u4e86 \u7d04 \u62ff \u7684 \u795e \u8e5f \u4ee5 \u5916 \uff0c \u518d \u6c92 \u6709 \u795e \u8e5f \u7d66 \u4ed6 \u770b \u3002 \u8036 \u7a4c \u5c31 \u96e2 \u958b \u4ed6 \u5011 \u53bb \u4e86 \u3002"}, {"pk": 581660, "verse": 5, "text": "\u9580 \u5f92 \u6e21 \u5230 \u90a3 \u908a \u53bb \uff0c \u5fd8 \u4e86 \u5e36 \u9905 \u3002"}, {"pk": 581661, "verse": 6, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u8981 \u8b39 \u614e \uff0c \u9632 \u5099 \u6cd5 \u5229 \u8cfd \u4eba \u548c \u6492 \u90fd \u8a72 \u4eba \u7684 \u9175 \u3002"}, {"pk": 581662, "verse": 7, "text": "\u9580 \u5f92 \u5f7c \u6b64 \u8b70 \u8ad6 \u8aaa \uff1a \u9019 \u662f \u56e0 \u70ba \u6211 \u5011 \u6c92 \u6709 \u5e36 \u9905 \u7f77 \u3002"}, {"pk": 581663, "verse": 8, "text": "\u8036 \u7a4c \u770b \u51fa \u4f86 \uff0c \u5c31 \u8aaa \uff1a \u4f60 \u5011 \u9019 \u5c0f \u4fe1 \u7684 \u4eba \uff0c \u70ba \u751a \u9ebc \u56e0 \u70ba \u6c92 \u6709 \u9905 \u5f7c \u6b64 \u8b70 \u8ad6 \u5462 \uff1f"}, {"pk": 581664, "verse": 9, "text": "\u4f60 \u5011 \u9084 \u4e0d \u660e \u767d \u9ebc \uff1f \u4e0d \u8a18 \u5f97 \u90a3 \u4e94 \u500b \u9905 \u5206 \u7d66 \u4e94 \u5343 \u4eba \u3001 \u53c8 \u6536 \u62fe \u4e86 \u591a \u5c11 \u7c43 \u5b50 \u7684 \u96f6 \u788e \u9ebc \uff1f"}, {"pk": 581665, "verse": 10, "text": "\u4e5f \u4e0d \u8a18 \u5f97 \u90a3 \u4e03 \u500b \u9905 \u5206 \u7d66 \u56db \u5343 \u4eba \u3001 \u53c8 \u6536 \u62fe \u4e86 \u591a \u5c11 \u7b50 \u5b50 \u7684 \u96f6 \u788e \u9ebc \uff1f"}, {"pk": 581666, "verse": 11, "text": "\u6211 \u5c0d \u4f60 \u5011 \u8aaa \uff1a \u8981 \u9632 \u5099 \u6cd5 \u5229 \u8cfd \u4eba \u548c \u6492 \u90fd \u8a72 \u4eba \u7684 \u9175 \uff0c \u9019 \u8a71 \u4e0d \u662f \u6307 \u8457 \u9905 \u8aaa \u7684 \uff0c \u4f60 \u5011 \u600e \u9ebc \u4e0d \u660e \u767d \u5462 \uff1f"}, {"pk": 581667, "verse": 12, "text": "\u9580 \u5f92 \u9019 \u624d \u66c9 \u5f97 \u4ed6 \u8aaa \u7684 \u4e0d \u662f \u53eb \u4ed6 \u5011 \u9632 \u5099 \u9905 \u7684 \u9175 \uff0c \u4e43 \u662f \u9632 \u5099 \u6cd5 \u5229 \u8cfd \u4eba \u548c \u6492 \u90fd \u8a72 \u4eba \u7684 \u6559 \u8a13 \u3002"}, {"pk": 581668, "verse": 13, "text": "\u8036 \u7a4c \u5230 \u4e86 \u8a72 \u6492 \u5229 \u4e9e \u8153 \u7acb \u6bd4 \u7684 \u5883 \u5167 \uff0c \u5c31 \u554f \u9580 \u5f92 \u8aaa \uff1a \u4eba \u8aaa \u6211 \uff08 \u6709 \u53e4 \u5377 \u6c92 \u6709 \u6211 \u5b57 \uff09 \u4eba \u5b50 \u662f \u8ab0 \uff1f"}, {"pk": 581669, "verse": 14, "text": "\u4ed6 \u5011 \u8aaa \uff1a \u6709 \u4eba \u8aaa \u662f \u65bd \u6d17 \u7684 \u7d04 \u7ff0 \uff1b \u6709 \u4eba \u8aaa \u662f \u4ee5 \u5229 \u4e9e \uff1b \u53c8 \u6709 \u4eba \u8aaa \u662f \u8036 \u5229 \u7c73 \u6216 \u662f \u5148 \u77e5 \u88e1 \u7684 \u4e00 \u4f4d \u3002"}, {"pk": 581670, "verse": 15, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4f60 \u5011 \u8aaa \u6211 \u662f \u8ab0 \uff1f"}, {"pk": 581671, "verse": 16, "text": "\u897f \u9580 \u5f7c \u5f97 \u56de \u7b54 \u8aaa \uff1a \u4f60 \u662f \u57fa \u7763 \uff0c \u662f \u6c38 \u751f \u795e \u7684 \u5152 \u5b50 \u3002"}, {"pk": 581672, "verse": 17, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u897f \u9580 \u5df4 \u7d04 \u62ff \uff0c \u4f60 \u662f \u6709 \u798f \u7684 \uff01 \u56e0 \u70ba \u9019 \u4e0d \u662f \u5c6c \u8840 \u8089 \u7684 \u6307 \u793a \u4f60 \u7684 \uff0c \u4e43 \u662f \u6211 \u5728 \u5929 \u4e0a \u7684 \u7236 \u6307 \u793a \u7684 \u3002"}, {"pk": 581673, "verse": 18, "text": "\u6211 \u9084 \u544a \u8a34 \u4f60 \uff0c \u4f60 \u662f \u5f7c \u5f97 \uff0c \u6211 \u8981 \u628a \u6211 \u7684 \u6559 \u6703 \u5efa \u9020 \u5728 \u9019 \u78d0 \u77f3 \u4e0a \uff1b \u9670 \u9593 \u7684 \u6b0a \u67c4 \uff08 \u6b0a \u67c4 \uff1a \u539f \u6587 \u662f \u9580 \uff09 \uff0c \u4e0d \u80fd \u52dd \u904e \u4ed6 \u3002"}, {"pk": 581674, "verse": 19, "text": "\u6211 \u8981 \u628a \u5929 \u570b \u7684 \u9470 \u5319 \u7d66 \u4f60 \uff0c \u51e1 \u4f60 \u5728 \u5730 \u4e0a \u6240 \u6346 \u7d81 \u7684 \uff0c \u5728 \u5929 \u4e0a \u4e5f \u8981 \u6346 \u7d81 \uff1b \u51e1 \u4f60 \u5728 \u5730 \u4e0a \u6240 \u91cb \u653e \u7684 \uff0c \u5728 \u5929 \u4e0a \u4e5f \u8981 \u91cb \u653e \u3002"}, {"pk": 581675, "verse": 20, "text": "\u7576 \u4e0b \uff0c \u8036 \u7a4c \u56d1 \u5490 \u9580 \u5f92 \uff0c \u4e0d \u53ef \u5c0d \u4eba \u8aaa \u4ed6 \u662f \u57fa \u7763 \u3002"}, {"pk": 581676, "verse": 21, "text": "\u5f9e \u6b64 \uff0c \u8036 \u7a4c \u624d \u6307 \u793a \u9580 \u5f92 \uff0c \u4ed6 \u5fc5 \u9808 \u4e0a \u8036 \u8def \u6492 \u51b7 \u53bb \uff0c \u53d7 \u9577 \u8001 \u3001 \u796d \u53f8 \u9577 \u3001 \u6587 \u58eb \u8a31 \u591a \u7684 \u82e6 \uff0c \u4e26 \u4e14 \u88ab \u6bba \uff0c \u7b2c \u4e09 \u65e5 \u5fa9 \u6d3b \u3002"}, {"pk": 581677, "verse": 22, "text": "\u5f7c \u5f97 \u5c31 \u62c9 \u8457 \u4ed6 \uff0c \u52f8 \u4ed6 \u8aaa \uff1a \u4e3b \u963f \uff0c \u842c \u4e0d \u53ef \u5982 \u6b64 \uff01 \u9019 \u4e8b \u5fc5 \u4e0d \u81e8 \u5230 \u4f60 \u8eab \u4e0a \u3002"}, {"pk": 581678, "verse": 23, "text": "\u8036 \u7a4c \u8f49 \u904e \u4f86 \uff0c \u5c0d \u5f7c \u5f97 \u8aaa \uff1a \u6492 \u4f46 \uff0c \u9000 \u6211 \u5f8c \u908a \u53bb \u7f77 \uff01 \u4f60 \u662f \u7d46 \u6211 \u8173 \u7684 \uff1b \u56e0 \u70ba \u4f60 \u4e0d \u9ad4 \u8cbc \u795e \u7684 \u610f \u601d \uff0c \u53ea \u9ad4 \u8cbc \u4eba \u7684 \u610f \u601d \u3002"}, {"pk": 581679, "verse": 24, "text": "\u65bc \u662f \u8036 \u7a4c \u5c0d \u9580 \u5f92 \u8aaa \uff1a \u82e5 \u6709 \u4eba \u8981 \u8ddf \u5f9e \u6211 \uff0c \u5c31 \u7576 \u6368 \u5df1 \uff0c \u80cc \u8d77 \u4ed6 \u7684 \u5341 \u5b57 \u67b6 \u4f86 \u8ddf \u5f9e \u6211 \u3002"}, {"pk": 581680, "verse": 25, "text": "\u56e0 \u70ba \uff0c \u51e1 \u8981 \u6551 \u81ea \u5df1 \u751f \u547d \uff08 \u751f \u547d \uff1a \u6216 \u4f5c \u9748 \u9b42 \uff1b \u4e0b \u540c \uff09 \u7684 \uff0c \u5fc5 \u55aa \u6389 \u751f \u547d \uff1b \u51e1 \u70ba \u6211 \u55aa \u6389 \u751f \u547d \u7684 \uff0c \u5fc5 \u5f97 \u8457 \u751f \u547d \u3002"}, {"pk": 581681, "verse": 26, "text": "\u4eba \u82e5 \u8cfa \u5f97 \u5168 \u4e16 \u754c \uff0c \u8ce0 \u4e0a \u81ea \u5df1 \u7684 \u751f \u547d \uff0c \u6709 \u751a \u9ebc \u76ca \u8655 \u5462 \uff1f \u4eba \u9084 \u80fd \u62ff \u751a \u9ebc \u63db \u751f \u547d \u5462 \uff1f"}, {"pk": 581682, "verse": 27, "text": "\u4eba \u5b50 \u8981 \u5728 \u4ed6 \u7236 \u7684 \u69ae \u8000 \u88e1 \uff0c \u540c \u8457 \u773e \u4f7f \u8005 \u964d \u81e8 \uff1b \u90a3 \u6642 \u5019 \uff0c \u4ed6 \u8981 \u7167 \u5404 \u4eba \u7684 \u884c \u70ba \u5831 \u61c9 \u5404 \u4eba \u3002"}, {"pk": 581683, "verse": 28, "text": "\u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u7ad9 \u5728 \u9019 \u88e1 \u7684 \uff0c \u6709 \u4eba \u5728 \u6c92 \u5617 \u6b7b \u5473 \u4ee5 \u524d \u5fc5 \u770b \u898b \u4eba \u5b50 \u964d \u81e8 \u5728 \u4ed6 \u7684 \u570b \u88e1 \u3002"}]