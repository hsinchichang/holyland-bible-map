[{"pk": 572102, "verse": 1, "text": "\uff08 \u8036 \u548c \u83ef \u7684 \u50d5 \u4eba \u5927 \u885b \u7684 \u8a69 \uff0c \u4ea4 \u8207 \u4f36 \u9577 \u3002 \u7576 \u8036 \u548c \u83ef \u6551 \u4ed6 \u812b \u96e2 \u4e00 \u5207 \u4ec7 \u6575 \u548c \u6383 \u7f85 \u4e4b \u624b \u7684 \u65e5 \u5b50 \uff0c \u4ed6 \u5411 \u8036 \u548c \u83ef \u5ff5 \u9019 \u8a69 \u7684 \u8a71 \u3002 \u8aaa \uff1a \uff09 \u8036 \u548c \u83ef \uff0c \u6211 \u7684 \u529b \u91cf \u554a \uff0c \u6211 \u611b \u4f60 \uff01"}, {"pk": 572103, "verse": 2, "text": "\u8036 \u548c \u83ef \u662f \u6211 \u7684 \u5dd6 \u77f3 \uff0c \u6211 \u7684 \u5c71 \u5be8 \uff0c \u6211 \u7684 \u6551 \u4e3b \uff0c \u6211 \u7684 \u795e \uff0c \u6211 \u7684 \u78d0 \u77f3 \uff0c \u6211 \u6240 \u6295 \u9760 \u7684 \u3002 \u4ed6 \u662f \u6211 \u7684 \u76fe \u724c \uff0c \u662f \u62ef \u6551 \u6211 \u7684 \u89d2 \uff0c \u662f \u6211 \u7684 \u9ad8 \u81fa \u3002"}, {"pk": 572104, "verse": 3, "text": "\u6211 \u8981 \u6c42 \u544a \u7576 \u8b9a \u7f8e \u7684 \u8036 \u548c \u83ef \uff1b \u9019 \u6a23 \u6211 \u5fc5 \u5f9e \u4ec7 \u6575 \u624b \u4e2d \u88ab \u6551 \u51fa \u4f86 \u3002"}, {"pk": 572105, "verse": 4, "text": "\u66fe \u6709 \u6b7b \u4ea1 \u7684 \u7e69 \u7d22 \u7e8f \u7e5e \u6211 \uff0c \u532a \u985e \u7684 \u6025 \u6d41 \u4f7f \u6211 \u9a5a \u61fc \uff0c"}, {"pk": 572106, "verse": 5, "text": "\u9670 \u9593 \u7684 \u7e69 \u7d22 \u7e8f \u7e5e \u6211 \uff0c \u6b7b \u4ea1 \u7684 \u7db2 \u7f85 \u81e8 \u5230 \u6211 \u3002"}, {"pk": 572107, "verse": 6, "text": "\u6211 \u5728 \u6025 \u96e3 \u4e2d \u6c42 \u544a \u8036 \u548c \u83ef \uff0c \u5411 \u6211 \u7684 \u3000 \u795e \u547c \u6c42 \u3002 \u4ed6 \u5f9e \u6bbf \u4e2d \u807d \u4e86 \u6211 \u7684 \u8072 \u97f3 \uff1b \u6211 \u5728 \u4ed6 \u9762 \u524d \u7684 \u547c \u6c42 \u5165 \u4e86 \u4ed6 \u7684 \u8033 \u4e2d \u3002"}, {"pk": 572108, "verse": 7, "text": "\u90a3 \u6642 \uff0c \u56e0 \u4ed6 \u767c \u6012 \uff0c \u5730 \u5c31 \u6416 \u64bc \u6230 \u6296 \uff1b \u5c71 \u7684 \u6839 \u57fa \u4e5f \u9707 \u52d5 \u6416 \u64bc \u3002"}, {"pk": 572109, "verse": 8, "text": "\u5f9e \u4ed6 \u9f3b \u5b54 \u5192 \u7159 \u4e0a \u9a30 \uff1b \u5f9e \u4ed6 \u53e3 \u4e2d \u767c \u706b \u711a \u71d2 \uff0c \u9023 \u70ad \u4e5f \u8457 \u4e86 \u3002"}, {"pk": 572110, "verse": 9, "text": "\u4ed6 \u53c8 \u4f7f \u5929 \u4e0b \u5782 \uff0c \u89aa \u81ea \u964d \u81e8 \uff0c \u6709 \u9ed1 \u96f2 \u5728 \u4ed6 \u8173 \u4e0b \u3002"}, {"pk": 572111, "verse": 10, "text": "\u4ed6 \u5750 \u8457 \u57fa \u8def \u4f2f \u98db \u884c \uff1b \u4ed6 \u85c9 \u8457 \u98a8 \u7684 \u7fc5 \u8180 \u5feb \u98db \u3002"}, {"pk": 572112, "verse": 11, "text": "\u4ed6 \u4ee5 \u9ed1 \u6697 \u70ba \u85cf \u8eab \u4e4b \u8655 \uff0c \u4ee5 \u6c34 \u7684 \u9ed1 \u6697 \u3001 \u5929 \u7a7a \u7684 \u539a \u96f2 \u70ba \u4ed6 \u56db \u570d \u7684 \u884c \u5bae \u3002"}, {"pk": 572113, "verse": 12, "text": "\u56e0 \u4ed6 \u9762 \u524d \u7684 \u5149 \u8f1d \uff0c \u4ed6 \u7684 \u539a \u96f2 \u884c \u904e \u4fbf \u6709 \u51b0 \u96f9 \u706b \u70ad \u3002"}, {"pk": 572114, "verse": 13, "text": "\u8036 \u548c \u83ef \u4e5f \u5728 \u5929 \u4e0a \u6253 \u96f7 \uff1b \u81f3 \u9ad8 \u8005 \u767c \u51fa \u8072 \u97f3 \u4fbf \u6709 \u51b0 \u96f9 \u706b \u70ad \u3002"}, {"pk": 572115, "verse": 14, "text": "\u4ed6 \u5c04 \u51fa \u7bad \u4f86 \uff0c \u4f7f \u4ec7 \u6575 \u56db \u6563 \uff1b \u591a \u591a \u767c \u51fa \u9583 \u96fb \uff0c \u4f7f \u4ed6 \u5011 \u64fe \u4e82 \u3002"}, {"pk": 572116, "verse": 15, "text": "\u8036 \u548c \u83ef \u554a \uff0c \u4f60 \u7684 \u65a5 \u8cac \u4e00 \u767c \uff0c \u4f60 \u9f3b \u5b54 \u7684 \u6c23 \u4e00 \u51fa \uff0c \u6d77 \u5e95 \u5c31 \u51fa \u73fe \uff0c \u5927 \u5730 \u7684 \u6839 \u57fa \u4e5f \u986f \u9732 \u3002"}, {"pk": 572117, "verse": 16, "text": "\u4ed6 \u5f9e \u9ad8 \u5929 \u4f38 \u624b \u6293 \u4f4f \u6211 \uff0c \u628a \u6211 \u5f9e \u5927 \u6c34 \u4e2d \u62c9 \u4e0a \u4f86 \u3002"}, {"pk": 572118, "verse": 17, "text": "\u4ed6 \u6551 \u6211 \u812b \u96e2 \u6211 \u7684 \u52c1 \u6575 \u548c \u90a3 \u4e9b \u6068 \u6211 \u7684 \u4eba \uff0c \u56e0 \u70ba \u4ed6 \u5011 \u6bd4 \u6211 \u5f37 \u76db \u3002"}, {"pk": 572119, "verse": 18, "text": "\u6211 \u906d \u9047 \u707d \u96e3 \u7684 \u65e5 \u5b50 \uff0c \u4ed6 \u5011 \u4f86 \u653b \u64ca \u6211 \uff1b \u4f46 \u8036 \u548c \u83ef \u662f \u6211 \u7684 \u501a \u9760 \u3002"}, {"pk": 572120, "verse": 19, "text": "\u4ed6 \u53c8 \u9818 \u6211 \u5230 \u5bec \u95ca \u4e4b \u8655 \uff1b \u4ed6 \u6551 \u62d4 \u6211 \uff0c \u56e0 \u4ed6 \u559c \u6085 \u6211 \u3002"}, {"pk": 572121, "verse": 20, "text": "\u8036 \u548c \u83ef \u6309 \u8457 \u6211 \u7684 \u516c \u7fa9 \u5831 \u7b54 \u6211 \uff0c \u6309 \u8457 \u6211 \u624b \u4e2d \u7684 \u6e05 \u6f54 \u8cde \u8cdc \u6211 \u3002"}, {"pk": 572122, "verse": 21, "text": "\u56e0 \u70ba \u6211 \u9075 \u5b88 \u4e86 \u8036 \u548c \u83ef \u7684 \u9053 \uff0c \u672a \u66fe \u4f5c \u60e1 \u96e2 \u958b \u6211 \u7684 \u3000 \u795e \u3002"}, {"pk": 572123, "verse": 22, "text": "\u4ed6 \u7684 \u4e00 \u5207 \u5178 \u7ae0 \u5e38 \u5728 \u6211 \u9762 \u524d \uff1b \u4ed6 \u7684 \u5f8b \u4f8b \u6211 \u4e5f \u672a \u66fe \u4e1f \u68c4 \u3002"}, {"pk": 572124, "verse": 23, "text": "\u6211 \u5728 \u4ed6 \u9762 \u524d \u4f5c \u4e86 \u5b8c \u5168 \u4eba \uff1b \u6211 \u4e5f \u4fdd \u5b88 \u81ea \u5df1 \u9060 \u96e2 \u6211 \u7684 \u7f6a \u5b7d \u3002"}, {"pk": 572125, "verse": 24, "text": "\u6240 \u4ee5 \uff0c \u8036 \u548c \u83ef \u6309 \u6211 \u7684 \u516c \u7fa9 \uff0c \u6309 \u6211 \u5728 \u4ed6 \u773c \u524d \u624b \u4e2d \u7684 \u6e05 \u6f54 \u511f \u9084 \u6211 \u3002"}, {"pk": 572126, "verse": 25, "text": "\u6148 \u611b \u7684 \u4eba \uff0c \u4f60 \u4ee5 \u6148 \u611b \u5f85 \u4ed6 \uff1b \u5b8c \u5168 \u7684 \u4eba \uff0c \u4f60 \u4ee5 \u5b8c \u5168 \u5f85 \u4ed6 \u3002"}, {"pk": 572127, "verse": 26, "text": "\u6e05 \u6f54 \u7684 \u4eba \uff0c \u4f60 \u4ee5 \u6e05 \u6f54 \u5f85 \u4ed6 \uff1b \u4e56 \u50fb \u7684 \u4eba \uff0c \u4f60 \u4ee5 \u5f4e \u66f2 \u5f85 \u4ed6 \u3002"}, {"pk": 572128, "verse": 27, "text": "\u56f0 \u82e6 \u7684 \u767e \u59d3 \uff0c \u4f60 \u5fc5 \u62ef \u6551 \uff1b \u9ad8 \u50b2 \u7684 \u773c \u76ee \uff0c \u4f60 \u5fc5 \u4f7f \u4ed6 \u964d \u5351 \u3002"}, {"pk": 572129, "verse": 28, "text": "\u4f60 \u5fc5 \u9ede \u8457 \u6211 \u7684 \u71c8 \uff1b \u8036 \u548c \u83ef \u2500 \u6211 \u7684 \u3000 \u795e \u5fc5 \u7167 \u660e \u6211 \u7684 \u9ed1 \u6697 \u3002"}, {"pk": 572130, "verse": 29, "text": "\u6211 \u85c9 \u8457 \u4f60 \u885d \u5165 \u6575 \u8ecd \uff0c \u85c9 \u8457 \u6211 \u7684 \u3000 \u795e \u8df3 \u904e \u7246 \u57a3 \u3002"}, {"pk": 572131, "verse": 30, "text": "\u81f3 \u65bc \u795e \uff0c \u4ed6 \u7684 \u9053 \u662f \u5b8c \u5168 \u7684 \uff1b \u8036 \u548c \u83ef \u7684 \u8a71 \u662f \u7149 \u6de8 \u7684 \u3002 \u51e1 \u6295 \u9760 \u4ed6 \u7684 \uff0c \u4ed6 \u4fbf \u4f5c \u4ed6 \u5011 \u7684 \u76fe \u724c \u3002"}, {"pk": 572132, "verse": 31, "text": "\u9664 \u4e86 \u8036 \u548c \u83ef \uff0c \u8ab0 \u662f \u3000 \u795e \u5462 \uff1f \u9664 \u4e86 \u6211 \u5011 \u7684 \u3000 \u795e \uff0c \u8ab0 \u662f \u78d0 \u77f3 \u5462 \uff1f"}, {"pk": 572133, "verse": 32, "text": "\u60df \u6709 \u90a3 \u4ee5 \u529b \u91cf \u675f \u6211 \u7684 \u8170 \u3001 \u4f7f \u6211 \u884c \u70ba \u5b8c \u5168 \u7684 \uff0c \u4ed6 \u662f \u795e \u3002"}, {"pk": 572134, "verse": 33, "text": "\u4ed6 \u4f7f \u6211 \u7684 \u8173 \u5feb \u5982 \u6bcd \u9e7f \u7684 \u8e44 \uff0c \u53c8 \u4f7f \u6211 \u5728 \u9ad8 \u8655 \u5b89 \u7a69 \u3002"}, {"pk": 572135, "verse": 34, "text": "\u4ed6 \u6559 \u5c0e \u6211 \u7684 \u624b \u80fd \u4ee5 \u722d \u6230 \uff0c \u751a \u81f3 \u6211 \u7684 \u8180 \u81c2 \u80fd \u958b \u9285 \u5f13 \u3002"}, {"pk": 572136, "verse": 35, "text": "\u4f60 \u628a \u4f60 \u7684 \u6551 \u6069 \u7d66 \u6211 \u4f5c \u76fe \u724c \uff1b \u4f60 \u7684 \u53f3 \u624b \u6276 \u6301 \u6211 \uff1b \u4f60 \u7684 \u6eab \u548c \u4f7f \u6211 \u70ba \u5927 \u3002"}, {"pk": 572137, "verse": 36, "text": "\u4f60 \u4f7f \u6211 \u8173 \u4e0b \u7684 \u5730 \u6b65 \u5bec \u95ca \uff1b \u6211 \u7684 \u8173 \u672a \u66fe \u6ed1 \u8dcc \u3002"}, {"pk": 572138, "verse": 37, "text": "\u6211 \u8981 \u8ffd \u8d95 \u6211 \u7684 \u4ec7 \u6575 \uff0c \u4e26 \u8981 \u8ffd \u4e0a \u4ed6 \u5011 \uff1b \u4e0d \u5c07 \u4ed6 \u5011 \u6ec5 \u7d55 \uff0c \u6211 \u7e3d \u4e0d \u6b78 \u56de \u3002"}, {"pk": 572139, "verse": 38, "text": "\u6211 \u8981 \u6253 \u50b7 \u4ed6 \u5011 \uff0c \u4f7f \u4ed6 \u5011 \u4e0d \u80fd \u8d77 \u4f86 \uff1b \u4ed6 \u5011 \u5fc5 \u5012 \u5728 \u6211 \u7684 \u8173 \u4e0b \u3002"}, {"pk": 572140, "verse": 39, "text": "\u56e0 \u70ba \u4f60 \u66fe \u4ee5 \u529b \u91cf \u675f \u6211 \u7684 \u8170 \uff0c \u4f7f \u6211 \u80fd \u722d \u6230 \uff1b \u4f60 \u4e5f \u4f7f \u90a3 \u8d77 \u4f86 \u653b \u64ca \u6211 \u7684 \u90fd \u670d \u5728 \u6211 \u4ee5 \u4e0b \u3002"}, {"pk": 572141, "verse": 40, "text": "\u4f60 \u53c8 \u4f7f \u6211 \u7684 \u4ec7 \u6575 \u5728 \u6211 \u9762 \u524d \u8f49 \u80cc \u9003 \u8dd1 \uff0c \u53eb \u6211 \u80fd \u4ee5 \u526a \u9664 \u90a3 \u6068 \u6211 \u7684 \u4eba \u3002"}, {"pk": 572142, "verse": 41, "text": "\u4ed6 \u5011 \u547c \u6c42 \uff0c \u537b \u7121 \u4eba \u62ef \u6551 \uff1b \u5c31 \u662f \u547c \u6c42 \u8036 \u548c \u83ef \uff0c \u4ed6 \u4e5f \u4e0d \u61c9 \u5141 \u3002"}, {"pk": 572143, "verse": 42, "text": "\u6211 \u6417 \u788e \u4ed6 \u5011 \uff0c \u5982 \u540c \u98a8 \u524d \u7684 \u7070 \u5875 \uff0c \u5012 \u51fa \u4ed6 \u5011 \uff0c \u5982 \u540c \u8857 \u4e0a \u7684 \u6ce5 \u571f \u3002"}, {"pk": 572144, "verse": 43, "text": "\u4f60 \u6551 \u6211 \u812b \u96e2 \u767e \u59d3 \u7684 \u722d \u7af6 \uff0c \u7acb \u6211 \u4f5c \u5217 \u570b \u7684 \u5143 \u9996 \uff1b \u6211 \u7d20 \u4e0d \u8a8d \u8b58 \u7684 \u6c11 \u5fc5 \u4e8b \u5949 \u6211 \u3002"}, {"pk": 572145, "verse": 44, "text": "\u4ed6 \u5011 \u4e00 \u807d \u898b \u6211 \u7684 \u540d \u8072 \u5c31 \u5fc5 \u9806 \u5f9e \u6211 \uff1b \u5916 \u90a6 \u4eba \u8981 \u6295 \u964d \u6211 \u3002"}, {"pk": 572146, "verse": 45, "text": "\u5916 \u90a6 \u4eba \u8981 \u8870 \u6b98 \uff0c \u6230 \u6230 \u5162 \u5162 \u5730 \u51fa \u4ed6 \u5011 \u7684 \u71df \u5be8 \u3002"}, {"pk": 572147, "verse": 46, "text": "\u8036 \u548c \u83ef \u662f \u6d3b \u795e \u3002 \u9858 \u6211 \u7684 \u78d0 \u77f3 \u88ab \u4eba \u7a31 \u980c \uff1b \u9858 \u6551 \u6211 \u7684 \u3000 \u795e \u88ab \u4eba \u5c0a \u5d07 \u3002"}, {"pk": 572148, "verse": 47, "text": "\u9019 \u4f4d \u795e \uff0c \u5c31 \u662f \u90a3 \u70ba \u6211 \u4f38 \u51a4 \u3001 \u4f7f \u773e \u6c11 \u670d \u5728 \u6211 \u4ee5 \u4e0b \u7684 \u3002"}, {"pk": 572149, "verse": 48, "text": "\u4f60 \u6551 \u6211 \u812b \u96e2 \u4ec7 \u6575 \uff0c \u53c8 \u628a \u6211 \u8209 \u8d77 \uff0c \u9ad8 \u904e \u90a3 \u4e9b \u8d77 \u4f86 \u653b \u64ca \u6211 \u7684 \uff1b \u4f60 \u6551 \u6211 \u812b \u96e2 \u5f37 \u66b4 \u7684 \u4eba \u3002"}, {"pk": 572150, "verse": 49, "text": "\u8036 \u548c \u83ef \u554a \uff0c \u56e0 \u6b64 \u6211 \u8981 \u5728 \u5916 \u90a6 \u4e2d \u7a31 \u8b1d \u4f60 \uff0c \u6b4c \u980c \u4f60 \u7684 \u540d \u3002"}, {"pk": 572151, "verse": 50, "text": "\u8036 \u548c \u83ef \u8cdc \u6975 \u5927 \u7684 \u6551 \u6069 \u7d66 \u4ed6 \u6240 \u7acb \u7684 \u738b \uff0c \u65bd \u6148 \u611b \u7d66 \u4ed6 \u7684 \u53d7 \u818f \u8005 \uff0c \u5c31 \u662f \u7d66 \u5927 \u885b \u548c \u4ed6 \u7684 \u5f8c \u88d4 \uff0c \u76f4 \u5230 \u6c38 \u9060 \u3002"}]