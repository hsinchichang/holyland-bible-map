[{"pk": 572675, "verse": 1, "text": "\uff08 \u5927 \u885b \u8207 \u62d4 \u793a \u5df4 \u540c \u5ba4 \u4ee5 \u5f8c \uff0c \u5148 \u77e5 \u62ff \u55ae \u4f86 \u898b \u4ed6 \uff1b \u4ed6 \u4f5c \u9019 \u8a69 \uff0c \u4ea4 \u8207 \u4f36 \u9577 \u3002 \uff09 \u3000 \u795e \u554a \uff0c \u6c42 \u4f60 \u6309 \u4f60 \u7684 \u6148 \u611b \u6190 \u6064 \u6211 \uff01 \u6309 \u4f60 \u8c50 \u76db \u7684 \u6148 \u60b2 \u5857 \u62b9 \u6211 \u7684 \u904e \u72af \uff01"}, {"pk": 572676, "verse": 2, "text": "\u6c42 \u4f60 \u5c07 \u6211 \u7684 \u7f6a \u5b7d \u6d17 \u9664 \u6de8 \u76e1 \uff0c \u4e26 \u6f54 \u9664 \u6211 \u7684 \u7f6a \uff01"}, {"pk": 572677, "verse": 3, "text": "\u56e0 \u70ba \uff0c \u6211 \u77e5 \u9053 \u6211 \u7684 \u904e \u72af \uff1b \u6211 \u7684 \u7f6a \u5e38 \u5728 \u6211 \u9762 \u524d \u3002"}, {"pk": 572678, "verse": 4, "text": "\u6211 \u5411 \u4f60 \u72af \u7f6a \uff0c \u60df \u7368 \u5f97 \u7f6a \u4e86 \u4f60 \uff1b \u5728 \u4f60 \u773c \u524d \u884c \u4e86 \u9019 \u60e1 \uff0c \u4ee5 \u81f4 \u4f60 \u8cac \u5099 \u6211 \u7684 \u6642 \u5019 \u986f \u70ba \u516c \u7fa9 \uff0c \u5224 \u65b7 \u6211 \u7684 \u6642 \u5019 \u986f \u70ba \u6e05 \u6b63 \u3002"}, {"pk": 572679, "verse": 5, "text": "\u6211 \u662f \u5728 \u7f6a \u5b7d \u88e1 \u751f \u7684 \uff0c \u5728 \u6211 \u6bcd \u89aa \u61f7 \u80ce \u7684 \u6642 \u5019 \u5c31 \u6709 \u4e86 \u7f6a \u3002"}, {"pk": 572680, "verse": 6, "text": "\u4f60 \u6240 \u559c \u611b \u7684 \u662f \u5167 \u88e1 \u8aa0 \u5be6 \uff1b \u4f60 \u5728 \u6211 \u96b1 \u5bc6 \u8655 \uff0c \u5fc5 \u4f7f \u6211 \u5f97 \u667a \u6167 \u3002"}, {"pk": 572681, "verse": 7, "text": "\u6c42 \u4f60 \u7528 \u725b \u819d \u8349 \u6f54 \u6de8 \u6211 \uff0c \u6211 \u5c31 \u4e7e \u6de8 \uff1b \u6c42 \u4f60 \u6d17 \u6ecc \u6211 \uff0c \u6211 \u5c31 \u6bd4 \u96ea \u66f4 \u767d \u3002"}, {"pk": 572682, "verse": 8, "text": "\u6c42 \u4f60 \u4f7f \u6211 \u5f97 \u807d \u6b61 \u559c \u5feb \u6a02 \u7684 \u8072 \u97f3 \uff0c \u4f7f \u4f60 \u6240 \u58d3 \u50b7 \u7684 \u9aa8 \u982d \u53ef \u4ee5 \u8e34 \u8e8d \u3002"}, {"pk": 572683, "verse": 9, "text": "\u6c42 \u4f60 \u63a9 \u9762 \u4e0d \u770b \u6211 \u7684 \u7f6a \uff0c \u5857 \u62b9 \u6211 \u4e00 \u5207 \u7684 \u7f6a \u5b7d \u3002"}, {"pk": 572684, "verse": 10, "text": "\u795e \u554a \uff0c \u6c42 \u4f60 \u70ba \u6211 \u9020 \u6e05 \u6f54 \u7684 \u5fc3 \uff0c \u4f7f \u6211 \u88e1 \u9762 \u91cd \u65b0 \u6709 \u6b63 \u76f4 \uff08 \u6216 \u8b6f \uff1a \u5805 \u5b9a \uff09 \u7684 \u9748 \u3002"}, {"pk": 572685, "verse": 11, "text": "\u4e0d \u8981 \u4e1f \u68c4 \u6211 \uff0c \u4f7f \u6211 \u96e2 \u958b \u4f60 \u7684 \u9762 \uff1b \u4e0d \u8981 \u5f9e \u6211 \u6536 \u56de \u4f60 \u7684 \u8056 \u9748 \u3002"}, {"pk": 572686, "verse": 12, "text": "\u6c42 \u4f60 \u4f7f \u6211 \u4ecd \u5f97 \u6551 \u6069 \u4e4b \u6a02 \uff0c \u8cdc \u6211 \u6a02 \u610f \u7684 \u9748 \u6276 \u6301 \u6211 \uff0c"}, {"pk": 572687, "verse": 13, "text": "\u6211 \u5c31 \u628a \u4f60 \u7684 \u9053 \u6307 \u6559 \u6709 \u904e \u72af \u7684 \u4eba \uff0c \u7f6a \u4eba \u5fc5 \u6b78 \u9806 \u4f60 \u3002"}, {"pk": 572688, "verse": 14, "text": "\u795e \u554a \uff0c \u4f60 \u662f \u62ef \u6551 \u6211 \u7684 \u3000 \u795e \uff1b \u6c42 \u4f60 \u6551 \u6211 \u812b \u96e2 \u6d41 \u4eba \u8840 \u7684 \u7f6a \uff01 \u6211 \u7684 \u820c \u982d \u5c31 \u9ad8 \u8072 \u6b4c \u5531 \u4f60 \u7684 \u516c \u7fa9 \u3002"}, {"pk": 572689, "verse": 15, "text": "\u4e3b \u554a \uff0c \u6c42 \u4f60 \u4f7f \u6211 \u5634 \u5507 \u5f35 \u958b \uff0c \u6211 \u7684 \u53e3 \u4fbf \u50b3 \u63da \u8b9a \u7f8e \u4f60 \u7684 \u8a71 \uff01"}, {"pk": 572690, "verse": 16, "text": "\u4f60 \u672c \u4e0d \u559c \u611b \u796d \u7269 \uff0c \u82e5 \u559c \u611b \uff0c \u6211 \u5c31 \u737b \u4e0a \uff1b \u71d4 \u796d \uff0c \u4f60 \u4e5f \u4e0d \u559c \u6085 \u3002"}, {"pk": 572691, "verse": 17, "text": "\u795e \u6240 \u8981 \u7684 \u796d \u5c31 \u662f \u6182 \u50b7 \u7684 \u9748 \uff1b \u3000 \u795e \u554a \uff0c \u6182 \u50b7 \u75db \u6094 \u7684 \u5fc3 \uff0c \u4f60 \u5fc5 \u4e0d \u8f15 \u770b \u3002"}, {"pk": 572692, "verse": 18, "text": "\u6c42 \u4f60 \u96a8 \u4f60 \u7684 \u7f8e \u610f \u5584 \u5f85 \u932b \u5b89 \uff0c \u5efa \u9020 \u8036 \u8def \u6492 \u51b7 \u7684 \u57ce \u7246 \u3002"}, {"pk": 572693, "verse": 19, "text": "\u90a3 \u6642 \uff0c \u4f60 \u5fc5 \u559c \u611b \u516c \u7fa9 \u7684 \u796d \u548c \u71d4 \u796d \u4e26 \u5168 \u7272 \u7684 \u71d4 \u796d \uff1b \u90a3 \u6642 \uff0c \u4eba \u5fc5 \u5c07 \u516c \u725b \u737b \u5728 \u4f60 \u58c7 \u4e0a \u3002"}]