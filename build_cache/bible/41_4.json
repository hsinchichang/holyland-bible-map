[{"pk": 582307, "verse": 1, "text": "\u8036 \u7a4c \u53c8 \u5728 \u6d77 \u908a \u6559 \u8a13 \u4eba \u3002 \u6709 \u8a31 \u591a \u4eba \u5230 \u4ed6 \u90a3 \u88e1 \u805a \u96c6 \uff0c \u4ed6 \u53ea \u5f97 \u4e0a \u8239 \u5750 \u4e0b \u3002 \u8239 \u5728 \u6d77 \u88e1 \uff0c \u773e \u4eba \u90fd \u9760 \u8fd1 \u6d77 \uff0c \u7ad9 \u5728 \u5cb8 \u4e0a \u3002"}, {"pk": 582308, "verse": 2, "text": "\u8036 \u7a4c \u5c31 \u7528 \u6bd4 \u55bb \u6559 \u8a13 \u4ed6 \u5011 \u8a31 \u591a \u9053 \u7406 \u3002 \u5728 \u6559 \u8a13 \u4e4b \u9593 \uff0c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a"}, {"pk": 582309, "verse": 3, "text": "\u4f60 \u5011 \u807d \u963f \uff01 \u6709 \u4e00 \u500b \u6492 \u7a2e \u7684 \u51fa \u53bb \u6492 \u7a2e \u3002"}, {"pk": 582310, "verse": 4, "text": "\u6492 \u7684 \u6642 \u5019 \uff0c \u6709 \u843d \u5728 \u8def \u65c1 \u7684 \uff0c \u98db \u9ce5 \u4f86 \u5403 \u76e1 \u4e86 \uff1b"}, {"pk": 582311, "verse": 5, "text": "\u6709 \u843d \u5728 \u571f \u6dfa \u77f3 \u982d \u5730 \u4e0a \u7684 \uff0c \u571f \u65e2 \u4e0d \u6df1 \uff0c \u767c \u82d7 \u6700 \u5feb \uff0c"}, {"pk": 582312, "verse": 6, "text": "\u65e5 \u982d \u51fa \u4f86 \u4e00 \u66ec \uff0c \u56e0 \u70ba \u6c92 \u6709 \u6839 \uff0c \u5c31 \u67af \u4e7e \u4e86 \uff1b"}, {"pk": 582313, "verse": 7, "text": "\u6709 \u843d \u5728 \u834a \u68d8 \u88e1 \u7684 \uff0c \u834a \u68d8 \u9577 \u8d77 \u4f86 \uff0c \u628a \u4ed6 \u64e0 \u4f4f \u4e86 \uff0c \u5c31 \u4e0d \u7d50 \u5be6 \uff1b"}, {"pk": 582314, "verse": 8, "text": "\u53c8 \u6709 \u843d \u5728 \u597d \u571f \u88e1 \u7684 \uff0c \u5c31 \u767c \u751f \u9577 \u5927 \uff0c \u7d50 \u5be6 \u6709 \u4e09 \u5341 \u500d \u7684 \uff0c \u6709 \u516d \u5341 \u500d \u7684 \uff0c \u6709 \u4e00 \u767e \u500d \u7684 \uff1b"}, {"pk": 582315, "verse": 9, "text": "\u53c8 \u8aaa \uff1a \u6709 \u8033 \u53ef \u807d \u7684 \uff0c \u5c31 \u61c9 \u7576 \u807d \uff01"}, {"pk": 582316, "verse": 10, "text": "\u7121 \u4eba \u7684 \u6642 \u5019 \uff0c \u8ddf \u96a8 \u8036 \u7a4c \u7684 \u4eba \u548c \u5341 \u4e8c \u500b \u9580 \u5f92 \u554f \u4ed6 \u9019 \u6bd4 \u55bb \u7684 \u610f \u601d \u3002"}, {"pk": 582317, "verse": 11, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u795e \u570b \u7684 \u5967 \u7955 \u53ea \u53eb \u4f60 \u5011 \u77e5 \u9053 \uff0c \u82e5 \u662f \u5c0d \u5916 \u4eba \u8b1b \uff0c \u51e1 \u4e8b \u5c31 \u7528 \u6bd4 \u55bb \uff0c"}, {"pk": 582318, "verse": 12, "text": "\u53eb \u4ed6 \u5011 \u770b \u662f \u770b \u898b \uff0c \u537b \u4e0d \u66c9 \u5f97 \uff1b \u807d \u662f \u807d \u898b \uff0c \u537b \u4e0d \u660e \u767d \uff1b \u6050 \u6015 \u4ed6 \u5011 \u56de \u8f49 \u904e \u4f86 \uff0c \u5c31 \u5f97 \u8d66 \u514d \u3002"}, {"pk": 582319, "verse": 13, "text": "\u53c8 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u4e0d \u660e \u767d \u9019 \u6bd4 \u55bb \u9ebc \uff1f \u9019 \u6a23 \u600e \u80fd \u660e \u767d \u4e00 \u5207 \u7684 \u6bd4 \u55bb \u5462 \uff1f"}, {"pk": 582320, "verse": 14, "text": "\u6492 \u7a2e \u4e4b \u4eba \u6240 \u6492 \u7684 \u5c31 \u662f \u9053 \u3002"}, {"pk": 582321, "verse": 15, "text": "\u90a3 \u6492 \u5728 \u8def \u65c1 \u7684 \uff0c \u5c31 \u662f \u4eba \u807d \u4e86 \u9053 \uff0c \u6492 \u4f46 \u7acb \u523b \u4f86 \uff0c \u628a \u6492 \u5728 \u4ed6 \u5fc3 \u88e1 \u7684 \u9053 \u596a \u4e86 \u53bb \u3002"}, {"pk": 582322, "verse": 16, "text": "\u90a3 \u6492 \u5728 \u77f3 \u982d \u5730 \u4e0a \u7684 \uff0c \u5c31 \u662f \u4eba \u807d \u4e86 \u9053 \uff0c \u7acb \u523b \u6b61 \u559c \u9818 \u53d7 \uff0c"}, {"pk": 582323, "verse": 17, "text": "\u4f46 \u4ed6 \u5fc3 \u88e1 \u6c92 \u6709 \u6839 \uff0c \u4e0d \u904e \u662f \u66ab \u6642 \u7684 \uff0c \u53ca \u81f3 \u70ba \u9053 \u906d \u4e86 \u60a3 \u96e3 \uff0c \u6216 \u662f \u53d7 \u4e86 \u903c \u8feb \uff0c \u7acb \u523b \u5c31 \u8dcc \u5012 \u4e86 \u3002"}, {"pk": 582324, "verse": 18, "text": "\u9084 \u6709 \u90a3 \u6492 \u5728 \u834a \u68d8 \u88e1 \u7684 \uff0c \u5c31 \u662f \u4eba \u807d \u4e86 \u9053 \uff0c"}, {"pk": 582325, "verse": 19, "text": "\u5f8c \u4f86 \u6709 \u4e16 \u4e0a \u7684 \u601d \u616e \u3001 \u9322 \u8ca1 \u7684 \u8ff7 \u60d1 \uff0c \u548c \u5225 \u6a23 \u7684 \u79c1 \u617e \u9032 \u4f86 \uff0c \u628a \u9053 \u64e0 \u4f4f \u4e86 \uff0c \u5c31 \u4e0d \u80fd \u7d50 \u5be6 \u3002"}, {"pk": 582326, "verse": 20, "text": "\u90a3 \u6492 \u5728 \u597d \u5730 \u4e0a \u7684 \uff0c \u5c31 \u662f \u4eba \u807d \u9053 \uff0c \u53c8 \u9818 \u53d7 \uff0c \u4e26 \u4e14 \u7d50 \u5be6 \uff0c \u6709 \u4e09 \u5341 \u500d \u7684 \uff0c \u6709 \u516d \u5341 \u500d \u7684 \uff0c \u6709 \u4e00 \u767e \u500d \u7684 \u3002"}, {"pk": 582327, "verse": 21, "text": "\u8036 \u7a4c \u53c8 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4eba \u62ff \u71c8 \u4f86 \uff0c \u8c48 \u662f \u8981 \u653e \u5728 \u6597 \u5e95 \u4e0b \uff0c \u5e8a \u5e95 \u4e0b \uff0c \u4e0d \u653e \u5728 \u71c8 \u81fa \u4e0a \u9ebc \uff1f"}, {"pk": 582328, "verse": 22, "text": "\u56e0 \u70ba \u63a9 \u85cf \u7684 \u4e8b \uff0c \u6c92 \u6709 \u4e0d \u986f \u51fa \u4f86 \u7684 \uff1b \u96b1 \u779e \u7684 \u4e8b \uff0c \u6c92 \u6709 \u4e0d \u9732 \u51fa \u4f86 \u7684 \u3002"}, {"pk": 582329, "verse": 23, "text": "\u6709 \u8033 \u53ef \u807d \u7684 \uff0c \u5c31 \u61c9 \u7576 \u807d \uff01"}, {"pk": 582330, "verse": 24, "text": "\u53c8 \u8aaa \uff1a \u4f60 \u5011 \u6240 \u807d \u7684 \u8981 \u7559 \u5fc3 \u3002 \u4f60 \u5011 \u7528 \u751a \u9ebc \u91cf \u5668 \u91cf \u7d66 \u4eba \uff0c \u4e5f \u5fc5 \u7528 \u751a \u9ebc \u91cf \u5668 \u91cf \u7d66 \u4f60 \u5011 \uff0c \u4e26 \u4e14 \u8981 \u591a \u7d66 \u4f60 \u5011 \u3002"}, {"pk": 582331, "verse": 25, "text": "\u56e0 \u70ba \u6709 \u7684 \uff0c \u9084 \u8981 \u7d66 \u4ed6 \uff1b \u6c92 \u6709 \u7684 \uff0c \u9023 \u4ed6 \u6240 \u6709 \u7684 \u4e5f \u8981 \u596a \u53bb \u3002"}, {"pk": 582332, "verse": 26, "text": "\u53c8 \u8aaa \uff1a \u795e \u7684 \u570b \u5982 \u540c \u4eba \u628a \u7a2e \u6492 \u5728 \u5730 \u4e0a \u3002"}, {"pk": 582333, "verse": 27, "text": "\u9ed1 \u591c \u7761 \u89ba \uff0c \u767d \u65e5 \u8d77 \u4f86 \uff0c \u9019 \u7a2e \u5c31 \u767c \u82bd \u6f38 \u9577 \uff0c \u90a3 \u4eba \u537b \u4e0d \u66c9 \u5f97 \u5982 \u4f55 \u9019 \u6a23 \u3002"}, {"pk": 582334, "verse": 28, "text": "\u5730 \u751f \u4e94 \u7a40 \u662f \u51fa \u65bc \u81ea \u7136 \u7684 \uff1a \u5148 \u767c \u82d7 \uff0c \u5f8c \u9577 \u7a57 \uff0c \u518d \u5f8c \u7a57 \u4e0a \u7d50 \u6210 \u98fd \u6eff \u7684 \u5b50 \u7c92 \uff1b"}, {"pk": 582335, "verse": 29, "text": "\u7a40 \u65e2 \u719f \u4e86 \uff0c \u5c31 \u7528 \u942e \u5200 \u53bb \u5272 \uff0c \u56e0 \u70ba \u6536 \u6210 \u7684 \u6642 \u5019 \u5230 \u4e86 \u3002"}, {"pk": 582336, "verse": 30, "text": "\u53c8 \u8aaa \uff1a \u795e \u7684 \u570b \uff0c \u6211 \u5011 \u53ef \u7528 \u751a \u9ebc \u6bd4 \u8f03 \u5462 \uff1f \u53ef \u7528 \u751a \u9ebc \u6bd4 \u55bb \u8868 \u660e \u5462 \uff1f"}, {"pk": 582337, "verse": 31, "text": "\u597d \u50cf \u4e00 \u7c92 \u82a5 \u83dc \u7a2e \uff0c \u7a2e \u5728 \u5730 \u88e1 \u7684 \u6642 \u5019 \uff0c \u96d6 \u6bd4 \u5730 \u4e0a \u7684 \u767e \u7a2e \u90fd \u5c0f \uff0c"}, {"pk": 582338, "verse": 32, "text": "\u4f46 \u7a2e \u4e0a \u4ee5 \u5f8c \uff0c \u5c31 \u9577 \u8d77 \u4f86 \uff0c \u6bd4 \u5404 \u6a23 \u7684 \u83dc \u90fd \u5927 \uff0c \u53c8 \u9577 \u51fa \u5927 \u679d \u4f86 \uff0c \u751a \u81f3 \u5929 \u4e0a \u7684 \u98db \u9ce5 \u53ef \u4ee5 \u5bbf \u5728 \u4ed6 \u7684 \u852d \u4e0b \u3002"}, {"pk": 582339, "verse": 33, "text": "\u8036 \u7a4c \u7528 \u8a31 \u591a \u9019 \u6a23 \u7684 \u6bd4 \u55bb \uff0c \u7167 \u4ed6 \u5011 \u6240 \u80fd \u807d \u7684 \uff0c \u5c0d \u4ed6 \u5011 \u8b1b \u9053 \u3002"}, {"pk": 582340, "verse": 34, "text": "\u82e5 \u4e0d \u7528 \u6bd4 \u55bb \uff0c \u5c31 \u4e0d \u5c0d \u4ed6 \u5011 \u8b1b \uff1b \u6c92 \u6709 \u4eba \u7684 \u6642 \u5019 \uff0c \u5c31 \u628a \u4e00 \u5207 \u7684 \u9053 \u8b1b \u7d66 \u9580 \u5f92 \u807d \u3002"}, {"pk": 582341, "verse": 35, "text": "\u7576 \u90a3 \u5929 \u665a \u4e0a \uff0c \u8036 \u7a4c \u5c0d \u9580 \u5f92 \u8aaa \uff1a \u6211 \u5011 \u6e21 \u5230 \u90a3 \u908a \u53bb \u7f77 \u3002"}, {"pk": 582342, "verse": 36, "text": "\u9580 \u5f92 \u96e2 \u958b \u773e \u4eba \uff0c \u8036 \u7a4c \u4ecd \u5728 \u8239 \u4e0a \uff0c \u4ed6 \u5011 \u5c31 \u628a \u4ed6 \u4e00 \u540c \u5e36 \u53bb \uff1b \u4e5f \u6709 \u5225 \u7684 \u8239 \u548c \u4ed6 \u540c \u884c \u3002"}, {"pk": 582343, "verse": 37, "text": "\u5ffd \u7136 \u8d77 \u4e86 \u66b4 \u98a8 \uff0c \u6ce2 \u6d6a \u6253 \u5165 \u8239 \u5167 \uff0c \u751a \u81f3 \u8239 \u8981 \u6eff \u4e86 \u6c34 \u3002"}, {"pk": 582344, "verse": 38, "text": "\u8036 \u7a4c \u5728 \u8239 \u5c3e \u4e0a \uff0c \u6795 \u8457 \u6795 \u982d \u7761 \u89ba \u3002 \u9580 \u5f92 \u53eb \u9192 \u4e86 \u4ed6 \uff0c \u8aaa \uff1a \u592b \u5b50 \uff01 \u6211 \u5011 \u55aa \u547d \uff0c \u4f60 \u4e0d \u9867 \u9ebc \uff1f"}, {"pk": 582345, "verse": 39, "text": "\u8036 \u7a4c \u9192 \u4e86 \uff0c \u65a5 \u8cac \u98a8 \uff0c \u5411 \u6d77 \u8aaa \uff1a \u4f4f \u4e86 \u7f77 \uff01 \u975c \u4e86 \u7f77 \uff01 \u98a8 \u5c31 \u6b62 \u4f4f \uff0c \u5927 \u5927 \u7684 \u5e73 \u975c \u4e86 \u3002"}, {"pk": 582346, "verse": 40, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u70ba \u751a \u9ebc \u81bd \u602f \uff1f \u4f60 \u5011 \u9084 \u6c92 \u6709 \u4fe1 \u5fc3 \u9ebc \uff1f"}, {"pk": 582347, "verse": 41, "text": "\u4ed6 \u5011 \u5c31 \u5927 \u5927 \u7684 \u61fc \u6015 \uff0c \u5f7c \u6b64 \u8aaa \uff1a \u9019 \u5230 \u5e95 \u662f \u8ab0 \uff0c \u9023 \u98a8 \u548c \u6d77 \u4e5f \u807d \u5f9e \u4ed6 \u4e86 \u3002"}]