[{"pk": 581266, "verse": 1, "text": "\u4f60 \u5011 \u8981 \u5c0f \u5fc3 \uff0c \u4e0d \u53ef \u5c07 \u5584 \u4e8b \u884c \u5728 \u4eba \u7684 \u9762 \u524d \uff0c \u6545 \u610f \u53eb \u4ed6 \u5011 \u770b \u898b \uff0c \u82e5 \u662f \u9019 \u6a23 \uff0c \u5c31 \u4e0d \u80fd \u5f97 \u4f60 \u5011 \u5929 \u7236 \u7684 \u8cde \u8cdc \u4e86 \u3002"}, {"pk": 581267, "verse": 2, "text": "\u6240 \u4ee5 \uff0c \u4f60 \u65bd \u6368 \u7684 \u6642 \u5019 \uff0c \u4e0d \u53ef \u5728 \u4f60 \u9762 \u524d \u5439 \u865f \uff0c \u50cf \u90a3 \u5047 \u5192 \u70ba \u5584 \u7684 \u4eba \u5728 \u6703 \u5802 \u88e1 \u548c \u8857 \u9053 \u4e0a \u6240 \u884c \u7684 \uff0c \u6545 \u610f \u8981 \u5f97 \u4eba \u7684 \u69ae \u8000 \u3002 \u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4ed6 \u5011 \u5df2 \u7d93 \u5f97 \u4e86 \u4ed6 \u5011 \u7684 \u8cde \u8cdc \u3002"}, {"pk": 581268, "verse": 3, "text": "\u4f60 \u65bd \u6368 \u7684 \u6642 \u5019 \uff0c \u4e0d \u8981 \u53eb \u5de6 \u624b \u77e5 \u9053 \u53f3 \u624b \u6240 \u505a \u7684 \uff0c"}, {"pk": 581269, "verse": 4, "text": "\u8981 \u53eb \u4f60 \u65bd \u6368 \u7684 \u4e8b \u884c \u5728 \u6697 \u4e2d \u3002 \u4f60 \u7236 \u5728 \u6697 \u4e2d \u5bdf \u770b \uff0c \u5fc5 \u7136 \u5831 \u7b54 \u4f60 \uff08 \u6709 \u53e4 \u5377 \uff1a \u5fc5 \u5728 \u660e \u8655 \u5831 \u7b54 \u4f60 \uff09 \u3002"}, {"pk": 581270, "verse": 5, "text": "\u4f60 \u5011 \u79b1 \u544a \u7684 \u6642 \u5019 \uff0c \u4e0d \u53ef \u50cf \u90a3 \u5047 \u5192 \u70ba \u5584 \u7684 \u4eba \uff0c \u611b \u7ad9 \u5728 \u6703 \u5802 \u88e1 \u548c \u5341 \u5b57 \u8def \u53e3 \u4e0a \u79b1 \u544a \uff0c \u6545 \u610f \u53eb \u4eba \u770b \u898b \u3002 \u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4ed6 \u5011 \u5df2 \u7d93 \u5f97 \u4e86 \u4ed6 \u5011 \u7684 \u8cde \u8cdc \u3002"}, {"pk": 581271, "verse": 6, "text": "\u4f60 \u79b1 \u544a \u7684 \u6642 \u5019 \uff0c \u8981 \u9032 \u4f60 \u7684 \u5167 \u5c4b \uff0c \u95dc \u4e0a \u9580 \uff0c \u79b1 \u544a \u4f60 \u5728 \u6697 \u4e2d \u7684 \u7236 \uff1b \u4f60 \u7236 \u5728 \u6697 \u4e2d \u5bdf \u770b \uff0c \u5fc5 \u7136 \u5831 \u7b54 \u4f60 \u3002"}, {"pk": 581272, "verse": 7, "text": "\u4f60 \u5011 \u79b1 \u544a \uff0c \u4e0d \u53ef \u50cf \u5916 \u90a6 \u4eba \uff0c \u7528 \u8a31 \u591a \u91cd \u8907 \u8a71 \uff0c \u4ed6 \u5011 \u4ee5 \u70ba \u8a71 \u591a \u4e86 \u5fc5 \u8499 \u5782 \u807d \u3002"}, {"pk": 581273, "verse": 8, "text": "\u4f60 \u5011 \u4e0d \u53ef \u6548 \u6cd5 \u4ed6 \u5011 \uff1b \u56e0 \u70ba \u4f60 \u5011 \u6c92 \u6709 \u7948 \u6c42 \u4ee5 \u5148 \uff0c \u4f60 \u5011 \u6240 \u9700 \u7528 \u7684 \uff0c \u4f60 \u5011 \u7684 \u7236 \u65e9 \u5df2 \u77e5 \u9053 \u4e86 \u3002"}, {"pk": 581274, "verse": 9, "text": "\u6240 \u4ee5 \uff0c \u4f60 \u5011 \u79b1 \u544a \u8981 \u9019 \u6a23 \u8aaa \uff1a \u6211 \u5011 \u5728 \u5929 \u4e0a \u7684 \u7236 \uff1a \u9858 \u4eba \u90fd \u5c0a \u4f60 \u7684 \u540d \u70ba \u8056 \u3002"}, {"pk": 581275, "verse": 10, "text": "\u9858 \u4f60 \u7684 \u570b \u964d \u81e8 \uff1b \u9858 \u4f60 \u7684 \u65e8 \u610f \u884c \u5728 \u5730 \u4e0a \uff0c \u5982 \u540c \u884c \u5728 \u5929 \u4e0a \u3002"}, {"pk": 581276, "verse": 11, "text": "\u6211 \u5011 \u65e5 \u7528 \u7684 \u98f2 \u98df \uff0c \u4eca \u65e5 \u8cdc \u7d66 \u6211 \u5011 \u3002"}, {"pk": 581277, "verse": 12, "text": "\u514d \u6211 \u5011 \u7684 \u50b5 \uff0c \u5982 \u540c \u6211 \u5011 \u514d \u4e86 \u4eba \u7684 \u50b5 \u3002"}, {"pk": 581278, "verse": 13, "text": "\u4e0d \u53eb \u6211 \u5011 \u9047 \u898b \u8a66 \u63a2 \uff1b \u6551 \u6211 \u5011 \u812b \u96e2 \u5147 \u60e1 \uff08 \u6216 \u4f5c \uff1a \u812b \u96e2 \u60e1 \u8005 \uff09 \u3002 \u56e0 \u70ba \u570b \u5ea6 \u3001 \u6b0a \u67c4 \u3001 \u69ae \u8000 \uff0c \u5168 \u662f \u4f60 \u7684 \uff0c \u76f4 \u5230 \u6c38 \u9060 \u3002 \u963f \u5011 \uff08 \u6709 \u53e4 \u5377 \u6c92 \u6709 \u56e0 \u70ba \u2026 \u2026 \u963f \u5011 \u7b49 \u5b57 \uff09 \uff01"}, {"pk": 581279, "verse": 14, "text": "\u4f60 \u5011 \u9952 \u6055 \u4eba \u7684 \u904e \u72af \uff0c \u4f60 \u5011 \u7684 \u5929 \u7236 \u4e5f \u5fc5 \u9952 \u6055 \u4f60 \u5011 \u7684 \u904e \u72af \uff1b"}, {"pk": 581280, "verse": 15, "text": "\u4f60 \u5011 \u4e0d \u9952 \u6055 \u4eba \u7684 \u904e \u72af \uff0c \u4f60 \u5011 \u7684 \u5929 \u7236 \u4e5f \u5fc5 \u4e0d \u9952 \u6055 \u4f60 \u5011 \u7684 \u904e \u72af \u3002"}, {"pk": 581281, "verse": 16, "text": "\u4f60 \u5011 \u7981 \u98df \u7684 \u6642 \u5019 \uff0c \u4e0d \u53ef \u50cf \u90a3 \u5047 \u5192 \u70ba \u5584 \u7684 \u4eba \uff0c \u81c9 \u4e0a \u5e36 \u8457 \u6101 \u5bb9 \uff1b \u56e0 \u70ba \u4ed6 \u5011 \u628a \u81c9 \u5f04 \u5f97 \u96e3 \u770b \uff0c \u6545 \u610f \u53eb \u4eba \u770b \u51fa \u4ed6 \u5011 \u662f \u7981 \u98df \u3002 \u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4ed6 \u5011 \u5df2 \u7d93 \u5f97 \u4e86 \u4ed6 \u5011 \u7684 \u8cde \u8cdc \u3002"}, {"pk": 581282, "verse": 17, "text": "\u4f60 \u7981 \u98df \u7684 \u6642 \u5019 \uff0c \u8981 \u68b3 \u982d \u6d17 \u81c9 \uff0c"}, {"pk": 581283, "verse": 18, "text": "\u4e0d \u53eb \u4eba \u770b \u51fa \u4f60 \u7981 \u98df \u4f86 \uff0c \u53ea \u53eb \u4f60 \u6697 \u4e2d \u7684 \u7236 \u770b \u898b \uff1b \u4f60 \u7236 \u5728 \u6697 \u4e2d \u5bdf \u770b \uff0c \u5fc5 \u7136 \u5831 \u7b54 \u4f60 \u3002"}, {"pk": 581284, "verse": 19, "text": "\u4e0d \u8981 \u70ba \u81ea \u5df1 \u7a4d \u5139 \u8ca1 \u5bf6 \u5728 \u5730 \u4e0a \uff1b \u5730 \u4e0a \u6709 \u87f2 \u5b50 \u54ac \uff0c \u80fd \ufffd \u58de \uff0c \u4e5f \u6709 \u8cca \u6316 \u7a9f \u7abf \u4f86 \u5077 \u3002"}, {"pk": 581285, "verse": 20, "text": "\u53ea \u8981 \u7a4d \u5139 \u8ca1 \u5bf6 \u5728 \u5929 \u4e0a \uff1b \u5929 \u4e0a \u6c92 \u6709 \u87f2 \u5b50 \u54ac \uff0c \u4e0d \u80fd \ufffd \u58de \uff0c \u4e5f \u6c92 \u6709 \u8cca \u6316 \u7a9f \u7abf \u4f86 \u5077 \u3002"}, {"pk": 581286, "verse": 21, "text": "\u56e0 \u70ba \u4f60 \u7684 \u8ca1 \u5bf6 \u5728 \u90a3 \u88e1 \uff0c \u4f60 \u7684 \u5fc3 \u4e5f \u5728 \u90a3 \u88e1 \u3002"}, {"pk": 581287, "verse": 22, "text": "\u773c \u775b \u5c31 \u662f \u8eab \u4e0a \u7684 \u71c8 \u3002 \u4f60 \u7684 \u773c \u775b \u82e5 \u77ad \u4eae \uff0c \u5168 \u8eab \u5c31 \u5149 \u660e \uff1b"}, {"pk": 581288, "verse": 23, "text": "\u4f60 \u7684 \u773c \u775b \u82e5 \u660f \u82b1 \uff0c \u5168 \u8eab \u5c31 \u9ed1 \u6697 \u3002 \u4f60 \u88e1 \u982d \u7684 \u5149 \u82e5 \u9ed1 \u6697 \u4e86 \uff0c \u90a3 \u9ed1 \u6697 \u662f \u4f55 \u7b49 \u5927 \u5462 \uff01"}, {"pk": 581289, "verse": 24, "text": "\u4e00 \u500b \u4eba \u4e0d \u80fd \u4e8b \u5949 \u5169 \u500b \u4e3b \uff1b \u4e0d \u662f \u60e1 \u9019 \u500b \uff0c \u611b \u90a3 \u500b \uff0c \u5c31 \u662f \u91cd \u9019 \u500b \uff0c \u8f15 \u90a3 \u500b \u3002 \u4f60 \u5011 \u4e0d \u80fd \u53c8 \u4e8b \u5949 \u795e \uff0c \u53c8 \u4e8b \u5949 \u746a \u9580 \uff08 \u746a \u9580 \uff1a \u8ca1 \u5229 \u7684 \u610f \u601d \uff09 \u3002"}, {"pk": 581290, "verse": 25, "text": "\u6240 \u4ee5 \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4e0d \u8981 \u70ba \u751f \u547d \u6182 \u616e \u5403 \u751a \u9ebc \uff0c \u559d \u751a \u9ebc \uff1b \u70ba \u8eab \u9ad4 \u6182 \u616e \u7a7f \u751a \u9ebc \u3002 \u751f \u547d \u4e0d \u52dd \u65bc \u98f2 \u98df \u9ebc \uff1f \u8eab \u9ad4 \u4e0d \u52dd \u65bc \u8863 \u88f3 \u9ebc \uff1f"}, {"pk": 581291, "verse": 26, "text": "\u4f60 \u5011 \u770b \u90a3 \u5929 \u4e0a \u7684 \u98db \u9ce5 \uff0c \u4e5f \u4e0d \u7a2e \uff0c \u4e5f \u4e0d \u6536 \uff0c \u4e5f \u4e0d \u7a4d \u84c4 \u5728 \u5009 \u88e1 \uff0c \u4f60 \u5011 \u7684 \u5929 \u7236 \u5c1a \u4e14 \u990a \u6d3b \u4ed6 \u3002 \u4f60 \u5011 \u4e0d \u6bd4 \u98db \u9ce5 \u8cb4 \u91cd \u5f97 \u591a \u9ebc \uff1f"}, {"pk": 581292, "verse": 27, "text": "\u4f60 \u5011 \u90a3 \u4e00 \u500b \u80fd \u7528 \u601d \u616e \u4f7f \u58fd \u6578 \u591a \u52a0 \u4e00 \u523b \u5462 \uff08 \u6216 \u4f5c \uff1a \u4f7f \u8eab \u91cf \u591a \u52a0 \u4e00 \u8098 \u5462 \uff09 \uff1f"}, {"pk": 581293, "verse": 28, "text": "\u4f55 \u5fc5 \u70ba \u8863 \u88f3 \u6182 \u616e \u5462 \uff1f \u4f60 \u60f3 \u91ce \u5730 \u88e1 \u7684 \u767e \u5408 \u82b1 \u600e \u9ebc \u9577 \u8d77 \u4f86 \uff1b \u4ed6 \u4e5f \u4e0d \u52de \u82e6 \uff0c \u4e5f \u4e0d \u7d21 \u7dda \u3002"}, {"pk": 581294, "verse": 29, "text": "\u7136 \u800c \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u5c31 \u662f \u6240 \u7f85 \u9580 \u6975 \u69ae \u83ef \u7684 \u6642 \u5019 \uff0c \u4ed6 \u6240 \u7a7f \u6234 \u7684 \uff0c \u9084 \u4e0d \u5982 \u9019 \u82b1 \u4e00 \u6735 \u5462 \uff01"}, {"pk": 581295, "verse": 30, "text": "\u4f60 \u5011 \u9019 \u5c0f \u4fe1 \u7684 \u4eba \u54ea \uff01 \u91ce \u5730 \u88e1 \u7684 \u8349 \u4eca \u5929 \u9084 \u5728 \uff0c \u660e \u5929 \u5c31 \u4e1f \u5728 \u7210 \u88e1 \uff0c \u795e \u9084 \u7d66 \u4ed6 \u9019 \u6a23 \u7684 \u599d \u98fe \uff0c \u4f55 \u6cc1 \u4f60 \u5011 \u5462 \uff01"}, {"pk": 581296, "verse": 31, "text": "\u6240 \u4ee5 \uff0c \u4e0d \u8981 \u6182 \u616e \u8aaa \uff1a \u5403 \u751a \u9ebc \uff1f \u559d \u751a \u9ebc \uff1f \u7a7f \u751a \u9ebc \uff1f"}, {"pk": 581297, "verse": 32, "text": "\u9019 \u90fd \u662f \u5916 \u90a6 \u4eba \u6240 \u6c42 \u7684 \uff0c \u4f60 \u5011 \u9700 \u7528 \u7684 \u9019 \u4e00 \u5207 \u6771 \u897f \uff0c \u4f60 \u5011 \u7684 \u5929 \u7236 \u662f \u77e5 \u9053 \u7684 \u3002"}, {"pk": 581298, "verse": 33, "text": "\u4f60 \u5011 \u8981 \u5148 \u6c42 \u4ed6 \u7684 \u570b \u548c \u4ed6 \u7684 \u7fa9 \uff0c \u9019 \u4e9b \u6771 \u897f \u90fd \u8981 \u52a0 \u7d66 \u4f60 \u5011 \u4e86 \u3002"}, {"pk": 581299, "verse": 34, "text": "\u6240 \u4ee5 \uff0c \u4e0d \u8981 \u70ba \u660e \u5929 \u6182 \u616e \uff0c \u56e0 \u70ba \u660e \u5929 \u81ea \u6709 \u660e \u5929 \u7684 \u6182 \u616e \uff1b \u4e00 \u5929 \u7684 \u96e3 \u8655 \u4e00 \u5929 \u7576 \u5c31 \u5920 \u4e86 \u3002"}]