[{"pk": 566373, "verse": 1, "text": "\u6b64 \u5f8c \uff0c \u62bc \u6c99 \u9f8d \u70ba \u81ea \u5df1 \u9810 \u5099 \u8eca \u99ac \uff0c \u53c8 \u6d3e \u4e94 \u5341 \u4eba \u5728 \u4ed6 \u524d \u982d \u5954 \u8d70 \u3002"}, {"pk": 566374, "verse": 2, "text": "\u62bc \u6c99 \u9f8d \u5e38 \u5e38 \u65e9 \u6668 \u8d77 \u4f86 \uff0c \u7ad9 \u5728 \u57ce \u9580 \u7684 \u9053 \u65c1 \uff0c \u51e1 \u6709 \u722d \u8a1f \u8981 \u53bb \u6c42 \u738b  \u5224 \u65b7 \u7684 \uff0c \u62bc \u6c99 \u9f8d \u5c31 \u53eb \u4ed6 \u904e \u4f86 \uff0c \u554f \u4ed6 \u8aaa \uff1a \u4f60 \u662f \u54ea \u4e00 \u57ce \u7684 \u4eba \uff1f \u56de \u7b54 \u8aaa \uff1a \u50d5 \u4eba \u662f \u4ee5 \u8272 \u5217 \u67d0 \u652f \u6d3e \u7684 \u4eba \u3002"}, {"pk": 566375, "verse": 3, "text": "\u62bc \u6c99 \u9f8d \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u7684 \u4e8b \u6709 \u60c5 \u6709 \u7406 \uff0c \u7121 \u5948 \u738b \u6c92 \u6709 \u59d4 \u4eba \u807d \u4f60 \u4f38 \u8a34 \u3002"}, {"pk": 566376, "verse": 4, "text": "\u62bc \u6c99 \u9f8d \u53c8 \u8aaa \uff1a \u6068 \u4e0d \u5f97 \u6211 \u4f5c \u570b \u4e2d \u7684 \u58eb \u5e2b \uff01 \u51e1 \u6709 \u722d \u8a1f \u6c42 \u5be9 \u5224 \u7684 \u5230 \u6211 \u9019 \u88e1 \u4f86 \uff0c \u6211 \u5fc5 \u79c9 \u516c \u5224 \u65b7 \u3002"}, {"pk": 566377, "verse": 5, "text": "\u82e5 \u6709 \u4eba \u8fd1 \u524d \u4f86 \u8981 \u62dc \u62bc \u6c99 \u9f8d \uff0c \u62bc \u6c99 \u9f8d \u5c31 \u4f38 \u624b \u62c9 \u4f4f \u4ed6 \uff0c \u8207 \u4ed6 \u89aa \u5634 \u3002"}, {"pk": 566378, "verse": 6, "text": "\u4ee5 \u8272 \u5217 \u4eba \u4e2d \uff0c \u51e1 \u53bb \u898b \u738b \u6c42 \u5224 \u65b7 \u7684 \uff0c \u62bc \u6c99 \u9f8d \u90fd \u662f \u5982 \u6b64 \u5f85 \u4ed6 \u5011 \u3002 \u9019 \u6a23 \uff0c \u62bc \u6c99 \u9f8d \u6697 \u4e2d \u5f97 \u4e86 \u4ee5 \u8272 \u5217 \u4eba \u7684 \u5fc3 \u3002"}, {"pk": 566379, "verse": 7, "text": "\u6eff \u4e86 \u56db \u5341 \u5e74 \uff08 \u6709 \u4f5c \u56db \u5e74 \u7684 \uff09 \uff0c \u62bc \u6c99 \u9f8d \u5c0d \u738b \u8aaa \uff1a \u6c42 \u4f60 \u51c6 \u6211 \u5f80 \u5e0c \u4f2f \u5d19 \u53bb \uff0c \u9084 \u6211 \u5411 \u8036 \u548c \u83ef \u6240 \u8a31 \u7684 \u9858 \u3002"}, {"pk": 566380, "verse": 8, "text": "\u56e0 \u70ba \u50d5 \u4eba \u4f4f \u5728 \u4e9e \u862d \u7684 \u57fa \u8ff0 \uff0c \u66fe \u8a31 \u9858 \u8aaa \uff1a \u8036 \u548c \u83ef \u82e5 \u4f7f \u6211 \u518d \u56de \u8036 \u8def \u6492 \u51b7 \uff0c \u6211 \u5fc5 \u4e8b \u5949 \u4ed6 \u3002"}, {"pk": 566381, "verse": 9, "text": "\u738b \u8aaa \uff1a \u4f60 \u5e73 \u5e73 \u5b89 \u5b89 \u5730 \u53bb \u7f77 \uff01 \u62bc \u6c99 \u9f8d \u5c31 \u8d77 \u8eab \uff0c \u5f80 \u5e0c \u4f2f \u5d19 \u53bb \u4e86 \u3002"}, {"pk": 566382, "verse": 10, "text": "\u62bc \u6c99 \u9f8d \u6253 \u767c \u63a2 \u5b50 \u8d70 \u904d \u4ee5 \u8272 \u5217 \u5404 \u652f \u6d3e \uff0c \u8aaa \uff1a \u4f60 \u5011 \u4e00 \u807d \u898b \u89d2 \u8072 \u5c31 \u8aaa \uff1a \u62bc \u6c99 \u9f8d \u5728 \u5e0c \u4f2f \u5d19 \u4f5c \u738b \u4e86 \uff01"}, {"pk": 566383, "verse": 11, "text": "\u62bc \u6c99 \u9f8d \u5728 \u8036 \u8def \u6492 \u51b7 \u8acb \u4e86 \u4e8c \u767e \u4eba \u8207 \u4ed6 \u540c \u53bb \uff0c \u90fd \u662f \u8aa0 \u8aa0 \u5be6 \u5be6 \u53bb \u7684 \uff0c \u4e26 \u4e0d \u77e5 \u9053 \u5176 \u4e2d \u7684 \u771f \u60c5 \u3002"}, {"pk": 566384, "verse": 12, "text": "\u62bc \u6c99 \u9f8d \u737b \u796d \u7684 \u6642 \u5019 \uff0c \u6253 \u767c \u4eba \u53bb \u5c07 \u5927 \u885b \u7684 \u8b00 \u58eb \u3001 \u57fa \u7f85 \u4eba \u4e9e \u5e0c \u591a \u5f17 \u5f9e \u4ed6 \u672c \u57ce \u8acb \u4e86 \u4f86 \u3002 \u65bc \u662f \u53db \u9006 \u7684 \u52e2 \u6d3e \u751a \u5927 \uff1b \u56e0 \u70ba \u96a8 \u5f9e \u62bc \u6c99 \u9f8d \u7684 \u4eba \u6c11 \uff0c \u65e5 \u6f38 \u589e \u591a \u3002"}, {"pk": 566385, "verse": 13, "text": "\u6709 \u4eba \u5831 \u544a \u5927 \u885b \u8aaa \uff1a \u4ee5 \u8272 \u5217 \u4eba \u7684 \u5fc3 \u90fd \u6b78 \u5411 \u62bc \u6c99 \u9f8d \u4e86 \uff01"}, {"pk": 566386, "verse": 14, "text": "\u5927 \u885b \u5c31 \u5c0d \u8036 \u8def \u6492 \u51b7 \u8ddf \u96a8 \u4ed6 \u7684 \u81e3 \u50d5 \u8aaa \uff1a \u6211 \u5011 \u8981 \u8d77 \u4f86 \u9003 \u8d70 \uff0c \u4e0d \u7136 \u90fd \u4e0d \u80fd \u8eb2 \u907f \u62bc \u6c99 \u9f8d \u4e86 \uff1b \u8981 \u901f \u901f \u5730 \u53bb \uff0c \u6050 \u6015 \u4ed6 \u5ffd \u7136 \u4f86 \u5230 \uff0c \u52a0 \u5bb3 \u65bc \u6211 \u5011 \uff0c \u7528 \u5200 \u6bba \u76e1 \u5408 \u57ce \u7684 \u4eba \u3002"}, {"pk": 566387, "verse": 15, "text": "\u738b \u7684 \u81e3 \u50d5 \u5c0d \u738b \u8aaa \uff1a \u6211 \u4e3b \u6211 \u738b \u6240 \u5b9a \u7684 \uff0c \u50d5 \u4eba \u90fd \u9858 \u9075 \u884c \u3002"}, {"pk": 566388, "verse": 16, "text": "\u65bc \u662f \u738b \u5e36 \u8457 \u5168 \u5bb6 \u7684 \u4eba \u51fa \u53bb \u4e86 \uff0c \u4f46 \u7559 \u4e0b \u5341 \u500b \u5983 \u5b2a \u770b \u5b88 \u5bae \u6bbf \u3002"}, {"pk": 566389, "verse": 17, "text": "\u738b \u51fa \u53bb \uff0c \u773e \u6c11 \u90fd \u8ddf \u96a8 \u4ed6 \uff0c \u5230 \u4f2f \u58a8 \u54c8 \uff0c \u5c31 \u4f4f \u4e0b \u4e86 \u3002"}, {"pk": 566390, "verse": 18, "text": "\u738b \u7684 \u81e3 \u50d5 \u90fd \u5728 \u4ed6 \u9762 \u524d \u904e \u53bb \u3002 \u57fa \u5229 \u63d0 \u4eba \u3001 \u6bd4 \u5229 \u63d0 \u4eba \uff0c \u5c31 \u662f \u5f9e \u8fe6 \u7279 \u8ddf \u96a8 \u738b \u4f86 \u7684 \u516d \u767e \u4eba \uff0c \u4e5f \u90fd \u5728 \u4ed6 \u9762 \u524d \u904e \u53bb \u3002"}, {"pk": 566391, "verse": 19, "text": "\u738b \u5c0d \u8fe6 \u7279 \u4eba \u4ee5 \u592a \u8aaa \uff1a \u4f60 \u662f \u5916 \u90a6 \u9003 \u4f86 \u7684 \u4eba \uff0c \u70ba \u751a \u9ebc \u8207 \u6211 \u5011 \u540c \u53bb \u5462 \uff1f \u4f60 \u53ef \u4ee5 \u56de \u53bb \u8207 \u65b0 \u738b \u540c \u4f4f \uff0c \u6216 \u8005 \u56de \u4f60 \u672c \u5730 \u53bb \u7f77 \uff01"}, {"pk": 566392, "verse": 20, "text": "\u4f60 \u4f86 \u7684 \u65e5 \u5b50 \u4e0d \u591a \uff0c \u6211 \u4eca \u65e5 \u600e \u597d \u53eb \u4f60 \u8207 \u6211 \u5011 \u4e00 \u540c \u98c4 \u6d41 \u3001 \u6c92 \u6709 \u4e00 \u5b9a \u7684 \u4f4f \u8655 \u5462 \uff1f \u4f60 \u4e0d \u5982 \u5e36 \u4f60 \u7684 \u5f1f \u5144 \u56de \u53bb \u7f77 \uff01 \u9858 \u8036 \u548c \u83ef \u7528 \u6148 \u611b \u8aa0 \u5be6 \u5f85 \u4f60 \u3002"}, {"pk": 566393, "verse": 21, "text": "\u4ee5 \u592a \u5c0d \u738b \u8aaa \uff1a \u6211 \u6307 \u8457 \u6c38 \u751f \u7684 \u8036 \u548c \u83ef \u8d77 \u8a93 \uff0c \u53c8 \u6562 \u5728 \u738b \u9762 \u524d \u8d77 \u8a93 \uff1a \u7121 \u8ad6 \u751f \u6b7b \uff0c \u738b \u5728 \u54ea \u88e1 \uff0c \u50d5 \u4eba \u4e5f \u5fc5 \u5728 \u90a3 \u88e1 \u3002"}, {"pk": 566394, "verse": 22, "text": "\u5927 \u885b \u5c0d \u4ee5 \u592a \u8aaa \uff1a \u4f60 \u524d \u53bb \u904e \u6cb3 \u7f77 \uff01 \u65bc \u662f \u8fe6 \u7279 \u4eba \u4ee5 \u592a \u5e36 \u8457 \u8ddf \u96a8 \u4ed6 \u7684 \u4eba \u548c \u6240 \u6709 \u7684 \u5a66 \u4eba \u5b69 \u5b50 \uff0c \u5c31 \u90fd \u904e \u53bb \u4e86 \u3002"}, {"pk": 566395, "verse": 23, "text": "\u672c \u5730 \u7684 \u4eba \u90fd \u653e \u8072 \u5927 \u54ed \u3002 \u773e \u6c11 \u76e1 \u90fd \u904e \u53bb \uff0c \u738b \u4e5f \u904e \u4e86 \u6c72 \u6dea \u6eaa \uff1b \u773e \u6c11 \u5f80 \u66e0 \u91ce \u53bb \u4e86 \u3002"}, {"pk": 566396, "verse": 24, "text": "\u6492 \u7763 \u548c \u62ac \u3000 \u795e \u7d04 \u6ac3 \u7684 \u5229 \u672a \u4eba \u4e5f \u4e00 \u540c \u4f86 \u4e86 \uff0c \u5c07 \u3000 \u795e \u7684 \u7d04 \u6ac3 \u653e \u4e0b \u3002 \u4e9e \u6bd4 \u4e9e \u4ed6 \u4e0a \u4f86 \uff0c \u7b49 \u8457 \u773e \u6c11 \u5f9e \u57ce \u88e1 \u51fa \u4f86 \u904e \u53bb \u3002"}, {"pk": 566397, "verse": 25, "text": "\u738b \u5c0d \u6492 \u7763 \u8aaa \uff1a \u4f60 \u5c07 \u3000 \u795e \u7684 \u7d04 \u6ac3 \u62ac \u56de \u57ce \u53bb \u3002 \u6211 \u82e5 \u5728 \u8036 \u548c \u83ef \u773c \u524d \u8499 \u6069 \uff0c \u4ed6 \u5fc5 \u4f7f \u6211 \u56de \u4f86 \uff0c \u518d \u898b \u7d04 \u6ac3 \u548c \u4ed6 \u7684 \u5c45 \u6240 \u3002"}, {"pk": 566398, "verse": 26, "text": "\u5018 \u82e5 \u4ed6 \u8aaa \uff1a \u6211 \u4e0d \u559c \u6085 \u4f60 \uff0c \u770b \u54ea \uff0c \u6211 \u5728 \u9019 \u88e1 \uff0c \u9858 \u4ed6 \u6191 \u81ea \u5df1 \u7684 \u610f \u65e8 \u5f85 \u6211 \uff01"}, {"pk": 566399, "verse": 27, "text": "\u738b \u53c8 \u5c0d \u796d \u53f8 \u6492 \u7763 \u8aaa \uff1a \u4f60 \u4e0d \u662f \u5148 \u898b \u9ebc \uff1f \u4f60 \u53ef \u4ee5 \u5b89 \u7136 \u56de \u57ce \uff1b \u4f60 \u5152 \u5b50 \u4e9e \u5e0c \u746a \u65af \u548c \u4e9e \u6bd4 \u4e9e \u4ed6 \u7684 \u5152 \u5b50 \u7d04 \u62ff \u55ae \u90fd \u53ef \u4ee5 \u8207 \u4f60 \u540c \u53bb \u3002"}, {"pk": 566400, "verse": 28, "text": "\u6211 \u5728 \u66e0 \u91ce \u7684 \u6e21 \u53e3 \u90a3 \u88e1 \u7b49 \u4f60 \u5011 \u5831 \u4fe1 \u7d66 \u6211 \u3002"}, {"pk": 566401, "verse": 29, "text": "\u65bc \u662f \u6492 \u7763 \u548c \u4e9e \u6bd4 \u4e9e \u4ed6 \u5c07 \u3000 \u795e \u7684 \u7d04 \u6ac3 \u62ac \u56de \u8036 \u8def \u6492 \u51b7 \uff0c \u4ed6 \u5011 \u5c31 \u4f4f \u5728 \u90a3 \u88e1 \u3002"}, {"pk": 566402, "verse": 30, "text": "\u5927 \u885b \u8499 \u982d \u8d64 \u8173 \u4e0a \u6a44 \u6b16 \u5c71 \uff0c \u4e00 \u9762 \u4e0a \u4e00 \u9762 \u54ed \u3002 \u8ddf \u96a8 \u4ed6 \u7684 \u4eba \u4e5f \u90fd \u8499 \u982d \u54ed \u8457 \u4e0a \u53bb \uff1b"}, {"pk": 566403, "verse": 31, "text": "\u6709 \u4eba \u544a \u8a34 \u5927 \u885b \u8aaa \uff1a \u4e9e \u5e0c \u591a \u5f17 \u4e5f \u5728 \u53db \u9ee8 \u4e4b \u4e2d \uff0c \u96a8 \u5f9e \u62bc \u6c99 \u9f8d \u3002 \u5927 \u885b \u79b1 \u544a \u8aaa \uff1a \u8036 \u548c \u83ef \u554a \uff0c \u6c42 \u4f60 \u4f7f \u4e9e \u5e0c \u591a \u5f17 \u7684 \u8a08 \u8b00 \u8b8a \u70ba \u611a \u62d9 \uff01"}, {"pk": 566404, "verse": 32, "text": "\u5927 \u885b \u5230 \u4e86 \u5c71 \u9802 \u3001 \u656c \u62dc \u3000 \u795e \u7684 \u5730 \u65b9 \uff0c \u898b \u4e9e \u57fa \u4eba \u6236 \u7be9 \uff0c \u8863 \u670d \u6495 \u88c2 \uff0c \u982d \u8499 \u7070 \u5875 \u4f86 \u8fce \u63a5 \u4ed6 \u3002"}, {"pk": 566405, "verse": 33, "text": "\u5927 \u885b \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u82e5 \u8207 \u6211 \u540c \u53bb \uff0c \u5fc5 \u7d2f \u8d05 \u6211 \uff1b"}, {"pk": 566406, "verse": 34, "text": "\u4f60 \u82e5 \u56de \u57ce \u53bb \uff0c \u5c0d \u62bc \u6c99 \u9f8d \u8aaa \uff1a \u738b \u554a \uff0c \u6211 \u9858 \u4f5c \u4f60 \u7684 \u50d5 \u4eba \uff1b \u6211 \u5411 \u4f86 \u4f5c \u4f60 \u7236 \u89aa \u7684 \u50d5 \u4eba \uff0c \u73fe \u5728 \u6211 \u4e5f \u7167 \u6a23 \u4f5c \u4f60 \u7684 \u50d5 \u4eba \u3002 \u9019 \u6a23 \uff0c \u4f60 \u5c31 \u53ef \u4ee5 \u70ba \u6211 \u7834 \u58de \u4e9e \u5e0c \u591a \u5f17 \u7684 \u8a08 \u8b00 \u3002"}, {"pk": 566407, "verse": 35, "text": "\u796d \u53f8 \u6492 \u7763 \u548c \u4e9e \u6bd4 \u4e9e \u4ed6 \u8c48 \u4e0d \u90fd \u5728 \u90a3 \u88e1 \u9ebc \uff1f \u4f60 \u5728 \u738b \u5bae \u88e1 \u807d \u898b \u751a \u9ebc \uff0c \u5c31 \u8981 \u544a \u8a34 \u796d \u53f8 \u6492 \u7763 \u548c \u4e9e \u6bd4 \u4e9e \u4ed6 \u3002"}, {"pk": 566408, "verse": 36, "text": "\u6492 \u7763 \u7684 \u5152 \u5b50 \u4e9e \u5e0c \u746a \u65af \uff0c \u4e9e \u6bd4 \u4e9e \u4ed6 \u7684 \u5152 \u5b50 \u7d04 \u62ff \u55ae \uff0c \u4e5f \u90fd \u5728 \u90a3 \u88e1 \u3002 \u51e1 \u4f60 \u5011 \u6240 \u807d \u898b \u7684 \u53ef \u4ee5 \u8a17 \u9019 \u4e8c \u4eba \u4f86 \u5831 \u544a \u6211 \u3002"}, {"pk": 566409, "verse": 37, "text": "\u65bc \u662f \uff0c \u5927 \u885b \u7684 \u670b \u53cb \u6236 \u7be9 \u9032 \u4e86 \u57ce \uff1b \u62bc \u6c99 \u9f8d \u4e5f \u9032 \u4e86 \u8036 \u8def \u6492 \u51b7 \u3002"}]