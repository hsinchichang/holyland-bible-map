[{"pk": 581218, "verse": 1, "text": "\u8036 \u7a4c \u770b \u898b \u9019 \u8a31 \u591a \u7684 \u4eba \uff0c \u5c31 \u4e0a \u4e86 \u5c71 \uff0c \u65e2 \u5df2 \u5750 \u4e0b \uff0c \u9580 \u5f92 \u5230 \u4ed6 \u8ddf \u524d \u4f86 \uff0c"}, {"pk": 581219, "verse": 2, "text": "\u4ed6 \u5c31 \u958b \u53e3 \u6559 \u8a13 \u4ed6 \u5011 \uff0c \u8aaa \uff1a"}, {"pk": 581220, "verse": 3, "text": "\u865b \u5fc3 \u7684 \u4eba \u6709 \u798f \u4e86 \uff01 \u56e0 \u70ba \u5929 \u570b \u662f \u4ed6 \u5011 \u7684 \u3002"}, {"pk": 581221, "verse": 4, "text": "\u54c0 \u615f \u7684 \u4eba \u6709 \u798f \u4e86 \uff01 \u56e0 \u70ba \u4ed6 \u5011 \u5fc5 \u5f97 \u5b89 \u6170 \u3002"}, {"pk": 581222, "verse": 5, "text": "\u6eab \u67d4 \u7684 \u4eba \u6709 \u798f \u4e86 \uff01 \u56e0 \u70ba \u4ed6 \u5011 \u5fc5 \u627f \u53d7 \u5730 \u571f \u3002"}, {"pk": 581223, "verse": 6, "text": "\u98e2 \u6e34 \u6155 \u7fa9 \u7684 \u4eba \u6709 \u798f \u4e86 \uff01 \u56e0 \u70ba \u4ed6 \u5011 \u5fc5 \u5f97 \u98fd \u8db3 \u3002"}, {"pk": 581224, "verse": 7, "text": "\u6190 \u6064 \u4eba \u7684 \u4eba \u6709 \u798f \u4e86 \uff01 \u56e0 \u70ba \u4ed6 \u5011 \u5fc5 \u8499 \u6190 \u6064 \u3002"}, {"pk": 581225, "verse": 8, "text": "\u6e05 \u5fc3 \u7684 \u4eba \u6709 \u798f \u4e86 \uff01 \u56e0 \u70ba \u4ed6 \u5011 \u5fc5 \u5f97 \u898b \u795e \u3002"}, {"pk": 581226, "verse": 9, "text": "\u4f7f \u4eba \u548c \u7766 \u7684 \u4eba \u6709 \u798f \u4e86 \uff01 \u56e0 \u70ba \u4ed6 \u5011 \u5fc5 \u7a31 \u70ba \u795e \u7684 \u5152 \u5b50 \u3002"}, {"pk": 581227, "verse": 10, "text": "\u70ba \u7fa9 \u53d7 \u903c \u8feb \u7684 \u4eba \u6709 \u798f \u4e86 \uff01 \u56e0 \u70ba \u5929 \u570b \u662f \u4ed6 \u5011 \u7684 \u3002"}, {"pk": 581228, "verse": 11, "text": "\u4eba \u82e5 \u56e0 \u6211 \u8fb1 \u7f75 \u4f60 \u5011 \uff0c \u903c \u8feb \u4f60 \u5011 \uff0c \u634f \u9020 \u5404 \u6a23 \u58de \u8a71 \u6bc0 \u8b17 \u4f60 \u5011 \uff0c \u4f60 \u5011 \u5c31 \u6709 \u798f \u4e86 \uff01"}, {"pk": 581229, "verse": 12, "text": "\u61c9 \u7576 \u6b61 \u559c \u5feb \u6a02 \uff0c \u56e0 \u70ba \u4f60 \u5011 \u5728 \u5929 \u4e0a \u7684 \u8cde \u8cdc \u662f \u5927 \u7684 \u3002 \u5728 \u4f60 \u5011 \u4ee5 \u524d \u7684 \u5148 \u77e5 \uff0c \u4eba \u4e5f \u662f \u9019 \u6a23 \u903c \u8feb \u4ed6 \u5011 \u3002"}, {"pk": 581230, "verse": 13, "text": "\u4f60 \u5011 \u662f \u4e16 \u4e0a \u7684 \u9e7d \u3002 \u9e7d \u82e5 \u5931 \u4e86 \u5473 \uff0c \u600e \u80fd \u53eb \u4ed6 \u518d \u9e79 \u5462 \uff1f \u4ee5 \u5f8c \u7121 \u7528 \uff0c \u4e0d \u904e \u4e1f \u5728 \u5916 \u9762 \uff0c \u88ab \u4eba \u8e10 \u8e0f \u4e86 \u3002"}, {"pk": 581231, "verse": 14, "text": "\u4f60 \u5011 \u662f \u4e16 \u4e0a \u7684 \u5149 \u3002 \u57ce \u9020 \u5728 \u5c71 \u4e0a \u662f \u4e0d \u80fd \u96b1 \u85cf \u7684 \u3002"}, {"pk": 581232, "verse": 15, "text": "\u4eba \u9ede \u71c8 \uff0c \u4e0d \u653e \u5728 \u6597 \u5e95 \u4e0b \uff0c \u662f \u653e \u5728 \u71c8 \u81fa \u4e0a \uff0c \u5c31 \u7167 \u4eae \u4e00 \u5bb6 \u7684 \u4eba \u3002"}, {"pk": 581233, "verse": 16, "text": "\u4f60 \u5011 \u7684 \u5149 \u4e5f \u7576 \u9019 \u6a23 \u7167 \u5728 \u4eba \u524d \uff0c \u53eb \u4ed6 \u5011 \u770b \u898b \u4f60 \u5011 \u7684 \u597d \u884c \u70ba \uff0c \u4fbf \u5c07 \u69ae \u8000 \u6b78 \u7d66 \u4f60 \u5011 \u5728 \u5929 \u4e0a \u7684 \u7236 \u3002"}, {"pk": 581234, "verse": 17, "text": "\u83ab \u60f3 \u6211 \u4f86 \u8981 \u5ee2 \u6389 \u5f8b \u6cd5 \u548c \u5148 \u77e5 \u3002 \u6211 \u4f86 \u4e0d \u662f \u8981 \u5ee2 \u6389 \uff0c \u4e43 \u662f \u8981 \u6210 \u5168 \u3002"}, {"pk": 581235, "verse": 18, "text": "\u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u5c31 \u662f \u5230 \u5929 \u5730 \u90fd \u5ee2 \u53bb \u4e86 \uff0c \u5f8b \u6cd5 \u7684 \u4e00 \u9ede \u4e00 \u756b \u4e5f \u4e0d \u80fd \u5ee2 \u53bb \uff0c \u90fd \u8981 \u6210 \u5168 \u3002"}, {"pk": 581236, "verse": 19, "text": "\u6240 \u4ee5 \uff0c \u7121 \u8ad6 \u4f55 \u4eba \u5ee2 \u6389 \u9019 \u8aa1 \u547d \u4e2d \u6700 \u5c0f \u7684 \u4e00 \u689d \uff0c \u53c8 \u6559 \u8a13 \u4eba \u9019 \u6a23 \u4f5c \uff0c \u4ed6 \u5728 \u5929 \u570b \u8981 \u7a31 \u70ba \u6700 \u5c0f \u7684 \u3002 \u4f46 \u7121 \u8ad6 \u4f55 \u4eba \u9075 \u884c \u9019 \u8aa1 \u547d \uff0c \u53c8 \u6559 \u8a13 \u4eba \u9075 \u884c \uff0c \u4ed6 \u5728 \u5929 \u570b \u8981 \u7a31 \u70ba \u5927 \u7684 \u3002"}, {"pk": 581237, "verse": 20, "text": "\u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4f60 \u5011 \u7684 \u7fa9 \u82e5 \u4e0d \u52dd \u65bc \u6587 \u58eb \u548c \u6cd5 \u5229 \u8cfd \u4eba \u7684 \u7fa9 \uff0c \u65b7 \u4e0d \u80fd \u9032 \u5929 \u570b \u3002"}, {"pk": 581238, "verse": 21, "text": "\u4f60 \u5011 \u807d \u898b \u6709 \u5429 \u5490 \u53e4 \u4eba \u7684 \u8a71 \uff0c \u8aaa \uff1a \u4e0d \u53ef \u6bba \u4eba \uff1b \u53c8 \u8aaa \uff1a \u51e1 \u6bba \u4eba \u7684 \u96e3 \u514d \u53d7 \u5be9 \u5224 \u3002"}, {"pk": 581239, "verse": 22, "text": "\u53ea \u662f \u6211 \u544a \u8a34 \u4f60 \u5011 \uff1a \u51e1 \uff08 \u6709 \u53e4 \u5377 \u5728 \u51e1 \u5b57 \u4e0b \u52a0 \uff1a \u7121 \u7de3 \u7121 \u6545 \u5730 \uff09 \u5411 \u5f1f \u5144 \u52d5 \u6012 \u7684 \uff0c \u96e3 \u514d \u53d7 \u5be9 \u65b7 \uff1b \u51e1 \u7f75 \u5f1f \u5144 \u662f \u62c9 \u52a0 \u7684 \uff0c \u96e3 \u514d \u516c \u6703 \u7684 \u5be9 \u65b7 \uff1b \u51e1 \u7f75 \u5f1f \u5144 \u662f \u9b54 \u5229 \u7684 \uff0c \u96e3 \u514d \u5730 \u7344 \u7684 \u706b \u3002"}, {"pk": 581240, "verse": 23, "text": "\u6240 \u4ee5 \uff0c \u4f60 \u5728 \u796d \u58c7 \u4e0a \u737b \u79ae \u7269 \u7684 \u6642 \u5019 \uff0c \u82e5 \u60f3 \u8d77 \u5f1f \u5144 \u5411 \u4f60 \u61f7 \u6028 \uff0c"}, {"pk": 581241, "verse": 24, "text": "\u5c31 \u628a \u79ae \u7269 \u7559 \u5728 \u58c7 \u524d \uff0c \u5148 \u53bb \u540c \u5f1f \u5144 \u548c \u597d \uff0c \u7136 \u5f8c \u4f86 \u737b \u79ae \u7269 \u3002"}, {"pk": 581242, "verse": 25, "text": "\u4f60 \u540c \u544a \u4f60 \u7684 \u5c0d \u982d \u9084 \u5728 \u8def \u4e0a \uff0c \u5c31 \u8d95 \u7dca \u8207 \u4ed6 \u548c \u606f \uff0c \u6050 \u6015 \u4ed6 \u628a \u4f60 \u9001 \u7d66 \u5be9 \u5224 \u5b98 \uff0c \u5be9 \u5224 \u5b98 \u4ea4 \u4ed8 \u8859 \u5f79 \uff0c \u4f60 \u5c31 \u4e0b \u5728 \u76e3 \u88e1 \u4e86 \u3002"}, {"pk": 581243, "verse": 26, "text": "\u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \uff0c \u82e5 \u6709 \u4e00 \u6587 \u9322 \u6c92 \u6709 \u9084 \u6e05 \uff0c \u4f60 \u65b7 \u4e0d \u80fd \u5f9e \u90a3 \u88e1 \u51fa \u4f86 \u3002"}, {"pk": 581244, "verse": 27, "text": "\u4f60 \u5011 \u807d \u898b \u6709 \u8a71 \u8aaa \uff1a \u4e0d \u53ef \u59e6 \u6deb \u3002"}, {"pk": 581245, "verse": 28, "text": "\u53ea \u662f \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u51e1 \u770b \u898b \u5a66 \u5973 \u5c31 \u52d5 \u6deb \u5ff5 \u7684 \uff0c \u9019 \u4eba \u5fc3 \u88e1 \u5df2 \u7d93 \u8207 \u4ed6 \u72af \u59e6 \u6deb \u4e86 \u3002"}, {"pk": 581246, "verse": 29, "text": "\u82e5 \u662f \u4f60 \u7684 \u53f3 \u773c \u53eb \u4f60 \u8dcc \u5012 \uff0c \u5c31 \u525c \u51fa \u4f86 \u4e1f \u6389 \uff0c \u5be7 \u53ef \u5931 \u53bb \u767e \u9ad4 \u4e2d \u7684 \u4e00 \u9ad4 \uff0c \u4e0d \u53eb \u5168 \u8eab \u4e1f \u5728 \u5730 \u7344 \u88e1 \u3002"}, {"pk": 581247, "verse": 30, "text": "\u82e5 \u662f \u53f3 \u624b \u53eb \u4f60 \u8dcc \u5012 \uff0c \u5c31 \u780d \u4e0b \u4f86 \u4e1f \u6389 \uff0c \u5be7 \u53ef \u5931 \u53bb \u767e \u9ad4 \u4e2d \u7684 \u4e00 \u9ad4 \uff0c \u4e0d \u53eb \u5168 \u8eab \u4e0b \u5165 \u5730 \u7344 \u3002"}, {"pk": 581248, "verse": 31, "text": "\u53c8 \u6709 \u8a71 \u8aaa \uff1a \u4eba \u82e5 \u4f11 \u59bb \uff0c \u5c31 \u7576 \u7d66 \u4ed6 \u4f11 \u66f8 \u3002"}, {"pk": 581249, "verse": 32, "text": "\u53ea \u662f \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u51e1 \u4f11 \u59bb \u7684 \uff0c \u82e5 \u4e0d \u662f \u70ba \u6deb \u4e82 \u7684 \u7de3 \u6545 \uff0c \u5c31 \u662f \u53eb \u4ed6 \u4f5c \u6deb \u5a66 \u4e86 \uff1b \u4eba \u82e5 \u5a36 \u9019 \u88ab \u4f11 \u7684 \u5a66 \u4eba \uff0c \u4e5f \u662f \u72af \u59e6 \u6deb \u4e86 \u3002"}, {"pk": 581250, "verse": 33, "text": "\u4f60 \u5011 \u53c8 \u807d \u898b \u6709 \u5429 \u5490 \u53e4 \u4eba \u7684 \u8a71 \uff0c \u8aaa \uff1a \u4e0d \u53ef \u80cc \u8a93 \uff0c \u6240 \u8d77 \u7684 \u8a93 \u7e3d \u8981 \u5411 \u4e3b \u8b39 \u5b88 \u3002"}, {"pk": 581251, "verse": 34, "text": "\u53ea \u662f \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u751a \u9ebc \u8a93 \u90fd \u4e0d \u53ef \u8d77 \u3002 \u4e0d \u53ef \u6307 \u8457 \u5929 \u8d77 \u8a93 \uff0c \u56e0 \u70ba \u5929 \u662f \u795e \u7684 \u5ea7 \u4f4d \uff1b"}, {"pk": 581252, "verse": 35, "text": "\u4e0d \u53ef \u6307 \u8457 \u5730 \u8d77 \u8a93 \uff0c \u56e0 \u70ba \u5730 \u662f \u4ed6 \u7684 \u8173 \u51f3 \uff1b \u4e5f \u4e0d \u53ef \u6307 \u8457 \u8036 \u8def \u6492 \u51b7 \u8d77 \u8a93 \uff0c \u56e0 \u70ba \u8036 \u8def \u6492 \u51b7 \u662f \u5927 \u541b \u7684 \u4eac \u57ce \uff1b"}, {"pk": 581253, "verse": 36, "text": "\u53c8 \u4e0d \u53ef \u6307 \u8457 \u4f60 \u7684 \u982d \u8d77 \u8a93 \uff0c \u56e0 \u70ba \u4f60 \u4e0d \u80fd \u4f7f \u4e00 \u6839 \u982d \u9aee \u8b8a \u9ed1 \u8b8a \u767d \u4e86 \u3002"}, {"pk": 581254, "verse": 37, "text": "\u4f60 \u5011 \u7684 \u8a71 \uff0c \u662f \uff0c \u5c31 \u8aaa \u662f \uff1b \u4e0d \u662f \uff0c \u5c31 \u8aaa \u4e0d \u662f \uff1b \u82e5 \u518d \u591a \u8aaa \uff0c \u5c31 \u662f \u51fa \u65bc \u90a3 \u60e1 \u8005 \uff08 \u6216 \u4f5c \uff1a \u5c31 \u662f \u5f9e \u60e1 \u88e1 \u51fa \u4f86 \u7684 \uff09 \u3002"}, {"pk": 581255, "verse": 38, "text": "\u4f60 \u5011 \u807d \u898b \u6709 \u8a71 \u8aaa \uff1a \u4ee5 \u773c \u9084 \u773c \uff0c \u4ee5 \u7259 \u9084 \u7259 \u3002"}, {"pk": 581256, "verse": 39, "text": "\u53ea \u662f \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4e0d \u8981 \u8207 \u60e1 \u4eba \u4f5c \u5c0d \u3002 \u6709 \u4eba \u6253 \u4f60 \u7684 \u53f3 \u81c9 \uff0c \u9023 \u5de6 \u81c9 \u4e5f \u8f49 \u904e \u4f86 \u7531 \u4ed6 \u6253 \uff1b"}, {"pk": 581257, "verse": 40, "text": "\u6709 \u4eba \u60f3 \u8981 \u544a \u4f60 \uff0c \u8981 \u62ff \u4f60 \u7684 \u88e1 \u8863 \uff0c \u9023 \u5916 \u8863 \u4e5f \u7531 \u4ed6 \u62ff \u53bb \uff1b"}, {"pk": 581258, "verse": 41, "text": "\u6709 \u4eba \u5f37 \u903c \u4f60 \u8d70 \u4e00 \u91cc \u8def \uff0c \u4f60 \u5c31 \u540c \u4ed6 \u8d70 \u4e8c \u91cc \uff1b"}, {"pk": 581259, "verse": 42, "text": "\u6709 \u6c42 \u4f60 \u7684 \uff0c \u5c31 \u7d66 \u4ed6 \uff1b \u6709 \u5411 \u4f60 \u501f \u8cb8 \u7684 \uff0c \u4e0d \u53ef \u63a8 \u8fad \u3002"}, {"pk": 581260, "verse": 43, "text": "\u4f60 \u5011 \u807d \u898b \u6709 \u8a71 \u8aaa \uff1a \u7576 \u611b \u4f60 \u7684 \u9130 \u820d \uff0c \u6068 \u4f60 \u7684 \u4ec7 \u6575 \u3002"}, {"pk": 581261, "verse": 44, "text": "\u53ea \u662f \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u8981 \u611b \u4f60 \u5011 \u7684 \u4ec7 \u6575 \uff0c \u70ba \u90a3 \u903c \u8feb \u4f60 \u5011 \u7684 \u79b1 \u544a \u3002"}, {"pk": 581262, "verse": 45, "text": "\u9019 \u6a23 \u5c31 \u53ef \u4ee5 \u4f5c \u4f60 \u5011 \u5929 \u7236 \u7684 \u5152 \u5b50 \uff1b \u56e0 \u70ba \u4ed6 \u53eb \u65e5 \u982d \u7167 \u597d \u4eba \uff0c \u4e5f \u7167 \u6b79 \u4eba \uff1b \u964d \u96e8 \u7d66 \u7fa9 \u4eba \uff0c \u4e5f \u7d66 \u4e0d \u7fa9 \u7684 \u4eba \u3002"}, {"pk": 581263, "verse": 46, "text": "\u4f60 \u5011 \u82e5 \u55ae \u611b \u90a3 \u611b \u4f60 \u5011 \u7684 \u4eba \uff0c \u6709 \u751a \u9ebc \u8cde \u8cdc \u5462 \uff1f \u5c31 \u662f \u7a05 \u540f \u4e0d \u4e5f \u662f \u9019 \u6a23 \u884c \u9ebc \uff1f"}, {"pk": 581264, "verse": 47, "text": "\u4f60 \u5011 \u82e5 \u55ae \u8acb \u4f60 \u5f1f \u5144 \u7684 \u5b89 \uff0c \u6bd4 \u4eba \u6709 \u751a \u9ebc \u9577 \u8655 \u5462 \uff1f \u5c31 \u662f \u5916 \u90a6 \u4eba \u4e0d \u4e5f \u662f \u9019 \u6a23 \u884c \u9ebc \uff1f"}, {"pk": 581265, "verse": 48, "text": "\u6240 \u4ee5 \uff0c \u4f60 \u5011 \u8981 \u5b8c \u5168 \uff0c \u50cf \u4f60 \u5011 \u7684 \u5929 \u7236 \u5b8c \u5168 \u4e00 \u6a23 \u3002"}]