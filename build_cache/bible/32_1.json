[{"pk": 580515, "verse": 1, "text": "\u8036 \u548c \u83ef \u7684 \u8a71 \u81e8 \u5230 \u4e9e \u7c73 \u592a \u7684 \u5152 \u5b50 \u7d04 \u62ff \uff0c \u8aaa \uff1a"}, {"pk": 580516, "verse": 2, "text": "\u4f60 \u8d77 \u4f86 \u5f80 \u5c3c \u5c3c \u5fae \u5927 \u57ce \u53bb \uff0c \u5411 \u5176 \u4e2d \u7684 \u5c45 \u6c11 \u547c \u558a \uff0c \u56e0 \u70ba \u4ed6 \u5011 \u7684 \u60e1 \u9054 \u5230 \u6211 \u9762 \u524d \u3002"}, {"pk": 580517, "verse": 3, "text": "\u7d04 \u62ff \u537b \u8d77 \u4f86 \uff0c \u9003 \u5f80 \u4ed6 \u65bd \u53bb \u8eb2 \u907f \u8036 \u548c \u83ef \uff1b \u4e0b \u5230 \u7d04 \u5e15 \uff0c \u9047 \u898b \u4e00 \u96bb \u8239 \uff0c \u8981 \u5f80 \u4ed6 \u65bd \u53bb \u3002 \u4ed6 \u5c31 \u7d66 \u4e86 \u8239 \u50f9 \uff0c \u4e0a \u4e86 \u8239 \uff0c \u8981 \u8207 \u8239 \u4e0a \u7684 \u4eba \u540c \u5f80 \u4ed6 \u65bd \u53bb \u8eb2 \u907f \u8036 \u548c \u83ef \u3002"}, {"pk": 580518, "verse": 4, "text": "\u7136 \u800c \u8036 \u548c \u83ef \u4f7f \u6d77 \u4e2d \u8d77 \u5927 \u98a8 \uff0c \u6d77 \u5c31 \u72c2 \u98a8 \u5927 \u4f5c \uff0c \u751a \u81f3 \u8239 \u5e7e \u4e4e \u7834 \u58de \u3002"}, {"pk": 580519, "verse": 5, "text": "\u6c34 \u624b \u4fbf \u61fc \u6015 \uff0c \u5404 \u4eba \u54c0 \u6c42 \u81ea \u5df1 \u7684 \u3000 \u795e \u3002 \u4ed6 \u5011 \u5c07 \u8239 \u4e0a \u7684 \u8ca8 \u7269 \u62cb \u5728 \u6d77 \u4e2d \uff0c \u70ba \u8981 \u4f7f \u8239 \u8f15 \u4e9b \u3002 \u7d04 \u62ff \u5df2 \u4e0b \u5230 \u5e95 \u8259 \uff0c \u8eba \u81e5 \u6c89 \u7761 \u3002"}, {"pk": 580520, "verse": 6, "text": "\u8239 \u4e3b \u5230 \u4ed6 \u90a3 \u88e1 \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u9019 \u6c89 \u7761 \u7684 \u4eba \u54ea \uff0c \u70ba \u4f55 \u9019 \u6a23 \u5462 \uff1f \u8d77 \u4f86 \uff0c \u6c42 \u544a \u4f60 \u7684 \u3000 \u795e \uff0c \u6216 \u8005 \u3000 \u795e \u9867 \u5ff5 \u6211 \u5011 \uff0c \u4f7f \u6211 \u5011 \u4e0d \u81f4 \u6ec5 \u4ea1 \u3002"}, {"pk": 580521, "verse": 7, "text": "\u8239 \u4e0a \u7684 \u4eba \u5f7c \u6b64 \u8aaa \uff1a \u4f86 \u5427 \uff0c \u6211 \u5011 \u63a3 \u7c64 \uff0c \u770b \u770b \u9019 \u707d \u81e8 \u5230 \u6211 \u5011 \u662f \u56e0 \u8ab0 \u7684 \u7de3 \u6545 \u3002 \u65bc \u662f \u4ed6 \u5011 \u63a3 \u7c64 \uff0c \u63a3 \u51fa \u7d04 \u62ff \u4f86 \u3002"}, {"pk": 580522, "verse": 8, "text": "\u773e \u4eba \u5c0d \u4ed6 \u8aaa \uff1a \u8acb \u4f60 \u544a \u8a34 \u6211 \u5011 \uff0c \u9019 \u707d \u81e8 \u5230 \u6211 \u5011 \u662f \u56e0 \u8ab0 \u7684 \u7de3 \u6545 \uff1f \u4f60 \u4ee5 \u4f55 \u4e8b \u70ba \u696d \uff1f \u4f60 \u5f9e \u54ea \u88e1 \u4f86 \uff1f \u4f60 \u662f \u54ea \u4e00 \u570b \uff1f \u5c6c \u54ea \u4e00 \u65cf \u7684 \u4eba \uff1f"}, {"pk": 580523, "verse": 9, "text": "\u4ed6 \u8aaa \uff1a \u6211 \u662f \u5e0c \u4f2f \u4f86 \u4eba \u3002 \u6211 \u656c \u754f \u8036 \u548c \u83ef \u2500 \u90a3 \u5275 \u9020 \u6ec4 \u6d77 \u65f1 \u5730 \u4e4b \u5929 \u4e0a \u7684 \u3000 \u795e \u3002"}, {"pk": 580524, "verse": 10, "text": "\u4ed6 \u5011 \u5c31 \u5927 \u5927 \u61fc \u6015 \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u505a \u7684 \u662f \u751a \u9ebc \u4e8b \u5462 \uff1f \u4ed6 \u5011 \u5df2 \u7d93 \u77e5 \u9053 \u4ed6 \u8eb2 \u907f \u8036 \u548c \u83ef \uff0c \u56e0 \u70ba \u4ed6 \u544a \u8a34 \u4e86 \u4ed6 \u5011 \u3002"}, {"pk": 580525, "verse": 11, "text": "\u4ed6 \u5011 \u554f \u4ed6 \u8aaa \uff1a \u6211 \u5011 \u7576 \u5411 \u4f60 \u600e \u6a23 \u884c \uff0c \u4f7f \u6d77 \u6d6a \u5e73 \u975c \u5462 \uff1f \u9019 \u8a71 \u662f \u56e0 \u6d77 \u6d6a \u8d8a \u767c \u7ffb \u9a30 \u3002"}, {"pk": 580526, "verse": 12, "text": "\u4ed6 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u5c07 \u6211 \u62ac \u8d77 \u4f86 \uff0c \u62cb \u5728 \u6d77 \u4e2d \uff0c \u6d77 \u5c31 \u5e73 \u975c \u4e86 \uff1b \u6211 \u77e5 \u9053 \u4f60 \u5011 \u906d \u9019 \u5927 \u98a8 \u662f \u56e0 \u6211 \u7684 \u7de3 \u6545 \u3002"}, {"pk": 580527, "verse": 13, "text": "\u7136 \u800c \u90a3 \u4e9b \u4eba \u7aed \u529b \u76ea \u69f3 \uff0c \u8981 \u628a \u8239 \u650f \u5cb8 \uff0c \u537b \u662f \u4e0d \u80fd \uff0c \u56e0 \u70ba \u6d77 \u6d6a \u8d8a \u767c \u5411 \u4ed6 \u5011 \u7ffb \u9a30 \u3002"}, {"pk": 580528, "verse": 14, "text": "\u4ed6 \u5011 \u4fbf \u6c42 \u544a \u8036 \u548c \u83ef \u8aaa \uff1a \u8036 \u548c \u83ef \u554a \uff0c \u6211 \u5011 \u61c7 \u6c42 \u4f60 \uff0c \u4e0d \u8981 \u56e0 \u9019 \u4eba \u7684 \u6027 \u547d \u4f7f \u6211 \u5011 \u6b7b \u4ea1 \uff0c \u4e0d \u8981 \u4f7f \u6d41 \u7121 \u8f9c \u8840 \u7684 \u7f6a \u6b78 \u8207 \u6211 \u5011 \uff1b \u56e0 \u70ba \u4f60 \u2500 \u8036 \u548c \u83ef \u662f \u96a8 \u81ea \u5df1 \u7684 \u610f \u65e8 \u884c \u4e8b \u3002"}, {"pk": 580529, "verse": 15, "text": "\u4ed6 \u5011 \u9042 \u5c07 \u7d04 \u62ff \u62ac \u8d77 \uff0c \u62cb \u5728 \u6d77 \u4e2d \uff0c \u6d77 \u7684 \u72c2 \u6d6a \u5c31 \u5e73 \u606f \u4e86 \u3002"}, {"pk": 580530, "verse": 16, "text": "\u90a3 \u4e9b \u4eba \u4fbf \u5927 \u5927 \u656c \u754f \u8036 \u548c \u83ef \uff0c \u5411 \u8036 \u548c \u83ef \u737b \u796d \uff0c \u4e26 \u4e14 \u8a31 \u9858 \u3002"}, {"pk": 580531, "verse": 17, "text": "\u8036 \u548c \u83ef \u5b89 \u6392 \u4e00 \u689d \u5927 \u9b5a \u541e \u4e86 \u7d04 \u62ff \uff0c \u4ed6 \u5728 \u9b5a \u8179 \u4e2d \u4e09 \u65e5 \u4e09 \u591c \u3002"}]