[{"pk": 582522, "verse": 1, "text": "\u8036 \u7a4c \u53c8 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u7ad9 \u5728 \u9019 \u88e1 \u7684 \uff0c \u6709 \u4eba \u5728 \u6c92 \u5617 \u6b7b \u5473 \u4ee5 \u524d \uff0c \u5fc5 \u8981 \u770b \u898b \u795e \u7684 \u570b \u5927 \u6709 \u80fd \u529b \u81e8 \u5230 \u3002"}, {"pk": 582523, "verse": 2, "text": "\u904e \u4e86 \u516d \u5929 \uff0c \u8036 \u7a4c \u5e36 \u8457 \u5f7c \u5f97 \u3001 \u96c5 \u5404 \u3001 \u7d04 \u7ff0 \u6697 \u6697 \u7684 \u4e0a \u4e86 \u9ad8 \u5c71 \uff0c \u5c31 \u5728 \u4ed6 \u5011 \u9762 \u524d \u8b8a \u4e86 \u5f62 \u50cf \uff0c"}, {"pk": 582524, "verse": 3, "text": "\u8863 \u670d \u653e \u5149 \uff0c \u6975 \u5176 \u6f54 \u767d \uff0c \u5730 \u4e0a \u6f02 \u5e03 \u7684 \uff0c \u6c92 \u6709 \u4e00 \u500b \u80fd \u6f02 \u5f97 \u90a3 \u6a23 \u767d \u3002"}, {"pk": 582525, "verse": 4, "text": "\u5ffd \u7136 \uff0c \u6709 \u4ee5 \u5229 \u4e9e \u540c \u6469 \u897f \u5411 \u4ed6 \u5011 \u986f \u73fe \uff0c \u4e26 \u4e14 \u548c \u8036 \u7a4c \u8aaa \u8a71 \u3002"}, {"pk": 582526, "verse": 5, "text": "\u5f7c \u5f97 \u5c0d \u8036 \u7a4c \u8aaa \uff1a \u62c9 \u6bd4 \uff08 \u5c31 \u662f \u592b \u5b50 \uff09 \uff0c \u6211 \u5011 \u5728 \u9019 \u88e1 \u771f \u597d \uff01 \u53ef \u4ee5 \u642d \u4e09 \u5ea7 \u68da \uff0c \u4e00 \u5ea7 \u70ba \u4f60 \uff0c \u4e00 \u5ea7 \u70ba \u6469 \u897f \uff0c \u4e00 \u5ea7 \u70ba \u4ee5 \u5229 \u4e9e \u3002"}, {"pk": 582527, "verse": 6, "text": "\u5f7c \u5f97 \u4e0d \u77e5 \u9053 \u8aaa \u751a \u9ebc \u624d \u597d \uff0c \u56e0 \u70ba \u4ed6 \u5011 \u751a \u662f \u61fc \u6015 \u3002"}, {"pk": 582528, "verse": 7, "text": "\u6709 \u4e00 \u6735 \u96f2 \u5f69 \u4f86 \u906e \u84cb \u4ed6 \u5011 \uff1b \u4e5f \u6709 \u8072 \u97f3 \u5f9e \u96f2 \u5f69 \u88e1 \u51fa \u4f86 \uff0c \u8aaa \uff1a \u9019 \u662f \u6211 \u7684 \u611b \u5b50 \uff0c \u4f60 \u5011 \u8981 \u807d \u4ed6 \u3002"}, {"pk": 582529, "verse": 8, "text": "\u9580 \u5f92 \u5ffd \u7136 \u5468 \u570d \u4e00 \u770b \uff0c \u4e0d \u518d \u898b \u4e00 \u4eba \uff0c \u53ea \u898b \u8036 \u7a4c \u540c \u4ed6 \u5011 \u5728 \u90a3 \u88e1 \u3002"}, {"pk": 582530, "verse": 9, "text": "\u4e0b \u5c71 \u7684 \u6642 \u5019 \uff0c \u8036 \u7a4c \u56d1 \u5490 \u4ed6 \u5011 \u8aaa \uff1a \u4eba \u5b50 \u9084 \u6c92 \u6709 \u5f9e \u6b7b \u88e1 \u5fa9 \u6d3b \uff0c \u4f60 \u5011 \u4e0d \u8981 \u5c07 \u6240 \u770b \u898b \u7684 \u544a \u8a34 \u4eba \u3002"}, {"pk": 582531, "verse": 10, "text": "\u9580 \u5f92 \u5c07 \u9019 \u8a71 \u5b58 \u8a18 \u5728 \u5fc3 \uff0c \u5f7c \u6b64 \u8b70 \u8ad6 \u5f9e \u6b7b \u88e1 \u5fa9 \u6d3b \u662f \u751a \u9ebc \u610f \u601d \u3002"}, {"pk": 582532, "verse": 11, "text": "\u4ed6 \u5011 \u5c31 \u554f \u8036 \u7a4c \u8aaa \uff1a \u6587 \u58eb \u70ba \u751a \u9ebc \u8aaa \u4ee5 \u5229 \u4e9e \u5fc5 \u9808 \u5148 \u4f86 \uff1f"}, {"pk": 582533, "verse": 12, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4ee5 \u5229 \u4e9e \u56fa \u7136 \u5148 \u4f86 \u5fa9 \u8208 \u842c \u4e8b \uff1b \u7d93 \u4e0a \u4e0d \u662f \u6307 \u8457 \u4eba \u5b50 \u8aaa \uff0c \u4ed6 \u8981 \u53d7 \u8a31 \u591a \u7684 \u82e6 \u88ab \u4eba \u8f15 \u6162 \u5462 \uff1f"}, {"pk": 582534, "verse": 13, "text": "\u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4ee5 \u5229 \u4e9e \u5df2 \u7d93 \u4f86 \u4e86 \uff0c \u4ed6 \u5011 \u4e5f \u4efb \u610f \u5f85 \u4ed6 \uff0c \u6b63 \u5982 \u7d93 \u4e0a \u6240 \u6307 \u8457 \u4ed6 \u7684 \u8a71 \u3002"}, {"pk": 582535, "verse": 14, "text": "\u8036 \u7a4c \u5230 \u4e86 \u9580 \u5f92 \u90a3 \u88e1 \uff0c \u770b \u898b \u6709 \u8a31 \u591a \u4eba \u570d \u8457 \u4ed6 \u5011 \uff0c \u53c8 \u6709 \u6587 \u58eb \u548c \u4ed6 \u5011 \u8faf \u8ad6 \u3002"}, {"pk": 582536, "verse": 15, "text": "\u773e \u4eba \u4e00 \u898b \u8036 \u7a4c \uff0c \u90fd \u751a \u5e0c \u5947 \uff0c \u5c31 \u8dd1 \u4e0a \u53bb \u554f \u4ed6 \u7684 \u5b89 \u3002"}, {"pk": 582537, "verse": 16, "text": "\u8036 \u7a4c \u554f \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u548c \u4ed6 \u5011 \u8faf \u8ad6 \u7684 \u662f \u751a \u9ebc \uff1f"}, {"pk": 582538, "verse": 17, "text": "\u773e \u4eba \u4e2d \u9593 \u6709 \u4e00 \u500b \u4eba \u56de \u7b54 \u8aaa \uff1a \u592b \u5b50 \uff0c \u6211 \u5e36 \u4e86 \u6211 \u7684 \u5152 \u5b50 \u5230 \u4f60 \u9019 \u88e1 \u4f86 \uff0c \u4ed6 \u88ab \u555e \u5427 \u9b3c \u9644 \u8457 \u3002"}, {"pk": 582539, "verse": 18, "text": "\u7121 \u8ad6 \u5728 \u90a3 \u88e1 \uff0c \u9b3c \u6349 \u5f04 \u4ed6 \uff0c \u628a \u4ed6 \u6454 \u5012 \uff0c \u4ed6 \u5c31 \u53e3 \u4e2d \u6d41 \u6cab \uff0c \u54ac \u7259 \u5207 \u9f52 \uff0c \u8eab \u9ad4 \u67af \u4e7e \u3002 \u6211 \u8acb \u904e \u4f60 \u7684 \u9580 \u5f92 \u628a \u9b3c \u8d95 \u51fa \u53bb \uff0c \u4ed6 \u5011 \u537b \u662f \u4e0d \u80fd \u3002"}, {"pk": 582540, "verse": 19, "text": "\u8036 \u7a4c \u8aaa \uff1a \u566f \uff01 \u4e0d \u4fe1 \u7684 \u4e16 \u4ee3 \u963f \uff0c \u6211 \u5728 \u4f60 \u5011 \u9019 \u88e1 \u8981 \u5230 \u5e7e \u6642 \u5462 \uff1f \u6211 \u5fcd \u8010 \u4f60 \u5011 \u8981 \u5230 \u5e7e \u6642 \u5462 \uff1f \u628a \u4ed6 \u5e36 \u5230 \u6211 \u9019 \u88e1 \u4f86 \u7f77 \u3002"}, {"pk": 582541, "verse": 20, "text": "\u4ed6 \u5011 \u5c31 \u5e36 \u4e86 \u4ed6 \u4f86 \u3002 \u4ed6 \u4e00 \u898b \u8036 \u7a4c \uff0c \u9b3c \u4fbf \u53eb \u4ed6 \u91cd \u91cd \u7684 \u62bd \u760b \uff0c \u5012 \u5728 \u5730 \u4e0a \uff0c \u7ffb \u4f86 \u8986 \u53bb \uff0c \u53e3 \u4e2d \u6d41 \u6cab \u3002"}, {"pk": 582542, "verse": 21, "text": "\u8036 \u7a4c \u554f \u4ed6 \u7236 \u89aa \u8aaa \uff1a \u4ed6 \u5f97 \u9019 \u75c5 \u6709 \u591a \u5c11 \u65e5 \u5b50 \u5462 \uff1f \u56de \u7b54 \u8aaa \uff1a \u5f9e \u5c0f \u7684 \u6642 \u5019 \u3002"}, {"pk": 582543, "verse": 22, "text": "\u9b3c \u5c62 \u6b21 \u628a \u4ed6 \u6254 \u5728 \u706b \u88e1 \u3001 \u6c34 \u88e1 \uff0c \u8981 \u6ec5 \u4ed6 \u3002 \u4f60 \u82e5 \u80fd \u505a \u751a \u9ebc \uff0c \u6c42 \u4f60 \u6190 \u61ab \u6211 \u5011 \uff0c \u5e6b \u52a9 \u6211 \u5011 \u3002"}, {"pk": 582544, "verse": 23, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u82e5 \u80fd \u4fe1 \uff0c \u5728 \u4fe1 \u7684 \u4eba \uff0c \u51e1 \u4e8b \u90fd \u80fd \u3002"}, {"pk": 582545, "verse": 24, "text": "\u5b69 \u5b50 \u7684 \u7236 \u89aa \u7acb \u6642 \u558a \u8457 \u8aaa \uff08 \u6709 \u53e4 \u5377 \uff1a \u7acb \u6642 \u6d41 \u6dda \u7684 \u558a \u8457 \u8aaa \uff09 \uff1a \u6211 \u4fe1 \uff01 \u4f46 \u6211 \u4fe1 \u4e0d \u8db3 \uff0c \u6c42 \u4e3b \u5e6b \u52a9 \u3002"}, {"pk": 582546, "verse": 25, "text": "\u8036 \u7a4c \u770b \u898b \u773e \u4eba \u90fd \u8dd1 \u4e0a \u4f86 \uff0c \u5c31 \u65a5 \u8cac \u90a3 \u6c61 \u9b3c \u8aaa \uff1a \u4f60 \u9019 \u807e \u555e \u7684 \u9b3c \uff0c \u6211 \u5429 \u5490 \u4f60 \u5f9e \u4ed6 \u88e1 \u982d \u51fa \u4f86 \uff0c \u518d \u4e0d \u8981 \u9032 \u53bb \uff01"}, {"pk": 582547, "verse": 26, "text": "\u90a3 \u9b3c \u558a \u53eb \uff0c \u4f7f \u5b69 \u5b50 \u5927 \u5927 \u7684 \u62bd \u4e86 \u4e00 \u9663 \u760b \uff0c \u5c31 \u51fa \u4f86 \u4e86 \u3002 \u5b69 \u5b50 \u597d \u50cf \u6b7b \u4e86 \u4e00 \u822c \u3002 \u4ee5 \u81f4 \u773e \u4eba \u591a \u534a \u8aaa \uff1a \u4ed6 \u662f \u6b7b \u4e86 \u3002"}, {"pk": 582548, "verse": 27, "text": "\u4f46 \u8036 \u7a4c \u62c9 \u8457 \u4ed6 \u7684 \u624b \uff0c \u6276 \u4ed6 \u8d77 \u4f86 \uff0c \u4ed6 \u5c31 \u7ad9 \u8d77 \u4f86 \u4e86 \u3002"}, {"pk": 582549, "verse": 28, "text": "\u8036 \u7a4c \u9032 \u4e86 \u5c4b \u5b50 \uff0c \u9580 \u5f92 \u5c31 \u6697 \u6697 \u7684 \u554f \u4ed6 \u8aaa \uff1a \u6211 \u5011 \u70ba \u751a \u9ebc \u4e0d \u80fd \u8d95 \u51fa \u4ed6 \u53bb \u5462 \uff1f"}, {"pk": 582550, "verse": 29, "text": "\u8036 \u7a4c \u8aaa \uff1a \u975e \u7528 \u79b1 \u544a \uff08 \u6709 \u53e4 \u5377 \u5728 \u6b64 \u6709 \uff1a \u7981 \u98df \u4e8c \u5b57 \uff09 \uff0c \u9019 \u4e00 \u985e \u7684 \u9b3c \u7e3d \u4e0d \u80fd \u51fa \u4f86 \uff08 \u6216 \u4f5c \uff1a \u4e0d \u80fd \u8d95 \u51fa \u4ed6 \u53bb \u4f86 \uff09 \u3002"}, {"pk": 582551, "verse": 30, "text": "\u4ed6 \u5011 \u96e2 \u958b \u90a3 \u5730 \u65b9 \uff0c \u7d93 \u904e \u52a0 \u5229 \u5229 \uff1b \u8036 \u7a4c \u4e0d \u9858 \u610f \u4eba \u77e5 \u9053 \u3002"}, {"pk": 582552, "verse": 31, "text": "\u65bc \u662f \u6559 \u8a13 \u9580 \u5f92 \uff0c \u8aaa \uff1a \u4eba \u5b50 \u5c07 \u8981 \u88ab \u4ea4 \u5728 \u4eba \u624b \u88e1 \uff0c \u4ed6 \u5011 \u8981 \u6bba \u5bb3 \u4ed6 \uff1b \u88ab \u6bba \u4ee5 \u5f8c \uff0c \u904e \u4e09 \u5929 \u4ed6 \u8981 \u5fa9 \u6d3b \u3002"}, {"pk": 582553, "verse": 32, "text": "\u9580 \u5f92 \u537b \u4e0d \u660e \u767d \u9019 \u8a71 \uff0c \u53c8 \u4e0d \u6562 \u554f \u4ed6 \u3002"}, {"pk": 582554, "verse": 33, "text": "\u4ed6 \u5011 \u4f86 \u5230 \u8fe6 \u767e \u8fb2 \uff0c \u8036 \u7a4c \u5728 \u5c4b \u88e1 \u554f \u9580 \u5f92 \u8aaa \uff1a \u4f60 \u5011 \u5728 \u8def \u4e0a \u8b70 \u8ad6 \u7684 \u662f \u751a \u9ebc \uff1f"}, {"pk": 582555, "verse": 34, "text": "\u9580 \u5f92 \u4e0d \u4f5c \u8072 \uff0c \u56e0 \u70ba \u4ed6 \u5011 \u5728 \u8def \u4e0a \u5f7c \u6b64 \u722d \u8ad6 \u8ab0 \u70ba \u5927 \u3002"}, {"pk": 582556, "verse": 35, "text": "\u8036 \u7a4c \u5750 \u4e0b \uff0c \u53eb \u5341 \u4e8c \u500b \u9580 \u5f92 \u4f86 \uff0c \u8aaa \uff1a \u82e5 \u6709 \u4eba \u9858 \u610f \u4f5c \u9996 \u5148 \u7684 \uff0c \u4ed6 \u5fc5 \u4f5c \u773e \u4eba \u672b \u5f8c \u7684 \uff0c \u4f5c \u773e \u4eba \u7684 \u7528 \u4eba \u3002"}, {"pk": 582557, "verse": 36, "text": "\u65bc \u662f \u9818 \u904e \u4e00 \u500b \u5c0f \u5b69 \u5b50 \u4f86 \uff0c \u53eb \u4ed6 \u7ad9 \u5728 \u9580 \u5f92 \u4e2d \u9593 \uff0c \u53c8 \u62b1 \u8d77 \u4ed6 \u4f86 \uff0c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a"}, {"pk": 582558, "verse": 37, "text": "\u51e1 \u70ba \u6211 \u540d \u63a5 \u5f85 \u4e00 \u500b \u50cf \u9019 \u5c0f \u5b69 \u5b50 \u7684 \uff0c \u5c31 \u662f \u63a5 \u5f85 \u6211 \uff1b \u51e1 \u63a5 \u5f85 \u6211 \u7684 \uff0c \u4e0d \u662f \u63a5 \u5f85 \u6211 \uff0c \u4e43 \u662f \u63a5 \u5f85 \u90a3 \u5dee \u6211 \u4f86 \u7684 \u3002"}, {"pk": 582559, "verse": 38, "text": "\u7d04 \u7ff0 \u5c0d \u8036 \u7a4c \u8aaa \uff1a \u592b \u5b50 \uff0c \u6211 \u5011 \u770b \u898b \u4e00 \u500b \u4eba \u5949 \u4f60 \u7684 \u540d \u8d95 \u9b3c \uff0c \u6211 \u5011 \u5c31 \u7981 \u6b62 \u4ed6 \uff0c \u56e0 \u70ba \u4ed6 \u4e0d \u8ddf \u5f9e \u6211 \u5011 \u3002"}, {"pk": 582560, "verse": 39, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4e0d \u8981 \u7981 \u6b62 \u4ed6 \uff1b \u56e0 \u70ba \u6c92 \u6709 \u4eba \u5949 \u6211 \u540d \u884c \u7570 \u80fd \uff0c \u53cd \u5012 \u8f15 \u6613 \u6bc0 \u8b17 \u6211 \u3002"}, {"pk": 582561, "verse": 40, "text": "\u4e0d \u6575 \u64cb \u6211 \u5011 \u7684 \uff0c \u5c31 \u662f \u5e6b \u52a9 \u6211 \u5011 \u7684 \u3002"}, {"pk": 582562, "verse": 41, "text": "\u51e1 \u56e0 \u4f60 \u5011 \u662f \u5c6c \u57fa \u7763 \uff0c \u7d66 \u4f60 \u5011 \u4e00 \u676f \u6c34 \u559d \u7684 \uff0c \u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4ed6 \u4e0d \u80fd \u4e0d \u5f97 \u8cde \u8cdc \u3002"}, {"pk": 582563, "verse": 42, "text": "\u51e1 \u4f7f \u9019 \u4fe1 \u6211 \u7684 \u4e00 \u500b \u5c0f \u5b50 \u8dcc \u5012 \u7684 \uff0c \u5012 \u4e0d \u5982 \u628a \u5927 \u78e8 \u77f3 \u62f4 \u5728 \u9019 \u4eba \u7684 \u9838 \u9805 \u4e0a \uff0c \u6254 \u5728 \u6d77 \u88e1 \u3002"}, {"pk": 582564, "verse": 43, "text": "\u5018 \u82e5 \u4f60 \u4e00 \u96bb \u624b \u53eb \u4f60 \u8dcc \u5012 \uff0c \u5c31 \u628a \u4ed6 \u780d \u4e0b \u4f86 \uff1b"}, {"pk": 582565, "verse": 44, "text": "\u4f60 \u7f3a \u4e86 \u80a2 \u9ad4 \u9032 \u5165 \u6c38 \u751f \uff0c \u5f37 \u5982 \u6709 \u5169 \u96bb \u624b \u843d \u5230 \u5730 \u7344 \uff0c \u5165 \u90a3 \u4e0d \u6ec5 \u7684 \u706b \u88e1 \u53bb \u3002"}, {"pk": 582566, "verse": 45, "text": "\u5018 \u82e5 \u4f60 \u4e00 \u96bb \u8173 \u53eb \u4f60 \u8dcc \u5012 \uff0c \u5c31 \u628a \u4ed6 \u780d \u4e0b \u4f86 \uff1b"}, {"pk": 582567, "verse": 46, "text": "\u4f60 \u7638 \u817f \u9032 \u5165 \u6c38 \u751f \uff0c \u5f37 \u5982 \u6709 \u5169 \u96bb \u8173 \u88ab \u4e1f \u5728 \u5730 \u7344 \u88e1 \u3002"}, {"pk": 582568, "verse": 47, "text": "\u5018 \u82e5 \u4f60 \u4e00 \u96bb \u773c \u53eb \u4f60 \u8dcc \u5012 \uff0c \u5c31 \u53bb \u6389 \u4ed6 \uff1b \u4f60 \u53ea \u6709 \u4e00 \u96bb \u773c \u9032 \u5165 \u795e \u7684 \u570b \uff0c \u5f37 \u5982 \u6709 \u5169 \u96bb \u773c \u88ab \u4e1f \u5728 \u5730 \u7344 \u88e1 \u3002"}, {"pk": 582569, "verse": 48, "text": "\u5728 \u90a3 \u88e1 \uff0c \u87f2 \u662f \u4e0d \u6b7b \u7684 \uff0c \u706b \u662f \u4e0d \u6ec5 \u7684 \u3002"}, {"pk": 582570, "verse": 49, "text": "\u56e0 \u70ba \u5fc5 \u7528 \u706b \u7576 \u9e7d \u9183 \u5404 \u4eba \u3002 \uff08 \u6709 \u53e4 \u5377 \u5728 \u6b64 \u6709 \uff1a \u51e1 \u796d \u7269 \u5fc5 \u7528 \u9e7d \u9183 \u3002 \uff09"}, {"pk": 582571, "verse": 50, "text": "\u9e7d \u672c \u662f \u597d \u7684 \uff0c \u82e5 \u5931 \u4e86 \u5473 \uff0c \u53ef \u7528 \u751a \u9ebc \u53eb \u4ed6 \u518d \u9e79 \u5462 \uff1f \u4f60 \u5011 \u88e1 \u982d \u61c9 \u7576 \u6709 \u9e7d \uff0c \u5f7c \u6b64 \u548c \u7766 \u3002"}]