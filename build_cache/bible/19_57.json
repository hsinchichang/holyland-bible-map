[{"pk": 572752, "verse": 1, "text": "\uff08 \u5927 \u885b \u9003 \u907f \u6383 \u7f85 \uff0c \u85cf \u5728 \u6d1e \u88e1 \u3002 \u90a3 \u6642 \uff0c \u4ed6 \u4f5c \u9019 \u91d1 \u8a69 \uff0c \u4ea4 \u8207 \u4f36 \u9577 \u3002 \u8abf \u7528 \u4f11 \u8981 \u6bc0 \u58de \u3002 \uff09 \u3000 \u795e \u554a \uff0c \u6c42 \u4f60 \u6190 \u61ab \u6211 \uff0c \u6190 \u61ab \u6211 \uff01 \u56e0 \u70ba \u6211 \u7684 \u5fc3 \u6295 \u9760 \u4f60 \u3002 \u6211 \u8981 \u6295 \u9760 \u5728 \u4f60 \u7fc5 \u8180 \u7684 \u852d \u4e0b \uff0c \u7b49 \u5230 \u707d \u5bb3 \u904e \u53bb \u3002"}, {"pk": 572753, "verse": 2, "text": "\u6211 \u8981 \u6c42 \u544a \u81f3 \u9ad8 \u7684 \u3000 \u795e \uff0c \u5c31 \u662f \u70ba \u6211 \u6210 \u5168 \u8af8 \u4e8b \u7684 \u3000 \u795e \u3002"}, {"pk": 572754, "verse": 3, "text": "\u90a3 \u8981 \u541e \u6211 \u7684 \u4eba \u8fb1 \u7f75 \u6211 \u7684 \u6642 \u5019 \uff0c \u3000 \u795e \u5f9e \u5929 \u4e0a \u5fc5 \u65bd \u6069 \u6551 \u6211 \uff0c \u4e5f \u5fc5 \u5411 \u6211 \u767c \u51fa \u6148 \u611b \u548c \u8aa0 \u5be6 \u3002"}, {"pk": 572755, "verse": 4, "text": "\u6211 \u7684 \u6027 \u547d \u5728 \u7345 \u5b50 \u4e2d \u9593 \uff1b \u6211 \u8eba \u81e5 \u5728 \u6027 \u5982 \u70c8 \u706b \u7684 \u4e16 \u4eba \u7576 \u4e2d \u3002 \u4ed6 \u5011 \u7684 \u7259 \u9f52 \u662f \u69cd \u3001 \u7bad \uff1b \u4ed6 \u5011 \u7684 \u820c \u982d \u662f \u5feb \u5200 \u3002"}, {"pk": 572756, "verse": 5, "text": "\u795e \u554a \uff0c \u9858 \u4f60 \u5d07 \u9ad8 \u904e \u65bc \u8af8 \u5929 \uff01 \u9858 \u4f60 \u7684 \u69ae \u8000 \u9ad8 \u904e \u5168 \u5730 \uff01"}, {"pk": 572757, "verse": 6, "text": "\u4ed6 \u5011 \u70ba \u6211 \u7684 \u8173 \u8a2d \u4e0b \u7db2 \u7f85 \uff0c \u58d3 \u5236 \u6211 \u7684 \u5fc3 \uff1b \u4ed6 \u5011 \u5728 \u6211 \u9762 \u524d \u6316 \u4e86 \u5751 \uff0c \u81ea \u5df1 \u53cd \u6389 \u5728 \u5176 \u4e2d \u3002 \uff08 \u7d30 \u62c9 \uff09"}, {"pk": 572758, "verse": 7, "text": "\u795e \u554a \uff0c \u6211 \u5fc3 \u5805 \u5b9a \uff0c \u6211 \u5fc3 \u5805 \u5b9a \uff1b \u6211 \u8981 \u5531 \u8a69 \uff0c \u6211 \u8981 \u6b4c \u980c \uff01"}, {"pk": 572759, "verse": 8, "text": "\u6211 \u7684 \u9748 \uff08 \u539f \u6587 \u662f \u69ae \u8000 \uff09 \u554a \uff0c \u4f60 \u7576 \u9192 \u8d77 \uff01 \u7434 \u745f \u554a \uff0c \u4f60 \u5011 \u7576 \u9192 \u8d77 \uff01 \u6211 \u81ea \u5df1 \u8981 \u6975 \u65e9 \u9192 \u8d77 \uff01"}, {"pk": 572760, "verse": 9, "text": "\u4e3b \u554a \uff0c \u6211 \u8981 \u5728 \u842c \u6c11 \u4e2d \u7a31 \u8b1d \u4f60 \uff0c \u5728 \u5217 \u90a6 \u4e2d \u6b4c \u980c \u4f60 \uff01"}, {"pk": 572761, "verse": 10, "text": "\u56e0 \u70ba \uff0c \u4f60 \u7684 \u6148 \u611b \u9ad8 \u53ca \u8af8 \u5929 \uff1b \u4f60 \u7684 \u8aa0 \u5be6 \u9054 \u5230 \u7a79 \u84bc \u3002"}, {"pk": 572762, "verse": 11, "text": "\u795e \u554a \uff0c \u9858 \u4f60 \u5d07 \u9ad8 \u904e \u65bc \u8af8 \u5929 \uff01 \u9858 \u4f60 \u7684 \u69ae \u8000 \u9ad8 \u904e \u5168 \u5730 \uff01"}]