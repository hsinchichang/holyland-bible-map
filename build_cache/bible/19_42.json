[{"pk": 572539, "verse": 1, "text": "\uff08 \u53ef \u62c9 \u5f8c \u88d4 \u7684 \u8a13 \u8aa8 \u8a69 \uff0c \u4ea4 \u8207 \u4f36 \u9577 \u3002 \uff09 \u795e \u554a \uff0c \u6211 \u7684 \u5fc3 \u5207 \u6155 \u4f60 \uff0c \u5982 \u9e7f \u5207 \u6155 \u6eaa \u6c34 \u3002"}, {"pk": 572540, "verse": 2, "text": "\u6211 \u7684 \u5fc3 \u6e34 \u60f3 \u3000 \u795e \uff0c \u5c31 \u662f \u6c38 \u751f \u795e \uff1b \u6211 \u5e7e \u6642 \u5f97 \u671d \u898b \u3000 \u795e \u5462 \uff1f"}, {"pk": 572541, "verse": 3, "text": "\u6211 \u665d \u591c \u4ee5 \u773c \u6dda \u7576 \u98f2 \u98df \uff1b \u4eba \u4e0d \u4f4f \u5730 \u5c0d \u6211 \u8aaa \uff1a \u4f60 \u7684 \u3000 \u795e \u5728 \u54ea \u88e1 \u5462 \uff1f"}, {"pk": 572542, "verse": 4, "text": "\u6211 \u5f9e \u524d \u8207 \u773e \u4eba \u540c \u5f80 \uff0c \u7528 \u6b61 \u547c \u7a31 \u8b9a \u7684 \u8072 \u97f3 \u9818 \u4ed6 \u5011 \u5230 \u3000 \u795e \u7684 \u6bbf \u88e1 \uff0c \u5927 \u5bb6 \u5b88 \u7bc0 \u3002 \u6211 \u8ffd \u60f3 \u9019 \u4e9b \u4e8b \uff0c \u6211 \u7684 \u5fc3 \u6975 \u5176 \u60b2 \u50b7 \u3002"}, {"pk": 572543, "verse": 5, "text": "\u6211 \u7684 \u5fc3 \u54ea \uff0c \u4f60 \u70ba \u4f55 \u6182 \u60b6 \uff1f \u70ba \u4f55 \u5728 \u6211 \u88e1 \u9762 \u7169 \u8e81 \uff1f \u61c9 \u7576 \u4ef0 \u671b \u3000 \u795e \uff0c \u56e0 \u4ed6 \u7b11 \u81c9 \u5e6b \u52a9 \u6211 \uff1b \u6211 \u9084 \u8981 \u7a31 \u8b9a \u4ed6 \u3002"}, {"pk": 572544, "verse": 6, "text": "\u6211 \u7684 \u3000 \u795e \u554a \uff0c \u6211 \u7684 \u5fc3 \u5728 \u6211 \u88e1 \u9762 \u6182 \u60b6 \uff0c \u6240 \u4ee5 \u6211 \u5f9e \u7d04 \u4f46 \u5730 \uff0c \u5f9e \u9ed1 \u9580 \u5dba \uff0c \u5f9e \u7c73 \u85a9 \u5c71 \u8a18 \u5ff5 \u4f60 \u3002"}, {"pk": 572545, "verse": 7, "text": "\u4f60 \u7684 \u7011 \u5e03 \u767c \u8072 \uff0c \u6df1 \u6df5 \u5c31 \u8207 \u6df1 \u6df5 \u97ff \u61c9 \uff1b \u4f60 \u7684 \u6ce2 \u6d6a \u6d2a \u6fe4 \u6f2b \u904e \u6211 \u8eab \u3002"}, {"pk": 572546, "verse": 8, "text": "\u767d \u665d \uff0c \u8036 \u548c \u83ef \u5fc5 \u5411 \u6211 \u65bd \u6148 \u611b \uff1b \u9ed1 \u591c \uff0c \u6211 \u8981 \u6b4c \u980c \u79b1 \u544a \u8cdc \u6211 \u751f \u547d \u7684 \u795e \u3002"}, {"pk": 572547, "verse": 9, "text": "\u6211 \u8981 \u5c0d \u795e \u2500 \u6211 \u7684 \u78d0 \u77f3 \u8aaa \uff1a \u4f60 \u70ba \u4f55 \u5fd8 \u8a18 \u6211 \u5462 \uff1f \u6211 \u70ba \u4f55 \u56e0 \u4ec7 \u6575 \u7684 \u6b3a \u58d3 \u6642 \u5e38 \u54c0 \u75db \u5462 \uff1f"}, {"pk": 572548, "verse": 10, "text": "\u6211 \u7684 \u6575 \u4eba \u8fb1 \u7f75 \u6211 \uff0c \u597d \u50cf \u6253 \u788e \u6211 \u7684 \u9aa8 \u982d \uff0c \u4e0d \u4f4f \u5730 \u5c0d \u6211 \u8aaa \uff1a \u4f60 \u7684 \u3000 \u795e \u5728 \u54ea \u88e1 \u5462 \uff1f"}, {"pk": 572549, "verse": 11, "text": "\u6211 \u7684 \u5fc3 \u54ea \uff0c \u4f60 \u70ba \u4f55 \u6182 \u60b6 \uff1f \u70ba \u4f55 \u5728 \u6211 \u88e1 \u9762 \u7169 \u8e81 \uff1f \u61c9 \u7576 \u4ef0 \u671b \u3000 \u795e \uff0c \u56e0 \u6211 \u9084 \u8981 \u7a31 \u8b9a \u4ed6 \u3002 \u4ed6 \u662f \u6211 \u81c9 \u4e0a \u7684 \u5149 \u69ae \uff08 \u539f \u6587 \u662f \u5e6b \u52a9 \uff09 \uff0c \u662f \u6211 \u7684 \u3000 \u795e \u3002"}]