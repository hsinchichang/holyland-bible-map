[{"pk": 558441, "verse": 1, "text": "\u90a3 \u5169 \u500b \u5929 \u4f7f \u665a \u4e0a \u5230 \u4e86 \u6240 \u591a \u746a \uff1b \u7f85 \u5f97 \u6b63 \u5750 \u5728 \u6240 \u591a \u746a \u57ce \u9580 \u53e3 \uff0c \u770b \u898b \u4ed6 \u5011 \uff0c \u5c31 \u8d77 \u4f86 \u8fce \u63a5 \uff0c \u81c9 \u4f0f \u65bc \u5730 \u4e0b \u62dc \uff0c"}, {"pk": 558442, "verse": 2, "text": "\u8aaa \uff1a \u6211 \u4e3b \u963f \uff0c \u8acb \u4f60 \u5011 \u5230 \u50d5 \u4eba \u5bb6 \u88e1 \u6d17 \u6d17 \u8173 \uff0c \u4f4f \u4e00 \u591c \uff0c \u6e05 \u65e9 \u8d77 \u4f86 \u518d \u8d70 \u3002 \u4ed6 \u5011 \u8aaa \uff1a \u4e0d \uff01 \u6211 \u5011 \u8981 \u5728 \u8857 \u4e0a \u904e \u591c \u3002"}, {"pk": 558443, "verse": 3, "text": "\u7f85 \u5f97 \u5207 \u5207 \u7684 \u8acb \u4ed6 \u5011 \uff0c \u4ed6 \u5011 \u9019 \u624d \u9032 \u53bb \uff0c \u5230 \u4ed6 \u5c4b \u88e1 \u3002 \u7f85 \u5f97 \u70ba \u4ed6 \u5011 \u9810 \u5099 \u7b75 \u5e2d \uff0c \u70e4 \u7121 \u9175 \u9905 \uff0c \u4ed6 \u5011 \u5c31 \u5403 \u4e86 \u3002"}, {"pk": 558444, "verse": 4, "text": "\u4ed6 \u5011 \u9084 \u6c92 \u6709 \u8eba \u4e0b \uff0c \u6240 \u591a \u746a \u57ce \u88e1 \u5404 \u8655 \u7684 \u4eba \uff0c \u9023 \u8001 \u5e36 \u5c11 \uff0c \u90fd \u4f86 \u570d \u4f4f \u90a3 \u623f \u5b50 \uff0c"}, {"pk": 558445, "verse": 5, "text": "\u547c \u53eb \u7f85 \u5f97 \u8aaa \uff1a \u4eca \u65e5 \u665a \u4e0a \u5230 \u4f60 \u9019 \u88e1 \u4f86 \u7684 \u4eba \u5728 \u90a3 \u88e1 \u5462 \uff1f \u628a \u4ed6 \u5011 \u5e36 \u51fa \u4f86 \uff0c \u4efb \u6211 \u5011 \u6240 \u70ba \u3002"}, {"pk": 558446, "verse": 6, "text": "\u7f85 \u5f97 \u51fa \u4f86 \uff0c \u628a \u9580 \u95dc \u4e0a \uff0c \u5230 \u773e \u4eba \u90a3 \u88e1 \uff0c"}, {"pk": 558447, "verse": 7, "text": "\u8aaa \uff1a \u773e \u5f1f \u5144 \uff0c \u8acb \u4f60 \u5011 \u4e0d \u8981 \u4f5c \u9019 \u60e1 \u4e8b \u3002"}, {"pk": 558448, "verse": 8, "text": "\u6211 \u6709 \u5169 \u500b \u5973 \u5152 \uff0c \u9084 \u662f \u8655 \u5973 \uff0c \u5bb9 \u6211 \u9818 \u51fa \u4f86 \uff0c \u4efb \u6191 \u4f60 \u5011 \u7684 \u5fc3 \u9858 \u800c \u884c \uff1b \u53ea \u662f \u9019 \u5169 \u500b \u4eba \u65e2 \u7136 \u5230 \u6211 \u820d \u4e0b \uff0c \u4e0d \u8981 \u5411 \u4ed6 \u5011 \u4f5c \u751a \u9ebc \u3002"}, {"pk": 558449, "verse": 9, "text": "\u773e \u4eba \u8aaa \uff1a \u9000 \u53bb \u7f77 \uff01 \u53c8 \u8aaa \uff1a \u9019 \u500b \u4eba \u4f86 \u5bc4 \u5c45 \uff0c \u9084 \u60f3 \u8981 \u4f5c \u5b98 \u54ea \uff01 \u73fe \u5728 \u6211 \u5011 \u8981 \u5bb3 \u4f60 \u6bd4 \u5bb3 \u4ed6 \u5011 \u66f4 \u751a \u3002 \u773e \u4eba \u5c31 \u5411 \u524d \u64c1 \u64e0 \u7f85 \u5f97 \uff0c \u8981 \u653b \u7834 \u623f \u9580 \u3002"}, {"pk": 558450, "verse": 10, "text": "\u53ea \u662f \u90a3 \u4e8c \u4eba \u4f38 \u51fa \u624b \u4f86 \uff0c \u5c07 \u7f85 \u5f97 \u62c9 \u9032 \u5c4b \u53bb \uff0c \u628a \u9580 \u95dc \u4e0a \uff0c"}, {"pk": 558451, "verse": 11, "text": "\u4e26 \u4e14 \u4f7f \u9580 \u5916 \u7684 \u4eba \uff0c \u7121 \u8ad6 \u8001 \u5c11 \uff0c \u773c \u90fd \u660f \u8ff7 \uff1b \u4ed6 \u5011 \u6478 \u4f86 \u6478 \u53bb \uff0c \u7e3d \u5c0b \u4e0d \u8457 \u623f \u9580 \u3002"}, {"pk": 558452, "verse": 12, "text": "\u4e8c \u4eba \u5c0d \u7f85 \u5f97 \u8aaa \uff1a \u4f60 \u9019 \u88e1 \u9084 \u6709 \u751a \u9ebc \u4eba \u9ebc \uff1f \u7121 \u8ad6 \u662f \u5973 \u5a7f \u662f \u5152 \u5973 \uff0c \u548c \u9019 \u57ce \u4e2d \u4e00 \u5207 \u5c6c \u4f60 \u7684 \u4eba \uff0c \u4f60 \u90fd \u8981 \u5c07 \u4ed6 \u5011 \u5f9e \u9019 \u5730 \u65b9 \u5e36 \u51fa \u53bb \u3002"}, {"pk": 558453, "verse": 13, "text": "\u6211 \u5011 \u8981 \u6bc0 \u6ec5 \u9019 \u5730 \u65b9 \uff1b \u56e0 \u70ba \u57ce \u5167 \u7f6a \u60e1 \u7684 \u8072 \u97f3 \u5728 \u8036 \u548c \u83ef \u9762 \u524d \u751a \u5927 \uff0c \u8036 \u548c \u83ef \u5dee \u6211 \u5011 \u4f86 \uff0c \u8981 \u6bc0 \u6ec5 \u9019 \u5730 \u65b9 \u3002"}, {"pk": 558454, "verse": 14, "text": "\u7f85 \u5f97 \u5c31 \u51fa \u53bb \uff0c \u544a \u8a34 \u5a36 \u4e86 ( \u6216 \u4f5c \u5c07 \u8981 \u5a36 ) \u4ed6 \u5973 \u5152 \u7684 \u5973 \u5a7f \u5011 \u8aaa \uff1a \u4f60 \u5011 \u8d77 \u4f86 \u96e2 \u958b \u9019 \u5730 \u65b9 \uff0c \u56e0 \u70ba \u8036 \u548c \u83ef \u8981 \u6bc0 \u6ec5 \u9019 \u57ce \u3002 \u4ed6 \u5973 \u5a7f \u5011 \u537b \u4ee5 \u70ba \u4ed6 \u8aaa \u7684 \u662f \u6232 \u8a00 \u3002"}, {"pk": 558455, "verse": 15, "text": "\u5929 \u660e \u4e86 \uff0c \u5929 \u4f7f \u50ac \u903c \u7f85 \u5f97 \u8aaa \uff1a \u8d77 \u4f86 \uff01 \u5e36 \u8457 \u4f60 \u7684 \u59bb \u5b50 \u548c \u4f60 \u5728 \u9019 \u88e1 \u7684 \u5169 \u500b \u5973 \u5152 \u51fa \u53bb \uff0c \u514d \u5f97 \u4f60 \u56e0 \u9019 \u57ce \u88e1 \u7684 \u7f6a \u60e1 \u540c \u88ab \u527f \u6ec5 \u3002"}, {"pk": 558456, "verse": 16, "text": "\u4f46 \u7f85 \u5f97 \u9072 \u5ef6 \u4e0d \u8d70 \u3002 \u4e8c \u4eba \u56e0 \u70ba \u8036 \u548c \u83ef \u6190 \u6064 \u7f85 \u5f97 \uff0c \u5c31 \u62c9 \u8457 \u4ed6 \u7684 \u624b \u548c \u4ed6 \u59bb \u5b50 \u7684 \u624b \uff0c \u4e26 \u4ed6 \u5169 \u500b \u5973 \u5152 \u7684 \u624b \uff0c \u628a \u4ed6 \u5011 \u9818 \u51fa \u4f86 \uff0c \u5b89 \u7f6e \u5728 \u57ce \u5916 \uff1b"}, {"pk": 558457, "verse": 17, "text": "\u9818 \u4ed6 \u5011 \u51fa \u4f86 \u4ee5 \u5f8c \uff0c \u5c31 \u8aaa \uff1a \u9003 \u547d \u7f77 \uff01 \u4e0d \u53ef \u56de \u982d \u770b \uff0c \u4e5f \u4e0d \u53ef \u5728 \u5e73 \u539f \u7ad9 \u4f4f \u3002 \u8981 \u5f80 \u5c71 \u4e0a \u9003 \u8dd1 \uff0c \u514d \u5f97 \u4f60 \u88ab \u527f \u6ec5 \u3002"}, {"pk": 558458, "verse": 18, "text": "\u7f85 \u5f97 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u6211 \u4e3b \u963f \uff0c \u4e0d \u8981 \u5982 \u6b64 \uff01"}, {"pk": 558459, "verse": 19, "text": "\u4f60 \u50d5 \u4eba \u5df2 \u7d93 \u5728 \u4f60 \u773c \u524d \u8499 \u6069 \uff1b \u4f60 \u53c8 \u5411 \u6211 \u986f \u51fa \u83ab \u5927 \u7684 \u6148 \u611b \uff0c \u6551 \u6211 \u7684 \u6027 \u547d \u3002 \u6211 \u4e0d \u80fd \u9003 \u5230 \u5c71 \u4e0a \u53bb \uff0c \u6050 \u6015 \u9019 \u707d \u798d \u81e8 \u5230 \u6211 \uff0c \u6211 \u4fbf \u6b7b \u4e86 \u3002"}, {"pk": 558460, "verse": 20, "text": "\u770b \u54ea \uff0c \u9019 \u5ea7 \u57ce \u53c8 \u5c0f \u53c8 \u8fd1 \uff0c \u5bb9 \u6613 \u9003 \u5230 \uff0c \u9019 \u4e0d \u662f \u4e00 \u500b \u5c0f \u7684 \u9ebc \uff1f \u6c42 \u4f60 \u5bb9 \u6211 \u9003 \u5230 \u90a3 \u88e1 \uff0c \u6211 \u7684 \u6027 \u547d \u5c31 \u5f97 \u5b58 \u6d3b \u3002"}, {"pk": 558461, "verse": 21, "text": "\u5929 \u4f7f \u5c0d \u4ed6 \u8aaa \uff1a \u9019 \u4e8b \u6211 \u4e5f \u61c9 \u5141 \u4f60 \uff1b \u6211 \u4e0d \u50be \u8986 \u4f60 \u6240 \u8aaa \u7684 \u9019 \u57ce \u3002"}, {"pk": 558462, "verse": 22, "text": "\u4f60 \u8981 \u901f \u901f \u5730 \u9003 \u5230 \u90a3 \u57ce \uff1b \u56e0 \u70ba \u4f60 \u9084 \u6c92 \u6709 \u5230 \u90a3 \u88e1 \uff0c \u6211 \u4e0d \u80fd \u4f5c \u751a \u9ebc \u3002 \u56e0 \u6b64 \u90a3 \u57ce \u540d \u53eb \u7463 \u73e5 ( \u5c31 \u662f \u5c0f \u7684 \u610f \u601d ) \u3002"}, {"pk": 558463, "verse": 23, "text": "\u7f85 \u5f97 \u5230 \u4e86 \u7463 \u73e5 \uff0c \u65e5 \u982d \u5df2 \u7d93 \u51fa \u4f86 \u4e86 \u3002"}, {"pk": 558464, "verse": 24, "text": "\u7576 \u6642 \uff0c \u8036 \u548c \u83ef \u5c07 \u786b \u78fa \u8207 \u706b \u5f9e \u5929 \u4e0a \u8036 \u548c \u83ef \u90a3 \u88e1 \u964d \u8207 \u6240 \u591a \u746a \u548c \u86fe \u6469 \u62c9 \uff0c"}, {"pk": 558465, "verse": 25, "text": "\u628a \u90a3 \u4e9b \u57ce \u548c \u5168 \u5e73 \u539f \uff0c \u4e26 \u57ce \u88e1 \u6240 \u6709 \u7684 \u5c45 \u6c11 \uff0c \u9023 \u5730 \u4e0a \u751f \u9577 \u7684 \uff0c \u90fd \u6bc0 \u6ec5 \u4e86 \u3002"}, {"pk": 558466, "verse": 26, "text": "\u7f85 \u5f97 \u7684 \u59bb \u5b50 \u5728 \u5f8c \u908a \u56de \u982d \u4e00 \u770b \uff0c \u5c31 \u8b8a \u6210 \u4e86 \u4e00 \u6839 \u9e7d \u67f1 \u3002"}, {"pk": 558467, "verse": 27, "text": "\u4e9e \u4f2f \u62c9 \u7f55 \u6e05 \u65e9 \u8d77 \u4f86 \uff0c \u5230 \u4e86 \u4ed6 \u5f9e \u524d \u7ad9 \u5728 \u8036 \u548c \u83ef \u9762 \u524d \u7684 \u5730 \u65b9 \uff0c"}, {"pk": 558468, "verse": 28, "text": "\u5411 \u6240 \u591a \u746a \u548c \u86fe \u6469 \u62c9 \u8207 \u5e73 \u539f \u7684 \u5168 \u5730 \u89c0 \u770b \uff0c \u4e0d \u6599 \uff0c \u90a3 \u5730 \u65b9 \u7159 \u6c23 \u4e0a \u9a30 \uff0c \u5982 \u540c \u71d2 \u7aaf \u4e00 \u822c \u3002"}, {"pk": 558469, "verse": 29, "text": "\u7576 \u3000 \u795e \u6bc0 \u6ec5 \u5e73 \u539f \u8af8 \u57ce \u7684 \u6642 \u5019 \uff0c \u4ed6 \u8a18 \u5ff5 \u4e9e \u4f2f \u62c9 \u7f55 \uff0c \u6b63 \u5728 \u50be \u8986 \u7f85 \u5f97 \u6240 \u4f4f \u4e4b \u57ce \u7684 \u6642 \u5019 \uff0c \u5c31 \u6253 \u767c \u7f85 \u5f97 \u5f9e \u50be \u8986 \u4e4b \u4e2d \u51fa \u4f86 \u3002"}, {"pk": 558470, "verse": 30, "text": "\u7f85 \u5f97 \u56e0 \u70ba \u6015 \u4f4f \u5728 \u7463 \u73e5 \uff0c \u5c31 \u540c \u4ed6 \u5169 \u500b \u5973 \u5152 \u5f9e \u7463 \u73e5 \u4e0a \u53bb \uff0c \u4f4f \u5728 \u5c71 \u88e1 \uff1b \u4ed6 \u548c \u5169 \u500b \u5973 \u5152 \u4f4f \u5728 \u4e00 \u500b \u6d1e \u88e1 \u3002"}, {"pk": 558471, "verse": 31, "text": "\u5927 \u5973 \u5152 \u5c0d \u5c0f \u5973 \u5152 \u8aaa \uff1a \u6211 \u5011 \u7684 \u7236 \u89aa \u8001 \u4e86 \uff0c \u5730 \u4e0a \u53c8 \u7121 \u4eba \u6309 \u8457 \u4e16 \u4e0a \u7684 \u5e38 \u898f \u9032 \u5230 \u6211 \u5011 \u9019 \u88e1 \u3002"}, {"pk": 558472, "verse": 32, "text": "\u4f86 \uff01 \u6211 \u5011 \u53ef \u4ee5 \u53eb \u7236 \u89aa \u559d \u9152 \uff0c \u8207 \u4ed6 \u540c \u5be2 \u3002 \u9019 \u6a23 \uff0c \u6211 \u5011 \u597d \u5f9e \u4ed6 \u5b58 \u7559 \u5f8c \u88d4 \u3002"}, {"pk": 558473, "verse": 33, "text": "\u65bc \u662f \uff0c \u90a3 \u591c \u4ed6 \u5011 \u53eb \u7236 \u89aa \u559d \u9152 \uff0c \u5927 \u5973 \u5152 \u5c31 \u9032 \u53bb \u548c \u4ed6 \u7236 \u89aa \u540c \u5be2 \uff1b \u4ed6 \u5e7e \u6642 \u8eba \u4e0b \uff0c \u5e7e \u6642 \u8d77 \u4f86 \uff0c \u7236 \u89aa \u90fd \u4e0d \u77e5 \u9053 \u3002"}, {"pk": 558474, "verse": 34, "text": "\u7b2c \u4e8c \u5929 \uff0c \u5927 \u5973 \u5152 \u5c0d \u5c0f \u5973 \u5152 \u8aaa \uff1a \u6211 \u6628 \u591c \u8207 \u7236 \u89aa \u540c \u5be2 \u3002 \u4eca \u591c \u6211 \u5011 \u518d \u53eb \u4ed6 \u559d \u9152 \uff0c \u4f60 \u53ef \u4ee5 \u9032 \u53bb \u8207 \u4ed6 \u540c \u5be2 \u3002 \u9019 \u6a23 \uff0c \u6211 \u5011 \u597d \u5f9e \u7236 \u89aa \u5b58 \u7559 \u5f8c \u88d4 \u3002"}, {"pk": 558475, "verse": 35, "text": "\u65bc \u662f \uff0c \u90a3 \u591c \u4ed6 \u5011 \u53c8 \u53eb \u7236 \u89aa \u559d \u9152 \uff0c \u5c0f \u5973 \u5152 \u8d77 \u4f86 \u8207 \u4ed6 \u7236 \u89aa \u540c \u5be2 \uff1b \u4ed6 \u5e7e \u6642 \u8eba \u4e0b \uff0c \u5e7e \u6642 \u8d77 \u4f86 \uff0c \u7236 \u89aa \u90fd \u4e0d \u77e5 \u9053 \u3002"}, {"pk": 558476, "verse": 36, "text": "\u9019 \u6a23 \uff0c \u7f85 \u5f97 \u7684 \u5169 \u500b \u5973 \u5152 \u90fd \u5f9e \u4ed6 \u7236 \u89aa \u61f7 \u4e86 \u5b55 \u3002"}, {"pk": 558477, "verse": 37, "text": "\u5927 \u5973 \u5152 \u751f \u4e86 \u5152 \u5b50 \uff0c \u7d66 \u4ed6 \u8d77 \u540d \u53eb \u6469 \u62bc \uff0c \u5c31 \u662f \u73fe \u4eca \u6469 \u62bc \u4eba \u7684 \u59cb \u7956 \u3002"}, {"pk": 558478, "verse": 38, "text": "\u5c0f \u5973 \u5152 \u4e5f \u751f \u4e86 \u5152 \u5b50 \uff0c \u7d66 \u4ed6 \u8d77 \u540d \u53eb \u4fbf \u4e9e \u7c73 \uff0c \u5c31 \u662f \u73fe \u4eca \u4e9e \u636b \u4eba \u7684 \u59cb \u7956 \u3002"}]