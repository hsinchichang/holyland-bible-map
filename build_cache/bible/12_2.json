[{"pk": 567535, "verse": 1, "text": "\u8036 \u548c \u83ef \u8981 \u7528 \u65cb \u98a8 \u63a5 \u4ee5 \u5229 \u4e9e \u5347 \u5929 \u7684 \u6642 \u5019 \uff0c \u4ee5 \u5229 \u4e9e \u8207 \u4ee5 \u5229 \u6c99 \u5f9e \u5409 \u7532 \u524d \u5f80 \u3002"}, {"pk": 567536, "verse": 2, "text": "\u4ee5 \u5229 \u4e9e \u5c0d \u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u8036 \u548c \u83ef \u5dee \u6211 \u5f80 \u4f2f \u7279 \u5229 \u53bb \uff0c \u4f60 \u53ef \u4ee5 \u5728 \u9019 \u88e1 \u7b49 \u5019 \u3002 \u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u6211 \u6307 \u8457 \u6c38 \u751f \u7684 \u8036 \u548c \u83ef \uff0c \u53c8 \u6562 \u5728 \u4f60 \u9762 \u524d \u8d77 \u8a93 \uff0c \u6211 \u5fc5 \u4e0d \u96e2 \u958b \u4f60 \u3002 \u65bc \u662f \u4e8c \u4eba \u4e0b \u5230 \u4f2f \u7279 \u5229 \u3002"}, {"pk": 567537, "verse": 3, "text": "\u4f4f \u4f2f \u7279 \u5229 \u7684 \u5148 \u77e5 \u9580 \u5f92 \u51fa \u4f86 \u898b \u4ee5 \u5229 \u6c99 \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u8036 \u548c \u83ef \u4eca \u65e5 \u8981 \u63a5 \u4f60 \u7684 \u5e2b \u5085 \u96e2 \u958b \u4f60 \uff0c \u4f60 \u77e5 \u9053 \u4e0d \u77e5 \u9053 \uff1f \u4ed6 \u8aaa \uff1a \u6211 \u77e5 \u9053 \uff0c \u4f60 \u5011 \u4e0d \u8981 \u4f5c \u8072 \u3002"}, {"pk": 567538, "verse": 4, "text": "\u4ee5 \u5229 \u4e9e \u5c0d \u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u8036 \u548c \u83ef \u5dee \u9063 \u6211 \u5f80 \u8036 \u5229 \u54e5 \u53bb \uff0c \u4f60 \u53ef \u4ee5 \u5728 \u9019 \u88e1 \u7b49 \u5019 \u3002 \u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u6211 \u6307 \u8457 \u6c38 \u751f \u7684 \u8036 \u548c \u83ef \uff0c \u53c8 \u6562 \u5728 \u4f60 \u9762 \u524d \u8d77 \u8a93 \uff0c \u6211 \u5fc5 \u4e0d \u96e2 \u958b \u4f60 \u3002 \u65bc \u662f \u4e8c \u4eba \u5230 \u4e86 \u8036 \u5229 \u54e5 \u3002"}, {"pk": 567539, "verse": 5, "text": "\u4f4f \u8036 \u5229 \u54e5 \u7684 \u5148 \u77e5 \u9580 \u5f92 \u5c31 \u8fd1 \u4ee5 \u5229 \u6c99 \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u8036 \u548c \u83ef \u4eca \u65e5 \u8981 \u63a5 \u4f60 \u7684 \u5e2b \u5085 \u96e2 \u958b \u4f60 \uff0c \u4f60 \u77e5 \u9053 \u4e0d \u77e5 \u9053 \uff1f \u4ed6 \u8aaa \uff1a \u6211 \u77e5 \u9053 \uff0c \u4f60 \u5011 \u4e0d \u8981 \u4f5c \u8072 \u3002"}, {"pk": 567540, "verse": 6, "text": "\u4ee5 \u5229 \u4e9e \u5c0d \u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u8036 \u548c \u83ef \u5dee \u9063 \u6211 \u5f80 \u7d04 \u4f46 \u6cb3 \u53bb \uff0c \u4f60 \u53ef \u4ee5 \u5728 \u9019 \u88e1 \u7b49 \u5019 \u3002 \u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u6211 \u6307 \u8457 \u6c38 \u751f \u7684 \u8036 \u548c \u83ef \uff0c \u53c8 \u6562 \u5728 \u4f60 \u9762 \u524d \u8d77 \u8a93 \uff0c \u6211 \u5fc5 \u4e0d \u96e2 \u958b \u4f60 \u3002 \u65bc \u662f \u4e8c \u4eba \u4e00 \u540c \u524d \u5f80 \u3002"}, {"pk": 567541, "verse": 7, "text": "\u6709 \u5148 \u77e5 \u9580 \u5f92 \u53bb \u4e86 \u4e94 \u5341 \u4eba \uff0c \u9060 \u9060 \u5730 \u7ad9 \u5728 \u4ed6 \u5011 \u5c0d \u9762 \uff1b \u4e8c \u4eba \u5728 \u7d04 \u4f46 \u6cb3 \u908a \u7ad9 \u4f4f \u3002"}, {"pk": 567542, "verse": 8, "text": "\u4ee5 \u5229 \u4e9e \u5c07 \u81ea \u5df1 \u7684 \u5916 \u8863 \u6372 \u8d77 \u4f86 \uff0c \u7528 \u4ee5 \u6253 \u6c34 \uff0c \u6c34 \u5c31 \u5de6 \u53f3 \u5206 \u958b \uff0c \u4e8c \u4eba \u8d70 \u4e7e \u5730 \u800c \u904e \u3002"}, {"pk": 567543, "verse": 9, "text": "\u904e \u53bb \u4e4b \u5f8c \uff0c \u4ee5 \u5229 \u4e9e \u5c0d \u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u6211 \u672a \u66fe \u88ab \u63a5 \u53bb \u96e2 \u958b \u4f60 \uff0c \u4f60 \u8981 \u6211 \u70ba \u4f60 \u505a \u751a \u9ebc \uff0c \u53ea \u7ba1 \u6c42 \u6211 \u3002 \u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u9858 \u611f \u52d5 \u4f60 \u7684 \u9748 \u52a0 \u500d \u5730 \u611f \u52d5 \u6211 \u3002"}, {"pk": 567544, "verse": 10, "text": "\u4ee5 \u5229 \u4e9e \u8aaa \uff1a \u4f60 \u6240 \u6c42 \u7684 \u96e3 \u5f97 \u3002 \u96d6 \u7136 \u5982 \u6b64 \uff0c \u6211 \u88ab \u63a5 \u53bb \u96e2 \u958b \u4f60 \u7684 \u6642 \u5019 \uff0c \u4f60 \u82e5 \u770b \u898b \u6211 \uff0c \u5c31 \u5fc5 \u5f97 \u8457 \uff1b \u4e0d \u7136 \uff0c \u5fc5 \u5f97 \u4e0d \u8457 \u4e86 \u3002"}, {"pk": 567545, "verse": 11, "text": "\u4ed6 \u5011 \u6b63 \u8d70 \u8457 \u8aaa \u8a71 \uff0c \u5ffd \u6709 \u706b \u8eca \u706b \u99ac \u5c07 \u4e8c \u4eba \u9694 \u958b \uff0c \u4ee5 \u5229 \u4e9e \u5c31 \u4e58 \u65cb \u98a8 \u5347 \u5929 \u53bb \u4e86 \u3002"}, {"pk": 567546, "verse": 12, "text": "\u4ee5 \u5229 \u6c99 \u770b \u898b \uff0c \u5c31 \u547c \u53eb \u8aaa \uff1a \u6211 \u7236 \u554a \uff01 \u6211 \u7236 \u554a \uff01 \u4ee5 \u8272 \u5217 \u7684 \u6230 \u8eca \u99ac \u5175 \u554a \uff01 \u4ee5 \u5f8c \u4e0d \u518d \u898b \u4ed6 \u4e86 \u3002 \u65bc \u662f \u4ee5 \u5229 \u6c99 \u628a \u81ea \u5df1 \u7684 \u8863 \u670d \u6495 \u70ba \u5169 \u7247 \u3002"}, {"pk": 567547, "verse": 13, "text": "\u4ed6 \u62fe \u8d77 \u4ee5 \u5229 \u4e9e \u8eab \u4e0a \u6389 \u4e0b \u4f86 \u7684 \u5916 \u8863 \uff0c \u56de \u53bb \u7ad9 \u5728 \u7d04 \u4f46 \u6cb3 \u908a \u3002"}, {"pk": 567548, "verse": 14, "text": "\u4ed6 \u7528 \u4ee5 \u5229 \u4e9e \u8eab \u4e0a \u6389 \u4e0b \u4f86 \u7684 \u5916 \u8863 \u6253 \u6c34 \uff0c \u8aaa \uff1a \u8036 \u548c \u83ef \u2500 \u4ee5 \u5229 \u4e9e \u7684 \u3000 \u795e \u5728 \u54ea \u88e1 \u5462 \uff1f \u6253 \u6c34 \u4e4b \u5f8c \uff0c \u6c34 \u4e5f \u5de6 \u53f3 \u5206 \u958b \uff0c \u4ee5 \u5229 \u6c99 \u5c31 \u904e \u4f86 \u4e86 \u3002"}, {"pk": 567549, "verse": 15, "text": "\u4f4f \u8036 \u5229 \u54e5 \u7684 \u5148 \u77e5 \u9580 \u5f92 \u5f9e \u5c0d \u9762 \u770b \u898b \u4ed6 \uff0c \u5c31 \u8aaa \uff1a \u611f \u52d5 \u4ee5 \u5229 \u4e9e \u7684 \u9748 \u611f \u52d5 \u4ee5 \u5229 \u6c99 \u4e86 \u3002 \u4ed6 \u5011 \u5c31 \u4f86 \u8fce \u63a5 \u4ed6 \uff0c \u5728 \u4ed6 \u9762 \u524d \u4fef \u4f0f \u65bc \u5730 \uff0c"}, {"pk": 567550, "verse": 16, "text": "\u5c0d \u4ed6 \u8aaa \uff1a \u50d5 \u4eba \u5011 \u9019 \u88e1 \u6709 \u4e94 \u5341 \u500b \u58ef \u58eb \uff0c \u6c42 \u4f60 \u5bb9 \u4ed6 \u5011 \u53bb \u5c0b \u627e \u4f60 \u5e2b \u5085 \uff0c \u6216 \u8005 \u8036 \u548c \u83ef \u7684 \u9748 \u5c07 \u4ed6 \u63d0 \u8d77 \u4f86 \uff0c \u6295 \u5728 \u67d0 \u5c71 \u67d0 \u8c37 \u3002 \u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u4f60 \u5011 \u4e0d \u5fc5 \u6253 \u767c \u4eba \u53bb \u3002"}, {"pk": 567551, "verse": 17, "text": "\u4ed6 \u5011 \u518d \u4e09 \u50ac \u4fc3 \u4ed6 \uff0c \u4ed6 \u96e3 \u4ee5 \u63a8 \u8fad \uff0c \u5c31 \u8aaa \uff1a \u4f60 \u5011 \u6253 \u767c \u4eba \u53bb \u7f77 \uff01 \u4ed6 \u5011 \u4fbf \u6253 \u767c \u4e94 \u5341 \u4eba \u53bb \uff0c \u5c0b \u627e \u4e86 \u4e09 \u5929 \uff0c \u4e5f \u6c92 \u6709 \u627e \u8457 \u3002"}, {"pk": 567552, "verse": 18, "text": "\u4ee5 \u5229 \u6c99 \u4ecd \u7136 \u5728 \u8036 \u5229 \u54e5 \u7b49 \u5019 \u4ed6 \u5011 \u56de \u5230 \u4ed6 \u90a3 \u88e1 \uff1b \u4ed6 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u6211 \u8c48 \u6c92 \u6709 \u544a \u8a34 \u4f60 \u5011 \u4e0d \u5fc5 \u53bb \u9ebc \uff1f"}, {"pk": 567553, "verse": 19, "text": "\u8036 \u5229 \u54e5 \u57ce \u7684 \u4eba \u5c0d \u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u9019 \u57ce \u7684 \u5730 \u52e2 \u7f8e \u597d \uff0c \u6211 \u4e3b \u770b \u898b \u4e86 \uff1b \u53ea \u662f \u6c34 \u60e1 \u52a3 \uff0c \u571f \u7522 \u4e0d \u719f \u800c \u843d \u3002"}, {"pk": 567554, "verse": 20, "text": "\u4ee5 \u5229 \u6c99 \u8aaa \uff1a \u4f60 \u5011 \u62ff \u4e00 \u500b \u65b0 \u74f6 \u4f86 \uff0c \u88dd \u9e7d \u7d66 \u6211 \uff1b \u4ed6 \u5011 \u5c31 \u62ff \u4f86 \u7d66 \u4ed6 \u3002"}, {"pk": 567555, "verse": 21, "text": "\u4ed6 \u51fa \u5230 \u6c34 \u6e90 \uff0c \u5c07 \u9e7d \u5012 \u5728 \u6c34 \u4e2d \uff0c \u8aaa \uff1a \u8036 \u548c \u83ef \u5982 \u6b64 \u8aaa \uff1a \u6211 \u6cbb \u597d \u4e86 \u9019 \u6c34 \uff0c \u5f9e \u6b64 \u5fc5 \u4e0d \u518d \u4f7f \u4eba \u6b7b \uff0c \u4e5f \u4e0d \u518d \u4f7f \u5730 \u571f \u4e0d \u751f \u7522 \u3002"}, {"pk": 567556, "verse": 22, "text": "\u65bc \u662f \u90a3 \u6c34 \u6cbb \u597d \u4e86 \uff0c \u76f4 \u5230 \u4eca \u65e5 \uff0c \u6b63 \u5982 \u4ee5 \u5229 \u6c99 \u6240 \u8aaa \u7684 \u3002"}, {"pk": 567557, "verse": 23, "text": "\u4ee5 \u5229 \u6c99 \u5f9e \u90a3 \u88e1 \u4e0a \u4f2f \u7279 \u5229 \u53bb \uff0c \u6b63 \u4e0a \u53bb \u7684 \u6642 \u5019 \uff0c \u6709 \u4e9b \u7ae5 \u5b50 \u5f9e \u57ce \u88e1 \u51fa \u4f86 \uff0c \u6232 \u7b11 \u4ed6 \u8aaa \uff1a \u79bf \u982d \u7684 \u4e0a \u53bb \u7f77 \uff01 \u79bf \u982d \u7684 \u4e0a \u53bb \u7f77 \uff01"}, {"pk": 567558, "verse": 24, "text": "\u4ed6 \u56de \u982d \u770b \u898b \uff0c \u5c31 \u5949 \u8036 \u548c \u83ef \u7684 \u540d \u5492 \u8a5b \u4ed6 \u5011 \u3002 \u65bc \u662f \u6709 \u5169 \u500b \u6bcd \u718a \u5f9e \u6797 \u4e2d \u51fa \u4f86 \uff0c \u6495 \u88c2 \u4ed6 \u5011 \u4e2d \u9593 \u56db \u5341 \u4e8c \u500b \u7ae5 \u5b50 \u3002"}, {"pk": 567559, "verse": 25, "text": "\u4ee5 \u5229 \u6c99 \u5f9e \u4f2f \u7279 \u5229 \u4e0a \u8fe6 \u5bc6 \u5c71 \uff0c \u53c8 \u5f9e \u8fe6 \u5bc6 \u5c71 \u56de \u5230 \u6492 \u746a \u5229 \u4e9e \u3002"}]