[{"pk": 572823, "verse": 1, "text": "\uff08 \u5927 \u885b \u5728 \u7336 \u5927 \u66e0 \u91ce \u7684 \u6642 \u5019 \uff0c \u4f5c \u4e86 \u9019 \u8a69 \u3002 \uff09 \u3000 \u795e \u554a \uff0c \u4f60 \u662f \u6211 \u7684 \u795e \uff0c \u6211 \u8981 \u5207 \u5207 \u5730 \u5c0b \u6c42 \u4f60 \uff0c \u5728 \u4e7e \u65f1 \u75b2 \u4e4f \u7121 \u6c34 \u4e4b \u5730 \uff0c \u6211 \u6e34 \u60f3 \u4f60 \uff1b \u6211 \u7684 \u5fc3 \u5207 \u6155 \u4f60 \u3002"}, {"pk": 572824, "verse": 2, "text": "\u6211 \u5728 \u8056 \u6240 \u4e2d \u66fe \u5982 \u6b64 \u77bb \u4ef0 \u4f60 \uff0c \u70ba \u8981 \u898b \u4f60 \u7684 \u80fd \u529b \u548c \u4f60 \u7684 \u69ae \u8000 \u3002"}, {"pk": 572825, "verse": 3, "text": "\u56e0 \u4f60 \u7684 \u6148 \u611b \u6bd4 \u751f \u547d \u66f4 \u597d \uff0c \u6211 \u7684 \u5634 \u5507 \u8981 \u980c \u8b9a \u4f60 \u3002"}, {"pk": 572826, "verse": 4, "text": "\u6211 \u9084 \u6d3b \u7684 \u6642 \u5019 \u8981 \u9019 \u6a23 \u7a31 \u980c \u4f60 \uff1b \u6211 \u8981 \u5949 \u4f60 \u7684 \u540d \u8209 \u624b \u3002"}, {"pk": 572827, "verse": 5, "text": "\u6211 \u5728 \u5e8a \u4e0a \u8a18 \u5ff5 \u4f60 \uff0c \u5728 \u591c \u66f4 \u7684 \u6642 \u5019 \u601d \u60f3 \u4f60 \uff1b \u6211 \u7684 \u5fc3 \u5c31 \u50cf \u98fd \u8db3 \u4e86 \u9aa8 \u9ad3 \u80a5 \u6cb9 \uff0c \u6211 \u4e5f \u8981 \u4ee5 \u6b61 \u6a02 \u7684 \u5634 \u5507 \u8b9a \u7f8e \u4f60 \u3002"}, {"pk": 572828, "verse": 6, "text": "\u5408 \u548c \u8b6f \u672c \u4f75 \u5165 \u4e0a \u4e00 \u7bc0"}, {"pk": 572829, "verse": 7, "text": "\u56e0 \u70ba \u4f60 \u66fe \u5e6b \u52a9 \u6211 \uff0c \u6211 \u5c31 \u5728 \u4f60 \u7fc5 \u8180 \u7684 \u852d \u4e0b \u6b61 \u547c \u3002"}, {"pk": 572830, "verse": 8, "text": "\u6211 \u5fc3 \u7dca \u7dca \u5730 \u8ddf \u96a8 \u4f60 \uff1b \u4f60 \u7684 \u53f3 \u624b \u6276 \u6301 \u6211 \u3002"}, {"pk": 572831, "verse": 9, "text": "\u4f46 \u90a3 \u4e9b \u5c0b \u7d22 \u8981 \u6ec5 \u6211 \u547d \u7684 \u4eba \u5fc5 \u5f80 \u5730 \u5e95 \u4e0b \u53bb \uff1b"}, {"pk": 572832, "verse": 10, "text": "\u4ed6 \u5011 \u5fc5 \u88ab \u5200 \u528d \u6240 \u6bba \uff0c \u88ab \u91ce \u72d7 \u6240 \u5403 \u3002"}, {"pk": 572833, "verse": 11, "text": "\u4f46 \u662f \u738b \u5fc5 \u56e0 \u795e \u6b61 \u559c \u3002 \u51e1 \u6307 \u8457 \u4ed6 \u767c \u8a93 \u7684 \u5fc5 \u8981 \u8a87 \u53e3 \uff0c \u56e0 \u70ba \u8aaa \u8b0a \u4e4b \u4eba \u7684 \u53e3 \u5fc5 \u88ab \u585e \u4f4f \u3002"}]