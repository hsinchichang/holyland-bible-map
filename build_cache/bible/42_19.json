[{"pk": 583715, "verse": 1, "text": "\u8036 \u7a4c \u9032 \u4e86 \u8036 \u5229 \u54e5 \uff0c \u6b63 \u7d93 \u904e \u7684 \u6642 \u5019 \uff0c"}, {"pk": 583716, "verse": 2, "text": "\u6709 \u4e00 \u500b \u4eba \u540d \u53eb \u6492 \u8a72 \uff0c \u4f5c \u7a05 \u540f \u9577 \uff0c \u662f \u500b \u8ca1 \u4e3b \u3002"}, {"pk": 583717, "verse": 3, "text": "\u4ed6 \u8981 \u770b \u770b \u8036 \u7a4c \u662f \u600e \u6a23 \u7684 \u4eba \uff1b \u53ea \u56e0 \u4eba \u591a \uff0c \u4ed6 \u7684 \u8eab \u91cf \u53c8 \u77ee \uff0c \u6240 \u4ee5 \u4e0d \u5f97 \u770b \u898b \uff0c"}, {"pk": 583718, "verse": 4, "text": "\u5c31 \u8dd1 \u5230 \u524d \u982d \uff0c \u722c \u4e0a \u6851 \u6a39 \uff0c \u8981 \u770b \u8036 \u7a4c \uff0c \u56e0 \u70ba \u8036 \u7a4c \u5fc5 \u5f9e \u90a3 \u88e1 \u7d93 \u904e \u3002"}, {"pk": 583719, "verse": 5, "text": "\u8036 \u7a4c \u5230 \u4e86 \u90a3 \u88e1 \uff0c \u62ac \u982d \u4e00 \u770b \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u6492 \u8a72 \uff0c \u5feb \u4e0b \u4f86 \uff01 \u4eca \u5929 \u6211 \u5fc5 \u4f4f \u5728 \u4f60 \u5bb6 \u88e1 \u3002"}, {"pk": 583720, "verse": 6, "text": "\u4ed6 \u5c31 \u6025 \u5fd9 \u4e0b \u4f86 \uff0c \u6b61 \u6b61 \u559c \u559c \u7684 \u63a5 \u5f85 \u8036 \u7a4c \u3002"}, {"pk": 583721, "verse": 7, "text": "\u773e \u4eba \u770b \u898b \uff0c \u90fd \u79c1 \u4e0b \u8b70 \u8ad6 \u8aaa \uff1a \u4ed6 \u7adf \u5230 \u7f6a \u4eba \u5bb6 \u88e1 \u53bb \u4f4f \u5bbf \u3002"}, {"pk": 583722, "verse": 8, "text": "\u6492 \u8a72 \u7ad9 \u8457 \u5c0d \u4e3b \u8aaa \uff1a \u4e3b \u963f \uff0c \u6211 \u628a \u6240 \u6709 \u7684 \u4e00 \u534a \u7d66 \u7aae \u4eba \uff1b \u6211 \u82e5 \u8a1b \u8a50 \u4e86 \u8ab0 \uff0c \u5c31 \u9084 \u4ed6 \u56db \u500d \u3002"}, {"pk": 583723, "verse": 9, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4eca \u5929 \u6551 \u6069 \u5230 \u4e86 \u9019 \u5bb6 \uff0c \u56e0 \u70ba \u4ed6 \u4e5f \u662f \u4e9e \u4f2f \u62c9 \u7f55 \u7684 \u5b50 \u5b6b \u3002"}, {"pk": 583724, "verse": 10, "text": "\u4eba \u5b50 \u4f86 \uff0c \u70ba \u8981 \u5c0b \u627e \uff0c \u62ef \u6551 \u5931 \u55aa \u7684 \u4eba \u3002"}, {"pk": 583725, "verse": 11, "text": "\u773e \u4eba \u6b63 \u5728 \u807d \u898b \u9019 \u4e9b \u8a71 \u7684 \u6642 \u5019 \uff0c \u8036 \u7a4c \u56e0 \u70ba \u5c07 \u8fd1 \u8036 \u8def \u6492 \u51b7 \uff0c \u53c8 \u56e0 \u4ed6 \u5011 \u4ee5 \u70ba \u795e \u7684 \u570b \u5feb \u8981 \u986f \u51fa \u4f86 \uff0c \u5c31 \u53e6 \u8a2d \u4e00 \u500b \u6bd4 \u55bb \uff0c \u8aaa \uff1a"}, {"pk": 583726, "verse": 12, "text": "\u6709 \u4e00 \u500b \u8cb4 \u5191 \u5f80 \u9060 \u65b9 \u53bb \uff0c \u8981 \u5f97 \u570b \u56de \u4f86 \uff0c"}, {"pk": 583727, "verse": 13, "text": "\u4fbf \u53eb \u4e86 \u4ed6 \u7684 \u5341 \u500b \u50d5 \u4eba \u4f86 \uff0c \u4ea4 \u7d66 \u4ed6 \u5011 \u5341 \u9320 \uff08 \u9320 \uff1a \u539f \u6587 \u4f5c \u5f4c \u62ff \u7d04 \u9280 \u5341 \u5169 \uff09 \u9280 \u5b50 \uff0c \u8aaa \uff1a \u4f60 \u5011 \u53bb \u4f5c \u751f \u610f \uff0c \u76f4 \u7b49 \u6211 \u56de \u4f86 \u3002"}, {"pk": 583728, "verse": 14, "text": "\u4ed6 \u672c \u570b \u7684 \u4eba \u537b \u6068 \u4ed6 \uff0c \u6253 \u767c \u4f7f \u8005 \u96a8 \u5f8c \u53bb \uff0c \u8aaa \uff1a \u6211 \u5011 \u4e0d \u9858 \u610f \u9019 \u500b \u4eba \u4f5c \u6211 \u5011 \u7684 \u738b \u3002"}, {"pk": 583729, "verse": 15, "text": "\u4ed6 \u65e2 \u5f97 \u570b \u56de \u4f86 \uff0c \u5c31 \u5429 \u5490 \u53eb \u90a3 \u9818 \u9280 \u5b50 \u7684 \u50d5 \u4eba \u4f86 \uff0c \u8981 \u77e5 \u9053 \u4ed6 \u5011 \u505a \u751f \u610f \u8cfa \u4e86 \u591a \u5c11 \u3002"}, {"pk": 583730, "verse": 16, "text": "\u982d \u4e00 \u500b \u4e0a \u4f86 \uff0c \u8aaa \uff1a \u4e3b \u963f \uff0c \u4f60 \u7684 \u4e00 \u9320 \u9280 \u5b50 \u5df2 \u7d93 \u8cfa \u4e86 \u5341 \u9320 \u3002"}, {"pk": 583731, "verse": 17, "text": "\u4e3b \u4eba \u8aaa \uff1a \u597d \uff01 \u826f \u5584 \u7684 \u50d5 \u4eba \uff0c \u4f60 \u65e2 \u5728 \u6700 \u5c0f \u7684 \u4e8b \u4e0a \u6709 \u5fe0 \u5fc3 \uff0c \u53ef \u4ee5 \u6709 \u6b0a \u67c4 \u7ba1 \u5341 \u5ea7 \u57ce \u3002"}, {"pk": 583732, "verse": 18, "text": "\u7b2c \u4e8c \u500b \u4f86 \uff0c \u8aaa \uff1a \u4e3b \u963f \uff01 \u4f60 \u7684 \u4e00 \u9320 \u9280 \u5b50 \uff0c \u5df2 \u7d93 \u8cfa \u4e86 \u4e94 \u9320 \u3002"}, {"pk": 583733, "verse": 19, "text": "\u4e3b \u4eba \u8aaa \uff1a \u4f60 \u4e5f \u53ef \u4ee5 \u7ba1 \u4e94 \u5ea7 \u57ce \u3002"}, {"pk": 583734, "verse": 20, "text": "\u53c8 \u6709 \u4e00 \u500b \u4f86 \u8aaa \uff1a \u4e3b \u963f \uff0c \u770b \u54ea \uff0c \u4f60 \u7684 \u4e00 \u9320 \u9280 \u5b50 \u5728 \u9019 \u88e1 \uff0c \u6211 \u628a \u4ed6 \u5305 \u5728 \u624b \u5dfe \u88e1 \u5b58 \u8457 \u3002"}, {"pk": 583735, "verse": 21, "text": "\u6211 \u539f \u662f \u6015 \u4f60 \uff0c \u56e0 \u70ba \u4f60 \u662f \u56b4 \u53b2 \u7684 \u4eba \uff1b \u6c92 \u6709 \u653e \u4e0b \u7684 \uff0c \u9084 \u8981 \u53bb \u62ff \uff1b \u6c92 \u6709 \u7a2e \u4e0b \u7684 \uff0c \u9084 \u8981 \u53bb \u6536 \u3002"}, {"pk": 583736, "verse": 22, "text": "\u4e3b \u4eba \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u9019 \u60e1 \u50d5 \uff0c \u6211 \u8981 \u6191 \u4f60 \u7684 \u53e3 \u5b9a \u4f60 \u7684 \u7f6a \u3002 \u4f60 \u65e2 \u77e5 \u9053 \u6211 \u662f \u56b4 \u53b2 \u7684 \u4eba \uff0c \u6c92 \u6709 \u653e \u4e0b \u7684 \uff0c \u9084 \u8981 \u53bb \u62ff \uff0c \u6c92 \u6709 \u7a2e \u4e0b \u7684 \uff0c \u9084 \u8981 \u53bb \u6536 \uff0c"}, {"pk": 583737, "verse": 23, "text": "\u70ba \u751a \u9ebc \u4e0d \u628a \u6211 \u7684 \u9280 \u5b50 \u4ea4 \u7d66 \u9280 \u884c \uff0c \u7b49 \u6211 \u4f86 \u7684 \u6642 \u5019 \uff0c \u9023 \u672c \u5e36 \u5229 \u90fd \u53ef \u4ee5 \u8981 \u56de \u4f86 \u5462 \uff1f"}, {"pk": 583738, "verse": 24, "text": "\u5c31 \u5c0d \u65c1 \u908a \u7ad9 \u8457 \u7684 \u4eba \u8aaa \uff1a \u596a \u904e \u4ed6 \u9019 \u4e00 \u9320 \u4f86 \uff0c \u7d66 \u90a3 \u6709 \u5341 \u9320 \u7684 \u3002"}, {"pk": 583739, "verse": 25, "text": "\u4ed6 \u5011 \u8aaa \uff1a \u4e3b \u963f \uff0c \u4ed6 \u5df2 \u7d93 \u6709 \u5341 \u9320 \u4e86 \u3002"}, {"pk": 583740, "verse": 26, "text": "\u4e3b \u4eba \u8aaa \uff1a \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u51e1 \u6709 \u7684 \uff0c \u9084 \u8981 \u52a0 \u7d66 \u4ed6 \uff1b \u6c92 \u6709 \u7684 \uff0c \u9023 \u4ed6 \u6240 \u6709 \u7684 \u4e5f \u8981 \u596a \u904e \u4f86 \u3002"}, {"pk": 583741, "verse": 27, "text": "\u81f3 \u65bc \u6211 \u90a3 \u4e9b \u4ec7 \u6575 \uff0c \u4e0d \u8981 \u6211 \u4f5c \u4ed6 \u5011 \u738b \u7684 \uff0c \u628a \u4ed6 \u5011 \u62c9 \u4f86 \uff0c \u5728 \u6211 \u9762 \u524d \u6bba \u4e86 \u7f77 \uff01"}, {"pk": 583742, "verse": 28, "text": "\u8036 \u7a4c \u8aaa \u5b8c \u4e86 \u9019 \u8a71 \uff0c \u5c31 \u5728 \u524d \u9762 \u8d70 \uff0c \u4e0a \u8036 \u8def \u6492 \u51b7 \u53bb \u3002"}, {"pk": 583743, "verse": 29, "text": "\u5c07 \u8fd1 \u4f2f \u6cd5 \u5176 \u548c \u4f2f \u5927 \u5c3c \uff0c \u5728 \u4e00 \u5ea7 \u5c71 \u540d \u53eb \u6a44 \u6b16 \u5c71 \u90a3 \u88e1 \uff0c \u5c31 \u6253 \u767c \u5169 \u500b \u9580 \u5f92 \uff0c \u8aaa \uff1a"}, {"pk": 583744, "verse": 30, "text": "\u4f60 \u5011 \u5f80 \u5c0d \u9762 \u6751 \u5b50 \u88e1 \u53bb \uff0c \u9032 \u53bb \u7684 \u6642 \u5019 \uff0c \u5fc5 \u770b \u898b \u4e00 \u5339 \u9a62 \u99d2 \u62f4 \u5728 \u90a3 \u88e1 \uff0c \u662f \u5f9e \u4f86 \u6c92 \u6709 \u4eba \u9a0e \u904e \u7684 \uff0c \u53ef \u4ee5 \u89e3 \u958b \u727d \u4f86 \u3002"}, {"pk": 583745, "verse": 31, "text": "\u82e5 \u6709 \u4eba \u554f \u70ba \u751a \u9ebc \u89e3 \u4ed6 \uff0c \u4f60 \u5011 \u5c31 \u8aaa \uff1a \u4e3b \u8981 \u7528 \u4ed6 \u3002"}, {"pk": 583746, "verse": 32, "text": "\u6253 \u767c \u7684 \u4eba \u53bb \u4e86 \uff0c \u6240 \u9047 \u898b \u7684 \u6b63 \u5982 \u8036 \u7a4c \u6240 \u8aaa \u7684 \u3002"}, {"pk": 583747, "verse": 33, "text": "\u4ed6 \u5011 \u89e3 \u9a62 \u99d2 \u7684 \u6642 \u5019 \uff0c \u4e3b \u4eba \u554f \u4ed6 \u5011 \u8aaa \uff1a \u89e3 \u9a62 \u99d2 \u505a \u751a \u9ebc \uff1f"}, {"pk": 583748, "verse": 34, "text": "\u4ed6 \u5011 \u8aaa \uff1a \u4e3b \u8981 \u7528 \u4ed6 \u3002"}, {"pk": 583749, "verse": 35, "text": "\u4ed6 \u5011 \u727d \u5230 \u8036 \u7a4c \u90a3 \u88e1 \uff0c \u628a \u81ea \u5df1 \u7684 \u8863 \u670d \u642d \u5728 \u4e0a \u9762 \uff0c \u6276 \u8457 \u8036 \u7a4c \u9a0e \u4e0a \u3002"}, {"pk": 583750, "verse": 36, "text": "\u8d70 \u7684 \u6642 \u5019 \uff0c \u773e \u4eba \u628a \u8863 \u670d \u92ea \u5728 \u8def \u4e0a \u3002"}, {"pk": 583751, "verse": 37, "text": "\u5c07 \u8fd1 \u8036 \u8def \u6492 \u51b7 \uff0c \u6b63 \u4e0b \u6a44 \u6b16 \u5c71 \u7684 \u6642 \u5019 \uff0c \u773e \u9580 \u5f92 \u56e0 \u6240 \u898b \u904e \u7684 \u4e00 \u5207 \u7570 \u80fd \uff0c \u90fd \u6b61 \u6a02 \u8d77 \u4f86 \uff0c \u5927 \u8072 \u8b9a \u7f8e \u795e \uff0c"}, {"pk": 583752, "verse": 38, "text": "\u8aaa \uff1a \u5949 \u4e3b \u540d \u4f86 \u7684 \u738b \u662f \u61c9 \u7576 \u7a31 \u980c \u7684 \uff01 \u5728 \u5929 \u4e0a \u6709 \u548c \u5e73 \uff1b \u5728 \u81f3 \u9ad8 \u4e4b \u8655 \u6709 \u69ae \u5149 \u3002"}, {"pk": 583753, "verse": 39, "text": "\u773e \u4eba \u4e2d \u6709 \u5e7e \u500b \u6cd5 \u5229 \u8cfd \u4eba \u5c0d \u8036 \u7a4c \u8aaa \uff1a \u592b \u5b50 \uff0c \u8cac \u5099 \u4f60 \u7684 \u9580 \u5f92 \u7f77 \uff01"}, {"pk": 583754, "verse": 40, "text": "\u8036 \u7a4c \u8aaa \uff1a \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u82e5 \u662f \u4ed6 \u5011 \u9589 \u53e3 \u4e0d \u8aaa \uff0c \u9019 \u4e9b \u77f3 \u982d \u5fc5 \u8981 \u547c \u53eb \u8d77 \u4f86 \u3002"}, {"pk": 583755, "verse": 41, "text": "\u8036 \u7a4c \u5feb \u5230 \u8036 \u8def \u6492 \u51b7 \uff0c \u770b \u898b \u57ce \uff0c \u5c31 \u70ba \u4ed6 \u54c0 \u54ed \uff0c"}, {"pk": 583756, "verse": 42, "text": "\u8aaa \uff1a \u5df4 \u4e0d \u5f97 \u4f60 \u5728 \u9019 \u65e5 \u5b50 \u77e5 \u9053 \u95dc \u4fc2 \u4f60 \u5e73 \u5b89 \u7684 \u4e8b \uff1b \u7121 \u5948 \u9019 \u4e8b \u73fe \u5728 \u662f \u96b1 \u85cf \u7684 \uff0c \u53eb \u4f60 \u7684 \u773c \u770b \u4e0d \u51fa \u4f86 \u3002"}, {"pk": 583757, "verse": 43, "text": "\u56e0 \u70ba \u65e5 \u5b50 \u5c07 \u5230 \uff0c \u4f60 \u7684 \u4ec7 \u6575 \u5fc5 \u7bc9 \u8d77 \u571f \u58d8 \uff0c \u5468 \u570d \u74b0 \u7e5e \u4f60 \uff0c \u56db \u9762 \u56f0 \u4f4f \u4f60 \uff0c"}, {"pk": 583758, "verse": 44, "text": "\u4e26 \u8981 \u6383 \u6ec5 \u4f60 \u548c \u4f60 \u88e1 \u982d \u7684 \u5152 \u5973 \uff0c \u9023 \u4e00 \u584a \u77f3 \u982d \u4e5f \u4e0d \u7559 \u5728 \u77f3 \u982d \u4e0a \uff0c \u56e0 \u4f60 \u4e0d \u77e5 \u9053 \u7737 \u9867 \u4f60 \u7684 \u6642 \u5019 \u3002"}, {"pk": 583759, "verse": 45, "text": "\u8036 \u7a4c \u9032 \u4e86 \u6bbf \uff0c \u8d95 \u51fa \u88e1 \u982d \u505a \u8cb7 \u8ce3 \u7684 \u4eba \uff0c"}, {"pk": 583760, "verse": 46, "text": "\u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u7d93 \u4e0a \u8aaa \uff1a \u6211 \u7684 \u6bbf \u5fc5 \u4f5c \u79b1 \u544a \u7684 \u6bbf \uff0c \u4f60 \u5011 \u5012 \u4f7f \u4ed6 \u6210 \u70ba \u8cca \u7aa9 \u4e86 \u3002"}, {"pk": 583761, "verse": 47, "text": "\u8036 \u7a4c \u5929 \u5929 \u5728 \u6bbf \u88e1 \u6559 \u8a13 \u4eba \u3002 \u796d \u53f8 \u9577 \u548c \u6587 \u58eb \u8207 \u767e \u59d3 \u7684 \u5c0a \u9577 \u90fd \u60f3 \u8981 \u6bba \u4ed6 \uff0c"}, {"pk": 583762, "verse": 48, "text": "\u4f46 \u5c0b \u4e0d \u51fa \u6cd5 \u5b50 \u4f86 \uff0c \u56e0 \u70ba \u767e \u59d3 \u90fd \u5074 \u8033 \u807d \u4ed6 \u3002"}]