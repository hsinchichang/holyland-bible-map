[{"pk": 568082, "verse": 1, "text": "\u90a3 \u6642 \uff0c \u5e0c \u897f \u5bb6 \u75c5 \u5f97 \u8981 \u6b7b \u3002 \u4e9e \u6469 \u65af \u7684 \u5152 \u5b50 \u5148 \u77e5 \u4ee5 \u8cfd \u4e9e \u53bb \u898b \u4ed6 \uff0c \u5c0d \u4ed6 \u8aaa \uff1a \u8036 \u548c \u83ef \u5982 \u6b64 \u8aaa \uff1a \u4f60 \u7576 \u7559 \u907a \u547d \u8207 \u4f60 \u7684 \u5bb6 \uff0c \u56e0 \u70ba \u4f60 \u5fc5 \u6b7b \uff0c \u4e0d \u80fd \u6d3b \u4e86 \u3002"}, {"pk": 568083, "verse": 2, "text": "\u5e0c \u897f \u5bb6 \u5c31 \u8f49 \u81c9 \u671d \u7246 \uff0c \u79b1 \u544a \u8036 \u548c \u83ef \u8aaa \uff1a"}, {"pk": 568084, "verse": 3, "text": "\u8036 \u548c \u83ef \u554a \uff0c \u6c42 \u4f60 \u8a18 \u5ff5 \u6211 \u5728 \u4f60 \u9762 \u524d \u600e \u6a23 \u5b58 \u5b8c \u5168 \u7684 \u5fc3 \uff0c \u6309 \u8aa0 \u5be6 \u884c \u4e8b \uff0c \u53c8 \u505a \u4f60 \u773c \u4e2d \u6240 \u770b \u70ba \u5584 \u7684 \u3002 \u5e0c \u897f \u5bb6 \u5c31 \u75db \u54ed \u4e86 \u3002"}, {"pk": 568085, "verse": 4, "text": "\u4ee5 \u8cfd \u4e9e \u51fa \u4f86 \uff0c \u9084 \u6c92 \u6709 \u5230 \u4e2d \u9662 ( \u9662 \u6216 \u4f5c \u57ce ) \uff0c \u8036 \u548c \u83ef \u7684 \u8a71 \u5c31 \u81e8 \u5230 \u4ed6 \uff0c \u8aaa \uff1a"}, {"pk": 568086, "verse": 5, "text": "\u4f60 \u56de \u53bb \u544a \u8a34 \u6211 \u6c11 \u7684 \u541b \u5e0c \u897f \u5bb6 \u8aaa \uff1a \u8036 \u548c \u83ef \u2500 \u4f60 \u7956 \u5927 \u885b \u7684 \u3000 \u795e \u5982 \u6b64 \u8aaa \uff1a \u6211 \u807d \u898b \u4e86 \u4f60 \u7684 \u79b1 \u544a \uff0c \u770b \u898b \u4e86 \u4f60 \u7684 \u773c \u6dda \uff0c \u6211 \u5fc5 \u91ab \u6cbb \u4f60 \uff1b \u5230 \u7b2c \u4e09 \u65e5 \uff0c \u4f60 \u5fc5 \u4e0a \u5230 \u8036 \u548c \u83ef \u7684 \u6bbf \u3002"}, {"pk": 568087, "verse": 6, "text": "\u6211 \u5fc5 \u52a0 \u589e \u4f60 \u5341 \u4e94 \u5e74 \u7684 \u58fd \u6578 \uff0c \u4e26 \u4e14 \u6211 \u8981 \u6551 \u4f60 \u548c \u9019 \u57ce \u812b \u96e2 \u4e9e \u8ff0 \u738b \u7684 \u624b \u3002 \u6211 \u70ba \u81ea \u5df1 \u548c \u6211 \u50d5 \u4eba \u5927 \u885b \u7684 \u7de3 \u6545 \uff0c \u5fc5 \u4fdd \u8b77 \u9019 \u57ce \u3002"}, {"pk": 568088, "verse": 7, "text": "\u4ee5 \u8cfd \u4e9e \u8aaa \uff1a \u7576 \u53d6 \u4e00 \u584a \u7121 \u82b1 \u679c \u9905 \u4f86 \u3002 \u4eba \u5c31 \u53d6 \u4e86 \u4f86 \uff0c \u8cbc \u5728 \u7621 \u4e0a \uff0c \u738b \u4fbf \u75ca \u6108 \u4e86 \u3002"}, {"pk": 568089, "verse": 8, "text": "\u5e0c \u897f \u5bb6 \u554f \u4ee5 \u8cfd \u4e9e \u8aaa \uff1a \u8036 \u548c \u83ef \u5fc5 \u91ab \u6cbb \u6211 \uff0c \u5230 \u7b2c \u4e09 \u65e5 \uff0c \u6211 \u80fd \u4e0a \u8036 \u548c \u83ef \u7684 \u6bbf \uff0c \u6709 \u751a \u9ebc \u5146 \u982d \u5462 \uff1f"}, {"pk": 568090, "verse": 9, "text": "\u4ee5 \u8cfd \u4e9e \u8aaa \uff1a \u8036 \u548c \u83ef \u5fc5 \u6210 \u5c31 \u4ed6 \u6240 \u8aaa \u7684 \u3002 \u9019 \u662f \u4ed6 \u7d66 \u4f60 \u7684 \u5146 \u982d \uff1a \u4f60 \u8981 \u65e5 \u5f71 \u5411 \u524d \u9032 \u5341 \u5ea6 \u5462 \uff1f \u662f \u8981 \u5f80 \u5f8c \u9000 \u5341 \u5ea6 \u5462 \uff1f"}, {"pk": 568091, "verse": 10, "text": "\u5e0c \u897f \u5bb6 \u56de \u7b54 \u8aaa \uff1a \u65e5 \u5f71 \u5411 \u524d \u9032 \u5341 \u5ea6 \u5bb9 \u6613 \uff0c \u6211 \u8981 \u65e5 \u5f71 \u5f80 \u5f8c \u9000 \u5341 \u5ea6 \u3002"}, {"pk": 568092, "verse": 11, "text": "\u5148 \u77e5 \u4ee5 \u8cfd \u4e9e \u6c42 \u544a \u8036 \u548c \u83ef \uff0c \u8036 \u548c \u5c31 \u4f7f \u4e9e \u54c8 \u65af \u7684 \u65e5 \u6677 \u5411 \u524d \u9032 \u7684 \u65e5 \u5f71 \uff0c \u5f80 \u5f8c \u9000 \u4e86 \u5341 \u5ea6 \u3002"}, {"pk": 568093, "verse": 12, "text": "\u90a3 \u6642 \uff0c \u5df4 \u6bd4 \u502b \u738b \u5df4 \u62c9 \u4f46 \u7684 \u5152 \u5b50 \u6bd4 \u7f85 \u9054 \u2022 \u5df4 \u62c9 \u4f46 \u807d \u898b \u5e0c \u897f \u5bb6 \u75c5 \u800c \u75ca \u6108 \uff0c \u5c31 \u9001 \u66f8 \u4fe1 \u548c \u79ae \u7269 \u7d66 \u4ed6 \u3002"}, {"pk": 568094, "verse": 13, "text": "\u5e0c \u897f \u5bb6 \u807d \u5f9e \u4f7f \u8005 \u7684 \u8a71 \uff0c \u5c31 \u628a \u4ed6 \u5bf6 \u5eab \u7684 \u91d1 \u5b50 \u3001 \u9280 \u5b50 \u3001 \u9999 \u6599 \u3001 \u8cb4 \u91cd \u7684 \u818f \u6cb9 \uff0c \u548c \u4ed6 \u6b66 \u5eab \u7684 \u4e00 \u5207 \u8ecd \u5668 \uff0c \u4e26 \u4ed6 \u6240 \u6709 \u7684 \u8ca1 \u5bf6 \uff0c \u90fd \u7d66 \u4ed6 \u5011 \u770b \u3002 \u4ed6 \u5bb6 \u4e2d \u548c \u4ed6 \u5168 \u570b \u4e4b \u5167 \uff0c \u5e0c \u897f \u5bb6 \u6c92 \u6709 \u4e00 \u6a23 \u4e0d \u7d66 \u4ed6 \u5011 \u770b \u7684 \u3002"}, {"pk": 568095, "verse": 14, "text": "\u65bc \u662f \u5148 \u77e5 \u4ee5 \u8cfd \u4e9e \u4f86 \u898b \u5e0c \u897f \u5bb6 \u738b \uff0c \u554f \u4ed6 \u8aaa \uff1a \u9019 \u4e9b \u4eba \u8aaa \u751a \u9ebc \uff1f \u4ed6 \u5011 \u5f9e \u54ea \u88e1 \u4f86 \u898b \u4f60 \uff1f \u5e0c \u897f \u5bb6 \u8aaa \uff1a \u4ed6 \u5011 \u5f9e \u9060 \u65b9 \u7684 \u5df4 \u6bd4 \u502b \u4f86 \u3002"}, {"pk": 568096, "verse": 15, "text": "\u4ee5 \u8cfd \u4e9e \u8aaa \uff1a \u4ed6 \u5011 \u5728 \u4f60 \u5bb6 \u88e1 \u770b \u898b \u4e86 \u751a \u9ebc \uff1f \u5e0c \u897f \u5bb6 \u8aaa \uff1a \u51e1 \u6211 \u5bb6 \u4e2d \u6240 \u6709 \u7684 \uff0c \u4ed6 \u5011 \u90fd \u770b \u898b \u4e86 \uff1b \u6211 \u8ca1 \u5bf6 \u4e2d \u6c92 \u6709 \u4e00 \u6a23 \u4e0d \u7d66 \u4ed6 \u5011 \u770b \u7684 \u3002"}, {"pk": 568097, "verse": 16, "text": "\u4ee5 \u8cfd \u4e9e \u5c0d \u5e0c \u897f \u5bb6 \u8aaa \uff1a \u4f60 \u8981 \u807d \u8036 \u548c \u83ef \u7684 \u8a71 \uff0c"}, {"pk": 568098, "verse": 17, "text": "\u65e5 \u5b50 \u5fc5 \u5230 \uff0c \u51e1 \u4f60 \u5bb6 \u88e1 \u6240 \u6709 \u7684 \uff0c \u4e26 \u4f60 \u5217 \u7956 \u7a4d \u84c4 \u5230 \u5982 \u4eca \u7684 \uff0c \u90fd \u8981 \u88ab \u64c4 \u5230 \u5df4 \u6bd4 \u502b \u53bb \uff0c \u4e0d \u7559 \u4e0b \u4e00 \u6a23 \u3002 \u9019 \u662f \u8036 \u548c \u83ef \u8aaa \u7684 \u3002"}, {"pk": 568099, "verse": 18, "text": "\u4e26 \u4e14 \u5f9e \u4f60 \u672c \u8eab \u6240 \u751f \u7684 \u773e \u5b50 \uff0c \u5176 \u4e2d \u5fc5 \u6709 \u88ab \u64c4 \u53bb \u5728 \u5df4 \u6bd4 \u502b \u738b \u5bae \u88e1 \u7576 \u592a \u76e3 \u7684 \u3002"}, {"pk": 568100, "verse": 19, "text": "\u5e0c \u897f \u5bb6 \u5c0d \u4ee5 \u8cfd \u4e9e \u8aaa \uff1a \u4f60 \u6240 \u8aaa \u8036 \u548c \u83ef \u7684 \u8a71 \u751a \u597d \uff01 \u82e5 \u5728 \u6211 \u7684 \u5e74 \u65e5 \u4e2d \u6709 \u592a \u5e73 \u548c \u7a69 \u56fa \u7684 \u666f \u6cc1 \uff0c \u8c48 \u4e0d \u662f \u597d \u9ebc \uff1f"}, {"pk": 568101, "verse": 20, "text": "\u5e0c \u897f \u5bb6 \u5176 \u9918 \u7684 \u4e8b \u548c \u4ed6 \u7684 \u52c7 \u529b \uff0c \u4ed6 \u600e \u6a23 \u6316 \u6c60 \u3001 \u6316 \u6e9d \u3001 \u5f15 \u6c34 \u5165 \u57ce \uff0c \u90fd \u5beb \u5728 \u7336 \u5927 \u5217 \u738b \u8a18 \u4e0a \u3002"}, {"pk": 568102, "verse": 21, "text": "\u5e0c \u897f \u5bb6 \u8207 \u4ed6 \u5217 \u7956 \u540c \u7761 \u3002 \u4ed6 \u5152 \u5b50 \u746a \u62ff \u897f \u63a5 \u7e8c \u4ed6 \u4f5c \u738b \u3002"}]