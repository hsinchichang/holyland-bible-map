[{"pk": 558344, "verse": 1, "text": "\u9019 \u4e8b \u4ee5 \u5f8c \uff0c \u8036 \u548c \u83ef \u5728 \u7570 \u8c61 \u4e2d \u6709 \u8a71 \u5c0d \u4e9e \u4f2f \u862d \u8aaa \uff1a \u4e9e \u4f2f \u862d \uff0c \u4f60 \u4e0d \u8981 \u61fc \u6015 \uff01 \u6211 \u662f \u4f60 \u7684 \u76fe \u724c \uff0c \u5fc5 \u5927 \u5927 \u7684 \u8cde \u8cdc \u4f60 \u3002"}, {"pk": 558345, "verse": 2, "text": "\u4e9e \u4f2f \u862d \u8aaa \uff1a \u4e3b \u8036 \u548c \u83ef \u963f \uff0c \u6211 \u65e2 \u7121 \u5b50 \uff0c \u4f60 \u9084 \u8cdc \u6211 \u751a \u9ebc \u5462 \uff1f \u4e26 \u4e14 \u8981 \u627f \u53d7 \u6211 \u5bb6 \u696d \u7684 \u662f \u5927 \u99ac \u8272 \u4eba \u4ee5 \u5229 \u4ee5 \u8b1d \u3002"}, {"pk": 558346, "verse": 3, "text": "\u4e9e \u4f2f \u862d \u53c8 \u8aaa \uff1a \u4f60 \u6c92 \u6709 \u7d66 \u6211 \u5152 \u5b50 \uff1b \u90a3 \u751f \u5728 \u6211 \u5bb6 \u4e2d \u7684 \u4eba \u5c31 \u662f \u6211 \u7684 \u5f8c \u55e3 \u3002"}, {"pk": 558347, "verse": 4, "text": "\u8036 \u548c \u83ef \u53c8 \u6709 \u8a71 \u5c0d \u4ed6 \u8aaa \uff1a \u9019 \u4eba \u5fc5 \u4e0d \u6210 \u70ba \u4f60 \u7684 \u5f8c \u55e3 \uff1b \u4f60 \u672c \u8eab \u6240 \u751f \u7684 \u624d \u6210 \u70ba \u4f60 \u7684 \u5f8c \u55e3 \u3002"}, {"pk": 558348, "verse": 5, "text": "\u65bc \u662f \u9818 \u4ed6 \u8d70 \u5230 \u5916 \u908a \uff0c \u8aaa \uff1a \u4f60 \u5411 \u5929 \u89c0 \u770b \uff0c \u6578 \u7b97 \u773e \u661f \uff0c \u80fd \u6578 \u5f97 \u904e \u4f86 \u9ebc \uff1f \u53c8 \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u7684 \u5f8c \u88d4 \u5c07 \u8981 \u5982 \u6b64 \u3002"}, {"pk": 558349, "verse": 6, "text": "\u4e9e \u4f2f \u862d \u4fe1 \u8036 \u548c \u83ef \uff0c \u8036 \u548c \u83ef \u5c31 \u4ee5 \u6b64 \u70ba \u4ed6 \u7684 \u7fa9 \u3002"}, {"pk": 558350, "verse": 7, "text": "\u8036 \u548c \u83ef \u53c8 \u5c0d \u4ed6 \u8aaa \uff1a \u6211 \u662f \u8036 \u548c \u83ef \uff0c \u66fe \u9818 \u4f60 \u51fa \u4e86 \u8fe6 \u52d2 \u5e95 \u7684 \u543e \u73e5 \uff0c \u70ba \u8981 \u5c07 \u9019 \u5730 \u8cdc \u4f60 \u70ba \u696d \u3002"}, {"pk": 558351, "verse": 8, "text": "\u4e9e \u4f2f \u862d \u8aaa \uff1a \u4e3b \u8036 \u548c \u83ef \u963f \uff0c \u6211 \u600e \u80fd \u77e5 \u9053 \u5fc5 \u5f97 \u9019 \u5730 \u70ba \u696d \u5462 \uff1f"}, {"pk": 558352, "verse": 9, "text": "\u4ed6 \u8aaa \uff1a \u4f60 \u70ba \u6211 \u53d6 \u4e00 \u96bb \u4e09 \u5e74 \u7684 \u6bcd \u725b \uff0c \u4e00 \u96bb \u4e09 \u5e74 \u7684 \u6bcd \u5c71 \u7f8a \uff0c \u4e00 \u96bb \u4e09 \u5e74 \u7684 \u516c \u7dbf \u7f8a \uff0c \u4e00 \u96bb \u6591 \u9ce9 \uff0c \u4e00 \u96bb \u96db \u9d3f \u3002"}, {"pk": 558353, "verse": 10, "text": "\u4e9e \u4f2f \u862d \u5c31 \u53d6 \u4e86 \u9019 \u4e9b \u4f86 \uff0c \u6bcf \u6a23 \u5288 \u958b \uff0c \u5206 \u6210 \u5169 \u534a \uff0c \u4e00 \u534a \u5c0d \u8457 \u4e00 \u534a \u5730 \u64fa \u5217 \uff0c \u53ea \u6709 \u9ce5 \u6c92 \u6709 \u5288 \u958b \u3002"}, {"pk": 558354, "verse": 11, "text": "\u6709 \u9dd9 \u9ce5 \u4e0b \u4f86 \uff0c \u843d \u5728 \u90a3 \u6b7b \u755c \u7684 \u8089 \u4e0a \uff0c \u4e9e \u4f2f \u862d \u5c31 \u628a \u4ed6 \u5687 \u98db \u4e86 \u3002"}, {"pk": 558355, "verse": 12, "text": "\u65e5 \u982d \u6b63 \u843d \u7684 \u6642 \u5019 \uff0c \u4e9e \u4f2f \u862d \u6c89 \u6c89 \u5730 \u7761 \u4e86 \uff1b \u5ffd \u7136 \u6709 \u9a5a \u4eba \u7684 \u5927 \u9ed1 \u6697 \u843d \u5728 \u4ed6 \u8eab \u4e0a \u3002"}, {"pk": 558356, "verse": 13, "text": "\u8036 \u548c \u83ef \u5c0d \u4e9e \u4f2f \u862d \u8aaa \uff1a \u4f60 \u8981 \u7684 \u78ba \u77e5 \u9053 \uff0c \u4f60 \u7684 \u5f8c \u88d4 \u5fc5 \u5bc4 \u5c45 \u5225 \u4eba \u7684 \u5730 \uff0c \u53c8 \u670d \u4e8b \u90a3 \u5730 \u7684 \u4eba \uff1b \u90a3 \u5730 \u7684 \u4eba \u8981 \u82e6 \u5f85 \u4ed6 \u5011 \u56db \u767e \u5e74 \u3002"}, {"pk": 558357, "verse": 14, "text": "\u4e26 \u4e14 \u4ed6 \u5011 \u6240 \u8981 \u670d \u4e8b \u7684 \u90a3 \u570b \uff0c \u6211 \u8981 \u61f2 \u7f70 \uff0c \u5f8c \u4f86 \u4ed6 \u5011 \u5fc5 \u5e36 \u8457 \u8a31 \u591a \u8ca1 \u7269 \u5f9e \u90a3 \u88e1 \u51fa \u4f86 \u3002"}, {"pk": 558358, "verse": 15, "text": "\u4f46 \u4f60 \u8981 \u4eab \u5927 \u58fd \u6578 \uff0c \u5e73 \u5e73 \u5b89 \u5b89 \u5730 \u6b78 \u5230 \u4f60 \u5217 \u7956 \u90a3 \u88e1 \uff0c \u88ab \u4eba \u57cb \u846c \u3002"}, {"pk": 558359, "verse": 16, "text": "\u5230 \u4e86 \u7b2c \u56db \u4ee3 \uff0c \u4ed6 \u5011 \u5fc5 \u56de \u5230 \u6b64 \u5730 \uff0c \u56e0 \u70ba \u4e9e \u6469 \u5229 \u4eba \u7684 \u7f6a \u5b7d \u9084 \u6c92 \u6709 \u6eff \u76c8 \u3002"}, {"pk": 558360, "verse": 17, "text": "\u65e5 \u843d \u5929 \u9ed1 \uff0c \u4e0d \u6599 \u6709 \u5192 \u7159 \u7684 \u7210 \u4e26 \u71d2 \u8457 \u7684 \u706b \u628a \u5f9e \u90a3 \u4e9b \u8089 \u584a \u4e2d \u7d93 \u904e \u3002"}, {"pk": 558361, "verse": 18, "text": "\u7576 \u90a3 \u65e5 \uff0c \u8036 \u548c \u83ef \u8207 \u4e9e \u4f2f \u862d \u7acb \u7d04 \uff0c \u8aaa \uff1a \u6211 \u5df2 \u8cdc \u7d66 \u4f60 \u7684 \u5f8c \u88d4 \uff0c \u5f9e \u57c3 \u53ca \u6cb3 \u76f4 \u5230 \u4f2f \u62c9 \u5927 \u6cb3 \u4e4b \u5730 \uff0c"}, {"pk": 558362, "verse": 19, "text": "\u5c31 \u662f \u57fa \u5c3c \u4eba \u3001 \u57fa \u5c3c \u6d17 \u4eba \u3001 \u7532 \u6469 \u5c3c \u4eba \u3001"}, {"pk": 558363, "verse": 20, "text": "\u8d6b \u4eba \u3001 \u6bd4 \u5229 \u6d17 \u4eba \u3001 \u5229 \u4e4f \u97f3 \u4eba \u3001"}, {"pk": 558364, "verse": 21, "text": "\u4e9e \u6469 \u5229 \u4eba \u3001 \u8fe6 \u5357 \u4eba \u3001 \u9769 \u8fe6 \u6492 \u4eba \u3001 \u8036 \u5e03 \u65af \u4eba \u4e4b \u5730 \u3002"}]