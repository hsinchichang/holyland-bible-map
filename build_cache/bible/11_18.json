[{"pk": 567325, "verse": 1, "text": "\u904e \u4e86 \u8a31 \u4e45 \uff0c \u5230 \u7b2c \u4e09 \u5e74 \uff0c \u8036 \u548c \u83ef \u7684 \u8a71 \u81e8 \u5230 \u4ee5 \u5229 \u4e9e \u8aaa \uff1a \u4f60 \u53bb \uff0c \u4f7f \u4e9e \u54c8 \u5f97 \u898b \u4f60 \uff1b \u6211 \u8981 \u964d \u96e8 \u5728 \u5730 \u4e0a \u3002"}, {"pk": 567326, "verse": 2, "text": "\u4ee5 \u5229 \u4e9e \u5c31 \u53bb \uff0c \u8981 \u4f7f \u4e9e \u54c8 \u5f97 \u898b \u4ed6 \u3002 \u90a3 \u6642 \uff0c \u6492 \u746a \u5229 \u4e9e \u6709 \u5927 \u9951 \u8352 \uff1b"}, {"pk": 567327, "verse": 3, "text": "\u4e9e \u54c8 \u5c07 \u4ed6 \u7684 \u5bb6 \u5bb0 \u4fc4 \u5df4 \u5e95 \u53ec \u4e86 \u4f86 \u3002 \u3008 \u4fc4 \u5df4 \u5e95 \u751a \u662f \u656c \u754f \u8036 \u548c \u83ef \uff0c"}, {"pk": 567328, "verse": 4, "text": "\u8036 \u6d17 \u5225 \u6bba \u8036 \u548c \u83ef \u773e \u5148 \u77e5 \u7684 \u6642 \u5019 \uff0c \u4fc4 \u5df4 \u5e95 \u5c07 \u4e00 \u767e \u500b \u5148 \u77e5 \u85cf \u4e86 \uff0c \u6bcf \u4e94 \u5341 \u4eba \u85cf \u5728 \u4e00 \u500b \u6d1e \u88e1 \uff0c \u62ff \u9905 \u548c \u6c34 \u4f9b \u990a \u4ed6 \u5011 \u3002 \u3009"}, {"pk": 567329, "verse": 5, "text": "\u4e9e \u54c8 \u5c0d \u4fc4 \u5df4 \u5e95 \u8aaa \uff1a \u6211 \u5011 \u8d70 \u904d \u9019 \u5730 \uff0c \u5230 \u4e00 \u5207 \u6c34 \u6cc9 \u65c1 \u548c \u4e00 \u5207 \u6eaa \u908a \uff0c \u6216 \u8005 \u627e \u5f97 \u8457 \u9752 \u8349 \uff0c \u53ef \u4ee5 \u6551 \u6d3b \u9a3e \u99ac \uff0c \u514d \u5f97 \u7d55 \u4e86 \u7272 \u755c \u3002"}, {"pk": 567330, "verse": 6, "text": "\u65bc \u662f \u4e8c \u4eba \u5206 \u5730 \u904a \u884c \uff0c \u4e9e \u54c8 \u7368 \u8d70 \u4e00 \u8def \uff0c \u4fc4 \u5df4 \u5e95 \u7368 \u8d70 \u4e00 \u8def \u3002"}, {"pk": 567331, "verse": 7, "text": "\u4fc4 \u5df4 \u5e95 \u5728 \u8def \u4e0a \u6070 \u8207 \u4ee5 \u5229 \u4e9e \u76f8 \u9047 \uff0c \u4fc4 \u5df4 \u5e95 \u8a8d \u51fa \u4ed6 \u4f86 \uff0c \u5c31 \u4fef \u4f0f \u5728 \u5730 \uff0c \u8aaa \uff1a \u4f60 \u662f \u6211 \u4e3b \u4ee5 \u5229 \u4e9e \u4e0d \u662f \uff1f"}, {"pk": 567332, "verse": 8, "text": "\u56de \u7b54 \u8aaa \uff1a \u662f \u3002 \u4f60 \u53bb \u544a \u8a34 \u4f60 \u4e3b \u4eba \u8aaa \uff0c \u4ee5 \u5229 \u4e9e \u5728 \u9019 \u88e1 \u3002"}, {"pk": 567333, "verse": 9, "text": "\u4fc4 \u5df4 \u5e95 \u8aaa \uff1a \u50d5 \u4eba \u6709 \u751a \u9ebc \u7f6a \uff0c \u4f60 \u7adf \u8981 \u5c07 \u6211 \u4ea4 \u5728 \u4e9e \u54c8 \u624b \u88e1 \uff0c \u4f7f \u4ed6 \u6bba \u6211 \u5462 \uff1f"}, {"pk": 567334, "verse": 10, "text": "\u6211 \u6307 \u8457 \u6c38 \u751f \u8036 \u548c \u83ef \u2500 \u4f60 \u7684 \u3000 \u795e \u8d77 \u8a93 \uff0c \u7121 \u8ad6 \u54ea \u4e00 \u90a6 \u54ea \u4e00 \u570b \uff0c \u6211 \u4e3b \u90fd \u6253 \u767c \u4eba \u53bb \u627e \u4f60 \u3002 \u82e5 \u8aaa \u4f60 \u6c92 \u6709 \u5728 \u90a3 \u88e1 \uff0c \u5c31 \u5fc5 \u4f7f \u90a3 \u90a6 \u90a3 \u570b \u7684 \u4eba \u8d77 \u8a93 \u8aaa \uff0c \u5be6 \u5728 \u662f \u627e \u4e0d \u8457 \u4f60 \u3002"}, {"pk": 567335, "verse": 11, "text": "\u73fe \u5728 \u4f60 \u8aaa \uff0c \u8981 \u53bb \u544a \u8a34 \u4f60 \u4e3b \u4eba \u8aaa \uff0c \u4ee5 \u5229 \u4e9e \u5728 \u9019 \u88e1 \uff1b"}, {"pk": 567336, "verse": 12, "text": "\u6050 \u6015 \u6211 \u4e00 \u96e2 \u958b \u4f60 \uff0c \u8036 \u548c \u83ef \u7684 \u9748 \u5c31 \u63d0 \u4f60 \u5230 \u6211 \u6240 \u4e0d \u77e5 \u9053 \u7684 \u5730 \u65b9 \u53bb \u3002 \u9019 \u6a23 \uff0c \u6211 \u53bb \u544a \u8a34 \u4e9e \u54c8 \uff0c \u4ed6 \u82e5 \u627e \u4e0d \u8457 \u4f60 \uff0c \u5c31 \u5fc5 \u6bba \u6211 \uff1b \u50d5 \u4eba \u537b \u662f \u81ea \u5e7c \u656c \u754f \u8036 \u548c \u83ef \u7684 \u3002"}, {"pk": 567337, "verse": 13, "text": "\u8036 \u6d17 \u5225 \u6bba \u8036 \u548c \u83ef \u773e \u5148 \u77e5 \u7684 \u6642 \u5019 \uff0c \u6211 \u5c07 \u8036 \u548c \u83ef \u7684 \u4e00 \u767e \u500b \u5148 \u77e5 \u85cf \u4e86 \uff0c \u6bcf \u4e94 \u5341 \u4eba \u85cf \u5728 \u4e00 \u500b \u6d1e \u88e1 \uff0c \u62ff \u9905 \u548c \u6c34 \u4f9b \u990a \u4ed6 \u5011 \uff0c \u8c48 \u6c92 \u6709 \u4eba \u5c07 \u9019 \u4e8b \u544a \u8a34 \u6211 \u4e3b \u9ebc \uff1f"}, {"pk": 567338, "verse": 14, "text": "\u73fe \u5728 \u4f60 \u8aaa \uff0c \u8981 \u53bb \u544a \u8a34 \u4f60 \u4e3b \u4eba \u8aaa \uff0c \u4ee5 \u5229 \u4e9e \u5728 \u9019 \u88e1 \uff0c \u4ed6 \u5fc5 \u6bba \u6211 \u3002"}, {"pk": 567339, "verse": 15, "text": "\u4ee5 \u5229 \u4e9e \u8aaa \uff1a \u6211 \u6307 \u8457 \u6240 \u4e8b \u5949 \u6c38 \u751f \u7684 \u842c \u8ecd \u4e4b \u8036 \u548c \u83ef \u8d77 \u8a93 \uff0c \u6211 \u4eca \u65e5 \u5fc5 \u4f7f \u4e9e \u54c8 \u5f97 \u898b \u6211 \u3002"}, {"pk": 567340, "verse": 16, "text": "\u65bc \u662f \u4fc4 \u5df4 \u5e95 \u53bb \u8fce \u8457 \u4e9e \u54c8 \uff0c \u544a \u8a34 \u4ed6 \uff1b \u4e9e \u54c8 \u5c31 \u53bb \u8fce \u8457 \u4ee5 \u5229 \u4e9e \u3002"}, {"pk": 567341, "verse": 17, "text": "\u4e9e \u54c8 \u898b \u4e86 \u4ee5 \u5229 \u4e9e \uff0c \u4fbf \u8aaa \uff1a \u4f7f \u4ee5 \u8272 \u5217 \u906d \u707d \u7684 \u5c31 \u662f \u4f60 \u9ebc \uff1f"}, {"pk": 567342, "verse": 18, "text": "\u4ee5 \u5229 \u4e9e \u8aaa \uff1a \u4f7f \u4ee5 \u8272 \u5217 \u906d \u707d \u7684 \u4e0d \u662f \u6211 \uff0c \u4e43 \u662f \u4f60 \u548c \u4f60 \u7236 \u5bb6 \uff1b \u56e0 \u70ba \u4f60 \u5011 \u96e2 \u68c4 \u8036 \u548c \u83ef \u7684 \u8aa1 \u547d \uff0c \u53bb \u96a8 \u5f9e \u5df4 \u529b \u3002"}, {"pk": 567343, "verse": 19, "text": "\u73fe \u5728 \u4f60 \u7576 \u5dee \u9063 \u4eba \uff0c \u62db \u805a \u4ee5 \u8272 \u5217 \u773e \u4eba \u548c \u4e8b \u5949 \u5df4 \u529b \u7684 \u90a3 \u56db \u767e \u4e94 \u5341 \u500b \u5148 \u77e5 \uff0c \u4e26 \u8036 \u6d17 \u5225 \u6240 \u4f9b \u990a \u4e8b \u5949 \u4e9e \u820d \u62c9 \u7684 \u90a3 \u56db \u767e \u500b \u5148 \u77e5 \uff0c \u4f7f \u4ed6 \u5011 \u90fd \u4e0a \u8fe6 \u5bc6 \u5c71 \u53bb \u898b \u6211 \u3002"}, {"pk": 567344, "verse": 20, "text": "\u4e9e \u54c8 \u5c31 \u5dee \u9063 \u4eba \u62db \u805a \u4ee5 \u8272 \u5217 \u773e \u4eba \u548c \u5148 \u77e5 \u90fd \u4e0a \u8fe6 \u5bc6 \u5c71 \u3002"}, {"pk": 567345, "verse": 21, "text": "\u4ee5 \u5229 \u4e9e \u524d \u4f86 \u5c0d \u773e \u6c11 \u8aaa \uff1a \u4f60 \u5011 \u5fc3 \u6301 \u5169 \u610f \u8981 \u5230 \u5e7e \u6642 \u5462 \uff1f \u82e5 \u8036 \u548c \u83ef \u662f \u3000 \u795e \uff0c \u5c31 \u7576 \u9806 \u5f9e \u8036 \u548c \u83ef \uff1b \u82e5 \u5df4 \u529b \u662f \u795e \uff0c \u5c31 \u7576 \u9806 \u5f9e \u5df4 \u529b \u3002 \u773e \u6c11 \u4e00 \u8a00 \u4e0d \u7b54 \u3002"}, {"pk": 567346, "verse": 22, "text": "\u4ee5 \u5229 \u4e9e \u5c0d \u773e \u6c11 \u8aaa \uff1a \u4f5c \u8036 \u548c \u83ef \u5148 \u77e5 \u7684 \u53ea \u5269 \u4e0b \u6211 \u4e00 \u500b \u4eba \uff1b \u5df4 \u529b \u7684 \u5148 \u77e5 \u537b \u6709 \u56db \u767e \u4e94 \u5341 \u500b \u4eba \u3002"}, {"pk": 567347, "verse": 23, "text": "\u7576 \u7d66 \u6211 \u5011 \u5169 \u96bb \u725b \u72a2 \uff0c \u5df4 \u529b \u7684 \u5148 \u77e5 \u53ef \u4ee5 \u6311 \u9078 \u4e00 \u96bb \uff0c \u5207 \u6210 \u584a \u5b50 \uff0c \u653e \u5728 \u67f4 \u4e0a \uff0c \u4e0d \u8981 \u9ede \u706b \uff1b \u6211 \u4e5f \u9810 \u5099 \u4e00 \u96bb \u725b \u72a2 \u653e \u5728 \u67f4 \u4e0a \uff0c \u4e5f \u4e0d \u9ede \u706b \u3002"}, {"pk": 567348, "verse": 24, "text": "\u4f60 \u5011 \u6c42 \u544a \u4f60 \u5011 \u3000 \u795e \u7684 \u540d \uff0c \u6211 \u4e5f \u6c42 \u544a \u8036 \u548c \u83ef \u7684 \u540d \u3002 \u90a3 \u964d \u706b \u986f \u61c9 \u7684 \u3000 \u795e \uff0c \u5c31 \u662f \u3000 \u795e \u3002 \u773e \u6c11 \u56de \u7b54 \u8aaa \uff1a \u9019 \u8a71 \u751a \u597d \u3002"}, {"pk": 567349, "verse": 25, "text": "\u4ee5 \u5229 \u4e9e \u5c0d \u5df4 \u529b \u7684 \u5148 \u77e5 \u8aaa \uff1a \u4f60 \u5011 \u65e2 \u662f \u4eba \u591a \uff0c \u7576 \u5148 \u6311 \u9078 \u4e00 \u96bb \u725b \u72a2 \uff0c \u9810 \u5099 \u597d \u4e86 \uff0c \u5c31 \u6c42 \u544a \u4f60 \u5011 \u3000 \u795e \u7684 \u540d \uff0c \u537b \u4e0d \u8981 \u9ede \u706b \u3002"}, {"pk": 567350, "verse": 26, "text": "\u4ed6 \u5011 \u5c07 \u6240 \u5f97 \u7684 \u725b \u72a2 \u9810 \u5099 \u597d \u4e86 \uff0c \u5f9e \u65e9 \u6668 \u5230 \u5348 \u9593 \uff0c \u6c42 \u544a \u5df4 \u529b \u7684 \u540d \u8aaa \uff1a \u5df4 \u529b \u554a \uff0c \u6c42 \u4f60 \u61c9 \u5141 \u6211 \u5011 \uff01 \u537b \u6c92 \u6709 \u8072 \u97f3 \uff0c \u6c92 \u6709 \u61c9 \u5141 \u7684 \u3002 \u4ed6 \u5011 \u5728 \u6240 \u7bc9 \u7684 \u58c7 \u56db \u570d \u8e0a \u8df3 \u3002"}, {"pk": 567351, "verse": 27, "text": "\u5230 \u4e86 \u6b63 \u5348 \uff0c \u4ee5 \u5229 \u4e9e \u5b09 \u7b11 \u4ed6 \u5011 \uff0c \u8aaa \uff1a \u5927 \u8072 \u6c42 \u544a \u7f77 \uff01 \u56e0 \u70ba \u4ed6 \u662f \u3000 \u795e \uff0c \u4ed6 \u6216 \u9ed8 \u60f3 \uff0c \u6216 \u8d70 \u5230 \u4e00 \u908a \uff0c \u6216 \u884c \u8def \uff0c \u6216 \u7761 \u89ba \uff0c \u4f60 \u5011 \u7576 \u53eb \u9192 \u4ed6 \u3002"}, {"pk": 567352, "verse": 28, "text": "\u4ed6 \u5011 \u5927 \u8072 \u6c42 \u544a \uff0c \u6309 \u8457 \u4ed6 \u5011 \u7684 \u898f \u77e9 \uff0c \u7528 \u5200 \u69cd \u81ea \u5272 \u3001 \u81ea \u523a \uff0c \u76f4 \u5230 \u8eab \u9ad4 \u6d41 \u8840 \u3002"}, {"pk": 567353, "verse": 29, "text": "\u5f9e \u5348 \u5f8c \u76f4 \u5230 \u737b \u665a \u796d \u7684 \u6642 \u5019 \uff0c \u4ed6 \u5011 \u72c2 \u547c \u4e82 \u53eb \uff0c \u537b \u6c92 \u6709 \u8072 \u97f3 \uff0c \u6c92 \u6709 \u61c9 \u5141 \u7684 \uff0c \u4e5f \u6c92 \u6709 \u7406 \u6703 \u7684 \u3002"}, {"pk": 567354, "verse": 30, "text": "\u4ee5 \u5229 \u4e9e \u5c0d \u773e \u6c11 \u8aaa \uff1a \u4f60 \u5011 \u5230 \u6211 \u9019 \u88e1 \u4f86 \u3002 \u773e \u6c11 \u5c31 \u5230 \u4ed6 \u90a3 \u88e1 \u3002 \u4ed6 \u4fbf \u91cd \u4fee \u5df2 \u7d93 \u6bc0 \u58de \u8036 \u548c \u83ef \u7684 \u58c7 \u3002"}, {"pk": 567355, "verse": 31, "text": "\u4ee5 \u5229 \u4e9e \u7167 \u96c5 \u5404 \u5b50 \u5b6b \u652f \u6d3e \u7684 \u6578 \u76ee \uff0c \u53d6 \u4e86 \u5341 \u4e8c \u584a \u77f3 \u982d \uff08 \u8036 \u548c \u83ef \u7684 \u8a71 \u66fe \u81e8 \u5230 \u96c5 \u5404 \u8aaa \uff1a \u4f60 \u7684 \u540d \u8981 \u53eb \u4ee5 \u8272 \u5217 \uff09 \uff0c"}, {"pk": 567356, "verse": 32, "text": "\u7528 \u9019 \u4e9b \u77f3 \u982d \u70ba \u8036 \u548c \u83ef \u7684 \u540d \u7bc9 \u4e00 \u5ea7 \u58c7 \uff0c \u5728 \u58c7 \u7684 \u56db \u570d \u6316 \u6e9d \uff0c \u53ef \u5bb9 \u7a40 \u7a2e \u4e8c \u7d30 \u4e9e \uff0c"}, {"pk": 567357, "verse": 33, "text": "\u53c8 \u5728 \u58c7 \u4e0a \u64fa \u597d \u4e86 \u67f4 \uff0c \u628a \u725b \u72a2 \u5207 \u6210 \u584a \u5b50 \u653e \u5728 \u67f4 \u4e0a \uff0c \u5c0d \u773e \u4eba \u8aaa \uff1a \u4f60 \u5011 \u7528 \u56db \u500b \u6876 \u76db \u6eff \u6c34 \uff0c \u5012 \u5728 \u71d4 \u796d \u548c \u67f4 \u4e0a \uff1b"}, {"pk": 567358, "verse": 34, "text": "\u53c8 \u8aaa \uff1a \u5012 \u7b2c \u4e8c \u6b21 \u3002 \u4ed6 \u5011 \u5c31 \u5012 \u7b2c \u4e8c \u6b21 \uff1b \u53c8 \u8aaa \uff1a \u5012 \u7b2c \u4e09 \u6b21 \u3002 \u4ed6 \u5011 \u5c31 \u5012 \u7b2c \u4e09 \u6b21 \u3002"}, {"pk": 567359, "verse": 35, "text": "\u6c34 \u6d41 \u5728 \u58c7 \u7684 \u56db \u570d \uff0c \u6e9d \u88e1 \u4e5f \u6eff \u4e86 \u6c34 \u3002"}, {"pk": 567360, "verse": 36, "text": "\u5230 \u4e86 \u737b \u665a \u796d \u7684 \u6642 \u5019 \uff0c \u5148 \u77e5 \u4ee5 \u5229 \u4e9e \u8fd1 \u524d \u4f86 \uff0c \u8aaa \uff1a \u4e9e \u4f2f \u62c9 \u7f55 \u3001 \u4ee5 \u6492 \u3001 \u4ee5 \u8272 \u5217 \u7684 \u3000 \u795e \uff0c \u8036 \u548c \u83ef \u554a \uff0c \u6c42 \u4f60 \u4eca \u65e5 \u4f7f \u4eba \u77e5 \u9053 \u4f60 \u662f \u4ee5 \u8272 \u5217 \u7684 \u3000 \u795e \uff0c \u4e5f \u77e5 \u9053 \u6211 \u662f \u4f60 \u7684 \u50d5 \u4eba \uff0c \u53c8 \u662f \u5949 \u4f60 \u7684 \u547d \u884c \u9019 \u4e00 \u5207 \u4e8b \u3002"}, {"pk": 567361, "verse": 37, "text": "\u8036 \u548c \u83ef \u554a \uff0c \u6c42 \u4f60 \u61c9 \u5141 \u6211 \uff0c \u61c9 \u5141 \u6211 \uff01 \u4f7f \u9019 \u6c11 \u77e5 \u9053 \u4f60 \u2500 \u8036 \u548c \u83ef \u662f \u3000 \u795e \uff0c \u53c8 \u77e5 \u9053 \u662f \u4f60 \u53eb \u9019 \u6c11 \u7684 \u5fc3 \u56de \u8f49 \u3002"}, {"pk": 567362, "verse": 38, "text": "\u65bc \u662f \uff0c \u8036 \u548c \u83ef \u964d \u4e0b \u706b \u4f86 \uff0c \u71d2 \u76e1 \u71d4 \u796d \u3001 \u6728 \u67f4 \u3001 \u77f3 \u982d \u3001 \u5875 \u571f \uff0c \u53c8 \u71d2 \u4e7e \u6e9d \u88e1 \u7684 \u6c34 \u3002"}, {"pk": 567363, "verse": 39, "text": "\u773e \u6c11 \u770b \u898b \u4e86 \uff0c \u5c31 \u4fef \u4f0f \u5728 \u5730 \uff0c \u8aaa \uff1a \u8036 \u548c \u83ef \u662f \u3000 \u795e \uff01 \u8036 \u548c \u83ef \u662f \u3000 \u795e \uff01"}, {"pk": 567364, "verse": 40, "text": "\u4ee5 \u5229 \u4e9e \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u62ff \u4f4f \u5df4 \u529b \u7684 \u5148 \u77e5 \uff0c \u4e0d \u5bb9 \u4e00 \u4eba \u9003 \u812b \uff01 \u773e \u4eba \u5c31 \u62ff \u4f4f \u4ed6 \u5011 \u3002 \u4ee5 \u5229 \u4e9e \u5e36 \u4ed6 \u5011 \u5230 \u57fa \u9806 \u6cb3 \u908a \uff0c \u5728 \u90a3 \u88e1 \u6bba \u4e86 \u4ed6 \u5011 \u3002"}, {"pk": 567365, "verse": 41, "text": "\u4ee5 \u5229 \u4e9e \u5c0d \u4e9e \u54c8 \u8aaa \uff1a \u4f60 \u73fe \u5728 \u53ef \u4ee5 \u4e0a \u53bb \u5403 \u559d \uff0c \u56e0 \u70ba \u6709 \u591a \u96e8 \u7684 \u97ff \u8072 \u4e86 \u3002"}, {"pk": 567366, "verse": 42, "text": "\u4e9e \u54c8 \u5c31 \u4e0a \u53bb \u5403 \u559d \u3002 \u4ee5 \u5229 \u4e9e \u4e0a \u4e86 \u8fe6 \u5bc6 \u5c71 \u9802 \uff0c \u5c48 \u8eab \u5728 \u5730 \uff0c \u5c07 \u81c9 \u4f0f \u5728 \u5169 \u819d \u4e4b \u4e2d \uff1b"}, {"pk": 567367, "verse": 43, "text": "\u5c0d \u50d5 \u4eba \u8aaa \uff1a \u4f60 \u4e0a \u53bb \uff0c \u5411 \u6d77 \u89c0 \u770b \u3002 \u50d5 \u4eba \u5c31 \u4e0a \u53bb \u89c0 \u770b \uff0c \u8aaa \uff1a \u6c92 \u6709 \u751a \u9ebc \u3002 \u4ed6 \u8aaa \uff1a \u4f60 \u518d \u53bb \u89c0 \u770b \u3002 \u5982 \u6b64 \u4e03 \u6b21 \u3002"}, {"pk": 567368, "verse": 44, "text": "\u7b2c \u4e03 \u6b21 \u50d5 \u4eba \u8aaa \uff1a \u6211 \u770b \u898b \u6709 \u4e00 \u5c0f \u7247 \u96f2 \u5f9e \u6d77 \u88e1 \u4e0a \u4f86 \uff0c \u4e0d \u904e \u5982 \u4eba \u624b \u90a3 \u6a23 \u5927 \u3002 \u4ee5 \u5229 \u4e9e \u8aaa \uff1a \u4f60 \u4e0a \u53bb \u544a \u8a34 \u4e9e \u54c8 \uff0c \u7576 \u5957 \u8eca \u4e0b \u53bb \uff0c \u514d \u5f97 \u88ab \u96e8 \u963b \u64cb \u3002"}, {"pk": 567369, "verse": 45, "text": "\u970e \u6642 \u9593 \uff0c \u5929 \u56e0 \u98a8 \u96f2 \u9ed1 \u6697 \uff0c \u964d \u4e0b \u5927 \u96e8 \u3002 \u4e9e \u54c8 \u5c31 \u5750 \u8eca \u5f80 \u8036 \u65af \u5217 \u53bb \u4e86 \u3002"}, {"pk": 567370, "verse": 46, "text": "\u8036 \u548c \u83ef \u7684 \u9748 ( \u539f \u6587 \u662f \u624b ) \u964d \u5728 \u4ee5 \u5229 \u4e9e \u8eab \u4e0a \uff0c \u4ed6 \u5c31 \u675f \u4e0a \u8170 \uff0c \u5954 \u5728 \u4e9e \u54c8 \u524d \u982d \uff0c \u76f4 \u5230 \u8036 \u65af \u5217 \u7684 \u57ce \u9580 \u3002"}]