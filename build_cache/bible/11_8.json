[{"pk": 566969, "verse": 1, "text": "\u90a3 \u6642 \uff0c \u6240 \u7f85 \u9580 \u5c07 \u4ee5 \u8272 \u5217 \u7684 \u9577 \u8001 \u548c \u5404 \u652f \u6d3e \u7684 \u9996 \u9818 \uff0c \u4e26 \u4ee5 \u8272 \u5217 \u7684 \u65cf \u9577 \uff0c \u62db \u805a \u5230 \u8036 \u8def \u6492 \u51b7 \uff0c \u8981 \u628a \u8036 \u548c \u83ef \u7684 \u7d04 \u6ac3 \u5f9e \u5927 \u885b \u57ce \u2500 \u5c31 \u662f \u932b \u5b89 \u2500 \u904b \u4e0a \u4f86 \u3002"}, {"pk": 566970, "verse": 2, "text": "\u4ee5 \u4ed6 \u5ff5 \u6708 \uff0c \u5c31 \u662f \u4e03 \u6708 \uff0c \u5728 \u7bc0 \u524d \uff0c \u4ee5 \u8272 \u5217 \u4eba \u90fd \u805a \u96c6 \u5230 \u6240 \u7f85 \u9580 \u738b \u90a3 \u88e1 \u3002"}, {"pk": 566971, "verse": 3, "text": "\u4ee5 \u8272 \u5217 \u9577 \u8001 \u4f86 \u5230 \uff0c \u796d \u53f8 \u4fbf \u62ac \u8d77 \u7d04 \u6ac3 \uff0c"}, {"pk": 566972, "verse": 4, "text": "\u796d \u53f8 \u548c \u5229 \u672a \u4eba \u5c07 \u8036 \u548c \u83ef \u7684 \u7d04 \u6ac3 \u904b \u4e0a \u4f86 \uff0c \u53c8 \u5c07 \u6703 \u5e55 \u548c \u6703 \u5e55 \u7684 \u4e00 \u5207 \u8056 \u5668 \u5177 \u90fd \u5e36 \u4e0a \u4f86 \u3002"}, {"pk": 566973, "verse": 5, "text": "\u6240 \u7f85 \u9580 \u738b \u548c \u805a \u96c6 \u5230 \u4ed6 \u90a3 \u88e1 \u7684 \u4ee5 \u8272 \u5217 \u5168 \u6703 \u773e \uff0c \u4e00 \u540c \u5728 \u7d04 \u6ac3 \u524d \u737b \u725b \u7f8a \u70ba \u796d \uff0c \u591a \u5f97 \u4e0d \u53ef \u52dd \u6578 \u3002"}, {"pk": 566974, "verse": 6, "text": "\u796d \u53f8 \u5c07 \u8036 \u548c \u83ef \u7684 \u7d04 \u6ac3 \u62ac \u9032 \u5167 \u6bbf \uff0c \u5c31 \u662f \u81f3 \u8056 \u6240 \uff0c \u653e \u5728 \u5169 \u500b \u57fa \u8def \u4f2f \u7684 \u7fc5 \u8180 \u5e95 \u4e0b \u3002"}, {"pk": 566975, "verse": 7, "text": "\u57fa \u8def \u4f2f \u5f35 \u8457 \u7fc5 \u8180 \u5728 \u7d04 \u6ac3 \u4e4b \u4e0a \uff0c \u906e \u63a9 \u7d04 \u6ac3 \u548c \u62ac \u6ac3 \u7684 \u6760 \u3002"}, {"pk": 566976, "verse": 8, "text": "\u9019 \u6760 \u751a \u9577 \uff0c \u6760 \u982d \u5728 \u5167 \u6bbf \u524d \u7684 \u8056 \u6240 \u53ef \u4ee5 \u770b \u898b \uff0c \u5728 \u6bbf \u5916 \u537b \u4e0d \u80fd \u770b \u898b \uff0c \u76f4 \u5230 \u5982 \u4eca \u9084 \u5728 \u90a3 \u88e1 \u3002"}, {"pk": 566977, "verse": 9, "text": "\u7d04 \u6ac3 \u88e1 \u60df \u6709 \u5169 \u584a \u77f3 \u7248 \uff0c \u5c31 \u662f \u4ee5 \u8272 \u5217 \u4eba \u51fa \u57c3 \u53ca \u5730 \u5f8c \uff0c \u8036 \u548c \u83ef \u8207 \u4ed6 \u5011 \u7acb \u7d04 \u7684 \u6642 \u5019 \u6469 \u897f \u5728 \u4f55 \u70c8 \u5c71 \u6240 \u653e \u7684 \u3002 \u9664 \u6b64 \u4ee5 \u5916 \uff0c \u4e26 \u7121 \u5225 \u7269 \u3002"}, {"pk": 566978, "verse": 10, "text": "\u796d \u53f8 \u5f9e \u8056 \u6240 \u51fa \u4f86 \u7684 \u6642 \u5019 \uff0c \u6709 \u96f2 \u5145 \u6eff \u8036 \u548c \u83ef \u7684 \u6bbf \uff1b"}, {"pk": 566979, "verse": 11, "text": "\u751a \u81f3 \u796d \u53f8 \u4e0d \u80fd \u7ad9 \u7acb \u4f9b \u8077 \uff0c \u56e0 \u70ba \u8036 \u548c \u83ef \u7684 \u69ae \u5149 \u5145 \u6eff \u4e86 \u6bbf \u3002"}, {"pk": 566980, "verse": 12, "text": "\u90a3 \u6642 \u6240 \u7f85 \u9580 \u8aaa \uff1a \u8036 \u548c \u83ef \u66fe \u8aaa \uff0c \u4ed6 \u5fc5 \u4f4f \u5728 \u5e7d \u6697 \u4e4b \u8655 \u3002"}, {"pk": 566981, "verse": 13, "text": "\u6211 \u5df2 \u7d93 \u5efa \u9020 \u6bbf \u5b87 \u4f5c \u4f60 \u7684 \u5c45 \u6240 \uff0c \u70ba \u4f60 \u6c38 \u9060 \u7684 \u4f4f \u8655 \u3002"}, {"pk": 566982, "verse": 14, "text": "\u738b \u8f49 \u81c9 \u70ba \u4ee5 \u8272 \u5217 \u6703 \u773e \u795d \u798f \uff0c \u4ee5 \u8272 \u5217 \u6703 \u773e \u5c31 \u90fd \u7ad9 \u7acb \u3002"}, {"pk": 566983, "verse": 15, "text": "\u6240 \u7f85 \u9580 \u8aaa \uff1a \u8036 \u548c \u83ef \u2500 \u4ee5 \u8272 \u5217 \u7684 \u3000 \u795e \u662f \u61c9 \u7576 \u7a31 \u980c \u7684 \uff01 \u56e0 \u4ed6 \u89aa \u53e3 \u5411 \u6211 \u7236 \u5927 \u885b \u6240 \u61c9 \u8a31 \u7684 \uff0c \u4e5f \u89aa \u624b \u6210 \u5c31 \u4e86 \u3002"}, {"pk": 566984, "verse": 16, "text": "\u4ed6 \u8aaa \uff1a \u81ea \u5f9e \u6211 \u9818 \u6211 \u6c11 \u4ee5 \u8272 \u5217 \u51fa \u57c3 \u53ca \u4ee5 \u4f86 \uff0c \u6211 \u672a \u66fe \u5728 \u4ee5 \u8272 \u5217 \u5404 \u652f \u6d3e \u4e2d \u9078 \u64c7 \u4e00 \u57ce \u5efa \u9020 \u6bbf \u5b87 \u2500 \u70ba \u6211 \u540d \u7684 \u5c45 \u6240 \uff0c \u4f46 \u63c0 \u9078 \u5927 \u885b \u6cbb \u7406 \u6211 \u6c11 \u4ee5 \u8272 \u5217 \u3002"}, {"pk": 566985, "verse": 17, "text": "\u6240 \u7f85 \u9580 \u8aaa \uff1a \u6211 \u7236 \u5927 \u885b \u66fe \u7acb \u610f \uff0c \u8981 \u70ba \u8036 \u548c \u83ef \u2500 \u4ee5 \u8272 \u5217 \u3000 \u795e \u7684 \u540d \u5efa \u6bbf \u3002"}, {"pk": 566986, "verse": 18, "text": "\u8036 \u548c \u83ef \u537b \u5c0d \u6211 \u7236 \u5927 \u885b \u8aaa \uff1a \u4f60 \u7acb \u610f \u70ba \u6211 \u7684 \u540d \u5efa \u6bbf \uff0c \u9019 \u610f \u601d \u751a \u597d \u3002"}, {"pk": 566987, "verse": 19, "text": "\u53ea \u662f \u4f60 \u4e0d \u53ef \u5efa \u6bbf \uff0c \u60df \u4f60 \u6240 \u751f \u7684 \u5152 \u5b50 \u5fc5 \u70ba \u6211 \u540d \u5efa \u6bbf \u3002"}, {"pk": 566988, "verse": 20, "text": "\u73fe \u5728 \u8036 \u548c \u83ef \u6210 \u5c31 \u4e86 \u4ed6 \u6240 \u61c9 \u8a31 \u7684 \u8a71 \uff0c \u4f7f \u6211 \u63a5 \u7e8c \u6211 \u7236 \u5927 \u885b \u5750 \u4ee5 \u8272 \u5217 \u7684 \u570b \u4f4d \uff0c \u53c8 \u70ba \u8036 \u548c \u83ef \u2500 \u4ee5 \u8272 \u5217 \u3000 \u795e \u7684 \u540d \u5efa \u9020 \u4e86 \u6bbf \u3002"}, {"pk": 566989, "verse": 21, "text": "\u6211 \u4e5f \u5728 \u5176 \u4e2d \u70ba \u7d04 \u6ac3 \u9810 \u5099 \u4e00 \u8655 \u3002 \u7d04 \u6ac3 \u5167 \u6709 \u8036 \u548c \u83ef \u7684 \u7d04 \uff0c \u5c31 \u662f \u4ed6 \u9818 \u6211 \u5011 \u5217 \u7956 \u51fa \u57c3 \u53ca \u5730 \u7684 \u6642 \u5019 \uff0c \u8207 \u4ed6 \u5011 \u6240 \u7acb \u7684 \u7d04 \u3002"}, {"pk": 566990, "verse": 22, "text": "\u6240 \u7f85 \u9580 \u7576 \u8457 \u4ee5 \u8272 \u5217 \u6703 \u773e \uff0c \u7ad9 \u5728 \u8036 \u548c \u83ef \u7684 \u58c7 \u524d \uff0c \u5411 \u5929 \u8209 \u624b \u8aaa \uff1a"}, {"pk": 566991, "verse": 23, "text": "\u8036 \u548c \u83ef \u2500 \u4ee5 \u8272 \u5217 \u7684 \u3000 \u795e \u554a \uff0c \u5929 \u4e0a \u5730 \u4e0b \u6c92 \u6709 \u3000 \u795e \u53ef \u6bd4 \u4f60 \u7684 \uff01 \u4f60 \u5411 \u90a3 \u76e1 \u5fc3 \u884c \u5728 \u4f60 \u9762 \u524d \u7684 \u50d5 \u4eba \u5b88 \u7d04 \u65bd \u6148 \u611b \uff1b"}, {"pk": 566992, "verse": 24, "text": "\u5411 \u4f60 \u50d5 \u4eba \u2500 \u6211 \u7236 \u5927 \u885b \u6240 \u61c9 \u8a31 \u7684 \u8a71 \u73fe \u5728 \u61c9 \u9a57 \u4e86 \u3002 \u4f60 \u89aa \u53e3 \u61c9 \u8a31 \uff0c \u89aa \u624b \u6210 \u5c31 \uff0c \u6b63 \u5982 \u4eca \u65e5 \u4e00 \u6a23 \u3002"}, {"pk": 566993, "verse": 25, "text": "\u8036 \u548c \u83ef \u2500 \u4ee5 \u8272 \u5217 \u7684 \u3000 \u795e \u554a \uff0c \u4f60 \u6240 \u61c9 \u8a31 \u4f60 \u50d5 \u4eba \u2500 \u6211 \u7236 \u5927 \u885b \u7684 \u8a71 \u8aaa \uff1a \u4f60 \u7684 \u5b50 \u5b6b \u82e5 \u8b39 \u614e \u81ea \u5df1 \u7684 \u884c \u70ba \uff0c \u5728 \u6211 \u9762 \u524d \u884c \u4e8b \u50cf \u4f60 \u6240 \u884c \u7684 \u4e00 \u6a23 \uff0c \u5c31 \u4e0d \u65b7 \u4eba \u5750 \u4ee5 \u8272 \u5217 \u7684 \u570b \u4f4d \u3002 \u73fe \u5728 \u6c42 \u4f60 \u61c9 \u9a57 \u9019 \u8a71 \u3002"}, {"pk": 566994, "verse": 26, "text": "\u4ee5 \u8272 \u5217 \u7684 \u3000 \u795e \u554a \uff0c \u6c42 \u4f60 \u6210 \u5c31 \u5411 \u4f60 \u50d5 \u4eba \u2500 \u6211 \u7236 \u5927 \u885b \u6240 \u61c9 \u8a31 \u7684 \u8a71 \u3002"}, {"pk": 566995, "verse": 27, "text": "\u795e \u679c \u771f \u4f4f \u5728 \u5730 \u4e0a \u9ebc \uff1f \u770b \u54ea \uff0c \u5929 \u548c \u5929 \u4e0a \u7684 \u5929 \u5c1a \u4e14 \u4e0d \u8db3 \u4f60 \u5c45 \u4f4f \u7684 \uff0c \u4f55 \u6cc1 \u6211 \u6240 \u5efa \u7684 \u9019 \u6bbf \u5462 \uff1f"}, {"pk": 566996, "verse": 28, "text": "\u60df \u6c42 \u8036 \u548c \u83ef \u2500 \u6211 \u7684 \u3000 \u795e \u5782 \u9867 \u50d5 \u4eba \u7684 \u79b1 \u544a \u7948 \u6c42 \uff0c \u4fef \u807d \u50d5 \u4eba \u4eca \u65e5 \u5728 \u4f60 \u9762 \u524d \u7684 \u7948 \u79b1 \u547c \u7c72 \u3002"}, {"pk": 566997, "verse": 29, "text": "\u9858 \u4f60 \u665d \u591c \u770b \u9867 \u9019 \u6bbf \uff0c \u5c31 \u662f \u4f60 \u61c9 \u8a31 \u7acb \u70ba \u4f60 \u540d \u7684 \u5c45 \u6240 \uff1b \u6c42 \u4f60 \u5782 \u807d \u50d5 \u4eba \u5411 \u6b64 \u8655 \u79b1 \u544a \u7684 \u8a71 \u3002"}, {"pk": 566998, "verse": 30, "text": "\u4f60 \u50d5 \u4eba \u548c \u4f60 \u6c11 \u4ee5 \u8272 \u5217 \u5411 \u6b64 \u8655 \u7948 \u79b1 \u7684 \u6642 \u5019 \uff0c \u6c42 \u4f60 \u5728 \u5929 \u4e0a \u4f60 \u7684 \u5c45 \u6240 \u5782 \u807d \uff0c \u5782 \u807d \u800c \u8d66 \u514d \u3002"}, {"pk": 566999, "verse": 31, "text": "\u4eba \u82e5 \u5f97 \u7f6a \u9130 \u820d \uff0c \u6709 \u4eba \u53eb \u4ed6 \u8d77 \u8a93 \uff0c \u4ed6 \u4f86 \u5230 \u9019 \u6bbf \u5728 \u4f60 \u7684 \u58c7 \u524d \u8d77 \u8a93 \uff0c"}, {"pk": 567000, "verse": 32, "text": "\u6c42 \u4f60 \u5728 \u5929 \u4e0a \u5782 \u807d \uff0c \u5224 \u65b7 \u4f60 \u7684 \u50d5 \u4eba \uff1a \u5b9a \u60e1 \u4eba \u6709 \u7f6a \uff0c \u7167 \u4ed6 \u6240 \u884c \u7684 \u5831 \u61c9 \u5728 \u4ed6 \u982d \u4e0a \uff1b \u5b9a \u7fa9 \u4eba \u6709 \u7406 \uff0c \u7167 \u4ed6 \u7684 \u7fa9 \u8cde \u8cdc \u4ed6 \u3002"}, {"pk": 567001, "verse": 33, "text": "\u4f60 \u7684 \u6c11 \u4ee5 \u8272 \u5217 \u82e5 \u5f97 \u7f6a \u4f60 \uff0c \u6557 \u5728 \u4ec7 \u6575 \u9762 \u524d \uff0c \u53c8 \u6b78 \u5411 \u4f60 \uff0c \u627f \u8a8d \u4f60 \u7684 \u540d \uff0c \u5728 \u9019 \u6bbf \u88e1 \u7948 \u6c42 \u79b1 \u544a \uff0c"}, {"pk": 567002, "verse": 34, "text": "\u6c42 \u4f60 \u5728 \u5929 \u4e0a \u5782 \u807d \uff0c \u8d66 \u514d \u4f60 \u6c11 \u4ee5 \u8272 \u5217 \u7684 \u7f6a \uff0c \u4f7f \u4ed6 \u5011 \u6b78 \u56de \u4f60 \u8cdc \u7d66 \u4ed6 \u5011 \u5217 \u7956 \u4e4b \u5730 \u3002"}, {"pk": 567003, "verse": 35, "text": "\u4f60 \u7684 \u6c11 \u56e0 \u5f97 \u7f6a \u4f60 \uff0c \u4f60 \u61f2 \u7f70 \u4ed6 \u5011 \uff0c \u4f7f \u5929 \u9589 \u585e \u4e0d \u4e0b \u96e8 \uff1b \u4ed6 \u5011 \u82e5 \u5411 \u6b64 \u8655 \u79b1 \u544a \uff0c \u627f \u8a8d \u4f60 \u7684 \u540d \uff0c \u96e2 \u958b \u4ed6 \u5011 \u7684 \u7f6a \uff0c"}, {"pk": 567004, "verse": 36, "text": "\u6c42 \u4f60 \u5728 \u5929 \u4e0a \u5782 \u807d \uff0c \u8d66 \u514d \u4f60 \u50d5 \u4eba \u4ee5 \u8272 \u5217 \u6c11 \u7684 \u7f6a \uff0c \u5c07 \u7576 \u884c \u7684 \u5584 \u9053 \u6307 \u6559 \u4ed6 \u5011 \uff0c \u4e14 \u964d \u96e8 \u5728 \u4f60 \u7684 \u5730 \uff0c \u5c31 \u662f \u4f60 \u8cdc \u7d66 \u4f60 \u6c11 \u70ba \u696d \u4e4b \u5730 \u3002"}, {"pk": 567005, "verse": 37, "text": "\u570b \u4e2d \u82e5 \u6709 \u9951 \u8352 \u3001 \u761f \u75ab \u3001 \u65f1 \u98a8 \u3001 \u9709 \u721b \u3001 \u8757 \u87f2 \u3001 \u879e \u86b1 \uff0c \u6216 \u6709 \u4ec7 \u6575 \u72af \u5883 \u570d \u56f0 \u57ce \u9091 \uff0c \u7121 \u8ad6 \u906d \u9047 \u751a \u9ebc \u707d \u798d \u75be \u75c5 \uff0c"}, {"pk": 567006, "verse": 38, "text": "\u4f60 \u7684 \u6c11 \u4ee5 \u8272 \u5217 \uff0c \u6216 \u662f \u773e \u4eba \uff0c \u6216 \u662f \u4e00 \u4eba \uff0c \u81ea \u89ba \u6709 \u7f6a ( \u539f \u6587 \u4f5c \u707d ) \uff0c \u5411 \u9019 \u6bbf \u8209 \u624b \uff0c \u7121 \u8ad6 \u7948 \u6c42 \u751a \u9ebc \uff0c \u79b1 \u544a \u751a \u9ebc \uff0c"}, {"pk": 567007, "verse": 39, "text": "\u6c42 \u4f60 \u5728 \u5929 \u4e0a \u4f60 \u7684 \u5c45 \u6240 \u5782 \u807d \u8d66 \u514d \u3002 \u4f60 \u662f \u77e5 \u9053 \u4eba \u5fc3 \u7684 \uff0c \u8981 \u7167 \u5404 \u4eba \u6240 \u884c \u7684 \u5f85 \u4ed6 \u5011 \uff08 \u60df \u6709 \u4f60 \u77e5 \u9053 \u4e16 \u4eba \u7684 \u5fc3 \uff09 \uff0c"}, {"pk": 567008, "verse": 40, "text": "\u4f7f \u4ed6 \u5011 \u5728 \u4f60 \u8cdc \u7d66 \u6211 \u5011 \u5217 \u7956 \u4e4b \u5730 \u4e0a \u4e00 \u751f \u4e00 \u4e16 \u656c \u754f \u4f60 \u3002"}, {"pk": 567009, "verse": 41, "text": "\u8ad6 \u5230 \u4e0d \u5c6c \u4f60 \u6c11 \u4ee5 \u8272 \u5217 \u7684 \u5916 \u90a6 \u4eba \uff0c \u70ba \u4f60 \u540d \u5f9e \u9060 \u65b9 \u800c \u4f86 \uff0c"}, {"pk": 567010, "verse": 42, "text": "\uff08 \u4ed6 \u5011 \u807d \u4eba \u8ad6 \u8aaa \u4f60 \u7684 \u5927 \u540d \u548c \u5927 \u80fd \u7684 \u624b \uff0c \u4e26 \u4f38 \u51fa \u4f86 \u7684 \u8180 \u81c2 \uff09 \u5411 \u9019 \u6bbf \u79b1 \u544a \uff0c"}, {"pk": 567011, "verse": 43, "text": "\u6c42 \u4f60 \u5728 \u5929 \u4e0a \u4f60 \u7684 \u5c45 \u6240 \u5782 \u807d \uff0c \u7167 \u8457 \u5916 \u90a6 \u4eba \u6240 \u7948 \u6c42 \u7684 \u800c \u884c \uff0c \u4f7f \u5929 \u4e0b \u842c \u6c11 \u90fd \u8a8d \u8b58 \u4f60 \u7684 \u540d \uff0c \u656c \u754f \u4f60 \u50cf \u4f60 \u7684 \u6c11 \u4ee5 \u8272 \u5217 \u4e00 \u6a23 \uff1b \u53c8 \u4f7f \u4ed6 \u5011 \u77e5 \u9053 \u6211 \u5efa \u9020 \u7684 \u9019 \u6bbf \u662f \u7a31 \u70ba \u4f60 \u540d \u4e0b \u7684 \u3002"}, {"pk": 567012, "verse": 44, "text": "\u4f60 \u7684 \u6c11 \u82e5 \u5949 \u4f60 \u7684 \u5dee \u9063 \uff0c \u7121 \u8ad6 \u5f80 \u4f55 \u8655 \u53bb \u8207 \u4ec7 \u6575 \u722d \u6230 \uff0c \u5411 \u8036 \u548c \u83ef \u6240 \u9078 \u64c7 \u7684 \u57ce \u8207 \u6211 \u70ba \u4f60 \u540d \u6240 \u5efa \u9020 \u7684 \u6bbf \u79b1 \u544a \uff0c"}, {"pk": 567013, "verse": 45, "text": "\u6c42 \u4f60 \u5728 \u5929 \u4e0a \u5782 \u807d \u4ed6 \u5011 \u7684 \u79b1 \u544a \u7948 \u6c42 \uff0c \u4f7f \u4ed6 \u5011 \u5f97 \u52dd \u3002"}, {"pk": 567014, "verse": 46, "text": "\u4f60 \u7684 \u6c11 \u82e5 \u5f97 \u7f6a \u4f60 \uff08 \u4e16 \u4e0a \u6c92 \u6709 \u4e0d \u72af \u7f6a \u7684 \u4eba \uff09 \uff0c \u4f60 \u5411 \u4ed6 \u5011 \u767c \u6012 \uff0c \u5c07 \u4ed6 \u5011 \u4ea4 \u7d66 \u4ec7 \u6575 \u64c4 \u5230 \u4ec7 \u6575 \u4e4b \u5730 \uff0c \u6216 \u9060 \u6216 \u8fd1 \uff0c"}, {"pk": 567015, "verse": 47, "text": "\u4ed6 \u5011 \u82e5 \u5728 \u64c4 \u5230 \u4e4b \u5730 \u60f3 \u8d77 \u7f6a \u4f86 \uff0c \u56de \u5fc3 \u8f49 \u610f \uff0c \u61c7 \u6c42 \u4f60 \u8aaa \uff1a \u6211 \u5011 \u6709 \u7f6a \u4e86 \uff0c \u6211 \u5011 \u6096 \u9006 \u4e86 \uff0c \u6211 \u5011 \u4f5c \u60e1 \u4e86 \uff1b"}, {"pk": 567016, "verse": 48, "text": "\u4ed6 \u5011 \u82e5 \u5728 \u64c4 \u5230 \u4e4b \u5730 \u76e1 \u5fc3 \u76e1 \u6027 \u6b78 \u670d \u4f60 \uff0c \u53c8 \u5411 \u81ea \u5df1 \u7684 \u5730 \uff0c \u5c31 \u662f \u4f60 \u8cdc \u7d66 \u4ed6 \u5011 \u5217 \u7956 \u4e4b \u5730 \u548c \u4f60 \u6240 \u9078 \u64c7 \u7684 \u57ce \uff0c \u4e26 \u6211 \u70ba \u4f60 \u540d \u6240 \u5efa \u9020 \u7684 \u6bbf \u79b1 \u544a \uff0c"}, {"pk": 567017, "verse": 49, "text": "\u6c42 \u4f60 \u5728 \u5929 \u4e0a \u4f60 \u7684 \u5c45 \u6240 \u5782 \u807d \u4ed6 \u5011 \u7684 \u79b1 \u544a \u7948 \u6c42 \uff0c \u70ba \u4ed6 \u5011 \u4f38 \u51a4 \uff1b"}, {"pk": 567018, "verse": 50, "text": "\u9952 \u6055 \u5f97 \u7f6a \u4f60 \u7684 \u6c11 \uff0c \u8d66 \u514d \u4ed6 \u5011 \u7684 \u4e00 \u5207 \u904e \u72af \uff0c \u4f7f \u4ed6 \u5011 \u5728 \u64c4 \u4ed6 \u5011 \u7684 \u4eba \u9762 \u524d \u8499 \u6190 \u6064 \u3002"}, {"pk": 567019, "verse": 51, "text": "\u56e0 \u70ba \u4ed6 \u5011 \u662f \u4f60 \u7684 \u5b50 \u6c11 \uff0c \u4f60 \u7684 \u7522 \u696d \uff0c \u662f \u4f60 \u5f9e \u57c3 \u53ca \u9818 \u51fa \u4f86 \u812b \u96e2 \u9435 \u7210 \u7684 \u3002"}, {"pk": 567020, "verse": 52, "text": "\u9858 \u4f60 \u7684 \u773c \u76ee \u770b \u9867 \u50d5 \u4eba \uff0c \u807d \u4f60 \u6c11 \u4ee5 \u8272 \u5217 \u7684 \u7948 \u6c42 \uff0c \u7121 \u8ad6 \u4f55 \u6642 \u5411 \u4f60 \u7948 \u6c42 \uff0c \u9858 \u4f60 \u5782 \u807d \u3002"}, {"pk": 567021, "verse": 53, "text": "\u4e3b \u8036 \u548c \u83ef \u554a \uff0c \u4f60 \u5c07 \u4ed6 \u5011 \u5f9e \u5730 \u4e0a \u7684 \u842c \u6c11 \u4e2d \u5206 \u5225 \u51fa \u4f86 \u4f5c \u4f60 \u7684 \u7522 \u696d \uff0c \u662f \u7167 \u4f60 \u9818 \u6211 \u5011 \u5217 \u7956 \u51fa \u57c3 \u53ca \u7684 \u6642 \u5019 \uff0c \u85c9 \u4f60 \u50d5 \u4eba \u6469 \u897f \u6240 \u61c9 \u8a31 \u7684 \u8a71 \u3002"}, {"pk": 567022, "verse": 54, "text": "\u6240 \u7f85 \u9580 \u5728 \u8036 \u548c \u83ef \u7684 \u58c7 \u524d \u5c48 \u819d \u8dea \u8457 \uff0c \u5411 \u5929 \u8209 \u624b \uff0c \u5728 \u8036 \u548c \u83ef \u9762 \u524d \u79b1 \u544a \u7948 \u6c42 \u5df2 \u7562 \uff0c \u5c31 \u8d77 \u4f86 \uff0c"}, {"pk": 567023, "verse": 55, "text": "\u7ad9 \u8457 \uff0c \u5927 \u8072 \u70ba \u4ee5 \u8272 \u5217 \u5168 \u6703 \u773e \u795d \u798f \uff0c \u8aaa \uff1a"}, {"pk": 567024, "verse": 56, "text": "\u8036 \u548c \u83ef \u662f \u61c9 \u7576 \u7a31 \u980c \u7684 \uff01 \u56e0 \u70ba \u4ed6 \u7167 \u8457 \u4e00 \u5207 \u6240 \u61c9 \u8a31 \u7684 \u8cdc \u5e73 \u5b89 \u7d66 \u4ed6 \u7684 \u6c11 \u4ee5 \u8272 \u5217 \u4eba \uff0c \u51e1 \u85c9 \u4ed6 \u50d5 \u4eba \u6469 \u897f \u61c9 \u8a31 \u8cdc \u798f \u7684 \u8a71 \uff0c \u4e00 \u53e5 \u90fd \u6c92 \u6709 \u843d \u7a7a \u3002"}, {"pk": 567025, "verse": 57, "text": "\u9858 \u8036 \u548c \u83ef \u2500 \u6211 \u5011 \u7684 \u3000 \u795e \u8207 \u6211 \u5011 \u540c \u5728 \uff0c \u50cf \u8207 \u6211 \u5011 \u5217 \u7956 \u540c \u5728 \u4e00 \u6a23 \uff0c \u4e0d \u6487 \u4e0b \u6211 \u5011 \uff0c \u4e0d \u4e1f \u68c4 \u6211 \u5011 \uff0c"}, {"pk": 567026, "verse": 58, "text": "\u4f7f \u6211 \u5011 \u7684 \u5fc3 \u6b78 \u5411 \u4ed6 \uff0c \u9075 \u884c \u4ed6 \u7684 \u9053 \uff0c \u8b39 \u5b88 \u4ed6 \u5429 \u5490 \u6211 \u5011 \u5217 \u7956 \u7684 \u8aa1 \u547d \u3001 \u5f8b \u4f8b \u3001 \u5178 \u7ae0 \u3002"}, {"pk": 567027, "verse": 59, "text": "\u6211 \u5728 \u8036 \u548c \u83ef \u9762 \u524d \u7948 \u6c42 \u7684 \u9019 \u4e9b \u8a71 \uff0c \u9858 \u8036 \u548c \u83ef \u2500 \u6211 \u5011 \u7684 \u3000 \u795e \u665d \u591c \u5782 \u5ff5 \uff0c \u6bcf \u65e5 \u70ba \u4ed6 \u50d5 \u4eba \u8207 \u4ed6 \u6c11 \u4ee5 \u8272 \u5217 \u4f38 \u51a4 \uff0c"}, {"pk": 567028, "verse": 60, "text": "\u4f7f \u5730 \u4e0a \u7684 \u842c \u6c11 \u90fd \u77e5 \u9053 \u60df \u7368 \u8036 \u548c \u83ef \u662f \u3000 \u795e \uff0c \u4e26 \u7121 \u5225 \u795e \u3002"}, {"pk": 567029, "verse": 61, "text": "\u6240 \u4ee5 \u4f60 \u5011 \u7576 \u5411 \u8036 \u548c \u83ef \u2500 \u6211 \u5011 \u7684 \u3000 \u795e \u5b58 \u8aa0 \u5be6 \u7684 \u5fc3 \uff0c \u9075 \u884c \u4ed6 \u7684 \u5f8b \u4f8b \uff0c \u8b39 \u5b88 \u4ed6 \u7684 \u8aa1 \u547d \uff0c \u81f3 \u7d42 \u5982 \u4eca \u65e5 \u4e00 \u6a23 \u3002"}, {"pk": 567030, "verse": 62, "text": "\u738b \u548c \u4ee5 \u8272 \u5217 \u773e \u6c11 \u4e00 \u540c \u5728 \u8036 \u548c \u83ef \u9762 \u524d \u737b \u796d \u3002"}, {"pk": 567031, "verse": 63, "text": "\u6240 \u7f85 \u9580 \u5411 \u8036 \u548c \u83ef \u737b \u5e73 \u5b89 \u796d \uff0c \u7528 \u725b \u4e8c \u842c \u4e8c \u5343 \uff0c \u7f8a \u5341 \u4e8c \u842c \u3002 \u9019 \u6a23 \uff0c \u738b \u548c \u4ee5 \u8272 \u5217 \u773e \u6c11 \u70ba \u8036 \u548c \u83ef \u7684 \u6bbf \u884c \u5949 \u737b \u4e4b \u79ae \u3002"}, {"pk": 567032, "verse": 64, "text": "\u7576 \u65e5 \uff0c \u738b \u56e0 \u8036 \u548c \u83ef \u6bbf \u524d \u7684 \u9285 \u58c7 \u592a \u5c0f \uff0c \u5bb9 \u4e0d \u4e0b \u71d4 \u796d \u3001 \u7d20 \u796d \uff0c \u548c \u5e73 \u5b89 \u796d \u7272 \u7684 \u8102 \u6cb9 \uff0c \u4fbf \u5c07 \u8036 \u548c \u83ef \u6bbf \u524d \u9662 \u5b50 \u7576 \u4e2d \u5206 \u5225 \u70ba \u8056 \uff0c \u5728 \u90a3 \u88e1 \u737b \u71d4 \u796d \u3001 \u7d20 \u796d \uff0c \u548c \u5e73 \u5b89 \u796d \u7272 \u7684 \u8102 \u6cb9 \u3002"}, {"pk": 567033, "verse": 65, "text": "\u90a3 \u6642 \uff0c \u6240 \u7f85 \u9580 \u548c \u4ee5 \u8272 \u5217 \u773e \u4eba \uff0c \u5c31 \u662f \u5f9e \u54c8 \u99ac \u53e3 \u76f4 \u5230 \u57c3 \u53ca \u5c0f \u6cb3 \u6240 \u6709 \u7684 \u4ee5 \u8272 \u5217 \u4eba \uff0c \u90fd \u805a \u96c6 \u6210 \u70ba \u5927 \u6703 \uff0c \u5728 \u8036 \u548c \u83ef \u2500 \u6211 \u5011 \u7684 \u3000 \u795e \u9762 \u524d \u5b88 \u7bc0 \u4e03 \u65e5 \u53c8 \u4e03 \u65e5 \uff0c \u5171 \u5341 \u56db \u65e5 \u3002"}, {"pk": 567034, "verse": 66, "text": "\u7b2c \u516b \u65e5 \uff0c \u738b \u9063 \u6563 \u773e \u6c11 \uff1b \u4ed6 \u5011 \u90fd \u70ba \u738b \u795d \u798f \u3002 \u56e0 \u898b \u8036 \u548c \u83ef \u5411 \u4ed6 \u50d5 \u4eba \u5927 \u885b \u548c \u4ed6 \u6c11 \u4ee5 \u8272 \u5217 \u6240 \u65bd \u7684 \u4e00 \u5207 \u6069 \u60e0 \uff0c \u5c31 \u90fd \u5fc3 \u4e2d \u559c \u6a02 \uff0c \u5404 \u6b78 \u5404 \u5bb6 \u53bb \u4e86 \u3002"}]