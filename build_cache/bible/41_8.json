[{"pk": 582484, "verse": 1, "text": "\u90a3 \u6642 \uff0c \u53c8 \u6709 \u8a31 \u591a \u4eba \u805a \u96c6 \uff0c \u4e26 \u6c92 \u6709 \u751a \u9ebc \u5403 \u7684 \u3002 \u8036 \u7a4c \u53eb \u9580 \u5f92 \u4f86 \uff0c \u8aaa \uff1a"}, {"pk": 582485, "verse": 2, "text": "\u6211 \u6190 \u61ab \u9019 \u773e \u4eba \uff1b \u56e0 \u70ba \u4ed6 \u5011 \u540c \u6211 \u5728 \u9019 \u88e1 \u5df2 \u7d93 \u4e09 \u5929 \uff0c \u4e5f \u6c92 \u6709 \u5403 \u7684 \u4e86 \u3002"}, {"pk": 582486, "verse": 3, "text": "\u6211 \u82e5 \u6253 \u767c \u4ed6 \u5011 \u9913 \u8457 \u56de \u5bb6 \uff0c \u5c31 \u5fc5 \u5728 \u8def \u4e0a \u56f0 \u4e4f \uff0c \u56e0 \u70ba \u5176 \u4e2d \u6709 \u5f9e \u9060 \u8655 \u4f86 \u7684 \u3002"}, {"pk": 582487, "verse": 4, "text": "\u9580 \u5f92 \u56de \u7b54 \u8aaa \uff1a \u5728 \u9019 \u91ce \u5730 \uff0c \u5f9e \u90a3 \u88e1 \u80fd \u5f97 \u9905 \uff0c \u53eb \u9019 \u4e9b \u4eba \u5403 \u98fd \u5462 \uff1f"}, {"pk": 582488, "verse": 5, "text": "\u8036 \u7a4c \u554f \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u6709 \u591a \u5c11 \u9905 \uff1f \u4ed6 \u5011 \u8aaa \uff1a \u4e03 \u500b \u3002"}, {"pk": 582489, "verse": 6, "text": "\u4ed6 \u5429 \u5490 \u773e \u4eba \u5750 \u5728 \u5730 \u4e0a \uff0c \u5c31 \u62ff \u8457 \u9019 \u4e03 \u500b \u9905 \u795d \u8b1d \u4e86 \uff0c \u64d8 \u958b \uff0c \u905e \u7d66 \u9580 \u5f92 \uff0c \u53eb \u4ed6 \u5011 \u64fa \u958b \uff0c \u9580 \u5f92 \u5c31 \u64fa \u5728 \u773e \u4eba \u9762 \u524d \u3002"}, {"pk": 582490, "verse": 7, "text": "\u53c8 \u6709 \u5e7e \u689d \u5c0f \u9b5a \uff1b \u8036 \u7a4c \u795d \u4e86 \u798f \uff0c \u5c31 \u5429 \u5490 \u4e5f \u64fa \u5728 \u773e \u4eba \u9762 \u524d \u3002"}, {"pk": 582491, "verse": 8, "text": "\u773e \u4eba \u90fd \u5403 \uff0c \u4e26 \u4e14 \u5403 \u98fd \u4e86 \uff0c \u6536 \u62fe \u5269 \u4e0b \u7684 \u96f6 \u788e \uff0c \u6709 \u4e03 \u7b50 \u5b50 \u3002"}, {"pk": 582492, "verse": 9, "text": "\u4eba \u6578 \u7d04 \u6709 \u56db \u5343 \u3002 \u8036 \u7a4c \u6253 \u767c \u4ed6 \u5011 \u8d70 \u4e86 \uff0c"}, {"pk": 582493, "verse": 10, "text": "\u96a8 \u5373 \u540c \u9580 \u5f92 \u4e0a \u8239 \uff0c \u4f86 \u5230 \u5927 \u746a \u52aa \u4ed6 \u5883 \u5167 \u3002"}, {"pk": 582494, "verse": 11, "text": "\u6cd5 \u5229 \u8cfd \u4eba \u51fa \u4f86 \u76e4 \u554f \u8036 \u7a4c \uff0c \u6c42 \u4ed6 \u5f9e \u5929 \u4e0a \u986f \u500b \u795e \u8e5f \u7d66 \u4ed6 \u5011 \u770b \uff0c \u60f3 \u8981 \u8a66 \u63a2 \u4ed6 \u3002"}, {"pk": 582495, "verse": 12, "text": "\u8036 \u7a4c \u5fc3 \u88e1 \u6df1 \u6df1 \u7684 \u6b4e \u606f \uff0c \u8aaa \uff1a \u9019 \u4e16 \u4ee3 \u70ba \u751a \u9ebc \u6c42 \u795e \u8e5f \u5462 \uff1f \u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u6c92 \u6709 \u795e \u8e5f \u7d66 \u9019 \u4e16 \u4ee3 \u770b \u3002"}, {"pk": 582496, "verse": 13, "text": "\u4ed6 \u5c31 \u96e2 \u958b \u4ed6 \u5011 \uff0c \u53c8 \u4e0a \u8239 \u5f80 \u6d77 \u90a3 \u908a \u53bb \u4e86 \u3002"}, {"pk": 582497, "verse": 14, "text": "\u9580 \u5f92 \u5fd8 \u4e86 \u5e36 \u9905 \uff1b \u5728 \u8239 \u4e0a \u9664 \u4e86 \u4e00 \u500b \u9905 \uff0c \u6c92 \u6709 \u5225 \u7684 \u98df \u7269 \u3002"}, {"pk": 582498, "verse": 15, "text": "\u8036 \u7a4c \u56d1 \u5490 \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u8981 \u8b39 \u614e \uff0c \u9632 \u5099 \u6cd5 \u5229 \u8cfd \u4eba \u7684 \u9175 \u548c \u5e0c \u5f8b \u7684 \u9175 \u3002"}, {"pk": 582499, "verse": 16, "text": "\u4ed6 \u5011 \u5f7c \u6b64 \u8b70 \u8ad6 \u8aaa \uff1a \u9019 \u662f \u56e0 \u70ba \u6211 \u5011 \u6c92 \u6709 \u9905 \u7f77 \u3002"}, {"pk": 582500, "verse": 17, "text": "\u8036 \u7a4c \u770b \u51fa \u4f86 \uff0c \u5c31 \u8aaa \uff1a \u4f60 \u5011 \u70ba \u751a \u9ebc \u56e0 \u70ba \u6c92 \u6709 \u9905 \u5c31 \u8b70 \u8ad6 \u5462 \uff1f \u4f60 \u5011 \u9084 \u4e0d \u7701 \u609f \uff0c \u9084 \u4e0d \u660e \u767d \u9ebc \uff1f \u4f60 \u5011 \u7684 \u5fc3 \u9084 \u662f \u611a \u9811 \u9ebc \uff1f"}, {"pk": 582501, "verse": 18, "text": "\u4f60 \u5011 \u6709 \u773c \u775b \uff0c \u770b \u4e0d \u898b \u9ebc \uff1f \u6709 \u8033 \u6735 \uff0c \u807d \u4e0d \u898b \u9ebc \uff1f \u4e5f \u4e0d \u8a18 \u5f97 \u9ebc \uff1f"}, {"pk": 582502, "verse": 19, "text": "\u6211 \u64d8 \u958b \u90a3 \u4e94 \u500b \u9905 \u5206 \u7d66 \u4e94 \u5343 \u4eba \uff0c \u4f60 \u5011 \u6536 \u62fe \u7684 \u96f6 \u788e \u88dd \u6eff \u4e86 \u591a \u5c11 \u7c43 \u5b50 \u5462 \uff1f \u4ed6 \u5011 \u8aaa \uff1a \u5341 \u4e8c \u500b \u3002"}, {"pk": 582503, "verse": 20, "text": "\u53c8 \u64d8 \u958b \u90a3 \u4e03 \u500b \u9905 \u5206 \u7d66 \u56db \u5343 \u4eba \uff0c \u4f60 \u5011 \u6536 \u62fe \u7684 \u96f6 \u788e \u88dd \u6eff \u4e86 \u591a \u5c11 \u7b50 \u5b50 \u5462 \uff1f \u4ed6 \u5011 \u8aaa \uff1a \u4e03 \u500b \u3002"}, {"pk": 582504, "verse": 21, "text": "\u8036 \u7a4c \u8aaa \uff1a \u4f60 \u5011 \u9084 \u662f \u4e0d \u660e \u767d \u9ebc \uff1f"}, {"pk": 582505, "verse": 22, "text": "\u4ed6 \u5011 \u4f86 \u5230 \u4f2f \u8cfd \u5927 \uff0c \u6709 \u4eba \u5e36 \u4e00 \u500b \u778e \u5b50 \u4f86 \uff0c \u6c42 \u8036 \u7a4c \u6478 \u4ed6 \u3002"}, {"pk": 582506, "verse": 23, "text": "\u8036 \u7a4c \u62c9 \u8457 \u778e \u5b50 \u7684 \u624b \uff0c \u9818 \u4ed6 \u5230 \u6751 \u5916 \uff0c \u5c31 \u5410 \u553e \u6cab \u5728 \u4ed6 \u773c \u775b \u4e0a \uff0c \u6309 \u624b \u5728 \u4ed6 \u8eab \u4e0a \uff0c \u554f \u4ed6 \u8aaa \uff1a \u4f60 \u770b \u898b \u751a \u9ebc \u4e86 \uff1f"}, {"pk": 582507, "verse": 24, "text": "\u4ed6 \u5c31 \u62ac \u982d \u4e00 \u770b \uff0c \u8aaa \uff1a \u6211 \u770b \u898b \u4eba \u4e86 \uff1b \u4ed6 \u5011 \u597d \u50cf \u6a39 \u6728 \uff0c \u4e26 \u4e14 \u884c \u8d70 \u3002"}, {"pk": 582508, "verse": 25, "text": "\u96a8 \u5f8c \u53c8 \u6309 \u624b \u5728 \u4ed6 \u773c \u775b \u4e0a \uff0c \u4ed6 \u5b9a \u775b \u4e00 \u770b \uff0c \u5c31 \u5fa9 \u4e86 \u539f \uff0c \u6a23 \u6a23 \u90fd \u770b \u5f97 \u6e05 \u695a \u4e86 \u3002"}, {"pk": 582509, "verse": 26, "text": "\u8036 \u7a4c \u6253 \u767c \u4ed6 \u56de \u5bb6 \uff0c \u8aaa \uff1a \u9023 \u9019 \u6751 \u5b50 \u4f60 \u4e5f \u4e0d \u8981 \u9032 \u53bb \u3002"}, {"pk": 582510, "verse": 27, "text": "\u8036 \u7a4c \u548c \u9580 \u5f92 \u51fa \u53bb \uff0c \u5f80 \u8a72 \u6492 \u5229 \u4e9e \u8153 \u7acb \u6bd4 \u7684 \u6751 \u838a \u53bb \uff1b \u5728 \u8def \u4e0a \u554f \u9580 \u5f92 \u8aaa \uff1a \u4eba \u8aaa \u6211 \u662f \u8ab0 \uff1f"}, {"pk": 582511, "verse": 28, "text": "\u4ed6 \u5011 \u8aaa \uff1a \u6709 \u4eba \u8aaa \u662f \u65bd \u6d17 \u7684 \u7d04 \u7ff0 \uff1b \u6709 \u4eba \u8aaa \u662f \u4ee5 \u5229 \u4e9e \uff1b \u53c8 \u6709 \u4eba \u8aaa \u662f \u5148 \u77e5 \u88e1 \u7684 \u4e00 \u4f4d \u3002"}, {"pk": 582512, "verse": 29, "text": "\u53c8 \u554f \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u8aaa \u6211 \u662f \u8ab0 \uff1f \u5f7c \u5f97 \u56de \u7b54 \u8aaa \uff1a \u4f60 \u662f \u57fa \u7763 \u3002"}, {"pk": 582513, "verse": 30, "text": "\u8036 \u7a4c \u5c31 \u7981 \u6212 \u4ed6 \u5011 \uff0c \u4e0d \u8981 \u544a \u8a34 \u4eba \u3002"}, {"pk": 582514, "verse": 31, "text": "\u5f9e \u6b64 \uff0c \u4ed6 \u6559 \u8a13 \u4ed6 \u5011 \u8aaa \uff1a \u4eba \u5b50 \u5fc5 \u9808 \u53d7 \u8a31 \u591a \u7684 \u82e6 \uff0c \u88ab \u9577 \u8001 \u3001 \u796d \u53f8 \u9577 \uff0c \u548c \u6587 \u58eb \u68c4 \u7d55 \uff0c \u4e26 \u4e14 \u88ab \u6bba \uff0c \u904e \u4e09 \u5929 \u5fa9 \u6d3b \u3002"}, {"pk": 582515, "verse": 32, "text": "\u8036 \u7a4c \u660e \u660e \u7684 \u8aaa \u9019 \u8a71 \uff0c \u5f7c \u5f97 \u5c31 \u62c9 \u8457 \u4ed6 \uff0c \u52f8 \u4ed6 \u3002"}, {"pk": 582516, "verse": 33, "text": "\u8036 \u7a4c \u8f49 \u904e \u4f86 \uff0c \u770b \u8457 \u9580 \u5f92 \uff0c \u5c31 \u8cac \u5099 \u5f7c \u5f97 \u8aaa \uff1a \u6492 \u4f46 \uff0c \u9000 \u6211 \u5f8c \u908a \u53bb \u7f77 \uff01 \u56e0 \u70ba \u4f60 \u4e0d \u9ad4 \u8cbc \u795e \u7684 \u610f \u601d \uff0c \u53ea \u9ad4 \u8cbc \u4eba \u7684 \u610f \u601d \u3002"}, {"pk": 582517, "verse": 34, "text": "\u65bc \u662f \u53eb \u773e \u4eba \u548c \u9580 \u5f92 \u4f86 \uff0c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u82e5 \u6709 \u4eba \u8981 \u8ddf \u5f9e \u6211 \uff0c \u5c31 \u7576 \u6368 \u5df1 \uff0c \u80cc \u8d77 \u4ed6 \u7684 \u5341 \u5b57 \u67b6 \u4f86 \u8ddf \u5f9e \u6211 \u3002"}, {"pk": 582518, "verse": 35, "text": "\u56e0 \u70ba \uff0c \u51e1 \u8981 \u6551 \u81ea \u5df1 \u751f \u547d \uff08 \u6216 \u4f5c \uff1a \u9748 \u9b42 \uff1b \u4e0b \u540c \uff09 \u7684 \uff0c \u5fc5 \u55aa \u6389 \u751f \u547d \uff1b \u51e1 \u70ba \u6211 \u548c \u798f \u97f3 \u55aa \u6389 \u751f \u547d \u7684 \uff0c \u5fc5 \u6551 \u4e86 \u751f \u547d \u3002"}, {"pk": 582519, "verse": 36, "text": "\u4eba \u5c31 \u662f \u8cfa \u5f97 \u5168 \u4e16 \u754c \uff0c \u8ce0 \u4e0a \u81ea \u5df1 \u7684 \u751f \u547d \uff0c \u6709 \u751a \u9ebc \u76ca \u8655 \u5462 \uff1f"}, {"pk": 582520, "verse": 37, "text": "\u4eba \u9084 \u80fd \u62ff \u751a \u9ebc \u63db \u751f \u547d \u5462 \uff1f"}, {"pk": 582521, "verse": 38, "text": "\u51e1 \u5728 \u9019 \u6deb \u4e82 \u7f6a \u60e1 \u7684 \u4e16 \u4ee3 \uff0c \u628a \u6211 \u548c \u6211 \u7684 \u9053 \u7576 \u4f5c \u53ef \u6065 \u7684 \uff0c \u4eba \u5b50 \u5728 \u4ed6 \u7236 \u7684 \u69ae \u8000 \u88e1 \uff0c \u540c \u8056 \u5929 \u4f7f \u964d \u81e8 \u7684 \u6642 \u5019 \uff0c \u4e5f \u8981 \u628a \u90a3 \u4eba \u7576 \u4f5c \u53ef \u6065 \u7684 \u3002"}]