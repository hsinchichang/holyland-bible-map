[{"pk": 574094, "verse": 1, "text": "\uff08 \u4e0a \u884c \u4e4b \u8a69 \u3002 \uff09 \u501a \u9760 \u8036 \u548c \u83ef \u7684 \u4eba \u597d \u50cf \u932b \u5b89 \u5c71 \uff0c \u6c38 \u4e0d \u52d5 \u6416 \u3002"}, {"pk": 574095, "verse": 2, "text": "\u773e \u5c71 \u600e \u6a23 \u570d \u7e5e \u8036 \u8def \u6492 \u51b7 \uff0c \u8036 \u548c \u83ef \u4e5f \u7167 \u6a23 \u570d \u7e5e \u4ed6 \u7684 \u767e \u59d3 \uff0c \u5f9e \u4eca \u6642 \u76f4 \u5230 \u6c38 \u9060 \u3002"}, {"pk": 574096, "verse": 3, "text": "\u60e1 \u4eba \u7684 \u6756 \u4e0d \u5e38 \u843d \u5728 \u7fa9 \u4eba \u7684 \u5206 \u4e0a \uff0c \u514d \u5f97 \u7fa9 \u4eba \u4f38 \u624b \u4f5c \u60e1 \u3002"}, {"pk": 574097, "verse": 4, "text": "\u8036 \u548c \u83ef \u554a \uff0c \u6c42 \u4f60 \u5584 \u5f85 \u90a3 \u4e9b \u70ba \u5584 \u548c \u5fc3 \u88e1 \u6b63 \u76f4 \u7684 \u4eba \u3002"}, {"pk": 574098, "verse": 5, "text": "\u81f3 \u65bc \u90a3 \u504f \u884c \u5f4e \u66f2 \u9053 \u8def \u7684 \u4eba \uff0c \u8036 \u548c \u83ef \u5fc5 \u4f7f \u4ed6 \u548c \u4f5c \u60e1 \u7684 \u4eba \u4e00 \u540c \u51fa \u53bb \u53d7 \u5211 \u3002 \u9858 \u5e73 \u5b89 \u6b78 \u65bc \u4ee5 \u8272 \u5217 \uff01"}]