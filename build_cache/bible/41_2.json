[{"pk": 582244, "verse": 1, "text": "\u904e \u4e86 \u4e9b \u65e5 \u5b50 \uff0c \u8036 \u7a4c \u53c8 \u9032 \u4e86 \u8fe6 \u767e \u8fb2 \u3002 \u4eba \u807d \u898b \u4ed6 \u5728 \u623f \u5b50 \u88e1 \uff0c"}, {"pk": 582245, "verse": 2, "text": "\u5c31 \u6709 \u8a31 \u591a \u4eba \u805a \u96c6 \uff0c \u751a \u81f3 \u9023 \u9580 \u524d \u90fd \u6c92 \u6709 \u7a7a \u5730 \uff1b \u8036 \u7a4c \u5c31 \u5c0d \u4ed6 \u5011 \u8b1b \u9053 \u3002"}, {"pk": 582246, "verse": 3, "text": "\u6709 \u4eba \u5e36 \u8457 \u4e00 \u500b \u7671 \u5b50 \u4f86 \u898b \u8036 \u7a4c \uff0c \u662f \u7528 \u56db \u500b \u4eba \u62ac \u4f86 \u7684 \uff1b"}, {"pk": 582247, "verse": 4, "text": "\u56e0 \u70ba \u4eba \u591a \uff0c \u4e0d \u5f97 \u8fd1 \u524d \uff0c \u5c31 \u628a \u8036 \u7a4c \u6240 \u5728 \u7684 \u623f \u5b50 \uff0c \u62c6 \u4e86 \u623f \u9802 \uff0c \u65e2 \u62c6 \u901a \u4e86 \uff0c \u5c31 \u628a \u7671 \u5b50 \u9023 \u6240 \u8eba \u81e5 \u7684 \u8925 \u5b50 \u90fd \u7e0b \u4e0b \u4f86 \u3002"}, {"pk": 582248, "verse": 5, "text": "\u8036 \u7a4c \u898b \u4ed6 \u5011 \u7684 \u4fe1 \u5fc3 \uff0c \u5c31 \u5c0d \u7671 \u5b50 \u8aaa \uff1a \u5c0f \u5b50 \uff0c \u4f60 \u7684 \u7f6a \u8d66 \u4e86 \u3002"}, {"pk": 582249, "verse": 6, "text": "\u6709 \u5e7e \u500b \u6587 \u58eb \u5750 \u5728 \u90a3 \u88e1 \uff0c \u5fc3 \u88e1 \u8b70 \u8ad6 \uff0c \u8aaa \uff1a"}, {"pk": 582250, "verse": 7, "text": "\u9019 \u500b \u4eba \u70ba \u751a \u9ebc \u9019 \u6a23 \u8aaa \u5462 \uff1f \u4ed6 \u8aaa \u50ed \u5984 \u7684 \u8a71 \u4e86 \u3002 \u9664 \u4e86 \u795e \u4ee5 \u5916 \uff0c \u8ab0 \u80fd \u8d66 \u7f6a \u5462 \uff1f"}, {"pk": 582251, "verse": 8, "text": "\u8036 \u7a4c \u5fc3 \u4e2d \u77e5 \u9053 \u4ed6 \u5011 \u5fc3 \u88e1 \u9019 \u6a23 \u8b70 \u8ad6 \uff0c \u5c31 \u8aaa \uff1a \u4f60 \u5011 \u5fc3 \u88e1 \u70ba \u751a \u9ebc \u9019 \u6a23 \u8b70 \u8ad6 \u5462 \uff1f"}, {"pk": 582252, "verse": 9, "text": "\u6216 \u5c0d \u7671 \u5b50 \u8aaa \u4f60 \u7684 \u7f6a \u8d66 \u4e86 \uff0c \u6216 \u8aaa \u8d77 \u4f86 \uff01 \u62ff \u4f60 \u7684 \u8925 \u5b50 \u884c \u8d70 \uff1b \u90a3 \u4e00 \u6a23 \u5bb9 \u6613 \u5462 \uff1f"}, {"pk": 582253, "verse": 10, "text": "\u4f46 \u8981 \u53eb \u4f60 \u5011 \u77e5 \u9053 \uff0c \u4eba \u5b50 \u5728 \u5730 \u4e0a \u6709 \u8d66 \u7f6a \u7684 \u6b0a \u67c4 \u3002 \u5c31 \u5c0d \u7671 \u5b50 \u8aaa \uff1a"}, {"pk": 582254, "verse": 11, "text": "\u6211 \u5429 \u5490 \u4f60 \uff0c \u8d77 \u4f86 \uff01 \u62ff \u4f60 \u7684 \u8925 \u5b50 \u56de \u5bb6 \u53bb \u7f77 \u3002"}, {"pk": 582255, "verse": 12, "text": "\u90a3 \u4eba \u5c31 \u8d77 \u4f86 \uff0c \u7acb \u523b \u62ff \u8457 \u8925 \u5b50 \uff0c \u7576 \u773e \u4eba \u9762 \u524d \u51fa \u53bb \u4e86 \uff0c \u4ee5 \u81f4 \u773e \u4eba \u90fd \u9a5a \u5947 \uff0c \u6b78 \u69ae \u8000 \u8207 \u795e \uff0c \u8aaa \uff1a \u6211 \u5011 \u5f9e \u4f86 \u6c92 \u6709 \u898b \u904e \u9019 \u6a23 \u7684 \u4e8b \uff01"}, {"pk": 582256, "verse": 13, "text": "\u8036 \u7a4c \u53c8 \u51fa \u5230 \u6d77 \u908a \u53bb \uff0c \u773e \u4eba \u90fd \u5c31 \u4e86 \u4ed6 \u4f86 \uff0c \u4ed6 \u4fbf \u6559 \u8a13 \u4ed6 \u5011 \u3002"}, {"pk": 582257, "verse": 14, "text": "\u8036 \u7a4c \u7d93 \u904e \u7684 \u6642 \u5019 \uff0c \u770b \u898b \u4e9e \u52d2 \u8153 \u7684 \u5152 \u5b50 \u5229 \u672a \u5750 \u5728 \u7a05 \u95dc \u4e0a \uff0c \u5c31 \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u8ddf \u5f9e \u6211 \u4f86 \u3002 \u4ed6 \u5c31 \u8d77 \u4f86 \uff0c \u8ddf \u5f9e \u4e86 \u8036 \u7a4c \u3002"}, {"pk": 582258, "verse": 15, "text": "\u8036 \u7a4c \u5728 \u5229 \u672a \u5bb6 \u88e1 \u5750 \u5e2d \u7684 \u6642 \u5019 \uff0c \u6709 \u597d \u4e9b \u7a05 \u540f \u548c \u7f6a \u4eba \u8207 \u8036 \u7a4c \u4e26 \u9580 \u5f92 \u4e00 \u540c \u5750 \u5e2d \uff1b \u56e0 \u70ba \u9019 \u6a23 \u7684 \u4eba \u591a \uff0c \u4ed6 \u5011 \u4e5f \u8ddf \u96a8 \u8036 \u7a4c \u3002"}, {"pk": 582259, "verse": 16, "text": "\u6cd5 \u5229 \u8cfd \u4eba \u4e2d \u7684 \u6587 \u58eb \uff08 \u6709 \u53e4 \u5377 \uff1a \u6587 \u58eb \u548c \u6cd5 \u5229 \u8cfd \u4eba \uff09 \u770b \u898b \u8036 \u7a4c \u548c \u7f6a \u4eba \u4e26 \u7a05 \u540f \u4e00 \u540c \u5403 \u98ef \uff0c \u5c31 \u5c0d \u4ed6 \u9580 \u5f92 \u8aaa \uff1a \u4ed6 \u548c \u7a05 \u540f \u4e26 \u7f6a \u4eba \u4e00 \u540c \u5403 \u559d \u9ebc \uff1f"}, {"pk": 582260, "verse": 17, "text": "\u8036 \u7a4c \u807d \u898b \uff0c \u5c31 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u5eb7 \u5065 \u7684 \u4eba \u7528 \u4e0d \u8457 \u91ab \u751f \uff0c \u6709 \u75c5 \u7684 \u4eba \u624d \u7528 \u5f97 \u8457 \u3002 \u6211 \u4f86 \u672c \u4e0d \u662f \u53ec \u7fa9 \u4eba \uff0c \u4e43 \u662f \u53ec \u7f6a \u4eba \u3002"}, {"pk": 582261, "verse": 18, "text": "\u7576 \u4e0b \uff0c \u7d04 \u7ff0 \u7684 \u9580 \u5f92 \u548c \u6cd5 \u5229 \u8cfd \u4eba \u7981 \u98df \u3002 \u4ed6 \u5011 \u4f86 \u554f \u8036 \u7a4c \u8aaa \uff1a \u7d04 \u7ff0 \u7684 \u9580 \u5f92 \u548c \u6cd5 \u5229 \u8cfd \u4eba \u7684 \u9580 \u5f92 \u7981 \u98df \uff0c \u4f60 \u7684 \u9580 \u5f92 \u5012 \u4e0d \u7981 \u98df \uff0c \u9019 \u662f \u70ba \u751a \u9ebc \u5462 \uff1f"}, {"pk": 582262, "verse": 19, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u65b0 \u90ce \u548c \u966a \u4f34 \u4e4b \u4eba \u540c \u5728 \u7684 \u6642 \u5019 \uff0c \u966a \u4f34 \u4e4b \u4eba \u8c48 \u80fd \u7981 \u98df \u5462 \uff1f \u65b0 \u90ce \u9084 \u540c \u5728 \uff0c \u4ed6 \u5011 \u4e0d \u80fd \u7981 \u98df \u3002"}, {"pk": 582263, "verse": 20, "text": "\u4f46 \u65e5 \u5b50 \u5c07 \u5230 \uff0c \u65b0 \u90ce \u8981 \u96e2 \u958b \u4ed6 \u5011 \uff0c \u90a3 \u65e5 \u4ed6 \u5011 \u5c31 \u8981 \u7981 \u98df \u3002"}, {"pk": 582264, "verse": 21, "text": "\u6c92 \u6709 \u4eba \u628a \u65b0 \u5e03 \u7e2b \u5728 \u820a \u8863 \u670d \u4e0a \uff0c \u6050 \u6015 \u6240 \u88dc \u4e0a \u7684 \u65b0 \u5e03 \u5e36 \u58de \u4e86 \u820a \u8863 \u670d \uff0c \u7834 \u7684 \u5c31 \u66f4 \u5927 \u4e86 \u3002"}, {"pk": 582265, "verse": 22, "text": "\u4e5f \u6c92 \u6709 \u4eba \u628a \u65b0 \u9152 \u88dd \u5728 \u820a \u76ae \u888b \u88e1 \uff0c \u6050 \u6015 \u9152 \u628a \u76ae \u888b \u88c2 \u958b \uff0c \u9152 \u548c \u76ae \u888b \u5c31 \u90fd \u58de \u4e86 \uff1b \u60df \u628a \u65b0 \u9152 \u88dd \u5728 \u65b0 \u76ae \u888b \u88e1 \u3002"}, {"pk": 582266, "verse": 23, "text": "\u8036 \u7a4c \u7576 \u5b89 \u606f \u65e5 \u5f9e \u9ea5 \u5730 \u7d93 \u904e \u3002 \u4ed6 \u9580 \u5f92 \u884c \u8def \u7684 \u6642 \u5019 \uff0c \u6390 \u4e86 \u9ea5 \u7a57 \u3002"}, {"pk": 582267, "verse": 24, "text": "\u6cd5 \u5229 \u8cfd \u4eba \u5c0d \u8036 \u7a4c \u8aaa \uff1a \u770b \u54ea \uff0c \u4ed6 \u5011 \u5728 \u5b89 \u606f \u65e5 \u70ba \u751a \u9ebc \u505a \u4e0d \u53ef \u505a \u7684 \u4e8b \u5462 \uff1f"}, {"pk": 582268, "verse": 25, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u7d93 \u4e0a \u8a18 \u8457 \u5927 \u885b \u548c \u8ddf \u5f9e \u4ed6 \u7684 \u4eba \u7f3a \u4e4f \u98e2 \u9913 \u4e4b \u6642 \u6240 \u505a \u7684 \u4e8b \uff0c \u4f60 \u5011 \u6c92 \u6709 \u5ff5 \u904e \u9ebc \uff1f"}, {"pk": 582269, "verse": 26, "text": "\u4ed6 \u7576 \u4e9e \u6bd4 \u4e9e \u4ed6 \u4f5c \u5927 \u796d \u53f8 \u7684 \u6642 \u5019 \uff0c \u600e \u9ebc \u9032 \u4e86 \u795e \u7684 \u6bbf \uff0c \u5403 \u4e86 \u9673 \u8a2d \u9905 \uff0c \u53c8 \u7d66 \u8ddf \u5f9e \u4ed6 \u7684 \u4eba \u5403 \u3002 \u9019 \u9905 \u9664 \u4e86 \u796d \u53f8 \u4ee5 \u5916 \uff0c \u4eba \u90fd \u4e0d \u53ef \u5403 \u3002"}, {"pk": 582270, "verse": 27, "text": "\u53c8 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u5b89 \u606f \u65e5 \u662f \u70ba \u4eba \u8a2d \u7acb \u7684 \uff0c \u4eba \u4e0d \u662f \u70ba \u5b89 \u606f \u65e5 \u8a2d \u7acb \u7684 \u3002"}, {"pk": 582271, "verse": 28, "text": "\u6240 \u4ee5 \uff0c \u4eba \u5b50 \u4e5f \u662f \u5b89 \u606f \u65e5 \u7684 \u4e3b \u3002"}]