[{"pk": 579663, "verse": 1, "text": "\u4ed6 \u5e36 \u6211 \u56de \u5230 \u6bbf \u9580 \uff0c \u898b \u6bbf \u7684 \u9580 \u6abb \u4e0b \u6709 \u6c34 \u5f80 \u6771 \u6d41 \u51fa \uff08 \u539f \u4f86 \u6bbf \u9762 \u671d \u6771 \uff09 \u3002 \u9019 \u6c34 \u5f9e \u6abb \u4e0b \uff0c \u7531 \u6bbf \u7684 \u53f3 \u908a \uff0c \u5728 \u796d \u58c7 \u7684 \u5357 \u908a \u5f80 \u4e0b \u6d41 \u3002"}, {"pk": 579664, "verse": 2, "text": "\u4ed6 \u5e36 \u6211 \u51fa \u5317 \u9580 \uff0c \u53c8 \u9818 \u6211 \u5f9e \u5916 \u908a \u8f49 \u5230 \u671d \u6771 \u7684 \u5916 \u9580 \uff0c \u898b \u6c34 \u5f9e \u53f3 \u908a \u6d41 \u51fa \u3002"}, {"pk": 579665, "verse": 3, "text": "\u4ed6 \u624b \u62ff \u6e96 \u7e69 \u5f80 \u6771 \u51fa \u53bb \u7684 \u6642 \u5019 \uff0c \u91cf \u4e86 \u4e00 \u5343 \u8098 \uff0c \u4f7f \u6211 \u903f \u904e \u6c34 \uff0c \u6c34 \u5230 \u8e1d \u5b50 \u9aa8 \u3002"}, {"pk": 579666, "verse": 4, "text": "\u4ed6 \u53c8 \u91cf \u4e86 \u4e00 \u5343 \u8098 \uff0c \u4f7f \u6211 \u903f \u904e \u6c34 \uff0c \u6c34 \u5c31 \u5230 \u819d \uff1b \u518d \u91cf \u4e86 \u4e00 \u5343 \u8098 \uff0c \u4f7f \u6211 \u903f \u904e \u6c34 \uff0c \u6c34 \u4fbf \u5230 \u8170 \uff1b"}, {"pk": 579667, "verse": 5, "text": "\u53c8 \u91cf \u4e86 \u4e00 \u5343 \u8098 \uff0c \u6c34 \u4fbf \u6210 \u4e86 \u6cb3 \uff0c \u4f7f \u6211 \u4e0d \u80fd \u903f \u904e \u3002 \u56e0 \u70ba \u6c34 \u52e2 \u6f32 \u8d77 \uff0c \u6210 \u70ba \u53ef \u6d11 \u7684 \u6c34 \uff0c \u4e0d \u53ef \u903f \u7684 \u6cb3 \u3002"}, {"pk": 579668, "verse": 6, "text": "\u4ed6 \u5c0d \u6211 \u8aaa \uff1a \u4eba \u5b50 \u554a \uff0c \u4f60 \u770b \u898b \u4e86 \u751a \u9ebc \uff1f \u4ed6 \u5c31 \u5e36 \u6211 \u56de \u5230 \u6cb3 \u908a \u3002"}, {"pk": 579669, "verse": 7, "text": "\u6211 \u56de \u5230 \u6cb3 \u908a \u7684 \u6642 \u5019 \uff0c \u898b \u5728 \u6cb3 \u9019 \u908a \u8207 \u90a3 \u908a \u7684 \u5cb8 \u4e0a \u6709 \u6975 \u591a \u7684 \u6a39 \u6728 \u3002"}, {"pk": 579670, "verse": 8, "text": "\u4ed6 \u5c0d \u6211 \u8aaa \uff1a \u9019 \u6c34 \u5f80 \u6771 \u65b9 \u6d41 \u53bb \uff0c \u5fc5 \u4e0b \u5230 \u4e9e \u62c9 \u5df4 \uff0c \u76f4 \u5230 \u6d77 \u3002 \u6240 \u767c \u51fa \u4f86 \u7684 \u6c34 \u5fc5 \u6d41 \u5165 \u9e7d \u6d77 \uff0c \u4f7f \u6c34 \u8b8a \u751c \uff08 \u539f \u6587 \u662f \u5f97 \u91ab \u6cbb \uff1b \u4e0b \u540c \uff09 \u3002"}, {"pk": 579671, "verse": 9, "text": "\u9019 \u6cb3 \u6c34 \u6240 \u5230 \u4e4b \u8655 \uff0c \u51e1 \u6ecb \u751f \u7684 \u52d5 \u7269 \u90fd \u5fc5 \u751f \u6d3b \uff0c \u4e26 \u4e14 \u56e0 \u9019 \u6d41 \u4f86 \u7684 \u6c34 \u5fc5 \u6709 \u6975 \u591a \u7684 \u9b5a \uff0c \u6d77 \u6c34 \u4e5f \u8b8a \u751c \u4e86 \u3002 \u9019 \u6cb3 \u6c34 \u6240 \u5230 \u4e4b \u8655 \uff0c \u767e \u7269 \u90fd \u5fc5 \u751f \u6d3b \u3002"}, {"pk": 579672, "verse": 10, "text": "\u5fc5 \u6709 \u6f01 \u592b \u7ad9 \u5728 \u6cb3 \u908a \uff0c \u5f9e \u96b1 \u57fa \u5e95 \u76f4 \u5230 \u96b1 \u4ee5 \u9769 \u84ee \uff0c \u90fd \u4f5c \u66ec \uff08 \u6216 \u8b6f \uff1a \u5f35 \uff09 \u7db2 \u4e4b \u8655 \u3002 \u90a3 \u9b5a \u5404 \u5f9e \u5176 \u985e \uff0c \u597d \u50cf \u5927 \u6d77 \u7684 \u9b5a \u751a \u591a \u3002"}, {"pk": 579673, "verse": 11, "text": "\u53ea \u662f \u6ce5 \u6fd8 \u4e4b \u5730 \u8207 \u7aaa \u6fd5 \u4e4b \u8655 \u4e0d \u5f97 \u6cbb \u597d \uff0c \u5fc5 \u70ba \u9e7d \u5730 \u3002"}, {"pk": 579674, "verse": 12, "text": "\u5728 \u6cb3 \u9019 \u908a \u8207 \u90a3 \u908a \u7684 \u5cb8 \u4e0a \u5fc5 \u751f \u9577 \u5404 \u985e \u7684 \u6a39 \u6728 \uff1b \u5176 \u679c \u53ef \u4f5c \u98df \u7269 \uff0c \u8449 \u5b50 \u4e0d \u67af \u4e7e \uff0c \u679c \u5b50 \u4e0d \u65b7 \u7d55 \u3002 \u6bcf \u6708 \u5fc5 \u7d50 \u65b0 \u679c \u5b50 \uff0c \u56e0 \u70ba \u9019 \u6c34 \u662f \u5f9e \u8056 \u6240 \u6d41 \u51fa \u4f86 \u7684 \u3002 \u6a39 \u4e0a \u7684 \u679c \u5b50 \u5fc5 \u4f5c \u98df \u7269 \uff0c \u8449 \u5b50 \u4e43 \u70ba \u6cbb \u75c5 \u3002"}, {"pk": 579675, "verse": 13, "text": "\u4e3b \u8036 \u548c \u83ef \u5982 \u6b64 \u8aaa \uff1a \u4f60 \u5011 \u8981 \u7167 \u5730 \u7684 \u5883 \u754c \uff0c \u6309 \u4ee5 \u8272 \u5217 \u5341 \u4e8c \u652f \u6d3e \u5206 \u5730 \u70ba \u696d \u3002 \u7d04 \u745f \u5fc5 \u5f97 \u5169 \u5206 \u3002"}, {"pk": 579676, "verse": 14, "text": "\u4f60 \u5011 \u627f \u53d7 \u9019 \u5730 \u70ba \u696d \uff0c \u8981 \u5f7c \u6b64 \u5747 \u5206 \uff1b \u56e0 \u70ba \u6211 \u66fe \u8d77 \u8a93 \u61c9 \u8a31 \u5c07 \u9019 \u5730 \u8cdc \u8207 \u4f60 \u5011 \u7684 \u5217 \u7956 \uff1b \u9019 \u5730 \u5fc5 \u6b78 \u4f60 \u5011 \u70ba \u696d \u3002"}, {"pk": 579677, "verse": 15, "text": "\u5730 \u7684 \u56db \u754c \u4e43 \u662f \u5982 \u6b64 \uff1a \u5317 \u754c \u5f9e \u5927 \u6d77 \u5f80 \u5e0c \u7279 \u502b \uff0c \u76f4 \u5230 \u897f \u9054 \u9054 \u53e3 \u3002"}, {"pk": 579678, "verse": 16, "text": "\u53c8 \u5f80 \u54c8 \u99ac \u3001 \u6bd4 \u7f85 \u4ed6 \u3001 \u897f \u4f2f \u84ee \uff08 \u897f \u4f2f \u84ee \u5728 \u5927 \u99ac \u8272 \u8207 \u54c8 \u99ac \u5169 \u754c \u4e2d \u9593 \uff09 \uff0c \u5230 \u6d69 \u862d \u908a \u754c \u7684 \u54c8 \u6492 \u54c8 \u63d0 \u5e72 \u3002"}, {"pk": 579679, "verse": 17, "text": "\u9019 \u6a23 \uff0c \u5883 \u754c \u5f9e \u6d77 \u908a \u5f80 \u5927 \u99ac \u8272 \u5730 \u754c \u4e0a \u7684 \u54c8 \u85a9 \u4ee5 \u96e3 \uff0c \u5317 \u908a \u4ee5 \u54c8 \u99ac \u5730 \u70ba \u754c \u3002 \u9019 \u662f \u5317 \u754c \u3002"}, {"pk": 579680, "verse": 18, "text": "\u6771 \u754c \u5728 \u6d69 \u862d \u3001 \u5927 \u99ac \u8272 \u3001 \u57fa \u5217 \uff0c \u548c \u4ee5 \u8272 \u5217 \u5730 \u7684 \u4e2d \u9593 \uff0c \u5c31 \u662f \u7d04 \u4f46 \u6cb3 \u3002 \u4f60 \u5011 \u8981 \u5f9e \u5317 \u754c \u91cf \u5230 \u6771 \u6d77 \u3002 \u9019 \u662f \u6771 \u754c \u3002"}, {"pk": 579681, "verse": 19, "text": "\u5357 \u754c \u662f \u5f9e \u4ed6 \u746a \u5230 \u7c73 \u5229 \u5df4 \u52a0 \u4f4e \u65af \u7684 \u6c34 \uff0c \u5ef6 \u5230 \u57c3 \u53ca \u5c0f \u6cb3 \uff0c \u76f4 \u5230 \u5927 \u6d77 \u3002 \u9019 \u662f \u5357 \u754c \u3002"}, {"pk": 579682, "verse": 20, "text": "\u897f \u754c \u5c31 \u662f \u5927 \u6d77 \uff0c \u5f9e \u5357 \u754c \u76f4 \u5230 \u54c8 \u99ac \u53e3 \u5c0d \u9762 \u4e4b \u5730 \u3002 \u9019 \u662f \u897f \u754c \u3002"}, {"pk": 579683, "verse": 21, "text": "\u4f60 \u5011 \u8981 \u6309 \u8457 \u4ee5 \u8272 \u5217 \u7684 \u652f \u6d3e \u5f7c \u6b64 \u5206 \u9019 \u5730 \u3002"}, {"pk": 579684, "verse": 22, "text": "\u8981 \u62c8 \u9b2e \u5206 \u9019 \u5730 \u70ba \u696d \uff0c \u6b78 \u8207 \u81ea \u5df1 \u548c \u4f60 \u5011 \u4e2d \u9593 \u5bc4 \u5c45 \u7684 \u5916 \u4eba \uff0c \u5c31 \u662f \u5728 \u4f60 \u5011 \u4e2d \u9593 \u751f \u990a \u5152 \u5973 \u7684 \u5916 \u4eba \u3002 \u4f60 \u5011 \u8981 \u770b \u4ed6 \u5011 \u5982 \u540c \u4ee5 \u8272 \u5217 \u4eba \u4e2d \u6240 \u751f \u7684 \u4e00 \u6a23 \uff1b \u4ed6 \u5011 \u5728 \u4ee5 \u8272 \u5217 \u652f \u6d3e \u4e2d \u8981 \u8207 \u4f60 \u5011 \u540c \u5f97 \u5730 \u696d"}, {"pk": 579685, "verse": 23, "text": "\u5916 \u4eba \u5bc4 \u5c45 \u5728 \u54ea \u652f \u6d3e \u4e2d \uff0c \u4f60 \u5011 \u5c31 \u5728 \u90a3 \u88e1 \u5206 \u7d66 \u4ed6 \u5730 \u696d \u3002 \u9019 \u662f \u4e3b \u8036 \u548c \u83ef \u8aaa \u7684 \u3002"}]