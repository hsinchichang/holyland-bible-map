[{"pk": 583229, "verse": 1, "text": "\u904e \u4e86 \u4e0d \u591a \u65e5 \uff0c \u8036 \u7a4c \u5468 \u904a \u5404 \u57ce \u5404 \u9109 \u50b3 \u9053 \uff0c \u5ba3 \u8b1b \u795e \u570b \u7684 \u798f \u97f3 \u3002 \u548c \u4ed6 \u540c \u53bb \u7684 \u6709 \u5341 \u4e8c \u500b \u9580 \u5f92 \uff0c"}, {"pk": 583230, "verse": 2, "text": "\u9084 \u6709 \u88ab \u60e1 \u9b3c \u6240 \u9644 \u3001 \u88ab \u75be \u75c5 \u6240 \u7d2f \u3001 \u5df2 \u7d93 \u6cbb \u597d \u7684 \u5e7e \u500b \u5a66 \u5973 \uff0c \u5167 \u4e2d \u6709 \u7a31 \u70ba \u62b9 \u5927 \u62c9 \u7684 \u99ac \u5229 \u4e9e \uff0c \u66fe \u6709 \u4e03 \u500b \u9b3c \u5f9e \u4ed6 \u8eab \u4e0a \u8d95 \u51fa \u4f86 \uff0c"}, {"pk": 583231, "verse": 3, "text": "\u53c8 \u6709 \u5e0c \u5f8b \u7684 \u5bb6 \u5bb0 \u82e6 \u6492 \u7684 \u59bb \u5b50 \u7d04 \u4e9e \u62ff \uff0c \u4e26 \u8607 \u6492 \u62ff \uff0c \u548c \u597d \u4e9b \u5225 \u7684 \u5a66 \u5973 \uff0c \u90fd \u662f \u7528 \u81ea \u5df1 \u7684 \u8ca1 \u7269 \u4f9b \u7d66 \u8036 \u7a4c \u548c \u9580 \u5f92 \u3002"}, {"pk": 583232, "verse": 4, "text": "\u7576 \u8a31 \u591a \u4eba \u805a \u96c6 \u3001 \u53c8 \u6709 \u4eba \u5f9e \u5404 \u57ce \u88e1 \u51fa \u4f86 \u898b \u8036 \u7a4c \u7684 \u6642 \u5019 \uff0c \u8036 \u7a4c \u5c31 \u7528 \u6bd4 \u55bb \u8aaa \uff1a"}, {"pk": 583233, "verse": 5, "text": "\u6709 \u4e00 \u500b \u6492 \u7a2e \u7684 \u51fa \u53bb \u6492 \u7a2e \u3002 \u6492 \u7684 \u6642 \u5019 \uff0c \u6709 \u843d \u5728 \u8def \u65c1 \u7684 \uff0c \u88ab \u4eba \u8e10 \u8e0f \uff0c \u5929 \u4e0a \u7684 \u98db \u9ce5 \u53c8 \u4f86 \u5403 \u76e1 \u4e86 \u3002"}, {"pk": 583234, "verse": 6, "text": "\u6709 \u843d \u5728 \u78d0 \u77f3 \u4e0a \u7684 \uff0c \u4e00 \u51fa \u4f86 \u5c31 \u67af \u4e7e \u4e86 \uff0c \u56e0 \u70ba \u5f97 \u4e0d \u8457 \u6ecb \u6f64 \u3002"}, {"pk": 583235, "verse": 7, "text": "\u6709 \u843d \u5728 \u834a \u68d8 \u88e1 \u7684 \uff0c \u834a \u68d8 \u4e00 \u540c \u751f \u9577 \uff0c \u628a \u4ed6 \u64e0 \u4f4f \u4e86 \u3002"}, {"pk": 583236, "verse": 8, "text": "\u53c8 \u6709 \u843d \u5728 \u597d \u571f \u88e1 \u7684 \uff0c \u751f \u9577 \u8d77 \u4f86 \uff0c \u7d50 \u5be6 \u767e \u500d \u3002 \u8036 \u7a4c \u8aaa \u4e86 \u9019 \u4e9b \u8a71 \uff0c \u5c31 \u5927 \u8072 \u8aaa \uff1a \u6709 \u8033 \u53ef \u807d \u7684 \uff0c \u5c31 \u61c9 \u7576 \u807d \uff01"}, {"pk": 583237, "verse": 9, "text": "\u9580 \u5f92 \u554f \u8036 \u7a4c \u8aaa \uff1a \u9019 \u6bd4 \u55bb \u662f \u751a \u9ebc \u610f \u601d \u5462 \uff1f"}, {"pk": 583238, "verse": 10, "text": "\u4ed6 \u8aaa \uff1a \u795e \u570b \u7684 \u5967 \u7955 \u53ea \u53eb \u4f60 \u5011 \u77e5 \u9053 \uff1b \u81f3 \u65bc \u5225 \u4eba \uff0c \u5c31 \u7528 \u6bd4 \u55bb \uff0c \u53eb \u4ed6 \u5011 \u770b \u4e5f \u770b \u4e0d \u898b \uff0c \u807d \u4e5f \u807d \u4e0d \u660e \u3002"}, {"pk": 583239, "verse": 11, "text": "\u9019 \u6bd4 \u55bb \u4e43 \u662f \u9019 \u6a23 \uff1a \u7a2e \u5b50 \u5c31 \u662f \u795e \u7684 \u9053 \u3002"}, {"pk": 583240, "verse": 12, "text": "\u90a3 \u4e9b \u5728 \u8def \u65c1 \u7684 \uff0c \u5c31 \u662f \u4eba \u807d \u4e86 \u9053 \uff0c \u96a8 \u5f8c \u9b54 \u9b3c \u4f86 \uff0c \u5f9e \u4ed6 \u5011 \u5fc3 \u88e1 \u628a \u9053 \u596a \u53bb \uff0c \u6050 \u6015 \u4ed6 \u5011 \u4fe1 \u4e86 \u5f97 \u6551 ."}, {"pk": 583241, "verse": 13, "text": "\u90a3 \u4e9b \u5728 \u78d0 \u77f3 \u4e0a \u7684 \uff0c \u5c31 \u662f \u4eba \u807d \u9053 \uff0c \u6b61 \u559c \u9818 \u53d7 \uff0c \u4f46 \u5fc3 \u4e2d \u6c92 \u6709 \u6839 \uff0c \u4e0d \u904e \u66ab \u6642 \u76f8 \u4fe1 \uff0c \u53ca \u81f3 \u9047 \u898b \u8a66 \u7149 \u5c31 \u9000 \u5f8c \u4e86 \u3002"}, {"pk": 583242, "verse": 14, "text": "\u90a3 \u843d \u5728 \u834a \u68d8 \u88e1 \u7684 \uff0c \u5c31 \u662f \u4eba \u807d \u4e86 \u9053 \uff0c \u8d70 \u958b \u4ee5 \u5f8c \uff0c \u88ab \u4eca \u751f \u7684 \u601d \u616e \u3001 \u9322 \u8ca1 \u3001 \u5bb4 \u6a02 \u64e0 \u4f4f \u4e86 \uff0c \u4fbf \u7d50 \u4e0d \u51fa \u6210 \u719f \u7684 \u5b50 \u7c92 \u4f86 \u3002"}, {"pk": 583243, "verse": 15, "text": "\u90a3 \u843d \u5728 \u597d \u571f \u88e1 \u7684 \uff0c \u5c31 \u662f \u4eba \u807d \u4e86 \u9053 \uff0c \u6301 \u5b88 \u5728 \u8aa0 \u5be6 \u5584 \u826f \u7684 \u5fc3 \u88e1 \uff0c \u4e26 \u4e14 \u5fcd \u8010 \u8457 \u7d50 \u5be6 \u3002"}, {"pk": 583244, "verse": 16, "text": "\u6c92 \u6709 \u4eba \u9ede \u71c8 \u7528 \u5668 \u76bf \u84cb \u4e0a \uff0c \u6216 \u653e \u5728 \u5e8a \u5e95 \u4e0b \uff0c \u4e43 \u662f \u653e \u5728 \u71c8 \u81fa \u4e0a \uff0c \u53eb \u9032 \u4f86 \u7684 \u4eba \u770b \u898b \u4eae \u5149 \u3002"}, {"pk": 583245, "verse": 17, "text": "\u56e0 \u70ba \u63a9 \u85cf \u7684 \u4e8b \u6c92 \u6709 \u4e0d \u986f \u51fa \u4f86 \u7684 \uff1b \u96b1 \u779e \u7684 \u4e8b \u6c92 \u6709 \u4e0d \u9732 \u51fa \u4f86 \u88ab \u4eba \u77e5 \u9053 \u7684 \u3002"}, {"pk": 583246, "verse": 18, "text": "\u6240 \u4ee5 \uff0c \u4f60 \u5011 \u61c9 \u7576 \u5c0f \u5fc3 \u600e \u6a23 \u807d \uff1b \u56e0 \u70ba \u51e1 \u6709 \u7684 \uff0c \u9084 \u8981 \u52a0 \u7d66 \u4ed6 \uff1b \u51e1 \u6c92 \u6709 \u7684 \uff0c \u9023 \u4ed6 \u81ea \u4ee5 \u70ba \u6709 \u7684 \uff0c \u4e5f \u8981 \u596a \u53bb \u3002"}, {"pk": 583247, "verse": 19, "text": "\u8036 \u7a4c \u7684 \u6bcd \u89aa \u548c \u4ed6 \u5f1f \u5144 \u4f86 \u4e86 \uff0c \u56e0 \u70ba \u4eba \u591a \uff0c \u4e0d \u5f97 \u5230 \u4ed6 \u8ddf \u524d \u3002"}, {"pk": 583248, "verse": 20, "text": "\u6709 \u4eba \u544a \u8a34 \u4ed6 \u8aaa \uff1a \u4f60 \u6bcd \u89aa \u548c \u4f60 \u5f1f \u5144 \u7ad9 \u5728 \u5916 \u908a \uff0c \u8981 \u898b \u4f60 \u3002"}, {"pk": 583249, "verse": 21, "text": "\u8036 \u7a4c \u56de \u7b54 \u8aaa \uff1a \u807d \u4e86 \u795e \u4e4b \u9053 \u800c \u9075 \u884c \u7684 \u4eba \u5c31 \u662f \u6211 \u7684 \u6bcd \u89aa \uff0c \u6211 \u7684 \u5f1f \u5144 \u4e86 \u3002"}, {"pk": 583250, "verse": 22, "text": "\u6709 \u4e00 \u5929 \uff0c \u8036 \u7a4c \u548c \u9580 \u5f92 \u4e0a \u4e86 \u8239 \uff0c \u5c0d \u9580 \u5f92 \u8aaa \uff1a \u6211 \u5011 \u53ef \u4ee5 \u6e21 \u5230 \u6e56 \u90a3 \u908a \u53bb \u3002 \u4ed6 \u5011 \u5c31 \u958b \u4e86 \u8239 \u3002"}, {"pk": 583251, "verse": 23, "text": "\u6b63 \u884c \u7684 \u6642 \u5019 \uff0c \u8036 \u7a4c \u7761 \u8457 \u4e86 \u3002 \u6e56 \u4e0a \u5ffd \u7136 \u8d77 \u4e86 \u66b4 \u98a8 \uff0c \u8239 \u5c07 \u6eff \u4e86 \u6c34 \uff0c \u751a \u662f \u5371 \u96aa \u3002"}, {"pk": 583252, "verse": 24, "text": "\u9580 \u5f92 \u4f86 \u53eb \u9192 \u4e86 \u4ed6 \uff0c \u8aaa \uff1a \u592b \u5b50 \uff01 \u592b \u5b50 \uff01 \u6211 \u5011 \u55aa \u547d \u5566 \uff01 \u8036 \u7a4c \u9192 \u4e86 \uff0c \u65a5 \u8cac \u90a3 \u72c2 \u98a8 \u5927 \u6d6a \uff1b \u98a8 \u6d6a \u5c31 \u6b62 \u4f4f \uff0c \u5e73 \u975c \u4e86 \u3002"}, {"pk": 583253, "verse": 25, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u7684 \u4fe1 \u5fc3 \u5728 \u90a3 \u88e1 \u5462 \uff1f \u4ed6 \u5011 \u53c8 \u61fc \u6015 \u53c8 \u5e0c \u5947 \uff0c \u5f7c \u6b64 \u8aaa \uff1a \u9019 \u5230 \u5e95 \u662f \u8ab0 \uff1f \u4ed6 \u5429 \u5490 \u98a8 \u548c \u6c34 \uff0c \u9023 \u98a8 \u548c \u6c34 \u4e5f \u807d \u5f9e \u4ed6 \u4e86 \u3002"}, {"pk": 583254, "verse": 26, "text": "\u4ed6 \u5011 \u5230 \u4e86 \u683c \u62c9 \u68ee \uff08 \u6709 \u53e4 \u5377 \uff1a \u52a0 \u5927 \u62c9 \uff09 \u4eba \u7684 \u5730 \u65b9 \uff0c \u5c31 \u662f \u52a0 \u5229 \u5229 \u7684 \u5c0d \u9762 \u3002"}, {"pk": 583255, "verse": 27, "text": "\u8036 \u7a4c \u4e0a \u4e86 \u5cb8 \uff0c \u5c31 \u6709 \u57ce \u88e1 \u4e00 \u500b \u88ab \u9b3c \u9644 \u8457 \u7684 \u4eba \u8fce \u9762 \u800c \u4f86 \u3002 \u9019 \u500b \u4eba \u8a31 \u4e45 \u4e0d \u7a7f \u8863 \u670d \uff0c \u4e0d \u4f4f \u623f \u5b50 \uff0c \u53ea \u4f4f \u5728 \u58b3 \u584b \u88e1 \u3002"}, {"pk": 583256, "verse": 28, "text": "\u4ed6 \u898b \u4e86 \u8036 \u7a4c \uff0c \u5c31 \u4fef \u4f0f \u5728 \u4ed6 \u9762 \u524d \uff0c \u5927 \u8072 \u558a \u53eb \uff0c \u8aaa \uff1a \u81f3 \u9ad8 \u795e \u7684 \u5152 \u5b50 \u8036 \u7a4c \uff0c \u6211 \u8207 \u4f60 \u6709 \u751a \u9ebc \u76f8 \u5e72 \uff1f \u6c42 \u4f60 \u4e0d \u8981 \u53eb \u6211 \u53d7 \u82e6 \uff01"}, {"pk": 583257, "verse": 29, "text": "\u662f \u56e0 \u8036 \u7a4c \u66fe \u5429 \u5490 \u6c61 \u9b3c \u5f9e \u90a3 \u4eba \u8eab \u4e0a \u51fa \u4f86 \u3002 \u539f \u4f86 \u9019 \u9b3c \u5c62 \u6b21 \u6293 \u4f4f \u4ed6 \uff1b \u4ed6 \u5e38 \u88ab \u4eba \u770b \u5b88 \uff0c \u53c8 \u88ab \u9435 \u934a \u548c \u8173 \u9410 \u6346 \u9396 \uff0c \u4ed6 \u7adf \u628a \u9396 \u934a \u6399 \u65b7 \uff0c \u88ab \u9b3c \u8d95 \u5230 \u66e0 \u91ce \u53bb \u3002"}, {"pk": 583258, "verse": 30, "text": "\u8036 \u7a4c \u554f \u4ed6 \u8aaa \uff1a \u4f60 \u540d \u53eb \u751a \u9ebc \uff1f \u4ed6 \u8aaa \uff1a \u6211 \u540d \u53eb \u7fa4 \uff1b \u9019 \u662f \u56e0 \u70ba \u9644 \u8457 \u4ed6 \u7684 \u9b3c \u591a \u3002"}, {"pk": 583259, "verse": 31, "text": "\u9b3c \u5c31 \u592e \u6c42 \u8036 \u7a4c \uff0c \u4e0d \u8981 \u5429 \u5490 \u4ed6 \u5011 \u5230 \u7121 \u5e95 \u5751 \u88e1 \u53bb \u3002"}, {"pk": 583260, "verse": 32, "text": "\u90a3 \u88e1 \u6709 \u4e00 \u5927 \u7fa4 \u8c6c \u5728 \u5c71 \u4e0a \u5403 \u98df \u3002 \u9b3c \u592e \u6c42 \u8036 \u7a4c \uff0c \u51c6 \u4ed6 \u5011 \u9032 \u5165 \u8c6c \u88e1 \u53bb \u3002 \u8036 \u7a4c \u51c6 \u4e86 \u4ed6 \u5011 \uff0c"}, {"pk": 583261, "verse": 33, "text": "\u9b3c \u5c31 \u5f9e \u90a3 \u4eba \u51fa \u4f86 \uff0c \u9032 \u5165 \u8c6c \u88e1 \u53bb \u3002 \u65bc \u662f \u90a3 \u7fa4 \u8c6c \u95d6 \u4e0b \u5c71 \u5d16 \uff0c \u6295 \u5728 \u6e56 \u88e1 \u6df9 \u6b7b \u4e86 \u3002"}, {"pk": 583262, "verse": 34, "text": "\u653e \u8c6c \u7684 \u770b \u898b \u9019 \u4e8b \u5c31 \u9003 \u8dd1 \u4e86 \uff0c \u53bb \u544a \u8a34 \u57ce \u88e1 \u548c \u9109 \u4e0b \u7684 \u4eba \u3002"}, {"pk": 583263, "verse": 35, "text": "\u773e \u4eba \u51fa \u4f86 \u8981 \u770b \u662f \u751a \u9ebc \u4e8b \uff1b \u5230 \u4e86 \u8036 \u7a4c \u90a3 \u88e1 \uff0c \u770b \u898b \u9b3c \u6240 \u96e2 \u958b \u7684 \u90a3 \u4eba \uff0c \u5750 \u5728 \u8036 \u7a4c \u8173 \u524d \uff0c \u7a7f \u8457 \u8863 \u670d \uff0c \u5fc3 \u88e1 \u660e \u767d \u904e \u4f86 \uff0c \u4ed6 \u5011 \u5c31 \u5bb3 \u6015 \u3002"}, {"pk": 583264, "verse": 36, "text": "\u770b \u898b \u9019 \u4e8b \u7684 \u4fbf \u5c07 \u88ab \u9b3c \u9644 \u8457 \u7684 \u4eba \u600e \u9ebc \u5f97 \u6551 \u544a \u8a34 \u4ed6 \u5011 \u3002"}, {"pk": 583265, "verse": 37, "text": "\u683c \u62c9 \u68ee \u56db \u570d \u7684 \u4eba \uff0c \u56e0 \u70ba \u5bb3 \u6015 \u5f97 \u5f88 \uff0c \u90fd \u6c42 \u8036 \u7a4c \u96e2 \u958b \u4ed6 \u5011 \uff1b \u8036 \u7a4c \u5c31 \u4e0a \u8239 \u56de \u53bb \u4e86 \u3002"}, {"pk": 583266, "verse": 38, "text": "\u9b3c \u6240 \u96e2 \u958b \u7684 \u90a3 \u4eba \u61c7 \u6c42 \u548c \u8036 \u7a4c \u540c \u5728 \uff1b \u8036 \u7a4c \u537b \u6253 \u767c \u4ed6 \u56de \u53bb \uff0c \u8aaa \uff1a"}, {"pk": 583267, "verse": 39, "text": "\u4f60 \u56de \u5bb6 \u53bb \uff0c \u50b3 \u8aaa \u795e \u70ba \u4f60 \u4f5c \u4e86 \u4f55 \u7b49 \u5927 \u7684 \u4e8b \u3002 \u4ed6 \u5c31 \u53bb \uff0c \u6eff \u57ce \u88e1 \u50b3 \u63da \u8036 \u7a4c \u70ba \u4ed6 \u4f5c \u4e86 \u4f55 \u7b49 \u5927 \u7684 \u4e8b \u3002"}, {"pk": 583268, "verse": 40, "text": "\u8036 \u7a4c \u56de \u4f86 \u7684 \u6642 \u5019 \uff0c \u773e \u4eba \u8fce \u63a5 \u4ed6 \uff0c \u56e0 \u70ba \u4ed6 \u5011 \u90fd \u7b49 \u5019 \u4ed6 \u3002"}, {"pk": 583269, "verse": 41, "text": "\u6709 \u4e00 \u500b \u7ba1 \u6703 \u5802 \u7684 \uff0c \u540d \u53eb \u775a \u9b6f \uff0c \u4f86 \u4fef \u4f0f \u5728 \u8036 \u7a4c \u8173 \u524d \uff0c \u6c42 \u8036 \u7a4c \u5230 \u4ed6 \u5bb6 \u88e1 \u53bb \uff1b"}, {"pk": 583270, "verse": 42, "text": "\u56e0 \u4ed6 \u6709 \u4e00 \u500b \u7368 \u751f \u5973 \u5152 \uff0c \u7d04 \u6709 \u5341 \u4e8c \u6b72 \uff0c \u5feb \u8981 \u6b7b \u4e86 \u3002 \u8036 \u7a4c \u53bb \u7684 \u6642 \u5019 \uff0c \u773e \u4eba \u64c1 \u64e0 \u4ed6 \u3002"}, {"pk": 583271, "verse": 43, "text": "\u6709 \u4e00 \u500b \u5973 \u4eba \uff0c \u60a3 \u4e86 \u5341 \u4e8c \u5e74 \u7684 \u8840 \u6f0f \uff0c \u5728 \u91ab \u751f \u624b \u88e1 \u82b1 \u76e1 \u4e86 \u4ed6 \u4e00 \u5207 \u990a \u751f \u7684 \uff0c \u4e26 \u6c92 \u6709 \u4e00 \u4eba \u80fd \u91ab \u597d \u4ed6 \u3002"}, {"pk": 583272, "verse": 44, "text": "\u4ed6 \u4f86 \u5230 \u8036 \u7a4c \u80cc \u5f8c \uff0c \u6478 \u4ed6 \u7684 \u8863 \u88f3 \u7e78 \u5b50 \uff0c \u8840 \u6f0f \u7acb \u523b \u5c31 \u6b62 \u4f4f \u4e86 \u3002"}, {"pk": 583273, "verse": 45, "text": "\u8036 \u7a4c \u8aaa \uff1a \u6478 \u6211 \u7684 \u662f \u8ab0 \uff1f \u773e \u4eba \u90fd \u4e0d \u627f \u8a8d \u3002 \u5f7c \u5f97 \u548c \u540c \u884c \u7684 \u4eba \u90fd \u8aaa \uff1a \u592b \u5b50 \uff0c \u773e \u4eba \u64c1 \u64c1 \u64e0 \u64e0 \u7dca \u9760 \u8457 \u4f60 \u3002 \uff08 \u6709 \u53e4 \u5377 \u5728 \u6b64 \u6709 \uff1a \u4f60 \u9084 \u554f \u6478 \u6211 \u7684 \u662f \u8ab0 \u9ebc \uff1f"}, {"pk": 583274, "verse": 46, "text": "\u8036 \u7a4c \u8aaa \uff1a \u7e3d \u6709 \u4eba \u6478 \u6211 \uff0c \u56e0 \u6211 \u89ba \u5f97 \u6709 \u80fd \u529b \u5f9e \u6211 \u8eab \u4e0a \u51fa \u53bb \u3002"}, {"pk": 583275, "verse": 47, "text": "\u90a3 \u5973 \u4eba \u77e5 \u9053 \u4e0d \u80fd \u96b1 \u85cf \uff0c \u5c31 \u6230 \u6230 \u5162 \u5162 \u7684 \u4f86 \u4fef \u4f0f \u5728 \u8036 \u7a4c \u8173 \u524d \uff0c \u628a \u6478 \u4ed6 \u7684 \u7de3 \u6545 \u548c \u600e \u6a23 \u7acb \u523b \u5f97 \u597d \u4e86 \uff0c \u7576 \u8457 \u773e \u4eba \u90fd \u8aaa \u51fa \u4f86 \u3002"}, {"pk": 583276, "verse": 48, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u8aaa \uff1a \u5973 \u5152 \uff0c \u4f60 \u7684 \u4fe1 \u6551 \u4e86 \u4f60 \uff1b \u5e73 \u5e73 \u5b89 \u5b89 \u7684 \u53bb \u7f77 \uff01"}, {"pk": 583277, "verse": 49, "text": "\u9084 \u8aaa \u8a71 \u7684 \u6642 \u5019 \uff0c \u6709 \u4eba \u5f9e \u7ba1 \u6703 \u5802 \u7684 \u5bb6 \u88e1 \u4f86 \uff0c \u8aaa \uff1a \u4f60 \u7684 \u5973 \u5152 \u6b7b \u4e86 \uff0c \u4e0d \u8981 \u52de \u52d5 \u592b \u5b50 \u3002"}, {"pk": 583278, "verse": 50, "text": "\u8036 \u7a4c \u807d \u898b \u5c31 \u5c0d \u4ed6 \u8aaa \uff1a \u4e0d \u8981 \u6015 \uff0c \u53ea \u8981 \u4fe1 \uff01 \u4f60 \u7684 \u5973 \u5152 \u5c31 \u5fc5 \u5f97 \u6551 \u3002"}, {"pk": 583279, "verse": 51, "text": "\u8036 \u7a4c \u5230 \u4e86 \u4ed6 \u7684 \u5bb6 \uff0c \u9664 \u4e86 \u5f7c \u5f97 \u3001 \u7d04 \u7ff0 \u3001 \u96c5 \u5404 \uff0c \u548c \u5973 \u5152 \u7684 \u7236 \u6bcd \uff0c \u4e0d \u8a31 \u5225 \u4eba \u540c \u4ed6 \u9032 \u53bb \u3002"}, {"pk": 583280, "verse": 52, "text": "\u773e \u4eba \u90fd \u70ba \u9019 \u5973 \u5152 \u54c0 \u54ed \u6376 \u80f8 \u3002 \u8036 \u7a4c \u8aaa \uff1a \u4e0d \u8981 \u54ed \u3002 \u4ed6 \u4e0d \u662f \u6b7b \u4e86 \uff0c \u662f \u7761 \u8457 \u4e86 \u3002"}, {"pk": 583281, "verse": 53, "text": "\u4ed6 \u5011 \u66c9 \u5f97 \u5973 \u5152 \u5df2 \u7d93 \u6b7b \u4e86 \uff0c \u5c31 \u55e4 \u7b11 \u8036 \u7a4c \u3002"}, {"pk": 583282, "verse": 54, "text": "\u8036 \u7a4c \u62c9 \u8457 \u4ed6 \u7684 \u624b \uff0c \u547c \u53eb \u8aaa \uff1a \u5973 \u5152 \uff0c \u8d77 \u4f86 \u7f77 \uff01"}, {"pk": 583283, "verse": 55, "text": "\u4ed6 \u7684 \u9748 \u9b42 \u4fbf \u56de \u4f86 \uff0c \u4ed6 \u5c31 \u7acb \u523b \u8d77 \u4f86 \u4e86 \u3002 \u8036 \u7a4c \u5429 \u5490 \u7d66 \u4ed6 \u6771 \u897f \u5403 \u3002"}, {"pk": 583284, "verse": 56, "text": "\u4ed6 \u7684 \u7236 \u6bcd \u9a5a \u5947 \u5f97 \u5f88 \uff1b \u8036 \u7a4c \u56d1 \u5490 \u4ed6 \u5011 \uff0c \u4e0d \u8981 \u628a \u6240 \u4f5c \u7684 \u4e8b \u544a \u8a34 \u4eba \u3002"}]