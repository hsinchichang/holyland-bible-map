[{"pk": 581176, "verse": 1, "text": "\u90a3 \u6642 \uff0c \u6709 \u65bd \u6d17 \u7684 \u7d04 \u7ff0 \u51fa \u4f86 \uff0c \u5728 \u7336 \u592a \u7684 \u66e0 \u91ce \u50b3 \u9053 \uff0c \u8aaa \uff1a"}, {"pk": 581177, "verse": 2, "text": "\u5929 \u570b \u8fd1 \u4e86 \uff0c \u4f60 \u5011 \u61c9 \u7576 \u6094 \u6539 \uff01"}, {"pk": 581178, "verse": 3, "text": "\u9019 \u4eba \u5c31 \u662f \u5148 \u77e5 \u4ee5 \u8cfd \u4e9e \u6240 \u8aaa \u7684 \u3002 \u4ed6 \u8aaa \uff1a \u5728 \u66e0 \u91ce \u6709 \u4eba \u8072 \u558a \u8457 \u8aaa \uff1a \u9810 \u5099 \u4e3b \u7684 \u9053 \uff0c \u4fee \u76f4 \u4ed6 \u7684 \u8def \uff01"}, {"pk": 581179, "verse": 4, "text": "\u9019 \u7d04 \u7ff0 \u8eab \u7a7f \u99f1 \u99dd \u6bdb \u7684 \u8863 \u670d \uff0c \u8170 \u675f \u76ae \u5e36 \uff0c \u5403 \u7684 \u662f \u8757 \u87f2 \u3001 \u91ce \u871c \u3002"}, {"pk": 581180, "verse": 5, "text": "\u90a3 \u6642 \uff0c \u8036 \u8def \u6492 \u51b7 \u548c \u7336 \u592a \u5168 \u5730 \uff0c \u4e26 \u7d04 \u4f46 \u6cb3 \u4e00 \u5e36 \u5730 \u65b9 \u7684 \u4eba \uff0c \u90fd \u51fa \u53bb \u5230 \u7d04 \u7ff0 \u90a3 \u88e1 \uff0c"}, {"pk": 581181, "verse": 6, "text": "\u627f \u8a8d \u4ed6 \u5011 \u7684 \u7f6a \uff0c \u5728 \u7d04 \u4f46 \u6cb3 \u88e1 \u53d7 \u4ed6 \u7684 \u6d17 \u3002"}, {"pk": 581182, "verse": 7, "text": "\u7d04 \u7ff0 \u770b \u898b \u8a31 \u591a \u6cd5 \u5229 \u8cfd \u4eba \u548c \u6492 \u90fd \u8a72 \u4eba \u4e5f \u4f86 \u53d7 \u6d17 \uff0c \u5c31 \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u6bd2 \u86c7 \u7684 \u7a2e \u985e \uff01 \u8ab0 \u6307 \u793a \u4f60 \u5011 \u9003 \u907f \u5c07 \u4f86 \u7684 \u5fff \u6012 \u5462 \uff1f"}, {"pk": 581183, "verse": 8, "text": "\u4f60 \u5011 \u8981 \u7d50 \u51fa \u679c \u5b50 \u4f86 \uff0c \u8207 \u6094 \u6539 \u7684 \u5fc3 \u76f8 \u7a31 \u3002"}, {"pk": 581184, "verse": 9, "text": "\u4e0d \u8981 \u81ea \u5df1 \u5fc3 \u88e1 \u8aaa \uff1a \u6709 \u4e9e \u4f2f \u62c9 \u7f55 \u70ba \u6211 \u5011 \u7684 \u7956 \u5b97 \u3002 \u6211 \u544a \u8a34 \u4f60 \u5011 \uff0c \u795e \u80fd \u5f9e \u9019 \u4e9b \u77f3 \u982d \u4e2d \u7d66 \u4e9e \u4f2f \u62c9 \u7f55 \u8208 \u8d77 \u5b50 \u5b6b \u4f86 \u3002"}, {"pk": 581185, "verse": 10, "text": "\u73fe \u5728 \u65a7 \u5b50 \u5df2 \u7d93 \u653e \u5728 \u6a39 \u6839 \u4e0a \uff0c \u51e1 \u4e0d \u7d50 \u597d \u679c \u5b50 \u7684 \u6a39 \u5c31 \u780d \u4e0b \u4f86 \uff0c \u4e1f \u5728 \u706b \u88e1 \u3002"}, {"pk": 581186, "verse": 11, "text": "\u6211 \u662f \u7528 \u6c34 \u7d66 \u4f60 \u5011 \u65bd \u6d17 \uff0c \u53eb \u4f60 \u5011 \u6094 \u6539 \u3002 \u4f46 \u90a3 \u5728 \u6211 \u4ee5 \u5f8c \u4f86 \u7684 \uff0c \u80fd \u529b \u6bd4 \u6211 \u66f4 \u5927 \uff0c \u6211 \u5c31 \u662f \u7d66 \u4ed6 \u63d0 \u978b \u4e5f \u4e0d \u914d \u3002 \u4ed6 \u8981 \u7528 \u8056 \u9748 \u8207 \u706b \u7d66 \u4f60 \u5011 \u65bd \u6d17 \u3002"}, {"pk": 581187, "verse": 12, "text": "\u4ed6 \u624b \u88e1 \u62ff \u8457 \u7c38 \u7b95 \uff0c \u8981 \u63da \u6de8 \u4ed6 \u7684 \u5834 \uff0c \u628a \u9ea5 \u5b50 \u6536 \u5728 \u5009 \u88e1 \uff0c \u628a \u7ce0 \u7528 \u4e0d \u6ec5 \u7684 \u706b \u71d2 \u76e1 \u4e86 \u3002"}, {"pk": 581188, "verse": 13, "text": "\u7576 \u4e0b \u8036 \u7a4c \u5f9e \u52a0 \u5229 \u5229 \u4f86 \u5230 \u7d04 \u4f46 \u6cb3 \uff0c \u898b \u4e86 \u7d04 \u7ff0 \uff0c \u8981 \u53d7 \u4ed6 \u7684 \u6d17 \u3002"}, {"pk": 581189, "verse": 14, "text": "\u7d04 \u7ff0 \u60f3 \u8981 \u6514 \u4f4f \u4ed6 \uff0c \u8aaa \uff1a \u6211 \u7576 \u53d7 \u4f60 \u7684 \u6d17 \uff0c \u4f60 \u53cd \u5012 \u4e0a \u6211 \u9019 \u88e1 \u4f86 \u9ebc \uff1f"}, {"pk": 581190, "verse": 15, "text": "\u8036 \u7a4c \u56de \u7b54 \u8aaa \uff1a \u4f60 \u66ab \u4e14 \u8a31 \u6211 \uff0c \u56e0 \u70ba \u6211 \u5011 \u7406 \u7576 \u9019 \u6a23 \u76e1 \u8af8 \u822c \u7684 \u7fa9 \uff08 \u6216 \u4f5c \uff1a \u79ae \uff09 \u3002 \u65bc \u662f \u7d04 \u7ff0 \u8a31 \u4e86 \u4ed6 \u3002"}, {"pk": 581191, "verse": 16, "text": "\u8036 \u7a4c \u53d7 \u4e86 \u6d17 \uff0c \u96a8 \u5373 \u5f9e \u6c34 \u88e1 \u4e0a \u4f86 \u3002 \u5929 \u5ffd \u7136 \u70ba \u4ed6 \u958b \u4e86 \uff0c \u4ed6 \u5c31 \u770b \u898b \u795e \u7684 \u9748 \u5f77 \u5f7f \u9d3f \u5b50 \u964d \u4e0b \uff0c \u843d \u5728 \u4ed6 \u8eab \u4e0a \u3002"}, {"pk": 581192, "verse": 17, "text": "\u5f9e \u5929 \u4e0a \u6709 \u8072 \u97f3 \u8aaa \uff1a \u9019 \u662f \u6211 \u7684 \u611b \u5b50 \uff0c \u6211 \u6240 \u559c \u6085 \u7684 \u3002"}]