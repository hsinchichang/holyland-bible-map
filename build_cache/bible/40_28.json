[{"pk": 582179, "verse": 1, "text": "\u5b89 \u606f \u65e5 \u5c07 \u76e1 \uff0c \u4e03 \u65e5 \u7684 \u982d \u4e00 \u65e5 \uff0c \u5929 \u5feb \u4eae \u7684 \u6642 \u5019 \uff0c \u62b9 \u5927 \u62c9 \u7684 \u99ac \u5229 \u4e9e \u548c \u90a3 \u500b \u99ac \u5229 \u4e9e \u4f86 \u770b \u58b3 \u5893 \u3002"}, {"pk": 582180, "verse": 2, "text": "\u5ffd \u7136 \uff0c \u5730 \u5927 \u9707 \u52d5 \uff1b \u56e0 \u70ba \u6709 \u4e3b \u7684 \u4f7f \u8005 \u5f9e \u5929 \u4e0a \u4e0b \u4f86 \uff0c \u628a \u77f3 \u982d \u6efe \u958b \uff0c \u5750 \u5728 \u4e0a \u9762 \u3002"}, {"pk": 582181, "verse": 3, "text": "\u4ed6 \u7684 \u50cf \u8c8c \u5982 \u540c \u9583 \u96fb \uff0c \u8863 \u670d \u6f54 \u767d \u5982 \u96ea \u3002"}, {"pk": 582182, "verse": 4, "text": "\u770b \u5b88 \u7684 \u4eba \u5c31 \u56e0 \u4ed6 \u5687 \u5f97 \u6e3e \u8eab \u4e82 \u6230 \uff0c \u751a \u81f3 \u548c \u6b7b \u4eba \u4e00 \u6a23 \u3002"}, {"pk": 582183, "verse": 5, "text": "\u5929 \u4f7f \u5c0d \u5a66 \u5973 \u8aaa \uff1a \u4e0d \u8981 \u5bb3 \u6015 \uff01 \u6211 \u77e5 \u9053 \u4f60 \u5011 \u662f \u5c0b \u627e \u90a3 \u91d8 \u5341 \u5b57 \u67b6 \u7684 \u8036 \u7a4c \u3002"}, {"pk": 582184, "verse": 6, "text": "\u4ed6 \u4e0d \u5728 \u9019 \u88e1 \uff0c \u7167 \u4ed6 \u6240 \u8aaa \u7684 \uff0c \u5df2 \u7d93 \u5fa9 \u6d3b \u4e86 \u3002 \u4f60 \u5011 \u4f86 \u770b \u5b89 \u653e \u4e3b \u7684 \u5730 \u65b9 \u3002"}, {"pk": 582185, "verse": 7, "text": "\u5feb \u53bb \u544a \u8a34 \u4ed6 \u7684 \u9580 \u5f92 \uff0c \u8aaa \u4ed6 \u5f9e \u6b7b \u88e1 \u5fa9 \u6d3b \u4e86 \uff0c \u4e26 \u4e14 \u5728 \u4f60 \u5011 \u4ee5 \u5148 \u5f80 \u52a0 \u5229 \u5229 \u53bb \uff0c \u5728 \u90a3 \u88e1 \u4f60 \u5011 \u8981 \u898b \u4ed6 \u3002 \u770b \u54ea \uff0c \u6211 \u5df2 \u7d93 \u544a \u8a34 \u4f60 \u5011 \u4e86 \u3002"}, {"pk": 582186, "verse": 8, "text": "\u5a66 \u5973 \u5011 \u5c31 \u6025 \u5fd9 \u96e2 \u958b \u58b3 \u5893 \uff0c \u53c8 \u5bb3 \u6015 \uff0c \u53c8 \u5927 \u5927 \u7684 \u6b61 \u559c \uff0c \u8dd1 \u53bb \u8981 \u5831 \u7d66 \u4ed6 \u7684 \u9580 \u5f92 \u3002"}, {"pk": 582187, "verse": 9, "text": "\u5ffd \u7136 \uff0c \u8036 \u7a4c \u9047 \u898b \u4ed6 \u5011 \uff0c \u8aaa \uff1a \u9858 \u4f60 \u5011 \u5e73 \u5b89 \uff01 \u4ed6 \u5011 \u5c31 \u4e0a \u524d \u62b1 \u4f4f \u4ed6 \u7684 \u8173 \u62dc \u4ed6 \u3002"}, {"pk": 582188, "verse": 10, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4e0d \u8981 \u5bb3 \u6015 \uff01 \u4f60 \u5011 \u53bb \u544a \u8a34 \u6211 \u7684 \u5f1f \u5144 \uff0c \u53eb \u4ed6 \u5011 \u5f80 \u52a0 \u5229 \u5229 \u53bb \uff0c \u5728 \u90a3 \u88e1 \u5fc5 \u898b \u6211 \u3002"}, {"pk": 582189, "verse": 11, "text": "\u4ed6 \u5011 \u53bb \u7684 \u6642 \u5019 \uff0c \u770b \u5b88 \u7684 \u5175 \u6709 \u5e7e \u500b \u9032 \u57ce \u53bb \uff0c \u5c07 \u6240 \u7d93 \u6b77 \u7684 \u4e8b \u90fd \u5831 \u7d66 \u796d \u53f8 \u9577 \u3002"}, {"pk": 582190, "verse": 12, "text": "\u796d \u53f8 \u9577 \u548c \u9577 \u8001 \u805a \u96c6 \u5546 \u8b70 \uff0c \u5c31 \u62ff \u8a31 \u591a \u9280 \u9322 \u7d66 \u5175 \u4e01 \uff0c \u8aaa \uff1a"}, {"pk": 582191, "verse": 13, "text": "\u4f60 \u5011 \u8981 \u9019 \u6a23 \u8aaa \uff1a \u591c \u9593 \u6211 \u5011 \u7761 \u89ba \u7684 \u6642 \u5019 \uff0c \u4ed6 \u7684 \u9580 \u5f92 \u4f86 \uff0c \u628a \u4ed6 \u5077 \u53bb \u4e86 \u3002"}, {"pk": 582192, "verse": 14, "text": "\u5018 \u82e5 \u9019 \u8a71 \u88ab \u5de1 \u64ab \u807d \u898b \uff0c \u6709 \u6211 \u5011 \u52f8 \u4ed6 \uff0c \u4fdd \u4f60 \u5011 \u7121 \u4e8b \u3002"}, {"pk": 582193, "verse": 15, "text": "\u5175 \u4e01 \u53d7 \u4e86 \u9280 \u9322 \uff0c \u5c31 \u7167 \u6240 \u56d1 \u5490 \u4ed6 \u5011 \u7684 \u53bb \u884c \u3002 \u9019 \u8a71 \u5c31 \u50b3 \u8aaa \u5728 \u7336 \u592a \u4eba \u4e2d \u9593 \uff0c \u76f4 \u5230 \u4eca \u65e5 \u3002"}, {"pk": 582194, "verse": 16, "text": "\u5341 \u4e00 \u500b \u9580 \u5f92 \u5f80 \u52a0 \u5229 \u5229 \u53bb \uff0c \u5230 \u4e86 \u8036 \u7a4c \u7d04 \u5b9a \u7684 \u5c71 \u4e0a \u3002"}, {"pk": 582195, "verse": 17, "text": "\u4ed6 \u5011 \u898b \u4e86 \u8036 \u7a4c \u5c31 \u62dc \u4ed6 \uff0c \u7136 \u800c \u9084 \u6709 \u4eba \u7591 \u60d1 \u3002"}, {"pk": 582196, "verse": 18, "text": "\u8036 \u7a4c \u9032 \u524d \u4f86 \uff0c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u5929 \u4e0a \u5730 \u4e0b \u6240 \u6709 \u7684 \u6b0a \u67c4 \u90fd \u8cdc \u7d66 \u6211 \u4e86 \u3002"}, {"pk": 582197, "verse": 19, "text": "\u6240 \u4ee5 \uff0c \u4f60 \u5011 \u8981 \u53bb \uff0c \u4f7f \u842c \u6c11 \u4f5c \u6211 \u7684 \u9580 \u5f92 \uff0c \u5949 \u7236 \u3001 \u5b50 \u3001 \u8056 \u9748 \u7684 \u540d \u7d66 \u4ed6 \u5011 \u65bd \u6d17 \uff08 \u6216 \u4f5c \uff1a \u7d66 \u4ed6 \u5011 \u65bd \u6d17 \uff0c \u6b78 \u65bc \u7236 \u3001 \u5b50 \u3001 \u8056 \u9748 \u7684 \u540d \uff09 \u3002"}, {"pk": 582198, "verse": 20, "text": "\u51e1 \u6211 \u6240 \u5429 \u5490 \u4f60 \u5011 \u7684 \uff0c \u90fd \u6559 \u8a13 \u4ed6 \u5011 \u9075 \u5b88 \uff0c \u6211 \u5c31 \u5e38 \u8207 \u4f60 \u5011 \u540c \u5728 \uff0c \u76f4 \u5230 \u4e16 \u754c \u7684 \u672b \u4e86 \u3002"}]