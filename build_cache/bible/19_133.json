[{"pk": 574153, "verse": 1, "text": "\uff08 \u5927 \u885b \u4e0a \u884c \u4e4b \u8a69 \u3002 \uff09 \u770b \u54ea \uff0c \u5f1f \u5144 \u548c \u7766 \u540c \u5c45 \u662f \u4f55 \u7b49 \u5730 \u5584 \uff0c \u4f55 \u7b49 \u5730 \u7f8e \uff01"}, {"pk": 574154, "verse": 2, "text": "\u9019 \u597d \u6bd4 \u90a3 \u8cb4 \u91cd \u7684 \u6cb9 \u6f86 \u5728 \u4e9e \u502b \u7684 \u982d \u4e0a \uff0c \u6d41 \u5230 \u9b0d \u9b1a \uff0c \u53c8 \u6d41 \u5230 \u4ed6 \u7684 \u8863 \u895f \uff1b"}, {"pk": 574155, "verse": 3, "text": "\u53c8 \u597d \u6bd4 \u9ed1 \u9580 \u7684 \u7518 \u9732 \u964d \u5728 \u932b \u5b89 \u5c71 \uff1b \u56e0 \u70ba \u5728 \u90a3 \u88e1 \u6709 \u8036 \u548c \u83ef \u6240 \u547d \u5b9a \u7684 \u798f \uff0c \u5c31 \u662f \u6c38 \u9060 \u7684 \u751f \u547d \u3002"}]