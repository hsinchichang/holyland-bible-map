[{"pk": 566116, "verse": 1, "text": "\u4ee5 \u8272 \u5217 \u773e \u652f \u6d3e \u4f86 \u5230 \u5e0c \u4f2f \u5d19 \u898b \u5927 \u885b \uff0c \u8aaa \uff1a \u6211 \u5011 \u539f \u662f \u4f60 \u7684 \u9aa8 \u8089 \u3002"}, {"pk": 566117, "verse": 2, "text": "\u5f9e \u524d \u6383 \u7f85 \u4f5c \u6211 \u5011 \u738b \u7684 \u6642 \u5019 \uff0c \u7387 \u9818 \u4ee5 \u8272 \u5217 \u4eba \u51fa \u5165 \u7684 \u662f \u4f60 \uff1b \u8036 \u548c \u83ef \u4e5f \u66fe \u61c9 \u8a31 \u4f60 \u8aaa \uff1a \u4f60 \u5fc5 \u7267 \u990a \u6211 \u7684 \u6c11 \u4ee5 \u8272 \u5217 \uff0c \u4f5c \u4ee5 \u8272 \u5217 \u7684 \u541b \u3002"}, {"pk": 566118, "verse": 3, "text": "\u65bc \u662f \u4ee5 \u8272 \u5217 \u7684 \u9577 \u8001 \u90fd \u4f86 \u5230 \u5e0c \u4f2f \u5d19 \u898b \u5927 \u885b \u738b \uff0c \u5927 \u885b \u5728 \u5e0c \u4f2f \u5d19 \u8036 \u548c \u83ef \u9762 \u524d \u8207 \u4ed6 \u5011 \u7acb \u7d04 \uff0c \u4ed6 \u5011 \u5c31 \u818f \u5927 \u885b \u4f5c \u4ee5 \u8272 \u5217 \u7684 \u738b \u3002"}, {"pk": 566119, "verse": 4, "text": "\u5927 \u885b \u767b \u57fa \u7684 \u6642 \u5019 \u5e74 \u4e09 \u5341 \u6b72 \uff0c \u5728 \u4f4d \u56db \u5341 \u5e74 \uff1b"}, {"pk": 566120, "verse": 5, "text": "\u5728 \u5e0c \u4f2f \u5d19 \u4f5c \u7336 \u5927 \u738b \u4e03 \u5e74 \u96f6 \u516d \u500b \u6708 \uff0c \u5728 \u8036 \u8def \u6492 \u51b7 \u4f5c \u4ee5 \u8272 \u5217 \u548c \u7336 \u5927 \u738b \u4e09 \u5341 \u4e09 \u5e74 \u3002"}, {"pk": 566121, "verse": 6, "text": "\u5927 \u885b \u548c \u8ddf \u96a8 \u4ed6 \u7684 \u4eba \u5230 \u4e86 \u8036 \u8def \u6492 \u51b7 \uff0c \u8981 \u653b \u6253 \u4f4f \u90a3 \u5730 \u65b9 \u7684 \u8036 \u5e03 \u65af \u4eba \u3002 \u8036 \u5e03 \u65af \u4eba \u5c0d \u5927 \u885b \u8aaa \uff1a \u4f60 \u82e5 \u4e0d \u8d95 \u51fa \u778e \u5b50 \u3001 \u7638 \u5b50 \uff0c \u5fc5 \u4e0d \u80fd \u9032 \u9019 \u5730 \u65b9 \uff1b \u5fc3 \u88e1 \u60f3 \u5927 \u885b \u6c7a \u4e0d \u80fd \u9032 \u53bb \u3002"}, {"pk": 566122, "verse": 7, "text": "\u7136 \u800c \u5927 \u885b \u653b \u53d6 \u932b \u5b89 \u7684 \u4fdd \u969c \uff0c \u5c31 \u662f \u5927 \u885b \u7684 \u57ce \u3002"}, {"pk": 566123, "verse": 8, "text": "\u7576 \u65e5 \uff0c \u5927 \u885b \u8aaa \uff1a \u8ab0 \u653b \u6253 \u8036 \u5e03 \u65af \u4eba \uff0c \u7576 \u4e0a \u6c34 \u6e9d \u653b \u6253 \u6211 \u5fc3 \u88e1 \u6240 \u6068 \u60e1 \u7684 \u7638 \u5b50 \u3001 \u778e \u5b50 \u3002 \u5f9e \u6b64 \u6709 \u4fd7 \u8a9e \u8aaa \uff1a \u5728 \u90a3 \u88e1 \u6709 \u778e \u5b50 \u3001 \u7638 \u5b50 \uff0c \u4ed6 \u4e0d \u80fd \u9032 \u5c4b \u53bb \u3002"}, {"pk": 566124, "verse": 9, "text": "\u5927 \u885b \u4f4f \u5728 \u4fdd \u969c \u88e1 \uff0c \u7d66 \u4fdd \u969c \u8d77 \u540d \u53eb \u5927 \u885b \u57ce \u3002 \u5927 \u885b \u53c8 \u5f9e \u7c73 \u7f85 \u4ee5 \u88e1 \uff0c \u5468 \u570d \u7bc9 \u7246 \u3002"}, {"pk": 566125, "verse": 10, "text": "\u5927 \u885b \u65e5 \u898b \u5f37 \u76db \uff0c \u56e0 \u70ba \u8036 \u548c \u83ef \u2500 \u842c \u8ecd \u4e4b \u3000 \u795e \u8207 \u4ed6 \u540c \u5728 \u3002"}, {"pk": 566126, "verse": 11, "text": "\u63a8 \u7f85 \u738b \u5e0c \u862d \u5c07 \u9999 \u67cf \u6728 \u904b \u5230 \u5927 \u885b \u90a3 \u88e1 \uff0c \u53c8 \u5dee \u9063 \u4f7f \u8005 \u548c \u6728 \u5320 \u3001 \u77f3 \u5320 \u7d66 \u5927 \u885b \u5efa \u9020 \u5bae \u6bbf \u3002"}, {"pk": 566127, "verse": 12, "text": "\u5927 \u885b \u5c31 \u77e5 \u9053 \u8036 \u548c \u83ef \u5805 \u7acb \u4ed6 \u4f5c \u4ee5 \u8272 \u5217 \u738b \uff0c \u53c8 \u70ba \u81ea \u5df1 \u7684 \u6c11 \u4ee5 \u8272 \u5217 \u4f7f \u4ed6 \u7684 \u570b \u8208 \u65fa \u3002"}, {"pk": 566128, "verse": 13, "text": "\u5927 \u885b \u96e2 \u958b \u5e0c \u4f2f \u5d19 \u4e4b \u5f8c \uff0c \u5728 \u8036 \u8def \u6492 \u51b7 \u53c8 \u7acb \u540e \u5983 \uff0c \u53c8 \u751f \u5152 \u5973 \u3002"}, {"pk": 566129, "verse": 14, "text": "\u5728 \u8036 \u8def \u6492 \u51b7 \u6240 \u751f \u7684 \u5152 \u5b50 \u662f \u6c99 \u6bcd \u4e9e \u3001 \u6714 \u7f77 \u3001 \u62ff \u55ae \u3001 \u6240 \u7f85 \u9580 \u3001"}, {"pk": 566130, "verse": 15, "text": "\u76ca \u8f44 \u3001 \u4ee5 \u5229 \u66f8 \u4e9e \u3001 \u5c3c \u6590 \u3001 \u96c5 \u975e \u4e9e \u3001"}, {"pk": 566131, "verse": 16, "text": "\u4ee5 \u5229 \u6c99 \u746a \u3001 \u4ee5 \u5229 \u96c5 \u5927 \u3001 \u4ee5 \u5229 \u6cd5 \u5217 \u3002"}, {"pk": 566132, "verse": 17, "text": "\u975e \u5229 \u58eb \u4eba \u807d \u898b \u4eba \u818f \u5927 \u885b \u4f5c \u4ee5 \u8272 \u5217 \u738b \uff0c \u975e \u5229 \u58eb \u4eba \u5c31 \u4e0a \u4f86 \u5c0b \u7d22 \u5927 \u885b \uff1b \u5927 \u885b \u807d \u898b \uff0c \u5c31 \u4e0b \u5230 \u4fdd \u969c \u3002"}, {"pk": 566133, "verse": 18, "text": "\u975e \u5229 \u58eb \u4eba \u4f86 \u4e86 \uff0c \u5e03 \u6563 \u5728 \u5229 \u4e4f \u97f3 \u8c37 \u3002"}, {"pk": 566134, "verse": 19, "text": "\u5927 \u885b \u6c42 \u554f \u8036 \u548c \u83ef \u8aaa \uff1a \u6211 \u53ef \u4ee5 \u4e0a \u53bb \u653b \u6253 \u975e \u5229 \u58eb \u4eba \u9ebc \uff1f \u4f60 \u5c07 \u4ed6 \u5011 \u4ea4 \u5728 \u6211 \u624b \u88e1 \u9ebc \uff1f \u8036 \u548c \u83ef \u8aaa \uff1a \u4f60 \u53ef \u4ee5 \u4e0a \u53bb \uff0c \u6211 \u5fc5 \u5c07 \u975e \u5229 \u58eb \u4eba \u4ea4 \u5728 \u4f60 \u624b \u88e1 \u3002"}, {"pk": 566135, "verse": 20, "text": "\u5927 \u885b \u4f86 \u5230 \u5df4 \u529b \u6bd7 \u62c9 \u5fc3 \uff0c \u5728 \u90a3 \u88e1 \u64ca \u6bba \u975e \u5229 \u58eb \u4eba \uff0c \u8aaa \uff1a \u8036 \u548c \u83ef \u5728 \u6211 \u9762 \u524d \u6c96 \u7834 \u6575 \u4eba \uff0c \u5982 \u540c \u6c34 \u6c96 \u53bb \u4e00 \u822c \u3002 \u56e0 \u6b64 \u7a31 \u90a3 \u5730 \u65b9 \u70ba \u5df4 \u529b \u6bd7 \u62c9 \u5fc3 \u3002"}, {"pk": 566136, "verse": 21, "text": "\u975e \u5229 \u58eb \u4eba \u5c07 \u5076 \u50cf \u6487 \u5728 \u90a3 \u88e1 \uff0c \u5927 \u885b \u548c \u8ddf \u96a8 \u4ed6 \u7684 \u4eba \u62ff \u53bb \u4e86 \u3002"}, {"pk": 566137, "verse": 22, "text": "\u975e \u5229 \u58eb \u4eba \u53c8 \u4e0a \u4f86 \uff0c \u5e03 \u6563 \u5728 \u5229 \u4e4f \u97f3 \u8c37 \u3002"}, {"pk": 566138, "verse": 23, "text": "\u5927 \u885b \u6c42 \u554f \u8036 \u548c \u83ef \uff1b \u8036 \u548c \u83ef \u8aaa \uff1a \u4e0d \u8981 \u4e00 \u76f4 \u5730 \u4e0a \u53bb \uff0c \u8981 \u8f49 \u5230 \u4ed6 \u5011 \u5f8c \u982d \uff0c \u5f9e \u6851 \u6797 \u5c0d \u9762 \u653b \u6253 \u4ed6 \u5011 \u3002"}, {"pk": 566139, "verse": 24, "text": "\u4f60 \u807d \u898b \u6851 \u6a39 \u68a2 \u4e0a \u6709 \u8173 \u6b65 \u7684 \u8072 \u97f3 \uff0c \u5c31 \u8981 \u6025 \u901f \u524d \u53bb \uff0c \u56e0 \u70ba \u90a3 \u6642 \u8036 \u548c \u83ef \u5df2 \u7d93 \u5728 \u4f60 \u524d \u982d \u53bb \u653b \u6253 \u975e \u5229 \u58eb \u4eba \u7684 \u8ecd \u968a \u3002"}, {"pk": 566140, "verse": 25, "text": "\u5927 \u885b \u5c31 \u9075 \u8457 \u8036 \u548c \u83ef \u6240 \u5429 \u5490 \u7684 \u53bb \u884c \uff0c \u653b \u6253 \u975e \u5229 \u58eb \u4eba \uff0c \u5f9e \u8fe6 \u5df4 \u76f4 \u5230 \u57fa \u8272 \u3002"}]