[{"pk": 581941, "verse": 1, "text": "\u8036 \u7a4c \u51fa \u4e86 \u8056 \u6bbf \uff0c \u6b63 \u8d70 \u7684 \u6642 \u5019 \uff0c \u9580 \u5f92 \u9032 \u524d \u4f86 \uff0c \u628a \u6bbf \u5b87 \u6307 \u7d66 \u4ed6 \u770b \u3002"}, {"pk": 581942, "verse": 2, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u4f60 \u5011 \u4e0d \u662f \u770b \u898b \u9019 \u6bbf \u5b87 \u9ebc \uff1f \u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u5c07 \u4f86 \u5728 \u9019 \u88e1 \u6c92 \u6709 \u4e00 \u584a \u77f3 \u982d \u7559 \u5728 \u77f3 \u982d \u4e0a \uff0c \u4e0d \u88ab \u62c6 \u6bc0 \u4e86 \u3002"}, {"pk": 581943, "verse": 3, "text": "\u8036 \u7a4c \u5728 \u6a44 \u6b16 \u5c71 \u4e0a \u5750 \u8457 \uff0c \u9580 \u5f92 \u6697 \u6697 \u7684 \u4f86 \u8aaa \uff1a \u8acb \u544a \u8a34 \u6211 \u5011 \uff0c \u751a \u9ebc \u6642 \u5019 \u6709 \u9019 \u4e9b \u4e8b \uff1f \u4f60 \u964d \u81e8 \u548c \u4e16 \u754c \u7684 \u672b \u4e86 \u6709 \u751a \u9ebc \u8c6b \u5146 \u5462 \uff1f"}, {"pk": 581944, "verse": 4, "text": "\u8036 \u7a4c \u56de \u7b54 \u8aaa \uff1a \u4f60 \u5011 \u8981 \u8b39 \u614e \uff0c \u514d \u5f97 \u6709 \u4eba \u8ff7 \u60d1 \u4f60 \u5011 \u3002"}, {"pk": 581945, "verse": 5, "text": "\u56e0 \u70ba \u5c07 \u4f86 \u6709 \u597d \u4e9b \u4eba \u5192 \u6211 \u7684 \u540d \u4f86 \uff0c \u8aaa \uff1a \u6211 \u662f \u57fa \u7763 \uff0c \u4e26 \u4e14 \u8981 \u8ff7 \u60d1 \u8a31 \u591a \u4eba \u3002"}, {"pk": 581946, "verse": 6, "text": "\u4f60 \u5011 \u4e5f \u8981 \u807d \u898b \u6253 \u4ed7 \u548c \u6253 \u4ed7 \u7684 \u98a8 \u8072 \uff0c \u7e3d \u4e0d \u8981 \u9a5a \u614c \uff1b \u56e0 \u70ba \u9019 \u4e9b \u4e8b \u662f \u5fc5 \u9808 \u6709 \u7684 \uff0c \u53ea \u662f \u672b \u671f \u9084 \u6c92 \u6709 \u5230 \u3002"}, {"pk": 581947, "verse": 7, "text": "\u6c11 \u8981 \u653b \u6253 \u6c11 \uff0c \u570b \u8981 \u653b \u6253 \u570b \uff1b \u591a \u8655 \u5fc5 \u6709 \u9951 \u8352 \u3001 \u5730 \u9707 \u3002"}, {"pk": 581948, "verse": 8, "text": "\u9019 \u90fd \u662f \u707d \u96e3 \uff08 \u707d \u96e3 \uff1a \u539f \u6587 \u662f \u751f \u7522 \u4e4b \u96e3 \uff09 \u7684 \u8d77 \u982d \u3002"}, {"pk": 581949, "verse": 9, "text": "\u90a3 \u6642 \uff0c \u4eba \u8981 \u628a \u4f60 \u5011 \u9677 \u5728 \u60a3 \u96e3 \u88e1 \uff0c \u4e5f \u8981 \u6bba \u5bb3 \u4f60 \u5011 \uff1b \u4f60 \u5011 \u53c8 \u8981 \u70ba \u6211 \u7684 \u540d \u88ab \u842c \u6c11 \u6068 \u60e1 \u3002"}, {"pk": 581950, "verse": 10, "text": "\u90a3 \u6642 \uff0c \u5fc5 \u6709 \u8a31 \u591a \u4eba \u8dcc \u5012 \uff0c \u4e5f \u8981 \u5f7c \u6b64 \u9677 \u5bb3 \uff0c \u5f7c \u6b64 \u6068 \u60e1 \uff1b"}, {"pk": 581951, "verse": 11, "text": "\u4e14 \u6709 \u597d \u4e9b \u5047 \u5148 \u77e5 \u8d77 \u4f86 \uff0c \u8ff7 \u60d1 \u591a \u4eba \u3002"}, {"pk": 581952, "verse": 12, "text": "\u53ea \u56e0 \u4e0d \u6cd5 \u7684 \u4e8b \u589e \u591a \uff0c \u8a31 \u591a \u4eba \u7684 \u611b \u5fc3 \u624d \u6f38 \u6f38 \u51b7 \u6de1 \u4e86 \u3002"}, {"pk": 581953, "verse": 13, "text": "\u60df \u6709 \u5fcd \u8010 \u5230 \u5e95 \u7684 \uff0c \u5fc5 \u7136 \u5f97 \u6551 \u3002"}, {"pk": 581954, "verse": 14, "text": "\u9019 \u5929 \u570b \u7684 \u798f \u97f3 \u8981 \u50b3 \u904d \u5929 \u4e0b \uff0c \u5c0d \u842c \u6c11 \u4f5c \u898b \u8b49 \uff0c \u7136 \u5f8c \u672b \u671f \u624d \u4f86 \u5230 \u3002"}, {"pk": 581955, "verse": 15, "text": "\u4f60 \u5011 \u770b \u898b \u5148 \u77e5 \u4f46 \u4ee5 \u7406 \u6240 \u8aaa \u7684 \u90a3 \u884c \u6bc0 \u58de \u53ef \u618e \u7684 \u7ad9 \u5728 \u8056 \u5730 \uff08 \u8b80 \u9019 \u7d93 \u7684 \u4eba \u9808 \u8981 \u6703 \u610f \uff09 \u3002"}, {"pk": 581956, "verse": 16, "text": "\u90a3 \u6642 \uff0c \u5728 \u7336 \u592a \u7684 \uff0c \u61c9 \u7576 \u9003 \u5230 \u5c71 \u4e0a \uff1b"}, {"pk": 581957, "verse": 17, "text": "\u5728 \u623f \u4e0a \u7684 \uff0c \u4e0d \u8981 \u4e0b \u4f86 \u62ff \u5bb6 \u88e1 \u7684 \u6771 \u897f \uff1b"}, {"pk": 581958, "verse": 18, "text": "\u5728 \u7530 \u88e1 \u7684 \uff0c \u4e5f \u4e0d \u8981 \u56de \u53bb \u53d6 \u8863 \u88f3 \u3002"}, {"pk": 581959, "verse": 19, "text": "\u7576 \u90a3 \u4e9b \u65e5 \u5b50 \uff0c \u61f7 \u5b55 \u7684 \u548c \u5976 \u5b69 \u5b50 \u7684 \u6709 \u798d \u4e86 \u3002"}, {"pk": 581960, "verse": 20, "text": "\u4f60 \u5011 \u61c9 \u7576 \u7948 \u6c42 \uff0c \u53eb \u4f60 \u5011 \u9003 \u8d70 \u7684 \u6642 \u5019 \uff0c \u4e0d \u9047 \u898b \u51ac \u5929 \u6216 \u662f \u5b89 \u606f \u65e5 \u3002"}, {"pk": 581961, "verse": 21, "text": "\u56e0 \u70ba \u90a3 \u6642 \u5fc5 \u6709 \u5927 \u707d \u96e3 \uff0c \u5f9e \u4e16 \u754c \u7684 \u8d77 \u982d \u76f4 \u5230 \u5982 \u4eca \uff0c \u6c92 \u6709 \u9019 \u6a23 \u7684 \u707d \u96e3 \uff0c \u5f8c \u4f86 \u4e5f \u5fc5 \u6c92 \u6709 \u3002"}, {"pk": 581962, "verse": 22, "text": "\u82e5 \u4e0d \u6e1b \u5c11 \u90a3 \u65e5 \u5b50 \uff0c \u51e1 \u6709 \u8840 \u6c23 \u7684 \u7e3d \u6c92 \u6709 \u4e00 \u500b \u5f97 \u6551 \u7684 \uff1b \u53ea \u662f \u70ba \u9078 \u6c11 \uff0c \u90a3 \u65e5 \u5b50 \u5fc5 \u6e1b \u5c11 \u4e86 \u3002"}, {"pk": 581963, "verse": 23, "text": "\u90a3 \u6642 \uff0c \u82e5 \u6709 \u4eba \u5c0d \u4f60 \u5011 \u8aaa \uff1a \u57fa \u7763 \u5728 \u9019 \u88e1 \uff0c \u6216 \u8aaa \uff1a \u57fa \u7763 \u5728 \u90a3 \u88e1 \uff0c \u4f60 \u5011 \u4e0d \u8981 \u4fe1 \uff01"}, {"pk": 581964, "verse": 24, "text": "\u56e0 \u70ba \u5047 \u57fa \u7763 \u3001 \u5047 \u5148 \u77e5 \u5c07 \u8981 \u8d77 \u4f86 \uff0c \u986f \u5927 \u795e \u8e5f \u3001 \u5927 \u5947 \u4e8b \uff0c \u5018 \u82e5 \u80fd \u884c \uff0c \u9023 \u9078 \u6c11 \u4e5f \u5c31 \u8ff7 \u60d1 \u4e86 \u3002"}, {"pk": 581965, "verse": 25, "text": "\u770b \u54ea \uff0c \u6211 \u9810 \u5148 \u544a \u8a34 \u4f60 \u5011 \u4e86 \u3002"}, {"pk": 581966, "verse": 26, "text": "\u82e5 \u6709 \u4eba \u5c0d \u4f60 \u5011 \u8aaa \uff1a \u770b \u54ea \uff0c \u57fa \u7763 \u5728 \u66e0 \u91ce \u88e1 \uff0c \u4f60 \u5011 \u4e0d \u8981 \u51fa \u53bb \uff01 \u6216 \u8aaa \uff1a \u770b \u54ea \uff0c \u57fa \u7763 \u5728 \u5167 \u5c4b \u4e2d \uff0c \u4f60 \u5011 \u4e0d \u8981 \u4fe1 \uff01"}, {"pk": 581967, "verse": 27, "text": "\u9583 \u96fb \u5f9e \u6771 \u908a \u767c \u51fa \uff0c \u76f4 \u7167 \u5230 \u897f \u908a \u3002 \u4eba \u5b50 \u964d \u81e8 \uff0c \u4e5f \u8981 \u9019 \u6a23 \u3002"}, {"pk": 581968, "verse": 28, "text": "\u5c4d \u9996 \u5728 \u90a3 \u88e1 \uff0c \u9df9 \u4e5f \u5fc5 \u805a \u5728 \u90a3 \u88e1 \u3002"}, {"pk": 581969, "verse": 29, "text": "\u90a3 \u4e9b \u65e5 \u5b50 \u7684 \u707d \u96e3 \u4e00 \u904e \u53bb \uff0c \u65e5 \u982d \u5c31 \u8b8a \u9ed1 \u4e86 \uff0c \u6708 \u4eae \u4e5f \u4e0d \u653e \u5149 \uff0c \u773e \u661f \u8981 \u5f9e \u5929 \u4e0a \u589c \u843d \uff0c \u5929 \u52e2 \u90fd \u8981 \u9707 \u52d5 \u3002"}, {"pk": 581970, "verse": 30, "text": "\u90a3 \u6642 \uff0c \u4eba \u5b50 \u7684 \u5146 \u982d \u8981 \u986f \u5728 \u5929 \u4e0a \uff0c \u5730 \u4e0a \u7684 \u842c \u65cf \u90fd \u8981 \u54c0 \u54ed \u3002 \u4ed6 \u5011 \u8981 \u770b \u898b \u4eba \u5b50 \uff0c \u6709 \u80fd \u529b \uff0c \u6709 \u5927 \u69ae \u8000 . \uff0c \u99d5 \u8457 \u5929 \u4e0a \u7684 \u96f2 \u964d \u81e8 \u3002"}, {"pk": 581971, "verse": 31, "text": "\u4ed6 \u8981 \u5dee \u9063 \u4f7f \u8005 \uff0c \u7528 \u865f \u7b52 \u7684 \u5927 \u8072 \uff0c \u5c07 \u4ed6 \u7684 \u9078 \u6c11 \uff0c \u5f9e \u56db \u65b9 \uff08 \u65b9 \uff1a \u539f \u6587 \u662f \u98a8 \uff09 \uff0c \u5f9e \u5929 \u9019 \u908a \u5230 \u5929 \u90a3 \u908a \uff0c \u90fd \u62db \u805a \u4e86 \u4f86 \u3002"}, {"pk": 581972, "verse": 32, "text": "\u4f60 \u5011 \u53ef \u4ee5 \u5f9e \u7121 \u82b1 \u679c \u6a39 \u5b78 \u500b \u6bd4 \u65b9 \uff1a \u7576 \u6a39 \u679d \u767c \u5ae9 \u9577 \u8449 \u7684 \u6642 \u5019 \uff0c \u4f60 \u5011 \u5c31 \u77e5 \u9053 \u590f \u5929 \u8fd1 \u4e86 \u3002"}, {"pk": 581973, "verse": 33, "text": "\u9019 \u6a23 \uff0c \u4f60 \u5011 \u770b \u898b \u9019 \u4e00 \u5207 \u7684 \u4e8b \uff0c \u4e5f \u8a72 \u77e5 \u9053 \u4eba \u5b50 \u8fd1 \u4e86 \uff0c \u6b63 \u5728 \u9580 \u53e3 \u4e86 \u3002"}, {"pk": 581974, "verse": 34, "text": "\u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u9019 \u4e16 \u4ee3 \u9084 \u6c92 \u6709 \u904e \u53bb \uff0c \u9019 \u4e9b \u4e8b \u90fd \u8981 \u6210 \u5c31 \u3002"}, {"pk": 581975, "verse": 35, "text": "\u5929 \u5730 \u8981 \u5ee2 \u53bb \uff0c \u6211 \u7684 \u8a71 \u537b \u4e0d \u80fd \u5ee2 \u53bb \u3002"}, {"pk": 581976, "verse": 36, "text": "\u90a3 \u65e5 \u5b50 \uff0c \u90a3 \u6642 \u8fb0 \uff0c \u6c92 \u6709 \u4eba \u77e5 \u9053 \uff0c \u9023 \u5929 \u4e0a \u7684 \u4f7f \u8005 \u4e5f \u4e0d \u77e5 \u9053 \uff0c \u5b50 \u4e5f \u4e0d \u77e5 \u9053 \uff0c \u60df \u7368 \u7236 \u77e5 \u9053 \u3002"}, {"pk": 581977, "verse": 37, "text": "\u632a \u4e9e \u7684 \u65e5 \u5b50 \u600e \u6a23 \uff0c \u4eba \u5b50 \u964d \u81e8 \u4e5f \u8981 \u600e \u6a23 \u3002"}, {"pk": 581978, "verse": 38, "text": "\u7576 \u6d2a \u6c34 \u4ee5 \u524d \u7684 \u65e5 \u5b50 \uff0c \u4eba \u7167 \u5e38 \u5403 \u559d \u5ac1 \u5a36 \uff0c \u76f4 \u5230 \u632a \u4e9e \u9032 \u65b9 \u821f \u7684 \u90a3 \u65e5 \uff1b"}, {"pk": 581979, "verse": 39, "text": "\u4e0d \u77e5 \u4e0d \u89ba \u6d2a \u6c34 \u4f86 \u4e86 \uff0c \u628a \u4ed6 \u5011 \u5168 \u90fd \u6c96 \u53bb \u3002 \u4eba \u5b50 \u964d \u81e8 \u4e5f \u8981 \u9019 \u6a23 \u3002"}, {"pk": 581980, "verse": 40, "text": "\u90a3 \u6642 \uff0c \u5169 \u500b \u4eba \u5728 \u7530 \u88e1 \uff0c \u53d6 \u53bb \u4e00 \u500b \uff0c \u6487 \u4e0b \u4e00 \u500b \u3002"}, {"pk": 581981, "verse": 41, "text": "\u5169 \u500b \u5973 \u4eba \u63a8 \u78e8 \uff0c \u53d6 \u53bb \u4e00 \u500b \uff0c \u6487 \u4e0b \u4e00 \u500b \u3002"}, {"pk": 581982, "verse": 42, "text": "\u6240 \u4ee5 \uff0c \u4f60 \u5011 \u8981 \u5106 \u9192 \uff0c \u56e0 \u70ba \u4e0d \u77e5 \u9053 \u4f60 \u5011 \u7684 \u4e3b \u662f \u90a3 \u4e00 \u5929 \u4f86 \u5230 \u3002"}, {"pk": 581983, "verse": 43, "text": "\u5bb6 \u4e3b \u82e5 \u77e5 \u9053 \u5e7e \u66f4 \u5929 \u6709 \u8cca \u4f86 \uff0c \u5c31 \u5fc5 \u5106 \u9192 \uff0c \u4e0d \u5bb9 \u4eba \u6316 \u900f \u623f \u5c4b \uff1b \u9019 \u662f \u4f60 \u5011 \u6240 \u77e5 \u9053 \u7684 \u3002"}, {"pk": 581984, "verse": 44, "text": "\u6240 \u4ee5 \uff0c \u4f60 \u5011 \u4e5f \u8981 \u9810 \u5099 \uff0c \u56e0 \u70ba \u4f60 \u5011 \u60f3 \u4e0d \u5230 \u7684 \u6642 \u5019 \uff0c \u4eba \u5b50 \u5c31 \u4f86 \u4e86 \u3002"}, {"pk": 581985, "verse": 45, "text": "\u8ab0 \u662f \u5fe0 \u5fc3 \u6709 \u898b \u8b58 \u7684 \u50d5 \u4eba \uff0c \u70ba \u4e3b \u4eba \u6240 \u6d3e \uff0c \u7ba1 \u7406 \u5bb6 \u88e1 \u7684 \u4eba \uff0c \u6309 \u6642 \u5206 \u7ce7 \u7d66 \u4ed6 \u5011 \u5462 \uff1f"}, {"pk": 581986, "verse": 46, "text": "\u4e3b \u4eba \u4f86 \u5230 \uff0c \u770b \u898b \u4ed6 \u9019 \u6a23 \u884c \uff0c \u90a3 \u50d5 \u4eba \u5c31 \u6709 \u798f \u4e86 \u3002"}, {"pk": 581987, "verse": 47, "text": "\u6211 \u5be6 \u5728 \u544a \u8a34 \u4f60 \u5011 \uff0c \u4e3b \u4eba \u8981 \u6d3e \u4ed6 \u7ba1 \u7406 \u4e00 \u5207 \u6240 \u6709 \u7684 \u3002"}, {"pk": 581988, "verse": 48, "text": "\u5018 \u82e5 \u90a3 \u60e1 \u50d5 \u5fc3 \u88e1 \u8aaa \uff1a \u6211 \u7684 \u4e3b \u4eba \u5fc5 \u4f86 \u5f97 \u9072 \uff0c"}, {"pk": 581989, "verse": 49, "text": "\u5c31 \u52d5 \u624b \u6253 \u4ed6 \u7684 \u540c \u4f34 \uff0c \u53c8 \u548c \u9152 \u9189 \u7684 \u4eba \u4e00 \u540c \u5403 \u559d \u3002"}, {"pk": 581990, "verse": 50, "text": "\u5728 \u60f3 \u4e0d \u5230 \u7684 \u65e5 \u5b50 \uff0c \u4e0d \u77e5 \u9053 \u7684 \u6642 \u8fb0 \uff0c \u90a3 \u50d5 \u4eba \u7684 \u4e3b \u4eba \u8981 \u4f86 \uff0c"}, {"pk": 581991, "verse": 51, "text": "\u91cd \u91cd \u7684 \u8655 \u6cbb \u4ed6 \uff08 \u6216 \u4f5c \uff1a \u628a \u4ed6 \u8170 \u65ac \u4e86 \uff09 \uff0c \u5b9a \u4ed6 \u548c \u5047 \u5192 \u70ba \u5584 \u7684 \u4eba \u540c \u7f6a \uff1b \u5728 \u90a3 \u88e1 \u5fc5 \u8981 \u54c0 \u54ed \u5207 \u9f52 \u4e86 \u3002"}]