[{"pk": 573379, "verse": 1, "text": "\u4f4f \u5728 \u81f3 \u9ad8 \u8005 \u96b1 \u5bc6 \u8655 \u7684 \uff0c \u5fc5 \u4f4f \u5728 \u5168 \u80fd \u8005 \u7684 \u852d \u4e0b \u3002"}, {"pk": 573380, "verse": 2, "text": "\u6211 \u8981 \u8ad6 \u5230 \u8036 \u548c \u83ef \u8aaa \uff1a \u4ed6 \u662f \u6211 \u7684 \u907f \u96e3 \u6240 \uff0c \u662f \u6211 \u7684 \u5c71 \u5be8 \uff0c \u662f \u6211 \u7684 \u3000 \u795e \uff0c \u662f \u6211 \u6240 \u501a \u9760 \u7684 \u3002"}, {"pk": 573381, "verse": 3, "text": "\u4ed6 \u5fc5 \u6551 \u4f60 \u812b \u96e2 \u6355 \u9ce5 \u4eba \u7684 \u7db2 \u7f85 \u548c \u6bd2 \u5bb3 \u7684 \u761f \u75ab \u3002"}, {"pk": 573382, "verse": 4, "text": "\u4ed6 \u5fc5 \u7528 \u81ea \u5df1 \u7684 \u7fce \u6bdb \u906e \u853d \u4f60 \uff1b \u4f60 \u8981 \u6295 \u9760 \u5728 \u4ed6 \u7684 \u7fc5 \u8180 \u5e95 \u4e0b \uff1b \u4ed6 \u7684 \u8aa0 \u5be6 \u662f \u5927 \u5c0f \u7684 \u76fe \u724c \u3002"}, {"pk": 573383, "verse": 5, "text": "\u4f60 \u5fc5 \u4e0d \u6015 \u9ed1 \u591c \u7684 \u9a5a \u99ed \uff0c \u6216 \u662f \u767d \u65e5 \u98db \u7684 \u7bad \uff0c"}, {"pk": 573384, "verse": 6, "text": "\u4e5f \u4e0d \u6015 \u9ed1 \u591c \u884c \u7684 \u761f \u75ab \uff0c \u6216 \u662f \u5348 \u9593 \u6ec5 \u4eba \u7684 \u6bd2 \u75c5 \u3002"}, {"pk": 573385, "verse": 7, "text": "\u96d6 \u6709 \u5343 \u4eba \u4ec6 \u5012 \u5728 \u4f60 \u65c1 \u908a \uff0c \u842c \u4eba \u4ec6 \u5012 \u5728 \u4f60 \u53f3 \u908a \uff0c \u9019 \u707d \u537b \u4e0d \u5f97 \u81e8 \u8fd1 \u4f60 \u3002"}, {"pk": 573386, "verse": 8, "text": "\u4f60 \u60df \u89aa \u773c \u89c0 \u770b \uff0c \u898b \u60e1 \u4eba \u906d \u5831 \u3002"}, {"pk": 573387, "verse": 9, "text": "\u8036 \u548c \u83ef \u662f \u6211 \u7684 \u907f \u96e3 \u6240 \uff1b \u4f60 \u5df2 \u5c07 \u81f3 \u9ad8 \u8005 \u7576 \u4f60 \u7684 \u5c45 \u6240 \uff0c"}, {"pk": 573388, "verse": 10, "text": "\u798d \u60a3 \u5fc5 \u4e0d \u81e8 \u5230 \u4f60 \uff0c \u707d \u5bb3 \u4e5f \u4e0d \u6328 \u8fd1 \u4f60 \u7684 \u5e33 \u68da \u3002"}, {"pk": 573389, "verse": 11, "text": "\u56e0 \u4ed6 \u8981 \u70ba \u4f60 \u5429 \u5490 \u4ed6 \u7684 \u4f7f \u8005 \uff0c \u5728 \u4f60 \u884c \u7684 \u4e00 \u5207 \u9053 \u8def \u4e0a \u4fdd \u8b77 \u4f60 \u3002"}, {"pk": 573390, "verse": 12, "text": "\u4ed6 \u5011 \u8981 \u7528 \u624b \u6258 \u8457 \u4f60 \uff0c \u514d \u5f97 \u4f60 \u7684 \u8173 \u78b0 \u5728 \u77f3 \u982d \u4e0a \u3002"}, {"pk": 573391, "verse": 13, "text": "\u4f60 \u8981 \u8e39 \u5728 \u7345 \u5b50 \u548c \u867a \u86c7 \u7684 \u8eab \u4e0a \uff0c \u8e10 \u8e0f \u5c11 \u58ef \u7345 \u5b50 \u548c \u5927 \u86c7 \u3002"}, {"pk": 573392, "verse": 14, "text": "\u795e \u8aaa \uff1a \u56e0 \u70ba \u4ed6 \u5c08 \u5fc3 \u611b \u6211 \uff0c \u6211 \u5c31 \u8981 \u642d \u6551 \u4ed6 \uff1b \u56e0 \u70ba \u4ed6 \u77e5 \u9053 \u6211 \u7684 \u540d \uff0c \u6211 \u8981 \u628a \u4ed6 \u5b89 \u7f6e \u5728 \u9ad8 \u8655 \u3002"}, {"pk": 573393, "verse": 15, "text": "\u4ed6 \u82e5 \u6c42 \u544a \u6211 \uff0c \u6211 \u5c31 \u61c9 \u5141 \u4ed6 \uff1b \u4ed6 \u5728 \u6025 \u96e3 \u4e2d \uff0c \u6211 \u8981 \u8207 \u4ed6 \u540c \u5728 \uff1b \u6211 \u8981 \u642d \u6551 \u4ed6 \uff0c \u4f7f \u4ed6 \u5c0a \u8cb4 \u3002"}, {"pk": 573394, "verse": 16, "text": "\u6211 \u8981 \u4f7f \u4ed6 \u8db3 \u4eab \u9577 \u58fd \uff0c \u5c07 \u6211 \u7684 \u6551 \u6069 \u986f \u660e \u7d66 \u4ed6 \u3002"}]