[{"pk": 581052, "verse": 1, "text": "\u8036 \u548c \u83ef \u7684 \u65e5 \u5b50 \u81e8 \u8fd1 \uff0c \u4f60 \u7684 \u8ca1 \u7269 \u5fc5 \u88ab \u6436 \u63a0 \uff0c \u5728 \u4f60 \u4e2d \u9593 \u5206 \u6563 \u3002"}, {"pk": 581053, "verse": 2, "text": "\u56e0 \u70ba \u6211 \u5fc5 \u805a \u96c6 \u842c \u570b \u8207 \u8036 \u8def \u6492 \u51b7 \u722d \u6230 \uff0c \u57ce \u5fc5 \u88ab \u653b \u53d6 \uff0c \u623f \u5c4b \u88ab \u6436 \u596a \uff0c \u5a66 \u5973 \u88ab \u73b7 \u6c61 \uff0c \u57ce \u4e2d \u7684 \u6c11 \u4e00 \u534a \u88ab \u64c4 \u53bb \uff1b \u5269 \u4e0b \u7684 \u6c11 \u4ecd \u5728 \u57ce \u4e2d \uff0c \u4e0d \u81f4 \u526a \u9664 \u3002"}, {"pk": 581054, "verse": 3, "text": "\u90a3 \u6642 \uff0c \u8036 \u548c \u83ef \u5fc5 \u51fa \u53bb \u8207 \u90a3 \u4e9b \u570b \u722d \u6230 \uff0c \u597d \u50cf \u5f9e \u524d \u722d \u6230 \u4e00 \u6a23 \u3002"}, {"pk": 581055, "verse": 4, "text": "\u90a3 \u65e5 \uff0c \u4ed6 \u7684 \u8173 \u5fc5 \u7ad9 \u5728 \u8036 \u8def \u6492 \u51b7 \u524d \u9762 \u671d \u6771 \u7684 \u6a44 \u6b16 \u5c71 \u4e0a \u3002 \u9019 \u5c71 \u5fc5 \u5f9e \u4e2d \u9593 \u5206 \u88c2 \uff0c \u81ea \u6771 \u81f3 \u897f \u6210 \u70ba \u6975 \u5927 \u7684 \u8c37 \u3002 \u5c71 \u7684 \u4e00 \u534a \u5411 \u5317 \u632a \u79fb \uff0c \u4e00 \u534a \u5411 \u5357 \u632a \u79fb \u3002"}, {"pk": 581056, "verse": 5, "text": "\u4f60 \u5011 \u8981 \u5f9e \u6211 \u5c71 \u7684 \u8c37 \u4e2d \u9003 \u8dd1 \uff0c \u56e0 \u70ba \u5c71 \u8c37 \u5fc5 \u5ef6 \u5230 \u4e9e \u85a9 \u3002 \u4f60 \u5011 \u9003 \u8dd1 \uff0c \u5fc5 \u5982 \u7336 \u5927 \u738b \u70cf \u897f \u96c5 \u5e74 \u9593 \u7684 \u4eba \u9003 \u907f \u5927 \u5730 \u9707 \u4e00 \u6a23 \u3002 \u8036 \u548c \u83ef \u2500 \u6211 \u7684 \u3000 \u795e \u5fc5 \u964d \u81e8 \uff0c \u6709 \u4e00 \u5207 \u8056 \u8005 \u540c \u4f86 \u3002"}, {"pk": 581057, "verse": 6, "text": "\u90a3 \u65e5 \uff0c \u5fc5 \u6c92 \u6709 \u5149 \uff0c \u4e09 \u5149 \u5fc5 \u9000 \u7e2e \u3002"}, {"pk": 581058, "verse": 7, "text": "\u90a3 \u65e5 \uff0c \u5fc5 \u662f \u8036 \u548c \u83ef \u6240 \u77e5 \u9053 \u7684 \uff0c \u4e0d \u662f \u767d \u665d \uff0c \u4e5f \u4e0d \u662f \u9ed1 \u591c \uff0c \u5230 \u4e86 \u665a \u4e0a \u624d \u6709 \u5149 \u660e \u3002"}, {"pk": 581059, "verse": 8, "text": "\u90a3 \u65e5 \uff0c \u5fc5 \u6709 \u6d3b \u6c34 \u5f9e \u8036 \u8def \u6492 \u51b7 \u51fa \u4f86 \uff0c \u4e00 \u534a \u5f80 \u6771 \u6d77 \u6d41 \uff0c \u4e00 \u534a \u5f80 \u897f \u6d77 \u6d41 \uff1b \u51ac \u590f \u90fd \u662f \u5982 \u6b64 \u3002"}, {"pk": 581060, "verse": 9, "text": "\u8036 \u548c \u83ef \u5fc5 \u4f5c \u5168 \u5730 \u7684 \u738b \u3002 \u90a3 \u65e5 \u8036 \u548c \u83ef \u5fc5 \u70ba \u7368 \u4e00 \u7121 \u4e8c \u7684 \uff0c \u4ed6 \u7684 \u540d \u4e5f \u662f \u7368 \u4e00 \u7121 \u4e8c \u7684 \u3002"}, {"pk": 581061, "verse": 10, "text": "\u5168 \u5730 \uff0c \u5f9e \u8fe6 \u5df4 \u76f4 \u5230 \u8036 \u8def \u6492 \u51b7 \u5357 \u65b9 \u7684 \u81e8 \u9580 \uff0c \u8981 \u8b8a \u70ba \u4e9e \u62c9 \u5df4 \u3002 \u8036 \u8def \u6492 \u51b7 \u5fc5 \u4ecd \u5c45 \u9ad8 \u4f4d \uff0c \u5c31 \u662f \u5f9e \u4fbf \u96c5 \u61ab \u9580 \u5230 \u7b2c \u4e00 \u9580 \u4e4b \u8655 \uff0c \u53c8 \u5230 \u89d2 \u9580 \uff0c \u4e26 \u5f9e \u54c8 \u6960 \u696d \u6a13 \uff0c \u76f4 \u5230 \u738b \u7684 \u9152 \u91a1 \u3002"}, {"pk": 581062, "verse": 11, "text": "\u4eba \u5fc5 \u4f4f \u5728 \u5176 \u4e2d \uff0c \u4e0d \u518d \u6709 \u5492 \u8a5b \u3002 \u8036 \u8def \u6492 \u51b7 \u4eba \u5fc5 \u5b89 \u7136 \u5c45 \u4f4f \u3002"}, {"pk": 581063, "verse": 12, "text": "\u8036 \u548c \u83ef \u7528 \u707d \u6b83 \u653b \u64ca \u90a3 \u8207 \u8036 \u8def \u6492 \u51b7 \u722d \u6230 \u7684 \u5217 \u570b \u4eba \uff0c \u5fc5 \u662f \u9019 \u6a23 \uff1a \u4ed6 \u5011 \u5169 \u8173 \u7ad9 \u7acb \u7684 \u6642 \u5019 \uff0c \u8089 \u5fc5 \u6d88 \u6c92 \uff0c \u773c \u5728 \u7736 \u4e2d \u4e7e \u765f \uff0c \u541e \u5728 \u53e3 \u4e2d \u6f70 \u721b \u3002"}, {"pk": 581064, "verse": 13, "text": "\u90a3 \u65e5 \uff0c \u8036 \u548c \u83ef \u5fc5 \u4f7f \u4ed6 \u5011 \u5927 \u5927 \u64fe \u4e82 \u3002 \u4ed6 \u5011 \u5404 \u4eba \u5f7c \u6b64 \u63ea \u4f4f \uff0c \u8209 \u624b \u653b \u64ca \u3002"}, {"pk": 581065, "verse": 14, "text": "\u7336 \u5927 \u4e5f \u5fc5 \u5728 \u8036 \u8def \u6492 \u51b7 \u722d \u6230 \u3002 \u90a3 \u6642 \u56db \u570d \u5404 \u570b \u7684 \u8ca1 \u7269 \uff0c \u5c31 \u662f \u8a31 \u591a \u91d1 \u9280 \u8863 \u670d \uff0c \u5fc5 \u88ab \u6536 \u805a \u3002"}, {"pk": 581066, "verse": 15, "text": "\u90a3 \u81e8 \u5230 \u99ac \u5339 \u3001 \u9a3e \u5b50 \u3001 \u99f1 \u99dd \u3001 \u9a62 \uff0c \u548c \u71df \u4e2d \u4e00 \u5207 \u7272 \u755c \u7684 \u707d \u6b83 \u662f \u8207 \u90a3 \u707d \u6b83 \u4e00 \u822c \u3002"}, {"pk": 581067, "verse": 16, "text": "\u6240 \u6709 \u4f86 \u653b \u64ca \u8036 \u8def \u6492 \u51b7 \u5217 \u570b \u4e2d \u5269 \u4e0b \u7684 \u4eba \uff0c \u5fc5 \u5e74 \u5e74 \u4e0a \u4f86 \u656c \u62dc \u5927 \u541b \u738b \u2500 \u842c \u8ecd \u4e4b \u8036 \u548c \u83ef \uff0c \u4e26 \u5b88 \u4f4f \u68da \u7bc0 \u3002"}, {"pk": 581068, "verse": 17, "text": "\u5730 \u4e0a \u842c \u65cf \u4e2d \uff0c \u51e1 \u4e0d \u4e0a \u8036 \u8def \u6492 \u51b7 \u656c \u62dc \u5927 \u541b \u738b \u2500 \u842c \u8ecd \u4e4b \u8036 \u548c \u83ef \u7684 \uff0c \u5fc5 \u7121 \u96e8 \u964d \u5728 \u4ed6 \u5011 \u7684 \u5730 \u4e0a \u3002"}, {"pk": 581069, "verse": 18, "text": "\u57c3 \u53ca \u65cf \u82e5 \u4e0d \u4e0a \u4f86 \uff0c \u96e8 \u4e5f \u4e0d \u964d \u5728 \u4ed6 \u5011 \u7684 \u5730 \u4e0a \uff1b \u51e1 \u4e0d \u4e0a \u4f86 \u5b88 \u4f4f \u68da \u7bc0 \u7684 \u5217 \u570b \u4eba \uff0c \u8036 \u548c \u83ef \u4e5f \u5fc5 \u7528 \u9019 \u707d \u653b \u64ca \u4ed6 \u5011 \u3002"}, {"pk": 581070, "verse": 19, "text": "\u9019 \u5c31 \u662f \u57c3 \u53ca \u7684 \u5211 \u7f70 \u548c \u90a3 \u4e0d \u4e0a \u4f86 \u5b88 \u4f4f \u68da \u7bc0 \u4e4b \u5217 \u570b \u7684 \u5211 \u7f70 \u3002"}, {"pk": 581071, "verse": 20, "text": "\u7576 \u90a3 \u65e5 \uff0c \u99ac \u7684 \u9234 \u943a \u4e0a \u5fc5 \u6709 \u6b78 \u8036 \u548c \u83ef \u70ba \u8056 \u7684 \u9019 \u53e5 \u8a71 \u3002 \u8036 \u548c \u83ef \u6bbf \u5167 \u7684 \u934b \u5fc5 \u5982 \u796d \u58c7 \u524d \u7684 \u7897 \u4e00 \u6a23 \u3002"}, {"pk": 581072, "verse": 21, "text": "\u51e1 \u8036 \u8def \u6492 \u51b7 \u548c \u7336 \u5927 \u7684 \u934b \u90fd \u5fc5 \u6b78 \u842c \u8ecd \u4e4b \u8036 \u548c \u83ef \u70ba \u8056 \u3002 \u51e1 \u737b \u796d \u7684 \u90fd \u5fc5 \u4f86 \u53d6 \u9019 \u934b \uff0c \u716e \u8089 \u5728 \u5176 \u4e2d \u3002 \u7576 \u90a3 \u65e5 \uff0c \u5728 \u842c \u8ecd \u4e4b \u8036 \u548c \u83ef \u7684 \u6bbf \u4e2d \u5fc5 \u4e0d \u518d \u6709 \u8fe6 \u5357 \u4eba \u3002"}]