[{"pk": 583091, "verse": 1, "text": "\u8036 \u7a4c \u7ad9 \u5728 \u9769 \u5c3c \u6492 \u52d2 \u6e56 \u908a \uff0c \u773e \u4eba \u64c1 \u64e0 \u4ed6 \uff0c \u8981 \u807d \u795e \u7684 \u9053 \u3002"}, {"pk": 583092, "verse": 2, "text": "\u4ed6 \u898b \u6709 \u5169 \u96bb \u8239 \u7063 \u5728 \u6e56 \u908a \uff1b \u6253 \u9b5a \u7684 \u4eba \u537b \u96e2 \u958b \u8239 \u6d17 \u7db2 \u53bb \u4e86 \u3002"}, {"pk": 583093, "verse": 3, "text": "\u6709 \u4e00 \u96bb \u8239 \u662f \u897f \u9580 \u7684 \uff0c \u8036 \u7a4c \u5c31 \u4e0a \u53bb \uff0c \u8acb \u4ed6 \u628a \u8239 \u6490 \u958b \uff0c \u7a0d \u5fae \u96e2 \u5cb8 \uff0c \u5c31 \u5750 \u4e0b \uff0c \u5f9e \u8239 \u4e0a \u6559 \u8a13 \u773e \u4eba \u3002"}, {"pk": 583094, "verse": 4, "text": "\u8b1b \u5b8c \u4e86 \uff0c \u5c0d \u897f \u9580 \u8aaa \uff1a \u628a \u8239 \u958b \u5230 \u6c34 \u6df1 \u4e4b \u8655 \uff0c \u4e0b \u7db2 \u6253 \u9b5a \u3002"}, {"pk": 583095, "verse": 5, "text": "\u897f \u9580 \u8aaa \uff1a \u592b \u5b50 \uff0c \u6211 \u5011 \u6574 \u591c \u52de \u529b \uff0c \u4e26 \u6c92 \u6709 \u6253 \u8457 \u751a \u9ebc \u3002 \u4f46 \u4f9d \u5f9e \u4f60 \u7684 \u8a71 \uff0c \u6211 \u5c31 \u4e0b \u7db2 \u3002"}, {"pk": 583096, "verse": 6, "text": "\u4ed6 \u5011 \u4e0b \u4e86 \u7db2 \uff0c \u5c31 \u5708 \u4f4f \u8a31 \u591a \u9b5a \uff0c \u7db2 \u96aa \u4e9b \u88c2 \u958b \uff0c"}, {"pk": 583097, "verse": 7, "text": "\u4fbf \u62db \u547c \u90a3 \u96bb \u8239 \u4e0a \u7684 \u540c \u4f34 \u4f86 \u5e6b \u52a9 \u3002 \u4ed6 \u5011 \u5c31 \u4f86 \uff0c \u628a \u9b5a \u88dd \u6eff \u4e86 \u5169 \u96bb \u8239 \uff0c \u751a \u81f3 \u8239 \u8981 \u6c89 \u4e0b \u53bb \u3002"}, {"pk": 583098, "verse": 8, "text": "\u897f \u9580 \u5f7c \u5f97 \u770b \u898b \uff0c \u5c31 \u4fef \u4f0f \u5728 \u8036 \u7a4c \u819d \u524d \uff0c \u8aaa \uff1a \u4e3b \u963f \uff01 \u96e2 \u958b \u6211 \uff0c \u6211 \u662f \u500b \u7f6a \u4eba \uff01"}, {"pk": 583099, "verse": 9, "text": "\u4ed6 \u548c \u4e00 \u5207 \u540c \u5728 \u7684 \u4eba \u90fd \u9a5a \u8a1d \u9019 \u4e00 \u7db2 \u6240 \u6253 \u7684 \u9b5a \u3002"}, {"pk": 583100, "verse": 10, "text": "\u4ed6 \u7684 \u5925 \u4f34 \u897f \u5e87 \u592a \u7684 \u5152 \u5b50 \u96c5 \u5404 \u3001 \u7d04 \u7ff0 \uff0c \u4e5f \u662f \u9019 \u6a23 \u3002 \u8036 \u7a4c \u5c0d \u897f \u9580 \u8aaa \uff1a \u4e0d \u8981 \u6015 \uff01 \u5f9e \u4eca \u4ee5 \u5f8c \uff0c \u4f60 \u8981 \u5f97 \u4eba \u4e86 \u3002"}, {"pk": 583101, "verse": 11, "text": "\u4ed6 \u5011 \u628a \u5169 \u96bb \u8239 \u650f \u4e86 \u5cb8 \uff0c \u5c31 \u6487 \u4e0b \u6240 \u6709 \u7684 \uff0c \u8ddf \u5f9e \u4e86 \u8036 \u7a4c \u3002"}, {"pk": 583102, "verse": 12, "text": "\u6709 \u4e00 \u56de \uff0c \u8036 \u7a4c \u5728 \u4e00 \u500b \u57ce \u88e1 \uff0c \u6709 \u4eba \u6eff \u8eab \u9577 \u4e86 \u5927 \u75f2 \u760b \uff0c \u770b \u898b \u4ed6 \uff0c \u5c31 \u4fef \u4f0f \u5728 \u5730 \uff0c \u6c42 \u4ed6 \u8aaa \uff1a \u4e3b \u82e5 \u80af \uff0c \u5fc5 \u80fd \u53eb \u6211 \u6f54 \u6de8 \u4e86 \u3002"}, {"pk": 583103, "verse": 13, "text": "\u8036 \u7a4c \u4f38 \u624b \u6478 \u4ed6 \uff0c \u8aaa \uff1a \u6211 \u80af \uff0c \u4f60 \u6f54 \u6de8 \u4e86 \u7f77 \uff01 \u5927 \u75f2 \u760b \u7acb \u523b \u5c31 \u96e2 \u4e86 \u4ed6 \u7684 \u8eab \u3002"}, {"pk": 583104, "verse": 14, "text": "\u8036 \u7a4c \u56d1 \u5490 \u4ed6 \uff1a \u4f60 \u5207 \u4e0d \u53ef \u544a \u8a34 \u4eba \uff0c \u53ea \u8981 \u53bb \u628a \u8eab \u9ad4 \u7d66 \u796d \u53f8 \u5bdf \u770b \uff0c \u53c8 \u8981 \u70ba \u4f60 \u5f97 \u4e86 \u6f54 \u6de8 \uff0c \u7167 \u6469 \u897f \u6240 \u5429 \u5490 \u7684 \u737b \u4e0a \u79ae \u7269 \uff0c \u5c0d \u773e \u4eba \u4f5c \u8b49 \u64da \u3002"}, {"pk": 583105, "verse": 15, "text": "\u4f46 \u8036 \u7a4c \u7684 \u540d \u8072 \u8d8a \u767c \u50b3 \u63da \u51fa \u53bb \u3002 \u6709 \u6975 \u591a \u7684 \u4eba \u805a \u96c6 \u4f86 \u807d \u9053 \uff0c \u4e5f \u6307 \u671b \u91ab \u6cbb \u4ed6 \u5011 \u7684 \u75c5 \u3002"}, {"pk": 583106, "verse": 16, "text": "\u8036 \u7a4c \u537b \u9000 \u5230 \u66e0 \u91ce \u53bb \u79b1 \u544a \u3002"}, {"pk": 583107, "verse": 17, "text": "\u6709 \u4e00 \u5929 \uff0c \u8036 \u7a4c \u6559 \u8a13 \u4eba \uff0c \u6709 \u6cd5 \u5229 \u8cfd \u4eba \u548c \u6559 \u6cd5 \u5e2b \u5728 \u65c1 \u908a \u5750 \u8457 \uff1b \u4ed6 \u5011 \u662f \u5f9e \u52a0 \u5229 \u5229 \u5404 \u9109 \u6751 \u548c \u7336 \u592a \u4e26 \u8036 \u8def \u6492 \u51b7 \u4f86 \u7684 \u3002 \u4e3b \u7684 \u80fd \u529b \u8207 \u8036 \u7a4c \u540c \u5728 \uff0c \u4f7f \u4ed6 \u80fd \u91ab \u6cbb \u75c5 \u4eba \u3002"}, {"pk": 583108, "verse": 18, "text": "\u6709 \u4eba \u7528 \u8925 \u5b50 \u62ac \u8457 \u4e00 \u500b \u7671 \u5b50 \uff0c \u8981 \u62ac \u9032 \u53bb \u653e \u5728 \u8036 \u7a4c \u9762 \u524d \uff0c"}, {"pk": 583109, "verse": 19, "text": "\u537b \u56e0 \u4eba \u591a \uff0c \u5c0b \u4e0d \u51fa \u6cd5 \u5b50 \u62ac \u9032 \u53bb \uff0c \u5c31 \u4e0a \u4e86 \u623f \u9802 \uff0c \u5f9e \u74e6 \u9593 \u628a \u4ed6 \u9023 \u8925 \u5b50 \u7e0b \u5230 \u7576 \u4e2d \uff0c \u6b63 \u5728 \u8036 \u7a4c \u9762 \u524d \u3002"}, {"pk": 583110, "verse": 20, "text": "\u8036 \u7a4c \u898b \u4ed6 \u5011 \u7684 \u4fe1 \u5fc3 \uff0c \u5c31 \u5c0d \u7671 \u5b50 \u8aaa \uff1a \u4f60 \u7684 \u7f6a \u8d66 \u4e86 \u3002"}, {"pk": 583111, "verse": 21, "text": "\u6587 \u58eb \u548c \u6cd5 \u5229 \u8cfd \u4eba \u5c31 \u8b70 \u8ad6 \u8aaa \uff1a \u9019 \u8aaa \u50ed \u5984 \u8a71 \u7684 \u662f \u8ab0 \uff1f \u9664 \u4e86 \u795e \u4ee5 \u5916 \uff0c \u8ab0 \u80fd \u8d66 \u7f6a \u5462 \uff1f"}, {"pk": 583112, "verse": 22, "text": "\u8036 \u7a4c \u77e5 \u9053 \u4ed6 \u5011 \u6240 \u8b70 \u8ad6 \u7684 \uff0c \u5c31 \u8aaa \uff1a \u4f60 \u5011 \u5fc3 \u88e1 \u8b70 \u8ad6 \u7684 \u662f \u751a \u9ebc \u5462 \uff1f"}, {"pk": 583113, "verse": 23, "text": "\u6216 \u8aaa \u4f60 \u7684 \u7f6a \u8d66 \u4e86 \uff0c \u6216 \u8aaa \u4f60 \u8d77 \u4f86 \u884c \u8d70 \uff0c \u90a3 \u4e00 \u6a23 \u5bb9 \u6613 \u5462 \uff1f"}, {"pk": 583114, "verse": 24, "text": "\u4f46 \u8981 \u53eb \u4f60 \u5011 \u77e5 \u9053 \uff0c \u4eba \u5b50 \u5728 \u5730 \u4e0a \u6709 \u8d66 \u7f6a \u7684 \u6b0a \u67c4 \u3002 \u5c31 \u5c0d \u7671 \u5b50 \u8aaa \uff1a \u6211 \u5429 \u5490 \u4f60 \uff0c \u8d77 \u4f86 \uff0c \u62ff \u4f60 \u7684 \u8925 \u5b50 \u56de \u5bb6 \u53bb \u7f77 \uff01"}, {"pk": 583115, "verse": 25, "text": "\u90a3 \u4eba \u7576 \u773e \u4eba \u9762 \u524d \u7acb \u523b \u8d77 \u4f86 \uff0c \u62ff \u8457 \u4ed6 \u6240 \u8eba \u81e5 \u7684 \u8925 \u5b50 \u56de \u5bb6 \u53bb \uff0c \u6b78 \u69ae \u8000 \u8207 \u795e \u3002"}, {"pk": 583116, "verse": 26, "text": "\u773e \u4eba \u90fd \u9a5a \u5947 \uff0c \u4e5f \u6b78 \u69ae \u8000 \u8207 \u795e \uff0c \u4e26 \u4e14 \u6eff \u5fc3 \u61fc \u6015 \uff0c \u8aaa \uff1a \u6211 \u5011 \u4eca \u65e5 \u770b \u898b \u975e \u5e38 \u7684 \u4e8b \u4e86 \u3002"}, {"pk": 583117, "verse": 27, "text": "\u9019 \u4e8b \u4ee5 \u5f8c \uff0c \u8036 \u7a4c \u51fa \u53bb \uff0c \u770b \u898b \u4e00 \u500b \u7a05 \u540f \uff0c \u540d \u53eb \u5229 \u672a \uff0c \u5750 \u5728 \u7a05 \u95dc \u4e0a \uff0c \u5c31 \u5c0d \u4ed6 \u8aaa \uff1a \u4f60 \u8ddf \u5f9e \u6211 \u4f86 \u3002"}, {"pk": 583118, "verse": 28, "text": "\u4ed6 \u5c31 \u6487 \u4e0b \u6240 \u6709 \u7684 \uff0c \u8d77 \u4f86 \uff0c \u8ddf \u5f9e \u4e86 \u8036 \u7a4c \u3002"}, {"pk": 583119, "verse": 29, "text": "\u5229 \u672a \u5728 \u81ea \u5df1 \u5bb6 \u88e1 \u70ba \u8036 \u7a4c \u5927 \u64fa \u7b75 \u5e2d \uff0c \u6709 \u8a31 \u591a \u7a05 \u540f \u548c \u5225 \u4eba \u8207 \u4ed6 \u5011 \u4e00 \u540c \u5750 \u5e2d \u3002"}, {"pk": 583120, "verse": 30, "text": "\u6cd5 \u5229 \u8cfd \u4eba \u548c \u6587 \u58eb \u5c31 \u5411 \u8036 \u7a4c \u7684 \u9580 \u5f92 \u767c \u6028 \u8a00 \u8aaa \uff1a \u4f60 \u5011 \u70ba \u751a \u9ebc \u548c \u7a05 \u540f \u4e26 \u7f6a \u4eba \u4e00 \u540c \u5403 \u559d \u5462 \uff1f"}, {"pk": 583121, "verse": 31, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u7121 \u75c5 \u7684 \u4eba \u7528 \u4e0d \u8457 \u91ab \u751f \uff1b \u6709 \u75c5 \u7684 \u4eba \u624d \u7528 \u5f97 \u8457 \u3002"}, {"pk": 583122, "verse": 32, "text": "\u6211 \u4f86 \u672c \u4e0d \u662f \u53ec \u7fa9 \u4eba \u6094 \u6539 \uff0c \u4e43 \u662f \u53ec \u7f6a \u4eba \u6094 \u6539 \u3002"}, {"pk": 583123, "verse": 33, "text": "\u4ed6 \u5011 \u8aaa \uff1a \u7d04 \u7ff0 \u7684 \u9580 \u5f92 \u5c62 \u6b21 \u7981 \u98df \u7948 \u79b1 \uff0c \u6cd5 \u5229 \u8cfd \u4eba \u7684 \u9580 \u5f92 \u4e5f \u662f \u9019 \u6a23 \uff1b \u60df \u7368 \u4f60 \u7684 \u9580 \u5f92 \u53c8 \u5403 \u53c8 \u559d \u3002"}, {"pk": 583124, "verse": 34, "text": "\u8036 \u7a4c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u65b0 \u90ce \u548c \u966a \u4f34 \u4e4b \u4eba \u540c \u5728 \u7684 \u6642 \u5019 \uff0c \u8c48 \u80fd \u53eb \u966a \u4f34 \u4e4b \u4eba \u7981 \u98df \u5462 \uff1f"}, {"pk": 583125, "verse": 35, "text": "\u4f46 \u65e5 \u5b50 \u5c07 \u5230 \uff0c \u65b0 \u90ce \u8981 \u96e2 \u958b \u4ed6 \u5011 \uff0c \u90a3 \u65e5 \u4ed6 \u5011 \u5c31 \u8981 \u7981 \u98df \u4e86 \u3002"}, {"pk": 583126, "verse": 36, "text": "\u8036 \u7a4c \u53c8 \u8a2d \u4e00 \u500b \u6bd4 \u55bb \uff0c \u5c0d \u4ed6 \u5011 \u8aaa \uff1a \u6c92 \u6709 \u4eba \u628a \u65b0 \u8863 \u670d \u6495 \u4e0b \u4e00 \u584a \u4f86 \u88dc \u5728 \u820a \u8863 \u670d \u4e0a \uff1b \u82e5 \u662f \u9019 \u6a23 \uff0c \u5c31 \u628a \u65b0 \u7684 \u6495 \u7834 \u4e86 \uff0c \u4e26 \u4e14 \u6240 \u6495 \u4e0b \u4f86 \u7684 \u90a3 \u584a \u65b0 \u7684 \u548c \u820a \u7684 \u4e5f \u4e0d \u76f8 \u7a31 \u3002"}, {"pk": 583127, "verse": 37, "text": "\u4e5f \u6c92 \u6709 \u4eba \u628a \u65b0 \u9152 \u88dd \u5728 \u820a \u76ae \u888b \u88e1 \uff1b \u82e5 \u662f \u9019 \u6a23 \uff0c \u65b0 \u9152 \u5fc5 \u5c07 \u76ae \u888b \u88c2 \u958b \uff0c \u9152 \u4fbf \u6f0f \u51fa \u4f86 \uff0c \u76ae \u888b \u4e5f \u5c31 \u58de \u4e86 \u3002"}, {"pk": 583128, "verse": 38, "text": "\u4f46 \u65b0 \u9152 \u5fc5 \u9808 \u88dd \u5728 \u65b0 \u76ae \u888b \u88e1 \u3002"}, {"pk": 583129, "verse": 39, "text": "\u6c92 \u6709 \u4eba \u559d \u4e86 \u9673 \u9152 \u53c8 \u60f3 \u559d \u65b0 \u7684 \uff1b \u4ed6 \u7e3d \u8aaa \u9673 \u7684 \u597d \u3002"}]