[{"pk": 574065, "verse": 1, "text": "\uff08 \u4e0a \u884c \u4e4b \u8a69 \u3002 \uff09 \u6211 \u8981 \u5411 \u5c71 \u8209 \u76ee \uff1b \u6211 \u7684 \u5e6b \u52a9 \u5f9e \u4f55 \u800c \u4f86 \uff1f"}, {"pk": 574066, "verse": 2, "text": "\u6211 \u7684 \u5e6b \u52a9 \u5f9e \u9020 \u5929 \u5730 \u7684 \u8036 \u548c \u83ef \u800c \u4f86 \u3002"}, {"pk": 574067, "verse": 3, "text": "\u4ed6 \u5fc5 \u4e0d \u53eb \u4f60 \u7684 \u8173 \u6416 \u52d5 \uff1b \u4fdd \u8b77 \u4f60 \u7684 \u5fc5 \u4e0d \u6253 \u76f9 \uff01"}, {"pk": 574068, "verse": 4, "text": "\u4fdd \u8b77 \u4ee5 \u8272 \u5217 \u7684 \uff0c \u4e5f \u4e0d \u6253 \u76f9 \u4e5f \u4e0d \u7761 \u89ba \u3002"}, {"pk": 574069, "verse": 5, "text": "\u4fdd \u8b77 \u4f60 \u7684 \u662f \u8036 \u548c \u83ef \uff1b \u8036 \u548c \u83ef \u5728 \u4f60 \u53f3 \u908a \u852d \u5e87 \u4f60 \u3002"}, {"pk": 574070, "verse": 6, "text": "\u767d \u65e5 \uff0c \u592a \u967d \u5fc5 \u4e0d \u50b7 \u4f60 \uff1b \u591c \u9593 \uff0c \u6708 \u4eae \u5fc5 \u4e0d \u5bb3 \u4f60 \u3002"}, {"pk": 574071, "verse": 7, "text": "\u8036 \u548c \u83ef \u8981 \u4fdd \u8b77 \u4f60 \uff0c \u514d \u53d7 \u4e00 \u5207 \u7684 \u707d \u5bb3 \uff1b \u4ed6 \u8981 \u4fdd \u8b77 \u4f60 \u7684 \u6027 \u547d \u3002"}, {"pk": 574072, "verse": 8, "text": "\u4f60 \u51fa \u4f60 \u5165 \uff0c \u8036 \u548c \u83ef \u8981 \u4fdd \u8b77 \u4f60 \uff0c \u5f9e \u4eca \u6642 \u76f4 \u5230 \u6c38 \u9060 \u3002"}]